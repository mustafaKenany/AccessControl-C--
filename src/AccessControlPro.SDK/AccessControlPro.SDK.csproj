<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="FCardCDrive">
      <HintPath>NativeDlls\FCardCDrive.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="NativeDlls\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <!-- Prevent duplicate publish conflict: FCardCDrive is already a managed Reference -->
    <None Update="NativeDlls\FCardCDrive.dll">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
