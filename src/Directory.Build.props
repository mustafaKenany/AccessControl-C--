<Project>
  <!-- Single source of truth for the product version across ALL projects (apps AND internal
       libraries). Without this, SDK/Application/Domain/Infrastructure defaulted to 1.0.0.0 and
       the release zip carried stale internal DLLs while only the app DLLs were version-stamped.
       Bump this one value per release. -->
  <PropertyGroup>
    <Version>4.6.60</Version>
    <AssemblyVersion>4.6.60.0</AssemblyVersion>
    <FileVersion>4.6.60.0</FileVersion>
  </PropertyGroup>
</Project>
