<UserControl x:Class="AccessControlPro.WPF.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Lang.NavDevices}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                        Padding="12,8" Margin="0,0,10,0" MinWidth="220">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Search" Width="13" Height="13"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"/>
                    </DockPanel>
                </Border>

                <!-- Search Network Button -->
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding SearchNetworkCommand}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Wifi" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.SearchNetwork}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Add Device Button -->
                <Button Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource SuccessBrush}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Plus" Width="12" Height="12"
                                         Foreground="White" Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.AddDevice}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ═══ Stats Bar ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <!-- Online -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding OnlineCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Online, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Offline -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding OfflineCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Offline, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Total -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Server" Width="12" Height="12"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Total, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Refresh -->
            <Button Style="{StaticResource SidebarButton}"
                    Command="{Binding RefreshCommand}" Margin="10,0,0,0">
                <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </StackPanel>

        <!-- ═══ Table Header ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgInputBrush}" CornerRadius="12,12,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Lang.Status}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Lang.DeviceName}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Lang.Model}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Lang.IPAddress}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding Lang.MACAddress}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Lang.Port}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="6" Text="{Binding Lang.Doors}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="7" Text="{Binding Lang.NavCards}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="8" Text="{Binding Lang.Actions}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- ═══ Table Body ═══ -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" CornerRadius="0,0,12,12">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Background="Transparent"
                                    Padding="18,14" CornerRadius="0"
                                    BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="330"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Name + Serial -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SerialNumber}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Model -->
                                    <TextBlock Grid.Column="2" Text="{Binding DeviceType}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- IP -->
                                    <TextBlock Grid.Column="3" Text="{Binding IP}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- MAC -->
                                    <TextBlock Grid.Column="4" Text="{Binding MAC}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Port -->
                                    <TextBlock Grid.Column="5" Text="{Binding TCPPort}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Doors -->
                                    <Border Grid.Column="6" Background="{StaticResource BgInputBrush}"
                                            CornerRadius="6" Padding="8,4"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DoorCount}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryLightBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Cards -->
                                    <Border Grid.Column="7" Background="{StaticResource BgInputBrush}"
                                            CornerRadius="6" Padding="8,4"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CardCount}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Actions — WrapPanel so all buttons stay reachable (Delete was
                                         clipping off the fixed-width column at 1366x768) -->
                                    <WrapPanel Grid.Column="8" VerticalAlignment="Center">
                                        <!-- Connect -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Connect, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanConnect, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="Plug" Width="12" Height="12"
                                                                         Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#1878CDD7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Open Door -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.OpenDoor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.RemoteOpenDoorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanConnect, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="UnlockAlt" Width="12" Height="12"
                                                                         Foreground="{StaticResource SuccessBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#182ED47A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Sync All Players -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.DevSyncAllPlayers, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.SyncAllPlayersCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanConnect, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="Upload" Width="12" Height="12"
                                                                         Foreground="#4FC3F7"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#184FC3F7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- More — rarely-used device actions (info, sync time, revoke expired,
                                             change IP, download logs, factory reset) in an overflow menu -->
                                        <Button Cursor="Hand" Click="DeviceMoreClick" ToolTip="More"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="EllipsisH" Width="12" Height="12"
                                                                         Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding PlacementTarget.Tag.Lang.DeviceInfo, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Command="{Binding PlacementTarget.Tag.GetDeviceInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{Binding PlacementTarget.Tag.Lang.SyncTime, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Command="{Binding PlacementTarget.Tag.SyncTimeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{Binding PlacementTarget.Tag.Lang.RevokeExpired, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Command="{Binding PlacementTarget.Tag.RevokeExpiredCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding PlacementTarget.Tag.Lang.ChangeIP, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Command="{Binding PlacementTarget.Tag.ChangeIPCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{Binding PlacementTarget.Tag.Lang.DownloadLogs, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Command="{Binding PlacementTarget.Tag.DownloadLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Factory Reset"
                                                              Command="{Binding PlacementTarget.Tag.FactoryResetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <!-- Edit/Rename -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Edit, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.RenameDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="Pencil" Width="12" Height="12"
                                                                         Foreground="{StaticResource PrimaryLightBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Delete -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Delete, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="TrashOutline" Width="12" Height="12"
                                                                         Foreground="{StaticResource DangerBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18F7685B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading / Downloading overlay -->
            <Border Background="#CC0E2A2D" CornerRadius="0,0,12,12"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Spinner" Width="30" Height="30"
                                     Foreground="{StaticResource PrimaryLightBrush}" SpinDuration="1" Spin="True"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
