<Window x:Class="AccessControlPro.WPF.Views.MemberCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="{Binding MemberCard, Source={x:Static helpers:LanguageManager.Instance}}"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#0B1416"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}">
    <StackPanel Margin="26">

        <!-- Printable card -->
        <Border x:Name="CardRoot" Width="400" Height="250" CornerRadius="16"
                Background="White" BorderBrush="#247B7B" BorderThickness="1.5"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header band: gym name -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="14,9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0D5C63" Offset="0"/>
                            <GradientStop Color="#247B7B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="GymNameText" Foreground="White" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Body: photo | info | QR -->
                <Grid Grid.Row="1" Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Photo -->
                    <Border Grid.Column="0" Width="92" Height="112" CornerRadius="8"
                            Background="#ECF1F1" BorderBrush="#CFDADA" BorderThickness="1"
                            VerticalAlignment="Top" ClipToBounds="True">
                        <Grid>
                            <fa:ImageAwesome x:Name="PhotoPlaceholder" Icon="User" Width="40" Height="40"
                                             Foreground="#9FB0B2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PhotoImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" Margin="14,2,10,0" VerticalAlignment="Top">
                        <TextBlock x:Name="NameText" Foreground="#10302F" FontSize="17" FontWeight="Bold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock x:Name="SubLabel" Text="" Foreground="#6B7B7D" FontSize="11"/>
                            <TextBlock x:Name="SubText" Foreground="#1B4D4B" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="ExpiryLabel" Foreground="#6B7B7D" FontSize="11"/>
                            <TextBlock x:Name="ExpiryText" Foreground="#1B4D4B" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="PhoneLabel" Foreground="#6B7B7D" FontSize="11"/>
                            <TextBlock x:Name="PhoneText" Foreground="#1B4D4B" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- QR + card number -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <Border Background="White" Padding="2" BorderBrush="#E0E6E6" BorderThickness="1">
                            <Image x:Name="QrImage" Width="92" Height="92"/>
                        </Border>
                        <TextBlock x:Name="CardNoText" Foreground="#10302F" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Buttons (not printed) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Padding="18,10" Click="PrintClick" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Print" Width="13" Height="13"
                                     Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PosPrintReceipt, Source={x:Static helpers:LanguageManager.Instance}}"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Padding="22,10" Click="CloseClick">
                <TextBlock Text="{Binding OK, Source={x:Static helpers:LanguageManager.Instance}}"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
