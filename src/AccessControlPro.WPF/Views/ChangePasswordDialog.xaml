<Window x:Class="AccessControlPro.WPF.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#1A1A2E" CornerRadius="14" BorderBrush="#2A2A3E" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top accent bar -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="#44A1A0"/>

            <!-- Header -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,22,28,0">
                <fa:ImageAwesome Icon="Key" Width="26" Height="26" Foreground="#78CDD7"
                                 VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Change Password"
                           FontSize="18" FontWeight="Bold" Foreground="#FFFFFA"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="2" Margin="28,20,28,0">
                <!-- Warning message for forced change -->
                <TextBlock x:Name="WarningText" TextWrapping="Wrap"
                           Foreground="#FFB946" FontSize="12.5"
                           Margin="0,0,0,14" Visibility="Collapsed"
                           LineHeight="20"/>

                <!-- Current Password -->
                <TextBlock x:Name="CurrentPasswordLabel" Text="Current Password"
                           FontSize="12" Foreground="#9EC5C8" Margin="0,0,0,6"/>
                <Border Background="#143436" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Lock" Width="14" Height="14"
                                         Foreground="#5A5A7A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center"
                                     CaretBrush="#E0E0E0"
                                     FontFamily="{StaticResource CairoFont}" FontWeight="Bold"/>
                    </DockPanel>
                </Border>

                <!-- New Password -->
                <TextBlock x:Name="NewPasswordLabel" Text="New Password"
                           FontSize="12" Foreground="#9EC5C8" Margin="0,0,0,6"/>
                <Border Background="#143436" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Lock" Width="14" Height="14"
                                         Foreground="#5A5A7A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center"
                                     CaretBrush="#E0E0E0"
                                     FontFamily="{StaticResource CairoFont}" FontWeight="Bold"/>
                    </DockPanel>
                </Border>

                <!-- Confirm Password -->
                <TextBlock x:Name="ConfirmPasswordLabel" Text="Confirm New Password"
                           FontSize="12" Foreground="#9EC5C8" Margin="0,0,0,6"/>
                <Border Background="#143436" CornerRadius="10" Padding="14,10" Margin="0,0,0,0">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Lock" Width="14" Height="14"
                                         Foreground="#5A5A7A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center"
                                     CaretBrush="#E0E0E0"
                                     FontFamily="{StaticResource CairoFont}" FontWeight="Bold"/>
                    </DockPanel>
                </Border>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" Text="" FontSize="12"
                           Foreground="#F7685B" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,20,0,24">
                <!-- Cancel -->
                <Button Width="140" Height="40" Margin="0,0,14,0"
                        Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#2A2A3E" CornerRadius="10"
                                    BorderBrush="#444" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333350"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="CancelButtonText" Text="Cancel" FontSize="14"
                               FontWeight="Bold" Foreground="#B0B0CC"/>
                </Button>

                <!-- Save -->
                <Button Width="140" Height="40"
                        Click="SaveButton_Click" IsDefault="True" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#44A1A0" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#247B7B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="SaveButtonText" Text="Save" FontSize="14"
                               FontWeight="Bold" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
