<Window x:Class="AccessControlPro.WPF.Views.QuickAddMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:ctrl="clr-namespace:AccessControlPro.WPF.Controls"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" SizeToContent="Manual"
        Width="860" Height="640" MouseLeftButtonDown="Window_Drag">

    <Window.Resources>
        <!-- Bare template for the plan tiles: the Border child carries all the visuals + hover. -->
        <ControlTemplate x:Key="TileTemplate" TargetType="Button">
            <ContentPresenter/>
        </ControlTemplate>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3044A1A0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#0F2427" BorderBrush="#2044A1A0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <DockPanel Margin="0">

            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Margin="24,20,20,8">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="UserPlus" Width="22" Height="22" Foreground="#2ED47A"
                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TitleText" Text="إضافة عضو سريع" FontSize="21" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="34" Height="34" Cursor="Hand"
                        Click="Cancel_Click" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cb" Background="Transparent" CornerRadius="8">
                                <fa:ImageAwesome Icon="Times" Width="14" Height="14" Foreground="#B0FFFFFF"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="Background" Value="#40F7685B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Action bar -->
            <Border DockPanel.Dock="Bottom" Margin="24,8,24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalAlignment="Left" Click="Cancel_Click" Cursor="Hand"
                            Width="140" Height="50" Background="#16FFFFFF">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cc" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="#30FFFFFF" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cc" Property="Background" Value="#26FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="CancelText" Text="إلغاء" FontSize="17" FontWeight="Bold" Foreground="#D0FFFFFF"/>
                    </Button>
                    <Button Grid.Column="1" HorizontalAlignment="Right" Click="Save_Click" Cursor="Hand"
                            Width="220" Height="50" Background="#2ED47A">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="sc" CornerRadius="12" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="sc" Property="Background" Value="#38E087"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Check" Width="18" Height="18" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SaveText" Text="حفظ العضو" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Body: fields (left) + plans & keypad (right) -->
            <Grid Margin="24,4,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Left: fields -->
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="NameLabel" Text="الاسم" FontSize="14" FontWeight="Bold" Foreground="#B0FFFFFF" Margin="2,0,0,5"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Field}" GotFocus="NameBox_GotFocus"/>

                    <TextBlock x:Name="PhoneLabel" Text="الهاتف" FontSize="14" FontWeight="Bold" Foreground="#B0FFFFFF" Margin="2,14,0,5"/>
                    <TextBox x:Name="PhoneBox" Style="{StaticResource Field}" GotFocus="NumericField_GotFocus"/>

                    <TextBlock x:Name="CardLabel" Text="رقم الكارت (امسح أو أدخل)" FontSize="14" FontWeight="Bold" Foreground="#B0FFFFFF" Margin="2,14,0,5"/>
                    <TextBox x:Name="CardBox" Style="{StaticResource Field}" GotFocus="NumericField_GotFocus"/>

                    <TextBlock x:Name="PaidLabel" Text="المبلغ المدفوع" FontSize="14" FontWeight="Bold" Foreground="#B0FFFFFF" Margin="2,14,0,5"/>
                    <TextBox x:Name="PaidBox" Style="{StaticResource Field}" GotFocus="NumericField_GotFocus"/>

                    <!-- Selected plan summary -->
                    <Border CornerRadius="12" Background="#142ED47A" BorderBrush="#402ED47A" BorderThickness="1"
                            Padding="14,10" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SummaryPlan" Text="لم يتم اختيار خطة" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="SummaryDates" Text="" FontSize="13" Foreground="#B0FFFFFF" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: plan tiles + keypad -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" x:Name="PlansLabel" Text="اختر الخطة" FontSize="14" FontWeight="Bold"
                               Foreground="#B0FFFFFF" Margin="2,0,0,6"/>
                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <ItemsControl x:Name="PlansPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ctrl:NumericKeypad x:Name="Keypad" DockPanel.Dock="Bottom"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
