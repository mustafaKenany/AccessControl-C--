<UserControl x:Class="AccessControlPro.WPF.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- ═══ Header ═══ -->
            <DockPanel Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TitleText}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding GreetingText}" FontSize="15"
                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding TodayDateText}" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <!-- Daily Pass now lives ONLY here on the home screen -->
                    <Button Style="{StaticResource PrimaryButton}" Background="#2E7D32" Margin="0,0,10,0"
                            Command="{Binding CreateDailyPassCommand}" ToolTip="{Binding DailyPassText}"
                            Visibility="{Binding CanDailyPass, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Qrcode" Width="14" Height="14"
                                             Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DailyPassText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                             Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RefreshText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- ═══ Three big owner cards ═══ -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,24">

                <!-- Entries today -->
                <Border CornerRadius="18" Padding="26,22" Margin="0,0,9,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D5C63" Offset="0"/>
                            <GradientStop Color="#247B7B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#0D5C63" BlurRadius="26" ShadowDepth="0" Opacity="0.28"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#30FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:ImageAwesome Icon="SignIn" Width="24" Height="24" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding EntriesToday}" FontSize="46" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding EntriesLabel}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#C8FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Subscriptions today -->
                <Border CornerRadius="18" Padding="26,22" Margin="9,0,9,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2ED47A" Offset="0"/>
                            <GradientStop Color="#56E89A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#2ED47A" BlurRadius="26" ShadowDepth="0" Opacity="0.28"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#30FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:ImageAwesome Icon="UserPlus" Width="24" Height="24" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding SubscriptionsToday}" FontSize="46" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding SubscriptionsLabel}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#C8FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Revenue today -->
                <Border CornerRadius="18" Padding="26,22" Margin="9,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#B8860B" Offset="0"/>
                            <GradientStop Color="#E0A526" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#B8860B" BlurRadius="26" ShadowDepth="0" Opacity="0.28"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#30FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:ImageAwesome Icon="Money" Width="24" Height="24" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding RevenueTodayText}" FontSize="34" FontWeight="Bold"
                                   Foreground="White" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding RevenueLabel}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#C8FFFFFF" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ Expiring soon ═══ -->
            <Border Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Right" Background="#22F7685B" CornerRadius="12" Padding="12,4"
                                VerticalAlignment="Center"
                                Visibility="{Binding ExpiringCount, Converter={StaticResource GreaterThanZeroToVisibility}}">
                            <TextBlock Text="{Binding ExpiringCount}" FontSize="15" FontWeight="Bold"
                                       Foreground="#F7685B"/>
                        </Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="ClockOutline" Width="18" Height="18"
                                                 Foreground="#FFB946" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ExpiringTitle}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ExpiringHint}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="28,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Empty state -->
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="12" Padding="20,26"
                            Visibility="{Binding NoExpiring, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="CheckCircle" Width="30" Height="30" Foreground="#2ED47A"
                                             HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding EmptyExpiringText}" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Member cards -->
                    <ItemsControl ItemsSource="{Binding ExpiringSoon}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgInputBrush}" CornerRadius="14"
                                        Padding="14" Margin="5" Width="210">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Photo (circular) with fallback icon behind -->
                                        <Border Width="58" Height="58" CornerRadius="29" Margin="0,0,12,0"
                                                Background="#2444A1A0">
                                            <Grid>
                                                <fa:ImageAwesome Icon="User" Width="26" Height="26"
                                                                 Foreground="#8044A1A0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border CornerRadius="29" ClipToBounds="True">
                                                    <Border.Background>
                                                        <ImageBrush Stretch="UniformToFill"
                                                                    ImageSource="{Binding PhotoData, Converter={StaticResource BytesToImage}}"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Width="112">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{Binding AccentBrush}" CornerRadius="8"
                                                    Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding DaysLeftText}" FontSize="12"
                                                           FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Phone}" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
