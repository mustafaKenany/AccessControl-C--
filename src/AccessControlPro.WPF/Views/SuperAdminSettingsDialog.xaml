<Window x:Class="AccessControlPro.WPF.Views.SuperAdminSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperAdmin Settings" WindowStartupLocation="CenterOwner" WindowStyle="None"
        SizeToContent="Height" Width="460" Background="#0B1416" ResizeMode="NoResize"
        FontFamily="{StaticResource CairoFont}">
    <Border Padding="26" BorderBrush="#1E2D2C" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="&#x1F6E0;  SuperAdmin Settings" Foreground="#44A1A0" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Local overrides for this machine (offline gyms). Online gyms are controlled from the cloud portal."
                       Foreground="#9FB0B2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <CheckBox x:Name="PosCheck" Foreground="White" FontSize="14" Margin="0,0,0,12">
                <TextBlock Text="Cashier / POS module enabled" Foreground="White"/>
            </CheckBox>
            <CheckBox x:Name="OnlineCheck" Foreground="White" FontSize="14" Margin="0,0,0,12">
                <TextBlock Text="Online subscription enabled (cloud sync)" Foreground="White"/>
            </CheckBox>
            <CheckBox x:Name="QrPoolCheck" Foreground="White" FontSize="14" Margin="0,0,0,4">
                <TextBlock Text="QR pool enabled (guest / daily passes loaded to gate)" Foreground="White"/>
            </CheckBox>
            <TextBlock x:Name="StatusText" Foreground="#2ED47A" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Close" Click="Close_Click" Padding="20,8" Background="#2A3A4A"
                        Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Click="Save_Click" Padding="20,8" Background="#44A1A0"
                        Foreground="White" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
