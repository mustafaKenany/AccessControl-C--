<Window x:Class="AccessControlPro.WPF.Views.DailyPassDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="{Binding DailyPass, Source={x:Static helpers:LanguageManager.Instance}}"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}">
    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="16" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <TextBlock x:Name="GymNameText" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DailyPass, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <!-- Price -->
            <Border Background="#15FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock x:Name="PriceLabel" FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PriceText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}"/>
                </DockPanel>
            </Border>
            <TextBlock x:Name="TodaySummaryText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Two main actions -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="QrButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                        Background="#2E7D32" Padding="0,16" Click="QrTicketClick">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Qrcode" Width="22" Height="22" Foreground="White"
                                         HorizontalAlignment="Center"/>
                        <TextBlock x:Name="QrButtonText" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TempButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Background="#0D5C63" Padding="0,16" Click="TempCardToggle">
                    <StackPanel>
                        <fa:ImageAwesome Icon="IdCard" Width="22" Height="22" Foreground="White"
                                         HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TempButtonText" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Manual entry: the captain admits the guest himself (joker card / door push
                 button). The system just records the daily-pass fee — no QR or card issued. -->
            <Button x:Name="ManualButton" Style="{StaticResource PrimaryButton}"
                    Background="#5D4037" Padding="0,14" Margin="0,8,0,0" Click="ManualEntryClick">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="HandPointerOutline" Width="18" Height="18" Foreground="White"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ManualButtonText" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Temporary card panel -->
            <Border x:Name="TempPanel" Visibility="Collapsed" Background="#10FFFFFF" CornerRadius="10"
                    Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="ScanHint" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="IssueButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource PrimaryLightBrush}" Padding="16,8" Margin="8,0,0,0"
                                Click="IssueCardClick"/>
                        <TextBox x:Name="CardNumberBox" Style="{StaticResource DarkTextBox}" Padding="10,8"
                                 FontSize="14" KeyDown="CardNumberBox_KeyDown"/>
                    </DockPanel>

                    <TextBlock x:Name="OutHeader" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,6"/>
                    <ItemsControl x:Name="OutList" MaxHeight="180">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12FFFFFF" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Tag="{Binding CardNumber}"
                                                Click="ReturnCardClick" Cursor="Hand"
                                                Background="#33F7685B" BorderThickness="0" Padding="10,5">
                                            <TextBlock Text="{Binding ReturnLabel}" Foreground="#FF8A7F" FontSize="12"/>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CardNumber}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding IssuedAtText}" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource SecondaryButton}" Padding="0,12" Click="CloseClick"
                    HorizontalContentAlignment="Center" Margin="0,16,0,0">
                <TextBlock x:Name="CloseText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
