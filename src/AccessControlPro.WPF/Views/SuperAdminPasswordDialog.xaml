<Window x:Class="AccessControlPro.WPF.Views.SuperAdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperAdmin" WindowStartupLocation="CenterScreen" WindowStyle="None"
        SizeToContent="Height" Width="430" Background="#0B1416" ResizeMode="NoResize"
        FontFamily="{StaticResource CairoFont}">
    <Border Padding="26" BorderBrush="#1E2D2C" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="&#x1F512;  SuperAdmin required" Foreground="#44A1A0" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="ActionText" Foreground="#D7E0E8" FontSize="13" TextWrapping="Wrap"
                       Margin="0,0,0,16"/>
            <TextBlock Text="SuperAdmin password" Foreground="#9FB0B2" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" FontSize="15" Padding="8,7" Background="#11201F"
                         Foreground="White" BorderBrush="#2A3A4A" BorderThickness="1"/>
            <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12" Margin="0,8,0,0"
                       Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Padding="20,8" Background="#2A3A4A"
                        Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Confirm" Click="Confirm_Click" Padding="20,8" Background="#44A1A0"
                        Foreground="White" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
