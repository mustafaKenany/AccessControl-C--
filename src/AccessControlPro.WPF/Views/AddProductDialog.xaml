<Window x:Class="AccessControlPro.WPF.Views.AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="{Binding PosAddProduct, Source={x:Static helpers:LanguageManager.Instance}}"
        Width="460" Height="520" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}" FontWeight="Bold">
    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding PosAddProduct, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <!-- Name EN -->
            <TextBlock Text="{Binding NameEn, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameEnBox" Style="{StaticResource DarkTextBox}" Padding="12,10" Margin="0,0,0,10"/>

            <!-- Name AR -->
            <TextBlock Text="{Binding NameAr, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameArBox" Style="{StaticResource DarkTextBox}" Padding="12,10" Margin="0,0,0,10"
                     FlowDirection="RightToLeft"/>

            <!-- Price -->
            <TextBlock Text="{Binding PosPrice, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="PriceBox" Style="{StaticResource DarkTextBox}" Padding="12,10" Margin="0,0,0,10"/>

            <!-- Category -->
            <TextBlock Text="{Binding FinCategory, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CategoryCombo" Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"
                      Loaded="CategoryCombo_Loaded"/>

            <!-- Stock -->
            <TextBlock Text="{Binding PosStock, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="StockBox" Style="{StaticResource DarkTextBox}" Padding="12,10" Margin="0,0,0,18"
                     Text="0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Padding="28,10"
                        Click="OkClick" Margin="0,0,12,0">
                    <TextBlock Text="{Binding OK, Source={x:Static helpers:LanguageManager.Instance}}"/>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="28,10"
                        Click="CancelClick">
                    <TextBlock Text="{Binding Cancel, Source={x:Static helpers:LanguageManager.Instance}}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
