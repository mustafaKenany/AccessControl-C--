<Window x:Class="AccessControlPro.WPF.Views.QrCodeDisplayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="QR Code"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}" FontWeight="Bold">

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center">
            <!-- Title -->
            <TextBlock Text="{Binding QrCodeTitle, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <!-- QR Code Image -->
            <Border Background="White" CornerRadius="8" Padding="16" HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- Pass Code -->
            <TextBlock x:Name="PassCodeText" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,4"/>

            <!-- Player Info -->
            <TextBlock x:Name="PlayerInfoText" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- Validity Info -->
            <TextBlock x:Name="ValidityText" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Click="PrintClick"
                        Width="120" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Print" Width="14" Height="14"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding QrPrint, Source={x:Static helpers:LanguageManager.Instance}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="{Binding Cancel, Source={x:Static helpers:LanguageManager.Instance}}"
                        Style="{StaticResource DarkButton}" Click="CloseClick"
                        Width="100"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
