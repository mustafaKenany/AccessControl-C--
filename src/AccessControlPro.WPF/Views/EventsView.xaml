<UserControl x:Class="AccessControlPro.WPF.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
             FlowDirection="{Binding Lang.FlowDirection}">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Lang.NavEvents}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource PrimaryLightBrush}"
                        Command="{Binding ShowAllCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Database" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.ShowAll}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}">
                    <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <!-- Search (prominent, by name or card number) -->
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="16,9"
                            Command="{Binding SearchCommand}" Margin="8,0,0,0">
                        <fa:ImageAwesome Icon="Search" Width="14" Height="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Button>
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="10" Padding="14,10"
                            ToolTip="{Binding FinSearch, Source={x:Static helpers:LanguageManager.Instance}}">
                        <Grid>
                            <DockPanel>
                                <fa:ImageAwesome Icon="Search" Width="14" Height="14" DockPanel.Dock="Left"
                                                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="EventSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="14" VerticalAlignment="Center" CaretBrush="{StaticResource TextPrimaryBrush}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding FinSearch, Source={x:Static helpers:LanguageManager.Instance}}" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="26,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=EventSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- Filters (type / device / period) — wrap on narrow screens -->
                <WrapPanel>
                    <ComboBox Width="150" SelectedIndex="{Binding SelectedEventTypeIndex}" Margin="0,0,10,6"
                              Style="{StaticResource DarkComboBox}"
                              ToolTip="{Binding EventType, Source={x:Static helpers:LanguageManager.Instance}}">
                        <ComboBoxItem Content="{Binding FinAll, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding EventCardAction, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding EventButtonAction, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding EventDoorSensor, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding EventSoftwareAction, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding EventAlarm, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding EventSystem, Source={x:Static helpers:LanguageManager.Instance}}"/>
                    </ComboBox>

                    <ComboBox Width="170" ItemsSource="{Binding DeviceFilters}"
                              SelectedIndex="{Binding SelectedDeviceIndex}" DisplayMemberPath="Display"
                              Style="{StaticResource DarkComboBox}" Margin="0,0,10,6"
                              ToolTip="{Binding Device, Source={x:Static helpers:LanguageManager.Instance}}"/>

                    <ComboBox Width="190" SelectedIndex="{Binding SelectedPeriodIndex}" Margin="0,0,10,6"
                              Style="{StaticResource DarkComboBox}"
                              ToolTip="{Binding FinPeriod, Source={x:Static helpers:LanguageManager.Instance}}">
                        <ComboBoxItem Content="{Binding FinAll, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipAll, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinToday, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipToday, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinYesterday, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipYesterday, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinThisWeek, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipThisWeek, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinLastWeek, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipLastWeek, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinThisMonth, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipThisMonth, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinLastMonth, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipLastMonth, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinLast3Months, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipLast3Months, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinLast6Months, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipLast6Months, Source={x:Static helpers:LanguageManager.Instance}}"/>
                        <ComboBoxItem Content="{Binding FinThisYear, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="{Binding FilterTipThisYear, Source={x:Static helpers:LanguageManager.Instance}}"/>
                    </ComboBox>

                    <Button Style="{StaticResource SecondaryButton}" Padding="14,8"
                            Command="{Binding FilterChangedCommand}" Margin="0,0,6,6">
                        <fa:ImageAwesome Icon="Filter" Width="14" Height="14"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,0,6"
                            Command="{Binding ClearFilterCommand}">
                        <fa:ImageAwesome Icon="Eraser" Width="14" Height="14"
                                         Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </WrapPanel>

                <!-- Date Range Display -->
                <TextBlock Text="{Binding DateRangeText}"
                           FontSize="11" Foreground="#44A1A0" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Stats Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Bolt" Width="12" Height="12"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Total, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource SidebarButton}"
                    Command="{Binding RefreshCommand}" Margin="10,0,0,0">
                <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </StackPanel>

        <!-- Table Header -->
        <Border Grid.Row="3" Background="{StaticResource BgInputBrush}" CornerRadius="12,12,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Lang.LogTimestamp}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Lang.Device}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Lang.Door}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Lang.Card}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding Lang.Player}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Lang.EventType}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="6" Text="{Binding Lang.LogDetails}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="7" Text="{Binding Lang.Direction}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- Table Body -->
        <Border Grid.Row="4" Background="{StaticResource BgCardBrush}" CornerRadius="0,0,12,12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding Events}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="Transparent"
                                        Padding="18,10" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2" Text="{Binding DoorName}" FontSize="12"
                                                   Foreground="#78CDD7" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding CardNumber}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4" Text="{Binding PlayerName}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Event Type badge -->
                                        <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="6" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33247B7B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Card">
                                                            <Setter Property="Background" Value="#332ED47A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Button">
                                                            <Setter Property="Background" Value="#334FC3F7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Alarm">
                                                            <Setter Property="Background" Value="#33F7685B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="System">
                                                            <Setter Property="Background" Value="#33FFB946"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EventType}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#44A1A0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EventType}" Value="Card">
                                                                <Setter Property="Foreground" Value="#2ED47A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="Button">
                                                                <Setter Property="Foreground" Value="#4FC3F7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="Alarm">
                                                                <Setter Property="Foreground" Value="#F7685B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="System">
                                                                <Setter Property="Foreground" Value="#FFB946"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="6" Text="{Binding EventDescription}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CardStatusKey}" Value="Active">
                                                            <Setter Property="Foreground" Value="#2ED47A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CardStatusKey}" Value="Expired">
                                                            <Setter Property="Foreground" Value="#F7685B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CardStatusKey}" Value="Frozen">
                                                            <Setter Property="Foreground" Value="#4FC3F7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CardStatusKey}" Value="Unregistered">
                                                            <Setter Property="Foreground" Value="#FFB946"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Direction badge -->
                                        <TextBlock Grid.Column="7" Text="{Binding Direction}" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Entry">
                                                            <Setter Property="Foreground" Value="#2ED47A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Exit">
                                                            <Setter Property="Foreground" Value="#F7685B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CardStatusKey}" Value="Unregistered">
                                        <Setter TargetName="row" Property="Background" Value="#18F7685B"/>
                                        <Setter TargetName="row" Property="BorderBrush" Value="#30F7685B"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsDataLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                    <fa:ImageAwesome Icon="Bolt" Width="40" Height="40" Foreground="#3A3A4E" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Lang.ClickShowAllEvents}" FontSize="15"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Background="#CC1E1E2E" CornerRadius="0,0,12,12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Width="30" Height="30"
                                         Foreground="{StaticResource PrimaryLightBrush}" SpinDuration="1" Spin="True"/>
                        <TextBlock Text="{Binding Lang.Loading}" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="5" Margin="0,10,0,0"
                Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
                    <Run Text="{Binding Lang.Page, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#9664;" Width="36" Height="30" Command="{Binding PreviousPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="&#9654;" Width="36" Height="30" Command="{Binding NextPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
