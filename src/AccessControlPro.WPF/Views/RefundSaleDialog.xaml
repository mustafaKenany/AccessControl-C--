<Window x:Class="AccessControlPro.WPF.Views.RefundSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="Refund"
        Width="820" Height="620" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}" FontWeight="Bold">
    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="16" Padding="24" BorderBrush="#2A3441" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock x:Name="PickText" Grid.Row="1" FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,6"/>

            <!-- Recent sales -->
            <DataGrid x:Name="SalesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                      RowBackground="#1E2530" AlternatingRowBackground="#222A36" Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="#2A3441" BorderThickness="1" SelectionMode="Single"
                      SelectionChanged="SalesGrid_SelectionChanged" FontWeight="Normal" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColTime" Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                    <DataGridTextColumn x:Name="ColItems" Binding="{Binding ItemsSummary}" Width="*"/>
                    <DataGridTextColumn x:Name="ColTotal" Binding="{Binding Total, StringFormat='N0'}" Width="110"/>
                    <DataGridTextColumn x:Name="ColRefundable" Binding="{Binding RefundableTotal, StringFormat='N0'}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="LinesText" Grid.Row="3" FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}" Margin="2,14,0,6"/>

            <!-- Lines of the selected sale, with editable "refund now" qty -->
            <DataGrid x:Name="LinesGrid" Grid.Row="4" AutoGenerateColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                      RowBackground="#1E2530" AlternatingRowBackground="#222A36" Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="#2A3441" BorderThickness="1" CanUserAddRows="False"
                      FontWeight="Normal" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColProduct" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn x:Name="ColPrice" Binding="{Binding UnitPrice, StringFormat='N0'}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn x:Name="ColSold" Binding="{Binding SoldQty}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn x:Name="ColRemaining" Binding="{Binding RefundableQty}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn x:Name="ColRefundNow" Binding="{Binding RefundNowQty, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Style="{StaticResource PrimaryButton}" Padding="28,10" Click="OkClick" Margin="0,0,12,0">
                    <TextBlock x:Name="OkText"/>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="28,10" Click="CancelClick">
                    <TextBlock Text="{Binding Cancel, Source={x:Static helpers:LanguageManager.Instance}}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
