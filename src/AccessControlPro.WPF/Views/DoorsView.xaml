<UserControl x:Class="AccessControlPro.WPF.Views.DoorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Lang.NavDoors}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                        Padding="12,8" Margin="0,0,10,0" MinWidth="220">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Search" Width="13" Height="13"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"/>
                    </DockPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Refresh" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.Refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ═══ Stats Bar ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <!-- Open -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding OpenCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.StatusOpen, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Closed -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding ClosedCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.StatusClosed, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Total -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Lock" Width="12" Height="12"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Total, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ Table Header ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgInputBrush}" CornerRadius="12,12,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Lang.Status}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Lang.Door}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Lang.DeviceName}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Lang.IPAddress}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding Lang.DoorNumber}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Lang.WorkingHours}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="6" Text="{Binding Lang.WorkingDays}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="7" Text="{Binding Lang.Actions}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- ═══ Table Body ═══ -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" CornerRadius="0,0,12,12">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Doors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Background="Transparent"
                                    Padding="18,14" CornerRadius="0"
                                    BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="270"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Open">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Alarm">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Fault">
                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Door Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Device Name -->
                                    <TextBlock Grid.Column="2" Text="{Binding DeviceName}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Device IP -->
                                    <TextBlock Grid.Column="3" Text="{Binding DeviceIP}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Door Number Badge -->
                                    <Border Grid.Column="4" Background="{StaticResource BgInputBrush}"
                                            CornerRadius="6" Padding="8,4"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DoorNumber}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryLightBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Working Hours -->
                                    <TextBlock Grid.Column="5" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:hh\:mm} - {1:hh\:mm}">
                                                <Binding Path="WorkStartTime"/>
                                                <Binding Path="WorkEndTime"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Is24Hours}" Value="True">
                                                        <Setter Property="Text" Value="24h"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Working Days -->
                                    <TextBlock Grid.Column="6" Text="{Binding WorkingDays}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="7" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Open Door -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.OpenDoor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.OpenDoorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanOpenClose, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="UnlockAlt" Width="12" Height="12"
                                                                         Foreground="{StaticResource SuccessBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#182ED47A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Close Door -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.CloseDoor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.CloseDoorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanOpenClose, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="Lock" Width="12" Height="12"
                                                                         Foreground="{StaticResource DangerBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18F7685B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Set Delay -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.SetDelay, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.SetDelayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanSettings, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="ClockOutline" Width="12" Height="12"
                                                                         Foreground="{StaticResource WarningBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18FFB946"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Set Password -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.SetPassword, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.SetPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanSettings, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="Key" Width="12" Height="12"
                                                                         Foreground="{StaticResource PrimaryLightBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Set Schedule -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.SetSchedule, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.SetScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanSettings, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="Calendar" Width="12" Height="12"
                                                                         Foreground="{StaticResource PrimaryLightBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Rename -->
                                        <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Edit, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.RenameDoorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanSettings, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="6" Padding="8,6">
                                                        <fa:ImageAwesome Icon="Pencil" Width="12" Height="12"
                                                                         Foreground="{StaticResource PrimaryLightBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

                <!-- Loading Overlay -->
                <Border Background="#CC1E1E2E" CornerRadius="0,0,12,12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Width="30" Height="30"
                                         Foreground="{StaticResource PrimaryLightBrush}" SpinDuration="1" Spin="True"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
