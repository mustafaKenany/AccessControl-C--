<UserControl x:Class="AccessControlPro.WPF.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Lang.NavPlayers}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                        Padding="12,8" Margin="0,0,10,0" MinWidth="220">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Search" Width="13" Height="13"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"/>
                    </DockPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource PrimaryLightBrush}"
                        Command="{Binding ShowAllCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Database" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.ShowAll}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource SuccessBrush}"
                        Command="{Binding AddEmployeeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="UserPlus" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.AddPlayer}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Stats Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Users" Width="12" Height="12"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Total, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding WithCardCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.WithCard, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding WithoutCardCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.WithoutCard, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource SidebarButton}"
                    Command="{Binding RefreshCommand}" Margin="10,0,0,0">
                <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </StackPanel>

        <!-- Table Header -->
        <Border Grid.Row="2" Background="{StaticResource BgInputBrush}" CornerRadius="12,12,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Lang.PlayerName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Lang.CardNo}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Lang.Subscription}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding Lang.Fee}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Lang.Paid}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="6" Text="{Binding Lang.Remaining}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="7" Text="{Binding Lang.NavCards}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="8" Text="{Binding Lang.Actions}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- Table Body -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" CornerRadius="0,0,12,12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Employees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="Transparent"
                                        Padding="18,10" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="280"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="30" Height="30"
                                                CornerRadius="15" Background="#2A2A3E"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <fa:ImageAwesome Icon="UserCircleOutline" Width="16" Height="16"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FullNameEn}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <!-- Frozen badge -->
                                                <Border Background="#3344A1A0" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="FROZEN" FontSize="9" FontWeight="Bold" Foreground="#78CDD7"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FullNameAr}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding CardNo}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding SubscriptionType}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="4" Text="{Binding SubscriptionFee, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="5" Text="{Binding AmountPaid, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="6" Text="{Binding RemainingBalance, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RemainingBalance}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="7" Background="{StaticResource BgInputBrush}"
                                                CornerRadius="6" Padding="8,4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CardCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CardCount}" Value="0">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.ViewCards, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.ViewCardsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="IdCard" Width="12" Height="12" Foreground="{StaticResource PrimaryLightBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.AssignCard, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.AssignCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="PlusCircle" Width="12" Height="12" Foreground="{StaticResource SuccessBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#182ED47A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Edit, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="Pencil" Width="12" Height="12" Foreground="{StaticResource PrimaryLightBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Delete, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="TrashOutline" Width="12" Height="12" Foreground="{StaticResource DangerBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#18F7685B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Separator -->
                                            <Border Width="1" Height="16" Background="#3A3A50" Margin="2,0"/>

                                            <!-- Freeze/Unfreeze -->
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.FreezePlayer, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.FreezePlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="PauseCircle" Width="12" Height="12" Foreground="#78CDD7"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#1878CDD7"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Renew Subscription -->
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.RenewSubscription, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.RenewSubscriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="Repeat" Width="12" Height="12" Foreground="{StaticResource SuccessBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#182ED47A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsDataLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                    <fa:ImageAwesome Icon="Database" Width="40" Height="40" Foreground="#3A3A4E" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Lang.ClickShowAll}" FontSize="15"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Background="#CC1E1E2E" CornerRadius="0,0,12,12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Width="30" Height="30"
                                         Foreground="{StaticResource PrimaryLightBrush}" SpinDuration="1" Spin="True"/>
                        <TextBlock Text="{Binding Lang.Loading}" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="4" Margin="0,10,0,0"
                Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
                    <Run Text="{Binding Lang.Page, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#9664;" Width="36" Height="30" Command="{Binding PreviousPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="&#9654;" Width="36" Height="30" Command="{Binding NextPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
