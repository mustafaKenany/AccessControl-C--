<UserControl x:Class="AccessControlPro.WPF.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Lang.NavPlayers}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                        Padding="12,8" Margin="0,0,10,0" MinWidth="220"
                        ToolTip="{Binding Lang.SearchBoxHint}">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Search" Width="13" Height="13"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 ToolTip="{Binding Lang.SearchBoxHint}"/>
                    </DockPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource PrimaryLightBrush}"
                        Command="{Binding ShowAllCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Database" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.ShowAll}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="#2E7D32"
                        Command="{Binding CreateDailyPassCommand}" Margin="0,0,10,0"
                        ToolTip="{Binding Lang.DailyPass}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Qrcode" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.DailyPass}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource SuccessBrush}"
                        Command="{Binding AddEmployeeCommand}" Margin="0,0,10,0"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="UserPlus" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.AddPlayer}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="#0D5C63"
                        Command="{Binding BulkOperationCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="ListAlt" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.BulkOperations}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="#247B7B" Margin="10,0,0,0"
                        Command="{Binding PrintListCommand}"
                        ToolTip="{Binding Lang.PrintList}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Print" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.PrintList}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </DockPanel>

        <!-- Stats Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Users" Width="12" Height="12"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Total, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding WithCardCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.WithCard, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding WithoutCardCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.WithoutCard, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource SidebarButton}"
                    Command="{Binding RefreshCommand}" Margin="10,0,0,0">
                <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </StackPanel>

        <!-- Filter Chips -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVisibility}}">
            <!-- All -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="0" Cursor="Hand" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.FilterAll}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="0">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Expiring -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="1" Cursor="Hand" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="ClockOutline" Width="11" Height="11"
                                                 Foreground="#FFB946" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Lang.RptExpiring}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="1">
                                <Setter TargetName="chip" Property="Background" Value="#4DFFB946"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Renewed -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="2" Cursor="Hand" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Repeat" Width="11" Height="11"
                                                 Foreground="#2ED47A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Lang.RptRenewed}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="2">
                                <Setter TargetName="chip" Property="Background" Value="#4D2ED47A"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Frozen -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="3" Cursor="Hand" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="PauseCircle" Width="11" Height="11"
                                                 Foreground="#78CDD7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Lang.RptFrozen}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="3">
                                <Setter TargetName="chip" Property="Background" Value="#4D78CDD7"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Expired -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="4" Cursor="Hand" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="TimesCircle" Width="11" Height="11"
                                                 Foreground="#F7685B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Lang.RptExpired}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="4">
                                <Setter TargetName="chip" Property="Background" Value="#4DF7685B"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Separator -->
            <Border Width="1" Height="20" Background="#3A3A50" Margin="6,0,12,0" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Period chips (only for Expiring/Renewed) -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Command="{Binding SetPeriodCommand}" CommandParameter="0" Cursor="Hand" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chip" CornerRadius="10" Padding="10,4" Background="Transparent">
                                <TextBlock Text="{Binding Lang.RptToday}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="0">
                                    <Setter TargetName="chip" Property="Background" Value="#2244A1A0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Command="{Binding SetPeriodCommand}" CommandParameter="1" Cursor="Hand" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chip" CornerRadius="10" Padding="10,4" Background="Transparent">
                                <TextBlock Text="{Binding Lang.RptThisWeek}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="1">
                                    <Setter TargetName="chip" Property="Background" Value="#2244A1A0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Command="{Binding SetPeriodCommand}" CommandParameter="2" Cursor="Hand" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chip" CornerRadius="10" Padding="10,4" Background="Transparent">
                                <TextBlock Text="{Binding Lang.RptLastWeek}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="2">
                                    <Setter TargetName="chip" Property="Background" Value="#2244A1A0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Command="{Binding SetPeriodCommand}" CommandParameter="3" Cursor="Hand" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chip" CornerRadius="10" Padding="10,4" Background="Transparent">
                                <TextBlock Text="{Binding Lang.RptThisMonth}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="3">
                                    <Setter TargetName="chip" Property="Background" Value="#2244A1A0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Command="{Binding SetPeriodCommand}" CommandParameter="4" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chip" CornerRadius="10" Padding="10,4" Background="Transparent">
                                <TextBlock Text="{Binding Lang.RptLastMonth}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="4">
                                    <Setter TargetName="chip" Property="Background" Value="#2244A1A0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Table Header -->
        <Border Grid.Row="3" Background="{StaticResource BgInputBrush}" CornerRadius="12,12,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Lang.PlayerName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Lang.CardNo}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Lang.SyncStatus}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Lang.Subscription}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Lang.Fee}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="6" Text="{Binding Lang.Paid}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="7" Text="{Binding Lang.Remaining}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="8" Text="{Binding Lang.NavCards}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="9" Text="{Binding Lang.Actions}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- Table Body -->
        <Border Grid.Row="4" Background="{StaticResource BgCardBrush}" CornerRadius="0,0,12,12">
            <Grid>
                <!-- Virtualization: ItemsControl by itself materializes ALL rows in the
                     Visual tree. With 2000+ players that meant ~2000 row containers held
                     in memory, never released on filter switch — the Basmia OOM root cause.
                     Switching to VirtualizingStackPanel + ScrollViewer.CanContentScroll
                     means only ~20 visible rows have Visual containers at any time.
                     Recycling mode reuses containers as the user scrolls. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding Employees}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="Transparent"
                                        Padding="18,10" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="300"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="30" Height="30"
                                                CornerRadius="15" Background="#2A2A3E"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <fa:ImageAwesome Icon="UserCircleOutline" Width="16" Height="16"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FullNameEn}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <!-- Frozen badge -->
                                                <Border Background="#3344A1A0" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="FROZEN" FontSize="9" FontWeight="Bold" Foreground="#78CDD7"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FullNameAr}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding CardNo}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Sync Status Dot -->
                                        <Ellipse Grid.Column="3" Width="10" Height="10"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 ToolTip="{Binding DataContext.Lang.SyncStatus, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#3A3A50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SyncStatus}" Value="1">
                                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SyncStatus}" Value="2">
                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SyncStatus}" Value="3">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="4" Text="{Binding SubscriptionType}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="5" Text="{Binding SubscriptionFee, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="6" Text="{Binding AmountPaid, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="7" Text="{Binding RemainingBalance, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RemainingBalance}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="8" Background="{StaticResource BgInputBrush}"
                                                CornerRadius="6" Padding="8,4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CardCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CardCount}" Value="0">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.PrfPlayerProfile, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.ViewProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="Eye" Width="12" Height="12" Foreground="#FFB946"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#18FFB946"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.MemberCard, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.PrintMemberCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="Print" Width="12" Height="12" Foreground="#7E8CE0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#187E8CE0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.ViewCards, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.ViewCardsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="IdCard" Width="12" Height="12" Foreground="{StaticResource PrimaryLightBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.AssignCard, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.AssignCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanAssignCard, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="PlusCircle" Width="12" Height="12" Foreground="{StaticResource SuccessBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#182ED47A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Edit, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="Pencil" Width="12" Height="12" Foreground="{StaticResource PrimaryLightBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.Delete, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="TrashOutline" Width="12" Height="12" Foreground="{StaticResource DangerBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#18F7685B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Separator -->
                                            <Border Width="1" Height="16" Background="#3A3A50" Margin="2,0"/>

                                            <!-- Freeze/Unfreeze -->
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.FreezePlayer, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.FreezePlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanFreeze, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="PauseCircle" Width="12" Height="12" Foreground="#78CDD7"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#1878CDD7"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Renew Subscription -->
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.RenewSubscription, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.RenewSubscriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanRenew, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="Repeat" Width="12" Height="12" Foreground="{StaticResource SuccessBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#182ED47A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Separator -->
                                            <Border Width="1" Height="16" Background="#3A3A50" Margin="2,0"/>

                                            <!-- Sync to Device -->
                                            <Button Cursor="Hand" ToolTip="{Binding DataContext.Lang.SyncToDevice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.SyncPlayerToDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanSyncToDevice, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                            <fa:ImageAwesome Icon="CloudUpload" Width="12" Height="12" Foreground="#44A1A0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#1844A1A0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsDataLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                    <fa:ImageAwesome Icon="Database" Width="40" Height="40" Foreground="#3A3A4E" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Lang.ClickShowAll}" FontSize="15"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Background="#CC1E1E2E" CornerRadius="0,0,12,12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Width="30" Height="30"
                                         Foreground="{StaticResource PrimaryLightBrush}" SpinDuration="1" Spin="True"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="5" Margin="0,10,0,0"
                Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
                    <Run Text="{Binding Lang.Page, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#9664;" Width="36" Height="30" Command="{Binding PreviousPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="&#9654;" Width="36" Height="30" Command="{Binding NextPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
