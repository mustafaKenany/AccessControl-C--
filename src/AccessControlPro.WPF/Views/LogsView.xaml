<UserControl x:Class="AccessControlPro.WPF.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
             FlowDirection="{Binding Lang.FlowDirection}">

    <UserControl.Resources>
        <helpers:ActionLocalizedConverter x:Key="ActionLocalizedConverter"/>
        <helpers:EntityTypeLocalizedConverter x:Key="EntityTypeLocalizedConverter"/>
        <helpers:DetailsLocalizedConverter x:Key="DetailsLocalizedConverter"/>
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Lang.NavLogs}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                        Padding="12,8" Margin="0,0,10,0" MinWidth="220">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Search" Width="13" Height="13"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"/>
                    </DockPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource PrimaryLightBrush}"
                        Command="{Binding ShowAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Database" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.ShowAll}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Stats Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="FileTextOutline" Width="12" Height="12"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.Total, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource SidebarButton}"
                    Command="{Binding RefreshCommand}" Margin="10,0,0,0">
                <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </StackPanel>

        <!-- Period Filter Chips -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <!-- All -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Show all records without date filter">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.FilterAll}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="0">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Today -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="1" Cursor="Hand" Margin="0,0,6,0" ToolTip="Records from today only">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.RptToday}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="1">
                                <Setter TargetName="chip" Property="Background" Value="#4D44A1A0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Yesterday -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="2" Cursor="Hand" Margin="0,0,6,0" ToolTip="Records from yesterday only">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.LogYesterday}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="2">
                                <Setter TargetName="chip" Property="Background" Value="#4D44A1A0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- This Week -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="3" Cursor="Hand" Margin="0,0,6,0" ToolTip="Records from this week">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.RptThisWeek}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="3">
                                <Setter TargetName="chip" Property="Background" Value="#4D44A1A0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Last Week -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="4" Cursor="Hand" Margin="0,0,6,0" ToolTip="Records from last week">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.RptLastWeek}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="4">
                                <Setter TargetName="chip" Property="Background" Value="#4D44A1A0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- This Month -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="5" Cursor="Hand" Margin="0,0,6,0" ToolTip="Records from the 1st of this month to today">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.RptThisMonth}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="5">
                                <Setter TargetName="chip" Property="Background" Value="#4D44A1A0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Last Month -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="6" Cursor="Hand" Margin="0,0,6,0" ToolTip="Records from last month only">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.RptLastMonth}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="6">
                                <Setter TargetName="chip" Property="Background" Value="#4D44A1A0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- Last 3 Months -->
            <Button Command="{Binding SetPeriodCommand}" CommandParameter="7" Cursor="Hand" ToolTip="Records from the last 3 months">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6" Background="#1A44A1A0">
                            <TextBlock Text="{Binding Lang.LogLast3Months}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectedPeriodIndex}" Value="7">
                                <Setter TargetName="chip" Property="Background" Value="#4D44A1A0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3344A1A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Table Header -->
        <Border Grid.Row="3" Background="{StaticResource BgInputBrush}" CornerRadius="12,12,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Lang.LogTimestamp}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Lang.LogUser}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Lang.LogAction}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Lang.LogEntity}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="4" Text="ID" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Lang.LogDetails}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- Table Body -->
        <Border Grid.Row="4" Background="{StaticResource BgCardBrush}" CornerRadius="0,0,12,12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="Transparent"
                                        Padding="18,10" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- User -->
                                        <TextBlock Grid.Column="1" Text="{Binding PerformedBy}"
                                                   FontSize="12" Foreground="#78CDD7"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Action badge -->
                                        <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="6" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33247B7B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}" Value="Create">
                                                            <Setter Property="Background" Value="#332ED47A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Update">
                                                            <Setter Property="Background" Value="#334FC3F7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Delete">
                                                            <Setter Property="Background" Value="#33F7685B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="SoftDelete">
                                                            <Setter Property="Background" Value="#33F7685B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Freeze">
                                                            <Setter Property="Background" Value="#3378CDD7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Unfreeze">
                                                            <Setter Property="Background" Value="#3378CDD7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Renew">
                                                            <Setter Property="Background" Value="#33FFB946"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Action, Converter={StaticResource ActionLocalizedConverter}}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#44A1A0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="Create">
                                                                <Setter Property="Foreground" Value="#2ED47A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Update">
                                                                <Setter Property="Foreground" Value="#4FC3F7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Delete">
                                                                <Setter Property="Foreground" Value="#F7685B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="SoftDelete">
                                                                <Setter Property="Foreground" Value="#F7685B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Freeze">
                                                                <Setter Property="Foreground" Value="#78CDD7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Unfreeze">
                                                                <Setter Property="Foreground" Value="#78CDD7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Renew">
                                                                <Setter Property="Foreground" Value="#FFB946"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding EntityType, Converter={StaticResource EntityTypeLocalizedConverter}}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4" Text="{Binding EntityId}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Details (bilingual) -->
                                        <TextBlock Grid.Column="5"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource DetailsLocalizedConverter}">
                                                    <Binding Path="Details"/>
                                                    <Binding Path="DetailsAr"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                            <TextBlock.ToolTip>
                                                <MultiBinding Converter="{StaticResource DetailsLocalizedConverter}">
                                                    <Binding Path="Details"/>
                                                    <Binding Path="DetailsAr"/>
                                                </MultiBinding>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsDataLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                    <fa:ImageAwesome Icon="FileTextOutline" Width="40" Height="40" Foreground="#3A3A4E" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Lang.ClickShowAllLogs}" FontSize="15"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Background="#CC1E1E2E" CornerRadius="0,0,12,12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Width="30" Height="30"
                                         Foreground="{StaticResource PrimaryLightBrush}" SpinDuration="1" Spin="True"/>
                        <TextBlock Text="{Binding Lang.Loading}" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="5" Margin="0,10,0,0"
                Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
                    <Run Text="{Binding Lang.Page, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#9664;" Width="36" Height="30" Command="{Binding PreviousPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="&#9654;" Width="36" Height="30" Command="{Binding NextPageCommand}"
                            Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#444" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
