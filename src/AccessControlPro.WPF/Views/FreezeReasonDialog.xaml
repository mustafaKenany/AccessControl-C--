<Window x:Class="AccessControlPro.WPF.Views.FreezeReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="{Binding Lang.FreezePlayer}"
        Width="460" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1A1A2E"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="border" Width="20" Height="20"
                                    Background="#2A2A3E" BorderBrush="#44A1A0"
                                    BorderThickness="2" CornerRadius="4"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="checkMark" Text="&#x2713;"
                                           Foreground="White" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44A1A0"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#78CDD7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="80" MaxHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <fa:ImageAwesome Icon="PauseCircle" Width="24" Height="24"
                             Foreground="#78CDD7" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding Lang.FreezePlayer}"
                       FontSize="20" FontWeight="Bold" Foreground="#FFFFFA"/>
        </StackPanel>

        <!-- Label -->
        <TextBlock Grid.Row="1" Text="{Binding Lang.EnterFreezeReason}"
                   Foreground="#9EC5C8" FontSize="13" Margin="0,0,0,8"/>

        <!-- Reason TextBox -->
        <TextBox x:Name="ReasonTextBox" Grid.Row="2"
                 FontSize="13" Padding="10,8"
                 Background="#2A2A3E" Foreground="#E0E0E0"
                 BorderBrush="#3A3A50" BorderThickness="1.5"
                 CaretBrush="#E0E0E0" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource CairoFont}" FontWeight="Bold"
                 Margin="0,0,0,14"/>

        <!-- Devices -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14" x:Name="DevicesSection">
            <TextBlock Text="{Binding SelectDevices, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" FontSize="13" Margin="0,0,0,6"/>
            <Border Background="#0E2A2D" BorderBrush="#3A3A50" BorderThickness="1.5"
                    CornerRadius="8" Padding="12,8" MinHeight="36">
                <StackPanel x:Name="DevicesPanel">
                    <TextBlock x:Name="NoDevicesText"
                               Text="{Binding NoDevicesAvailable, Source={x:Static helpers:LanguageManager.Instance}}"
                               Foreground="#5A8A8D" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="130" Height="40" Margin="0,0,14,0"
                    Click="CancelButton_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2A2A3E" CornerRadius="10"
                                BorderBrush="#444" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#333350"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding Lang.Cancel}" Foreground="#B0B0CC"
                           FontSize="14" FontWeight="Bold"/>
            </Button>

            <Button Width="130" Height="40"
                    Click="OkButton_Click" IsDefault="True" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#78CDD7" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#5AABB5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding Lang.FreezePlayer}" Foreground="White"
                           FontSize="14" FontWeight="Bold"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
