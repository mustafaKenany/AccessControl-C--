<Window x:Class="AccessControlPro.WPF.Views.RenewSubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="{Binding Lang.RenewSubscription}"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1A1A2E"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#44A1A0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3A3A50"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#44A1A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#1A2A2E"/>
            <Setter Property="Foreground" Value="#78CDD7"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="#2A2A3E"
                                                BorderBrush="#3A3A50" BorderThickness="1.5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="#222238" BorderThickness="1.5,0,0,0" BorderBrush="#3A3A50">
                                                    <Path Fill="#78CDD7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#44A1A0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="12,8,32,8"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2A2A3E" BorderBrush="#44A1A0"
                                            BorderThickness="1.5" Padding="0,4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title -->
            <RowDefinition Height="Auto"/>  <!-- Player Info (read-only) -->
            <RowDefinition Height="Auto"/>  <!-- Subscription Type -->
            <RowDefinition Height="Auto"/>  <!-- Period -->
            <RowDefinition Height="Auto"/>  <!-- Fee -->
            <RowDefinition Height="Auto"/>  <!-- Amount Paid -->
            <RowDefinition Height="Auto"/>  <!-- Remaining -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,18">
            <fa:ImageAwesome Icon="Repeat" Width="22" Height="22"
                             Foreground="#2ED47A" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding Lang.RenewSubscription}"
                       FontSize="20" FontWeight="Bold" Foreground="#FFFFFA"/>
        </StackPanel>

        <!-- Player Info -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Lang.PlayerName}"
                   Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
        <TextBox x:Name="PlayerNameText" Grid.Row="1" Grid.Column="1"
                 Style="{StaticResource ReadOnlyTextBox}" Margin="0,0,0,10"
                 Focusable="False" IsTabStop="False"/>

        <!-- Subscription Type -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Lang.Subscription}"
                   Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
        <ComboBox x:Name="SubscriptionTypeCombo" Grid.Row="2" Grid.Column="1"
                  Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"
                  SelectionChanged="SubscriptionTypeCombo_SelectionChanged"/>

        <!-- Period -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Lang.Period}"
                   Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
        <ComboBox x:Name="PeriodCombo" Grid.Row="3" Grid.Column="1"
                  Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"
                  SelectionChanged="PeriodCombo_SelectionChanged"/>

        <!-- Fee -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Lang.Fee}"
                   Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
        <TextBox x:Name="FeeTextBox" Grid.Row="4" Grid.Column="1"
                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                 TextChanged="FeeTextBox_TextChanged" IsReadOnly="True"/>

        <!-- Amount Paid -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Lang.Paid}"
                   Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
        <TextBox x:Name="PaidTextBox" Grid.Row="5" Grid.Column="1"
                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                 TextChanged="PaidTextBox_TextChanged"/>

        <!-- Remaining -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Lang.Remaining}"
                   Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
        <TextBox x:Name="RemainingTextBox" Grid.Row="6" Grid.Column="1"
                 Style="{StaticResource ReadOnlyTextBox}" Margin="0,0,0,10"
                 Focusable="False" IsTabStop="False"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="140" Height="42" Margin="0,0,14,0"
                    Click="CancelButton_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2A2A3E" CornerRadius="10"
                                BorderBrush="#444" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#333350"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding Lang.Cancel}" Foreground="#B0B0CC"
                           FontSize="15" FontWeight="Bold"/>
            </Button>

            <Button Width="140" Height="42"
                    Click="OkButton_Click" IsDefault="True" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2ED47A" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AB85E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding Lang.RenewSubscription}" Foreground="White"
                           FontSize="15" FontWeight="Bold"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
