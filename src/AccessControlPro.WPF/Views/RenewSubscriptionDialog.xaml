<Window x:Class="AccessControlPro.WPF.Views.RenewSubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="{Binding RenewSubscription, Source={x:Static helpers:LanguageManager.Instance}}"
        Width="540" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1A1A2E"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#44A1A0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3A3A50"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#44A1A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#1A2A2E"/>
            <Setter Property="Foreground" Value="#78CDD7"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="#2A2A3E"
                                                BorderBrush="#3A3A50" BorderThickness="1.5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="#222238" BorderThickness="1.5,0,0,0" BorderBrush="#3A3A50">
                                                    <Path Fill="#78CDD7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#44A1A0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="12,8,32,8"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2A2A3E" BorderBrush="#44A1A0"
                                            BorderThickness="1.5" Padding="0,4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="border" Width="20" Height="20"
                                    Background="#2A2A3E" BorderBrush="#44A1A0"
                                    BorderThickness="2" CornerRadius="4"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="checkMark" Text="&#x2713;"
                                           Foreground="White" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44A1A0"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#78CDD7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: Title -->
                <RowDefinition Height="Auto"/>  <!-- 1: Player Info -->
                <RowDefinition Height="Auto"/>  <!-- 2: Subscription Type -->
                <RowDefinition Height="Auto"/>  <!-- 3: Period -->
                <RowDefinition Height="Auto"/>  <!-- 4: Custom Days -->
                <RowDefinition Height="Auto"/>  <!-- 5: Fee -->
                <RowDefinition Height="Auto"/>  <!-- 6: Amount Paid -->
                <RowDefinition Height="Auto"/>  <!-- 7: Remaining -->
                <RowDefinition Height="Auto"/>  <!-- 8: Door Access -->
                <RowDefinition Height="Auto"/>  <!-- 9: Effective Times -->
                <RowDefinition Height="Auto"/>  <!-- 10: Devices -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>  <!-- 12: Buttons -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,18">
                <fa:ImageAwesome Icon="Repeat" Width="22" Height="22"
                                 Foreground="#2ED47A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding RenewSubscription, Source={x:Static helpers:LanguageManager.Instance}}"
                           FontSize="20" FontWeight="Bold" Foreground="#FFFFFA"/>
            </StackPanel>

            <!-- Player Info -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{Binding PlayerName, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <TextBox x:Name="PlayerNameText" Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource ReadOnlyTextBox}" Margin="0,0,0,10"
                     Focusable="False" IsTabStop="False"/>

            <!-- Subscription Type -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{Binding Subscription, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <ComboBox x:Name="SubscriptionTypeCombo" Grid.Row="2" Grid.Column="1"
                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"
                      SelectionChanged="SubscriptionTypeCombo_SelectionChanged"/>

            <!-- Period -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{Binding Period, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <ComboBox x:Name="PeriodCombo" Grid.Row="3" Grid.Column="1"
                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"
                      SelectionChanged="PeriodCombo_SelectionChanged"/>

            <!-- Custom Days (visible only when Custom is selected) -->
            <TextBlock x:Name="CustomDaysLabel" Grid.Row="4" Grid.Column="0"
                       Text="{Binding EnterDays, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"
                       Visibility="Collapsed"/>
            <TextBox x:Name="CustomDaysTextBox" Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                     Visibility="Collapsed" TextChanged="CustomDaysTextBox_TextChanged"
                     PreviewTextInput="NumberOnly_PreviewTextInput"
                     DataObject.Pasting="NumberOnly_Pasting"/>

            <!-- Fee -->
            <TextBlock Grid.Row="5" Grid.Column="0"
                       Text="{Binding Fee, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <TextBox x:Name="FeeTextBox" Grid.Row="5" Grid.Column="1"
                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                     TextChanged="FeeTextBox_TextChanged" IsReadOnly="True"
                     PreviewTextInput="NumberOnly_PreviewTextInput"
                     DataObject.Pasting="NumberOnly_Pasting"/>

            <!-- Amount Paid -->
            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="{Binding Paid, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <TextBox x:Name="PaidTextBox" Grid.Row="6" Grid.Column="1"
                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                     TextChanged="PaidTextBox_TextChanged"
                     PreviewTextInput="NumberOnly_PreviewTextInput"
                     DataObject.Pasting="NumberOnly_Pasting"/>

            <!-- Remaining -->
            <TextBlock Grid.Row="7" Grid.Column="0"
                       Text="{Binding Remaining, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <TextBox x:Name="RemainingTextBox" Grid.Row="7" Grid.Column="1"
                     Style="{StaticResource ReadOnlyTextBox}" Margin="0,0,0,10"
                     Focusable="False" IsTabStop="False"/>

            <!-- Door Access -->
            <TextBlock Grid.Row="8" Grid.Column="0"
                       Text="{Binding DoorAccess, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Top" Margin="0,6,0,10" FontSize="13"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
                <WrapPanel>
                    <CheckBox x:Name="Door1Check" Content="Door 1" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,20,2"/>
                    <CheckBox x:Name="Door2Check" Content="Door 2"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,20,2"/>
                    <CheckBox x:Name="Door3Check" Content="Door 3"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,20,2"/>
                    <CheckBox x:Name="Door4Check" Content="Door 4"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,0,2"/>
                </WrapPanel>
            </StackPanel>

            <!-- Effective Times — hidden in Multi Device mode -->
            <TextBlock x:Name="EffectiveTimesLabel" Grid.Row="9" Grid.Column="0"
                       Text="{Binding EffectiveTimes, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <ComboBox x:Name="EffectiveTimesCombo" Grid.Row="9" Grid.Column="1"
                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"/>

            <!-- Devices -->
            <TextBlock Grid.Row="10" Grid.Column="0"
                       Text="{Binding SelectDevices, Source={x:Static helpers:LanguageManager.Instance}}"
                       Foreground="#9EC5C8" VerticalAlignment="Top" Margin="0,6,0,10" FontSize="13"/>
            <Border Grid.Row="10" Grid.Column="1" Background="#0E2A2D"
                    BorderBrush="#3A3A50" BorderThickness="1.5" CornerRadius="8"
                    Margin="0,0,0,10" Padding="12,8" MinHeight="40">
                <StackPanel x:Name="DevicesPanel">
                    <TextBlock x:Name="NoDevicesText"
                               Text="{Binding NoDevicesAvailable, Source={x:Static helpers:LanguageManager.Instance}}"
                               Foreground="#5A8A8D" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Width="140" Height="42" Margin="0,0,14,0"
                        Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#2A2A3E" CornerRadius="10"
                                    BorderBrush="#444" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333350"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding Cancel, Source={x:Static helpers:LanguageManager.Instance}}"
                               Foreground="#B0B0CC" FontSize="15" FontWeight="Bold"/>
                </Button>

                <Button Width="140" Height="42"
                        Click="OkButton_Click" IsDefault="True" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#2ED47A" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#1AB85E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding RenewSubscription, Source={x:Static helpers:LanguageManager.Instance}}"
                               Foreground="White" FontSize="15" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
