<UserControl x:Class="AccessControlPro.WPF.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers">

    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Products Area -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">

            <!-- Top Bar: Title + Today's Sales + Refresh -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding Lang.NavPOS}"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadProductsCommand}" Padding="10,8" HorizontalAlignment="Right">
                    <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
                <!-- Today's Sales Summary -->
                <Border DockPanel.Dock="Right" Background="#1A44A1A0" CornerRadius="10"
                        Padding="14,6" Margin="16,0,8,0" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="LineChart" Width="14" Height="14"
                                         Foreground="{StaticResource PrimaryLightBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Lang.PosTodaySales}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TodaySalesCount}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="|" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{Binding TodaySalesTotal, StringFormat='{}{0:N0}'}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#FFB946" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Barcode Scanner Bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgInputBrush}"
                    CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                <DockPanel>
                    <fa:ImageAwesome DockPanel.Dock="Left" Icon="Barcode" Width="20" Height="20"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="4,0,10,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,8"
                            Command="{Binding ScanBarcodeCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Search" Width="12" Height="12"
                                             Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Lang.PosScan}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBox Style="{StaticResource DarkTextBox}" Padding="10,8" FontSize="14"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             helpers:EnterKeyBehavior.Command="{Binding ScanBarcodeCommand}"/>
                </DockPanel>
            </Border>

            <!-- Player Search Bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgInputBrush}"
                    CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                <DockPanel>
                    <fa:ImageAwesome DockPanel.Dock="Left" Icon="User" Width="16" Height="16"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     VerticalAlignment="Center" Margin="4,0,10,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,8"
                            Command="{Binding TopUpCardCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="CreditCard" Width="12" Height="12"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Lang.PosTopUp}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,8"
                            Command="{Binding SearchPlayerCommand}" Margin="8,0,0,0">
                        <fa:ImageAwesome Icon="Search" Width="12" Height="12" Foreground="White"/>
                    </Button>
                    <TextBox Style="{StaticResource DarkTextBox}" Padding="10,8"
                             Text="{Binding PlayerSearch, UpdateSourceTrigger=PropertyChanged}"
                             helpers:EnterKeyBehavior.Command="{Binding SearchPlayerCommand}"/>
                </DockPanel>
            </Border>

            <!-- Player Info -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,10"
                    Visibility="{Binding HasSelectedPlayer, Converter={StaticResource BoolToVisibility}}">
                <Border Background="#1A44A1A0" CornerRadius="10" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="User" Width="14" Height="14"
                                         Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerInfoText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFB946" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Category Tabs -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6" Cursor="Hand"
                                        Command="{Binding DataContext.SelectCategoryCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="tab" CornerRadius="8" Padding="16,8"
                                                    Background="{StaticResource BgInputBrush}">
                                                <TextBlock x:Name="txt" Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tab" Property="Background" Value="#2A2A3E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Product Cards Grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand" Margin="5"
                                    IsEnabled="{Binding Stock, Converter={StaticResource StockToBool}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Background="{StaticResource BgInputBrush}"
                                                CornerRadius="14" Padding="14,12" Width="160" MinHeight="120"
                                                Opacity="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           MaxHeight="40"/>
                                                <TextBlock Text="{Binding NameAr}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,6"/>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N0}'}"
                                                               FontSize="20" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryLightBrush}"/>
                                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                               Text="{Binding Stock, StringFormat='x{0}'}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Bottom"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="#3A3A4E"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="card" Property="Opacity" Value="0.4"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: Cart Panel -->
        <Border Grid.Column="1" Style="{StaticResource DashboardCard}">
            <DockPanel>
                <!-- Cart Header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <fa:ImageAwesome Icon="ShoppingCart" Width="18" Height="18"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Lang.PosCart}"
                               Style="{StaticResource SectionTitle}" Margin="0"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}" Padding="10,5"
                            Command="{Binding ClearCartCommand}">
                        <fa:ImageAwesome Icon="Trash" Width="12" Height="12"
                                         Foreground="#F7685B"/>
                    </Button>
                </DockPanel>

                <!-- Cart Total + Checkout Buttons -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#15FFFFFF" Margin="0,10"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Lang.Total}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Text="{Binding CartTotal, StringFormat='{}{0:N0}'}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryLightBrush}"/>
                    </DockPanel>
                    <Button Style="{StaticResource PrimaryButton}" Padding="0,12"
                            Command="{Binding CheckoutCashCommand}" Margin="0,0,0,8"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Money" Width="14" Height="14"
                                             Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Lang.PosPayCash}" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="0,12"
                            Command="{Binding CheckoutCardCommand}"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="CreditCard" Width="14" Height="14"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Lang.PosPayCard}" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Cart Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                                        Padding="12,10" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="6"
                                                VerticalAlignment="Top">
                                            <fa:ImageAwesome Icon="Times" Width="10" Height="10" Foreground="#F7685B"/>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:N0} x {1} = {2:N0}">
                                                            <Binding Path="Price"/>
                                                            <Binding Path="Quantity"/>
                                                            <Binding Path="Total"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <!-- +/- Quantity Buttons -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            HorizontalAlignment="Right" Margin="8,0,0,0">
                                                    <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                            Padding="4,2"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Border Background="#30F7685B" CornerRadius="4" Width="22" Height="22">
                                                            <fa:ImageAwesome Icon="Minus" Width="8" Height="8"
                                                                             Foreground="#F7685B"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Button>
                                                    <TextBlock Text="{Binding Quantity}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" Margin="6,0"
                                                               MinWidth="16" TextAlignment="Center"/>
                                                    <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                            Padding="4,2"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Border Background="#3044A1A0" CornerRadius="4" Width="22" Height="22">
                                                            <fa:ImageAwesome Icon="Plus" Width="8" Height="8"
                                                                             Foreground="{StaticResource PrimaryLightBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Button>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
