<UserControl x:Class="AccessControlPro.WPF.Views.QrPassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
             FontFamily="{StaticResource CairoFont}" FontWeight="Bold"
             FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header Bar ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <fa:ImageAwesome Icon="Qrcode" Width="24" Height="24"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding QrNavTitle, Source={x:Static helpers:LanguageManager.Instance}}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                <!-- Active Today Badge -->
                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12"
                        Padding="12,4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="CheckCircle" Width="12" Height="12"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Foreground="White" FontSize="12" VerticalAlignment="Center">
                            <Run Text="{Binding QrActiveToday, Source={x:Static helpers:LanguageManager.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding ActiveTodayCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenScanWindowCommand}"
                        Margin="0,0,8,0" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Camera" Width="14" Height="14"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding QrScanMode, Source={x:Static helpers:LanguageManager.Instance}}"
                                   Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreatePassCommand}"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="PlusCircle" Width="14" Height="14"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding QrCreatePass, Source={x:Static helpers:LanguageManager.Instance}}"
                                   Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Search & Filter Bar ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Style="{StaticResource DarkTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding SearchPlaceholder, Source={x:Static helpers:LanguageManager.Instance}}"
                     helpers:EnterKeyBehavior.Command="{Binding SearchCommand}"/>

            <Button Grid.Column="1" Style="{StaticResource DarkButton}"
                    Command="{Binding ToggleActiveFilterCommand}"
                    Margin="8,0,0,0" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Filter" Width="12" Height="12"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding QrActiveOnly, Source={x:Static helpers:LanguageManager.Instance}}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource DarkButton}"
                    Command="{Binding RefreshCommand}"
                    Margin="8,0,0,0" Padding="12,8">
                <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </Grid>

        <!-- ═══ Table Header ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgInputBrush}" CornerRadius="12,12,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pass Code" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding QrPlayerName, Source={x:Static helpers:LanguageManager.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Phone, Source={x:Static helpers:LanguageManager.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding QrValidTo, Source={x:Static helpers:LanguageManager.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="4" Text="Uses" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Fee, Source={x:Static helpers:LanguageManager.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="6" Text="{Binding SelectDevice, Source={x:Static helpers:LanguageManager.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="7" Text="Status" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="8" Text="{Binding Actions, Source={x:Static helpers:LanguageManager.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- ═══ Table Body ═══ -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" CornerRadius="0,0,12,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Passes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Background="Transparent"
                                    Padding="18,10" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pass Code -->
                                    <TextBlock Grid.Column="0" Text="{Binding PassCode}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Player Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding PlayerName}" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Phone -->
                                    <TextBlock Grid.Column="2" Text="{Binding Phone}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Valid To -->
                                    <TextBlock Grid.Column="3" Text="{Binding ValidTo, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                    <!-- Uses -->
                                    <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource WarningBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="UsedCount"/>
                                                <Binding Path="MaxUses"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- Fee -->
                                    <TextBlock Grid.Column="5" Text="{Binding Fee, StringFormat='{}{0:N0}'}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Device -->
                                    <TextBlock Grid.Column="6" Text="{Binding DeviceName}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Status -->
                                    <Border Grid.Column="7" Background="{Binding StatusColor}" CornerRadius="8"
                                            Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Cursor="Hand" ToolTip="View QR"
                                                Command="{Binding DataContext.ViewQrCodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                        <fa:ImageAwesome Icon="Qrcode" Width="12" Height="12"
                                                                         Foreground="{StaticResource PrimaryLightBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18247B7B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Cursor="Hand" ToolTip="Deactivate"
                                                Command="{Binding DataContext.DeactivatePassCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,5">
                                                        <fa:ImageAwesome Icon="Ban" Width="12" Height="12"
                                                                         Foreground="{StaticResource DangerBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#18F7685B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="#0CFFFFFF"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ═══ Pagination ═══ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Style="{StaticResource DarkButton}" Command="{Binding PrevPageCommand}"
                    Content="◀" Width="36" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}">
                <Run Text="{Binding Page, Source={x:Static helpers:LanguageManager.Instance}, Mode=OneWay}"/>
                <Run Text=" "/>
                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                <Run Text=" / "/>
                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
            </TextBlock>
            <Button Style="{StaticResource DarkButton}" Command="{Binding NextPageCommand}"
                    Content="▶" Width="36" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#80000000" CornerRadius="8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Loading, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
