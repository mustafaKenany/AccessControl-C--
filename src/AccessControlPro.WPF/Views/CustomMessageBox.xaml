<Window x:Class="AccessControlPro.WPF.Views.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#1A1A2E" CornerRadius="14" BorderBrush="#2A2A3E" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top accent color bar -->
            <Border x:Name="AccentBar" Grid.Row="0" CornerRadius="14,14,0,0"
                    Background="#44A1A0"/>

            <!-- Header: icon + title -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,22,28,0">
                <fa:ImageAwesome x:Name="IconElement" Icon="InfoCircle"
                                 Width="30" Height="30" Foreground="#78CDD7"
                                 VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Title"
                           FontSize="18" FontWeight="Bold" Foreground="#FFFFFA"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="MessageText" Grid.Row="2"
                       Text="Message" TextWrapping="Wrap"
                       Foreground="#B8B8CC" FontSize="13.5"
                       Margin="28,16,28,0" LineHeight="24"/>

            <!-- OK Button (single button mode) -->
            <Button x:Name="OkButton" Grid.Row="3" Width="140" Height="40"
                    Margin="0,24,0,24" Click="OkButton_Click"
                    Cursor="Hand" FontSize="14" FontWeight="Bold"
                    Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#44A1A0" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#247B7B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="OkText" Text="OK" FontSize="14"
                           FontWeight="Bold" Foreground="White"/>
            </Button>

            <!-- Yes/No Buttons (confirm mode) -->
            <StackPanel x:Name="ConfirmPanel" Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,24,0,24"
                        Visibility="Collapsed">
                <!-- No / Cancel -->
                <Button Width="140" Height="40" Margin="0,0,14,0"
                        Click="NoButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#2A2A3E" CornerRadius="10"
                                    BorderBrush="#444" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333350"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="NoText" Text="No" FontSize="14"
                               FontWeight="Bold" Foreground="#B0B0CC"/>
                </Button>

                <!-- Yes / Confirm -->
                <Button Width="140" Height="40"
                        Click="YesButton_Click" IsDefault="True" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#44A1A0" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#247B7B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="YesText" Text="Yes" FontSize="14"
                               FontWeight="Bold" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
