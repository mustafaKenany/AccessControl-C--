<Window x:Class="AccessControlPro.WPF.Views.SetDoorScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="{Binding Lang.SetSchedule}"
        Width="650" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#081B1D"
        ResizeMode="NoResize"
        FlowDirection="{Binding Lang.FlowDirection}">

    <Window.Resources>
        <!-- Styled ComboBox for time pickers -->
        <Style x:Key="TimeComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E8F1F2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="#0E2E30"
                                                BorderBrush="#2A5A5C" BorderThickness="1.5" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="#0A2224"
                                                        BorderThickness="1.5,0,0,0" BorderBrush="#2A5A5C"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Fill="#44A1A0" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#44A1A0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="6,4,24,4"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#0E2E30" BorderBrush="#44A1A0"
                                            BorderThickness="1.5" CornerRadius="4" Padding="0,4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8F1F2"/>
            <Setter Property="Background" Value="#0E2E30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A4446"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#44A1A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Day enable checkbox style -->
        <Style x:Key="DayEnableCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="4"
                                    Background="#0A2224" BorderBrush="#2A5A5C" BorderThickness="1.5">
                                <Path x:Name="checkMark" Data="M 3 8 L 7 12 L 14 4"
                                      Stroke="White" StrokeThickness="2"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#44A1A0"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#5BC0BE"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#78CDD7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset button style -->
        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E8F1F2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#1A2A2E"
                                BorderBrush="#2A5A5C" BorderThickness="1.5"
                                CornerRadius="8" Padding="14,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#44A1A0"/>
                                <Setter TargetName="bg" Property="Background" Value="#243A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent preset button (24/7) -->
        <Style x:Key="PresetButtonAccent" TargetType="Button" BasedOn="{StaticResource PresetButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#44A1A0"
                                BorderBrush="#5BC0BE" BorderThickness="1.5"
                                CornerRadius="8" Padding="14,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A8F8E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Add segment button style -->
        <Style x:Key="AddSegmentButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                CornerRadius="6" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete segment button style -->
        <Style x:Key="DeleteSegmentButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0E2E30" CornerRadius="12" Margin="12" Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0">
                <!-- Title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <fa:ImageAwesome Icon="ClockOutline" Width="22" Height="22"
                                     Foreground="#44A1A0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Lang.SetSchedule}" FontSize="20" FontWeight="Bold"
                               Foreground="#E8F1F2" FontFamily="Cairo"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Door Name -->
                <TextBlock x:Name="DoorNameText" FontSize="14"
                           Foreground="#44A1A0" FontFamily="Cairo" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Separator -->
                <Border Height="1" Background="#1A5A5C" Margin="0,0,0,10"/>

                <!-- Preset Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Style="{StaticResource PresetButtonAccent}"
                            Click="Preset247_Click" Margin="0,0,8,0">
                        <TextBlock Text="24/7" FontFamily="Cairo" FontSize="12"
                                   FontWeight="Bold" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource PresetButton}"
                            Click="PresetWeekdays_Click" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Lang.WorkingDays}" FontFamily="Cairo" FontSize="12"
                                   FontWeight="Bold" Foreground="#E8F1F2"/>
                    </Button>
                    <Button Style="{StaticResource PresetButton}"
                            Click="PresetCustom_Click">
                        <TextBlock Text="{Binding Lang.CustomPeriod}" FontFamily="Cairo" FontSize="12"
                                   FontWeight="Bold" Foreground="#E8F1F2"/>
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Border Height="1" Background="#1A5A5C" Margin="0,0,0,6"/>
            </StackPanel>

            <!-- SCHEDULE GRID (scrollable) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,8">
                <StackPanel x:Name="DaysContainer"/>
            </ScrollViewer>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Width="140" Height="40" Cursor="Hand"
                        Click="SaveButton_Click" Margin="0,0,14,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#44A1A0"
                                    CornerRadius="10" Padding="16,6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#3A8F8E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding Lang.UsrSave}" FontFamily="Cairo"
                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                </Button>
                <Button Width="140" Height="40" Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#1A2A2E"
                                    CornerRadius="10" BorderBrush="#2A5A5C"
                                    BorderThickness="1.5" Padding="16,6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#243A3E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding Lang.Cancel}" FontFamily="Cairo"
                               FontSize="14" FontWeight="Bold" Foreground="#9EC5C8"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
