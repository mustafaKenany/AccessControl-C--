<Window x:Class="AccessControlPro.WPF.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Setup Wizard"
        Width="680" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold">

    <Border CornerRadius="16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A1A1D" Offset="0"/>
                <GradientStop Color="#122428" Offset="0.5"/>
                <GradientStop Color="#0A1A1D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Title Bar ═══ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                    Padding="24,16">
                <DockPanel>
                    <fa:FontAwesome Icon="Magic" FontSize="22" Foreground="#44A1A0"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Setup Wizard" FontSize="20" Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StepIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               FontSize="13" Foreground="#AAB8C2" VerticalAlignment="Center"
                               Text="Step 1 of 5"/>
                </DockPanel>
            </Border>

            <!-- ═══ Step Progress Bar ═══ -->
            <Grid Grid.Row="0" Margin="24,48,24,0" VerticalAlignment="Bottom">
                <ProgressBar x:Name="StepProgress" Height="4" Minimum="0" Maximum="5" Value="1"
                             Background="#1E2D3D" Foreground="#44A1A0" BorderThickness="0"/>
            </Grid>

            <!-- ═══ Content Area ═══ -->
            <ScrollViewer Grid.Row="1" Margin="32,20,32,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>

                <!-- ── Step 1: Welcome ── -->
                <StackPanel x:Name="Step1_Welcome" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Shield" FontSize="56" Foreground="#44A1A0"
                                    HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Welcome to HM-GymManagement" FontSize="24" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Gym Access Control &amp; Management System" FontSize="14"
                               Foreground="#AAB8C2" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    <TextBlock TextAlignment="Center" FontSize="13" Foreground="#7A8A9A"
                               TextWrapping="Wrap" LineHeight="22">
                        This wizard will configure all 3 applications (Main, Admin Panel, POS Terminal).
                        You will set up the database connection, gym information, and create
                        the admin account. Desktop shortcuts will be created for all apps.
                    </TextBlock>

                    <Border Background="#0C2225" CornerRadius="10" Padding="20,16" Margin="40,24,40,0">
                        <StackPanel>
                            <TextBlock Text="Developer" FontSize="14" Foreground="#44A1A0"
                                       Margin="0,0,0,10"/>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="HM-TECH IT Solutions" FontSize="16" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Smart Tech, Secure Life" FontSize="11" FontStyle="Italic"
                                           Foreground="#2E8B57" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock Text="07812573845" FontSize="12" Foreground="#78CDD7" Margin="0,0,16,0"/>
                                    <TextBlock Text="hmtech.solutions" FontSize="12" Foreground="#78CDD7"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Developer logo removed - hardcoded in login page -->
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Step 2: Database Connection ── -->
                <StackPanel x:Name="Step2_Database" Visibility="Collapsed" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Database" FontSize="44" Foreground="#44A1A0"
                                    HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Database Connection" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Configure the SQL Server connection for your data." FontSize="13"
                               Foreground="#AAB8C2" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Margin="40,0">
                        <TextBlock Text="Server IP / Hostname:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="DbServerBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"
                                 Text="localhost"/>

                        <TextBlock Text="Database Name:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="DbNameBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"
                                 Text="AccessControlPro"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                                <TextBox x:Name="DbUserBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                         BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Text="sa"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="DbPasswordBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                             BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Test Connection -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TestDbButton" Grid.Column="0" Click="TestDbButton_Click"
                                    Background="#2A3A4A" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Padding="16,8">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3A4A5A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesome Icon="Plug" FontSize="14" Foreground="#4FC3F7" Margin="0,0,8,0"
                                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="Test Connection" Foreground="White" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="DbStatusText" Grid.Column="1" FontSize="12"
                                       Foreground="#AAB8C2" VerticalAlignment="Center" Margin="14,0,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ── Step 3: Gym Settings ── -->
                <StackPanel x:Name="Step3_GymSettings" Visibility="Collapsed" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Building" FontSize="44" Foreground="#44A1A0"
                                    HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Gym / Business Settings" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Set up your gym name and contact information." FontSize="13"
                               Foreground="#AAB8C2" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Margin="40,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gym Name (English):" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                                <TextBox x:Name="GymNameEnBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                         BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8"
                                         Text="My Gym"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gym Name (Arabic):" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"
                                           FlowDirection="RightToLeft"/>
                                <TextBox x:Name="GymNameArBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                         BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8"
                                         FlowDirection="RightToLeft" Text="نادي الرياضة"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Phone Number:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="GymPhoneBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Address:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="GymAddressBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Default Language:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LanguageCombo" FontSize="14" FontFamily="Cairo"
                                  Background="#0E2E30" Foreground="White" BorderBrush="#44A1A0"
                                  Padding="8,6" Margin="0,0,0,12" SelectedIndex="0">
                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0E2E30"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#44A1A0"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#0E2E30"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontFamily" Value="Cairo"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="toggleButton"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="border" Background="#0E2E30"
                                                            BorderBrush="#44A1A0" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="28"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="1" Background="#0A2224" BorderThickness="1,0,0,0" BorderBrush="#44A1A0">
                                                                <Path Fill="#44A1A0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Data="M 0 0 L 5 5 L 10 0 Z"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#55B2B1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Margin="10,6,28,6"/>
                                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               Placement="Bottom" PopupAnimation="Slide">
                                            <Grid MinWidth="{TemplateBinding ActualWidth}"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <Border Background="#0E2E30" BorderBrush="#44A1A0"
                                                        BorderThickness="1" Padding="0,4">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <StackPanel IsItemsHost="True"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="العربية (Arabic)" Tag="ar"/>
                        </ComboBox>

                        <TextBlock Text="Device Mode:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DeviceModeCombo" FontSize="14" FontFamily="Cairo"
                                  Background="#0E2E30" Foreground="White" BorderBrush="#44A1A0"
                                  Padding="8,6" Margin="0,0,0,12" SelectedIndex="0">
                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0E2E30"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#44A1A0"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#0E2E30"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontFamily" Value="Cairo"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="toggleButton"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="border" Background="#0E2E30"
                                                            BorderBrush="#44A1A0" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="28"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="1" Background="#0A2224" BorderThickness="1,0,0,0" BorderBrush="#44A1A0">
                                                                <Path Fill="#44A1A0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Data="M 0 0 L 5 5 L 10 0 Z"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#55B2B1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Margin="10,6,28,6"/>
                                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               Placement="Bottom" PopupAnimation="Slide">
                                            <Grid MinWidth="{TemplateBinding ActualWidth}"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <Border Background="#0E2E30" BorderBrush="#44A1A0"
                                                        BorderThickness="1" Padding="0,4">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <StackPanel IsItemsHost="True"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBoxItem Content="Single Device (supports visit counting)" Tag="Single"/>
                            <ComboBoxItem Content="Multi Device (date-based only)" Tag="Multi"/>
                        </ComboBox>

                        <!-- Cloud on/off: unchecked = fully local/offline install (no sync, no update
                             checks, no cloud errors). Checked = online cloud sync + remote support. -->
                        <CheckBox x:Name="CloudEnabledCheck" IsChecked="True" Margin="0,4,0,8"
                                  Foreground="White" FontSize="14" FontWeight="SemiBold">
                            <TextBlock Text="Connect to cloud (online sync, auto-updates &amp; remote support)"
                                       Foreground="White" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Text="Leave unchecked for a site with no internet — the app then runs fully offline (local only)."
                                   FontSize="11" Foreground="#7A8B99" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Cloud API Key -->
                        <TextBlock Text="Cloud API Key (leave blank to auto-generate a unique key):" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="CloudApiKeyBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"
                                 Text=""/>

                        <!-- Auto-provision: register this gym in the cloud automatically.
                             Enter the provisioning password to create the gym + its cloud database
                             without touching Super Admin. Leave blank to skip (create it manually). -->
                        <TextBlock Text="Provisioning password (optional — auto-creates the gym in the cloud):" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ProvisionPasswordBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                     BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>

                        <!-- Backup Folder -->
                        <TextBlock Text="Backup Folder:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="BackupFolderBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"
                                 Text="D:\Backups\AccessControlPro"/>

                        <!-- Gym Logo Upload -->
                        <TextBlock Text="Gym Logo:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BrowseGymLogoButton" DockPanel.Dock="Right"
                                    Click="BrowseGymLogo_Click"
                                    Background="#2A3A4A" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3A4A5A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesome Icon="FolderOpen" FontSize="12" Foreground="#4FC3F7" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse" FontSize="11" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Border Background="#1E2D3D" CornerRadius="6" Padding="6" Height="48">
                                <DockPanel>
                                    <Image x:Name="GymLogoPreview" Width="36" Height="36"
                                           Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="GymLogoFileName" Text="No logo selected"
                                               FontSize="11" Foreground="#7A8A9A"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ── Step 4: Admin Account ── -->
                <StackPanel x:Name="Step4_AdminAccount" Visibility="Collapsed" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="UserSecret" FontSize="44" Foreground="#44A1A0"
                                    HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Admin Account" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Create the administrator account for the system." FontSize="13"
                               Foreground="#AAB8C2" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Margin="80,0">
                        <TextBlock Text="Admin Username:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="AdminUsernameBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"
                                 Text="admin"/>

                        <TextBlock Text="Display Name:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <TextBox x:Name="AdminDisplayNameBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                 BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"
                                 Text="Administrator"/>

                        <TextBlock Text="Password:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="AdminPasswordBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                     BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Confirm Password:" FontSize="13" Foreground="#AAB8C2" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="AdminConfirmPasswordBox" FontSize="14" Background="#1E2D3D" Foreground="White"
                                     BorderBrush="#2A3A4A" BorderThickness="1" Padding="10,8" Margin="0,0,0,4"/>

                        <TextBlock x:Name="PasswordHint" FontSize="11" Foreground="#7A8A9A" Margin="0,0,0,0"
                                   Text="Password must be at least 6 characters."/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Step 5: Summary + Install ── -->
                <StackPanel x:Name="Step5_Summary" Visibility="Collapsed" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="CheckCircle" FontSize="44" Foreground="#44A1A0"
                                    HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Ready to Install" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Review your settings and click Install to complete setup." FontSize="13"
                               Foreground="#AAB8C2" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Border Background="#0C2225" CornerRadius="10" Padding="20,16" Margin="40,0">
                        <StackPanel>
                            <TextBlock x:Name="SummaryText" FontSize="13" Foreground="#CCD6E0"
                                       TextWrapping="Wrap" LineHeight="24"/>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <StackPanel Margin="40,12,40,0">
                        <CheckBox x:Name="CreateDesktopShortcutCheck" IsChecked="True"
                                  Foreground="#CCD6E0" FontSize="13" Margin="0,0,0,4">
                            <TextBlock Text="Create Desktop Shortcut" Foreground="#CCD6E0"/>
                        </CheckBox>
                        <CheckBox x:Name="CreateStartMenuCheck" IsChecked="True"
                                  Foreground="#CCD6E0" FontSize="13">
                            <TextBlock Text="Create Start Menu Shortcut" Foreground="#CCD6E0"/>
                        </CheckBox>
                    </StackPanel>

                    <!-- Install status -->
                    <TextBlock x:Name="InstallStatusText" FontSize="13" Foreground="#4FC3F7"
                               HorizontalAlignment="Center" Margin="0,12,0,0"
                               Visibility="Collapsed"/>
                    <ProgressBar x:Name="InstallProgress" Height="4" Margin="40,8,40,0"
                                 IsIndeterminate="True" Foreground="#44A1A0" Background="#1E2D3D"
                                 Visibility="Collapsed"/>
                </StackPanel>

                <!-- ── Step 6: Complete ── -->
                <StackPanel x:Name="Step6_Complete" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <fa:FontAwesome Icon="CheckCircle" FontSize="64" Foreground="#2ED47A"
                                    HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Setup Complete!" FontSize="26" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="All 3 applications have been configured successfully." FontSize="14"
                               Foreground="#AAB8C2" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Desktop and Start Menu shortcuts have been created." FontSize="13"
                               Foreground="#7A8A9A" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Click Finish to launch the application." FontSize="13"
                               Foreground="#7A8A9A" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>

            <!-- ═══ Bottom Buttons ═══ -->
            <Border Grid.Row="2" Padding="24,16">
                <DockPanel>
                    <!-- Back Button -->
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Click="BackButton_Click"
                            Background="#2A3A4A" Foreground="#AAB8C2" BorderThickness="0" Cursor="Hand"
                            Padding="20,10" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3A4A5A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesome Icon="ArrowLeft" FontSize="13" Foreground="#AAB8C2" Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>
                            <TextBlock Text="Back" FontSize="13" Foreground="#AAB8C2"/>
                        </StackPanel>
                    </Button>

                    <!-- Next/Install/Finish Button -->
                    <Button x:Name="NextButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Click="NextButton_Click"
                            Background="#44A1A0" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Padding="24,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#55B2B1"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel x:Name="NextButtonContent" Orientation="Horizontal">
                            <TextBlock x:Name="NextButtonText" Text="Next" FontSize="13" Foreground="White"/>
                            <fa:FontAwesome x:Name="NextButtonIcon" Icon="ArrowRight" FontSize="13"
                                            Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Click="CancelButton_Click" Margin="0,0,12,0"
                            Background="Transparent" Foreground="#7A8A9A" BorderThickness="0" Cursor="Hand"
                            Padding="16,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A2A3A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Cancel" FontSize="13" Foreground="#7A8A9A"/>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
