<Window x:Class="AccessControlPro.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Access Control Pro - Login"
        Width="480" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        >

    <Border CornerRadius="16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A1A1D" Offset="0"/>
                <GradientStop Color="#1A1A2E" Offset="0.5"/>
                <GradientStop Color="#0A1A1D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <!-- Invisible drag bar covering the entire window background -->
            <Border Background="Transparent" MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                    Panel.ZIndex="0"/>

            <!-- Window Controls (top right) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Panel.ZIndex="1">
                <Button Width="32" Height="32" Cursor="Hand" Click="MinimizeClick"
                        Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="8" Width="32" Height="32">
                                <fa:ImageAwesome Icon="WindowMinimize" Width="10" Height="10"
                                                 Foreground="#5A5A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="32" Height="32" Cursor="Hand" Click="CloseClick"
                        Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="8" Width="32" Height="32">
                                <fa:ImageAwesome Icon="Times" Width="10" Height="10"
                                                 Foreground="#5A5A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#40F7685B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="50,0" Panel.ZIndex="1">
                <!-- Logo Placeholders -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <!-- Dev Team Logo Placeholder -->
                    <Border Width="60" Height="60" CornerRadius="12" Background="#15FFFFFF" Margin="0,0,20,0">
                        <fa:ImageAwesome Icon="Code" Width="24" Height="24" Foreground="#3A3A4E"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Gym Logo Placeholder -->
                    <Border Width="60" Height="60" CornerRadius="12" Background="#15FFFFFF">
                        <fa:ImageAwesome Icon="Building" Width="24" Height="24" Foreground="#3A3A4E"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Shield Icon + Title -->
                <Border Width="64" Height="64" CornerRadius="16" Margin="0,10,0,0"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#247B7B" Offset="0"/>
                            <GradientStop Color="#44A1A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <fa:ImageAwesome Icon="Shield" Width="30" Height="30" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Access Control Pro" FontSize="22" FontWeight="Bold"
                           Foreground="#FFFFFA" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock x:Name="WelcomeText" Text="Welcome back" FontSize="13"
                           Foreground="#5A5A7A" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Username Field -->
                <TextBlock x:Name="UsernameLabel" Text="Username" FontSize="12"
                           Foreground="#9EC5C8" Margin="4,0,0,6"/>
                <Border Background="#143436" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                    <DockPanel>
                        <fa:ImageAwesome Icon="UserOutline" Width="14" Height="14"
                                         Foreground="#5A5A7A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center"
                                 CaretBrush="#E0E0E0"
                                 FontFamily="{StaticResource CairoFont}" FontWeight="Bold"
                                 KeyDown="UsernameTextBox_KeyDown"/>
                    </DockPanel>
                </Border>

                <!-- Password Field -->
                <TextBlock x:Name="PasswordLabel" Text="Password" FontSize="12"
                           Foreground="#9EC5C8" Margin="4,0,0,6"/>
                <Border Background="#143436" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                    <DockPanel>
                        <fa:ImageAwesome Icon="Lock" Width="14" Height="14"
                                         Foreground="#5A5A7A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center"
                                     CaretBrush="#E0E0E0"
                                     FontFamily="{StaticResource CairoFont}" FontWeight="Bold"
                                     KeyDown="PasswordBox_KeyDown"/>
                    </DockPanel>
                </Border>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" Text="" FontSize="12"
                           Foreground="#F7685B" HorizontalAlignment="Center"
                           Margin="0,0,0,12" Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton" Height="46" Cursor="Hand"
                        Click="LoginButton_Click" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="12" Height="46">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#247B7B" Offset="0"/>
                                        <GradientStop Color="#44A1A0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome x:Name="LoginIcon" Icon="SignIn" Width="16" Height="16"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="LoginButtonText" Text="Sign In" FontSize="15" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Loading Spinner (hidden by default) -->
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
                    <fa:ImageAwesome Icon="Spinner" Width="18" Height="18"
                                     Foreground="#44A1A0" SpinDuration="1" Spin="True"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LoadingText" Text="Signing in..." FontSize="12"
                               Foreground="#5A5A7A" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Footer: Dev Info Placeholders -->
                <Border Height="1" Background="#15FFFFFF" Margin="20,28,20,16"/>
                <TextBlock x:Name="FooterText" FontSize="11" Foreground="#3A3A4E"
                           HorizontalAlignment="Center" TextAlignment="Center">
                    <Run Text="Powered by Development Team"/>
                    <LineBreak/>
                    <Run Text="Phone: +964 XXX XXX XXXX | Location: Iraq"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
