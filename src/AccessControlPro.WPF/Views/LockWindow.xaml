<Window x:Class="AccessControlPro.WPF.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locked"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0B1416"
        FontFamily="{StaticResource CairoFont}">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Margin="24">
            <TextBlock Text="&#x1F512;" FontSize="84" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="MessageText" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="34" Margin="0,0,0,24"/>
            <TextBlock x:Name="ContactText" Foreground="#9FB0B2" FontSize="18" TextAlignment="Center" Margin="0,0,0,30"/>
            <Button x:Name="RecheckButton" Click="Recheck_Click" Padding="26,12" FontSize="16"
                    Background="#44A1A0" Foreground="White" BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Center" Content="&#x625;&#x639;&#x627;&#x62F;&#x629; &#x627;&#x644;&#x645;&#x62D;&#x627;&#x648;&#x644;&#x629; / Re-check"/>
            <TextBlock x:Name="StatusText" Foreground="#6B7B7D" FontSize="13" TextAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </Grid>
</Window>
