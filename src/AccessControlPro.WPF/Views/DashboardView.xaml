<UserControl x:Class="AccessControlPro.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:converters="clr-namespace:AccessControlPro.WPF.Converters">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- ═══ Header ═══ -->
            <DockPanel Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Lang.NavDashboard}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Refresh" Width="13" Height="13"
                                         Foreground="White" Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.Refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- ═══ Stat Cards Row ═══ -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">

                <!-- Total Devices -->
                <Border CornerRadius="16" Padding="22,20" Margin="0,0,10,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D5C63" Offset="0"/>
                            <GradientStop Color="#247B7B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#0D5C63" BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <fa:ImageAwesome Icon="Server" Width="20" Height="20"
                                             Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding TotalDevices}"
                                   FontSize="34" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Lang.TotalDevices}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#B0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Online Doors -->
                <Border CornerRadius="16" Padding="22,20" Margin="5,0,5,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2ED47A" Offset="0"/>
                            <GradientStop Color="#56E89A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#2ED47A" BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <fa:ImageAwesome Icon="Lock" Width="20" Height="20"
                                             Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding OnlineDoors}"
                                   FontSize="34" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Lang.OnlineDoors}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#B0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today's Events -->
                <Border CornerRadius="16" Padding="22,20" Margin="5,0,5,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#44A1A0" Offset="0"/>
                            <GradientStop Color="#78CDD7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#44A1A0" BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <fa:ImageAwesome Icon="ClockOutline" Width="20" Height="20"
                                             Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding TodayEvents}"
                                   FontSize="34" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Lang.TodayEvents}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#B0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Active Alarms -->
                <Border CornerRadius="16" Padding="22,20" Margin="10,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F7685B" Offset="0"/>
                            <GradientStop Color="#FF8A80" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#F7685B" BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <fa:ImageAwesome Icon="ExclamationTriangle" Width="20" Height="20"
                                             Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding ActiveAlarms}"
                                   FontSize="34" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Lang.ActiveAlarms}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#B0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ Door Status Section ═══ -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <fa:ImageAwesome Icon="Lock" Width="18" Height="18"
                                         Foreground="{StaticResource PrimaryLightBrush}"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Lang.DoorStatus}" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding DoorStatuses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgInputBrush}" CornerRadius="12"
                                        Padding="18,14" Margin="4" MinWidth="200">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DoorName}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DeviceName}" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="20,6,0,0"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                   Margin="20,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ Recent Events Section ═══ -->
            <Border Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <fa:ImageAwesome Icon="ClockOutline" Width="18" Height="18"
                                         Foreground="{StaticResource InfoBrush}"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Lang.RecentEvents}" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>

                    <!-- Table Header -->
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                            Padding="16,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Lang.Time}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Lang.Door}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Lang.Card}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Lang.Event}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Event Rows -->
                    <ItemsControl ItemsSource="{Binding RecentEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EventRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DoorName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CardNumber}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding EventDescription}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InfoBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
