<Window x:Class="AccessControlPro.WPF.Views.DiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="Discount"
        Width="420" Height="340" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}" FontWeight="Bold">
    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding PosDiscountLabel, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Percentage -->
            <TextBlock Text="{Binding PosDiscountPercent, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="PercentBox" Style="{StaticResource DarkTextBox}"
                     FontSize="16" Padding="12,10" Margin="0,0,0,12"
                     TextChanged="PercentBox_TextChanged"/>

            <!-- Fixed amount -->
            <TextBlock Text="{Binding PosDiscountAmount, Source={x:Static helpers:LanguageManager.Instance}}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="AmountBox" Style="{StaticResource DarkTextBox}"
                     FontSize="16" Padding="12,10" Margin="0,0,0,12"
                     TextChanged="AmountBox_TextChanged"/>

            <!-- Preview -->
            <TextBlock x:Name="PreviewText" FontSize="14" Foreground="#FFB946"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Padding="28,10"
                        Click="OkClick" Margin="0,0,12,0">
                    <TextBlock Text="{Binding OK, Source={x:Static helpers:LanguageManager.Instance}}"/>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="28,10"
                        Click="CancelClick">
                    <TextBlock Text="{Binding Cancel, Source={x:Static helpers:LanguageManager.Instance}}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
