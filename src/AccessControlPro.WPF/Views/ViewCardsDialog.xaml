<Window x:Class="AccessControlPro.WPF.Views.ViewCardsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="{Binding Lang.NavCards}"
        Width="540" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1A1A2E"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Player Info Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Photo -->
                <Border Grid.Column="0" Width="70" Height="85" CornerRadius="10"
                        Background="#2A2A3E" BorderBrush="#3A3A50" BorderThickness="1.5"
                        ClipToBounds="True" Margin="0,0,14,0">
                    <Grid>
                        <fa:ImageAwesome Icon="UserCircleOutline" Width="30" Height="30"
                                         Foreground="#3A3A4E" HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        <Image x:Name="PlayerPhoto" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Name & Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerNameText" FontSize="17" FontWeight="Bold"
                               Foreground="#FFFFFA" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PlayerCardNoText" FontSize="12"
                               Foreground="#78CDD7" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PlayerSubText" FontSize="11"
                               Foreground="#9EC5C8"/>
                </StackPanel>
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="1" Height="1" Background="#2A2A3E" Margin="0,0,0,14"/>

            <!-- Cards List -->
            <ItemsControl x:Name="CardsPanel" Grid.Row="2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#222238" CornerRadius="10" Padding="16,12"
                                Margin="0,0,0,10" BorderBrush="#2A2A3E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- Card Number -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <fa:ImageAwesome Icon="IdCard" Width="13" Height="13"
                                                         Foreground="#44A1A0" VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding CardNumber}" FontSize="15"
                                                   FontWeight="Bold" Foreground="#FFFFFA"/>
                                    </StackPanel>

                                    <!-- Type + Mode -->
                                    <TextBlock FontSize="11" Foreground="#9EC5C8" Margin="0,0,0,4">
                                        <Run Text="{Binding CardType, Mode=OneWay}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding DoorPermissions, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Valid period -->
                                    <TextBlock FontSize="11" Foreground="#78CDD7">
                                        <Run Text="{Binding ValidFrom, StringFormat=yyyy-MM-dd, Mode=OneWay}"/>
                                        <Run Text="  →  "/>
                                        <Run Text="{Binding ValidTo, StringFormat=yyyy-MM-dd, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Status badges -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Border CornerRadius="8" Padding="10,4" Margin="0,0,0,4"
                                            HorizontalAlignment="Right"
                                            Background="{Binding IsActive, Converter={StaticResource BoolToActiveBg}}">
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveText}}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    <Border CornerRadius="8" Padding="10,4"
                                            HorizontalAlignment="Right"
                                            Background="{Binding IsSyncedToDevice, Converter={StaticResource BoolToSyncBg}}">
                                        <TextBlock Text="{Binding IsSyncedToDevice, Converter={StaticResource BoolToSyncText}}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Window>
