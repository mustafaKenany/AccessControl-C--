<Window x:Class="AccessControlPro.WPF.Views.MonitorDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Monitor Display"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#081B1D"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}">

    <Grid x:Name="RootGrid">
        <!-- Idle State: Gym Logo / Name -->
        <Grid x:Name="IdlePanel" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,30">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#247B7B" Offset="0"/>
                            <GradientStop Color="#44A1A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <fa:ImageAwesome Icon="Shield" Width="50" Height="50" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Access Control Pro" FontSize="42" Foreground="#44A1A0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Lang.MonitorReady}" FontSize="20" Foreground="#556677"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Card Event Display -->
        <Grid x:Name="EventPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Grid.Row="0" Padding="0,34" Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fa:ImageAwesome x:Name="StatusIcon" Icon="CheckCircle" Width="58" Height="58"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,22,0"/>
                        <TextBlock x:Name="StatusText" FontSize="58" Foreground="White"
                                   VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <!-- Door Name -->
                    <TextBlock x:Name="DoorNameText" FontSize="24" Foreground="#78CDD7"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Player Info Card -->
            <Border Grid.Row="1" Margin="60,20,60,40" CornerRadius="24" Background="#0D2B2E" Padding="50">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Player Photo — enlarged to 300px so the member is clearly recognisable
                         from a few metres away (was 160px). -->
                    <Border Grid.Column="0" Width="300" Height="300" CornerRadius="150"
                            BorderBrush="#44A1A0" BorderThickness="5" Margin="0,0,60,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush x:Name="PlayerPhoto" Stretch="UniformToFill"/>
                        </Border.Background>
                        <Border CornerRadius="150" ClipToBounds="True">
                            <!-- Fallback icon when no photo -->
                            <fa:ImageAwesome x:Name="NoPhotoIcon" Icon="User" Width="150" Height="150"
                                             Foreground="#334455" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                    </Border>

                    <!-- Player Details — member-first ordering: name, then the two things a
                         member actually cares about (what plan, valid until), then balance due
                         if any. Receptionist-only fields (card no, start, fee, paid, time) drop
                         to a small quiet row at the bottom. -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Name -->
                        <TextBlock x:Name="PlayerNameText" FontSize="44" Foreground="#E0E6ED"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Divider -->
                        <Border Height="2" Background="#1C4044" Margin="0,0,40,20"/>

                        <!-- PRIMARY: Subscription type -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="SubLabel" FontSize="18" Foreground="#556677"/>
                            <TextBlock x:Name="SubValue" FontSize="34" Foreground="#78CDD7"/>
                        </StackPanel>

                        <!-- PRIMARY: Valid until (End Date) -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="EndLabel" FontSize="18" Foreground="#556677"/>
                            <TextBlock x:Name="EndValue" FontSize="34" Foreground="#78CDD7"/>
                        </StackPanel>

                        <!-- PRIMARY: Remaining balance — only shown when the member owes money -->
                        <StackPanel x:Name="BalancePanel" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock x:Name="BalanceLabel" FontSize="18" Foreground="#556677"/>
                            <TextBlock x:Name="BalanceValue" FontSize="40" Foreground="#F7685B"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="2" Background="#1C4044" Margin="0,4,40,18"/>

                        <!-- SECONDARY: quiet receptionist details -->
                        <WrapPanel>
                            <!-- Card Number -->
                            <StackPanel Margin="0,0,44,12">
                                <TextBlock x:Name="CardLabel" FontSize="15" Foreground="#556677"/>
                                <TextBlock x:Name="CardValue" FontSize="22" Foreground="#AABBCC"/>
                            </StackPanel>
                            <!-- Start Date -->
                            <StackPanel Margin="0,0,44,12">
                                <TextBlock x:Name="StartLabel" FontSize="15" Foreground="#556677"/>
                                <TextBlock x:Name="StartValue" FontSize="22" Foreground="#AABBCC"/>
                            </StackPanel>
                            <!-- Fee -->
                            <StackPanel x:Name="FeePanel" Margin="0,0,44,12" Visibility="Collapsed">
                                <TextBlock x:Name="FeeLabel" FontSize="15" Foreground="#556677"/>
                                <TextBlock x:Name="FeeValue" FontSize="22" Foreground="#AABBCC"/>
                            </StackPanel>
                            <!-- Paid -->
                            <StackPanel x:Name="PaidPanel" Margin="0,0,44,12" Visibility="Collapsed">
                                <TextBlock x:Name="PaidLabel" FontSize="15" Foreground="#556677"/>
                                <TextBlock x:Name="PaidValue" FontSize="22" Foreground="#2ED47A"/>
                            </StackPanel>
                            <!-- Time -->
                            <StackPanel Margin="0,0,44,12">
                                <TextBlock x:Name="TimeLabel" FontSize="15" Foreground="#556677"/>
                                <TextBlock x:Name="TimeValue" FontSize="22" Foreground="#AABBCC"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
