<UserControl x:Class="AccessControlPro.WPF.Views.CashFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Lang.NavCashFlow}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddIncomeCommand}" Margin="0,0,10,0"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Plus" Width="12" Height="12"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.FinAddIncome}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddExpenseCommand}" Margin="0,0,10,0"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Plus" Width="12" Height="12"
                                         Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.FinAddExpense}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}">
                    <fa:ImageAwesome Icon="Refresh" Width="14" Height="14"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Padding="16,12" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <!-- Category label + combo -->
                <fa:ImageAwesome Icon="Tags" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding FinCategory, Source={x:Static helpers:LanguageManager.Instance}}"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="180" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Display"
                          Style="{StaticResource DarkComboBox}" Margin="0,0,24,0"/>

                <!-- Type label + combo -->
                <fa:ImageAwesome Icon="Exchange" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding FinType, Source={x:Static helpers:LanguageManager.Instance}}"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="140" SelectedIndex="{Binding SelectedFilterIndex}"
                          Style="{StaticResource DarkComboBox}" Margin="0,0,24,0">
                    <ComboBoxItem Content="{Binding FinAll, Source={x:Static helpers:LanguageManager.Instance}}"/>
                    <ComboBoxItem Content="{Binding FinIncome, Source={x:Static helpers:LanguageManager.Instance}}"/>
                    <ComboBoxItem Content="{Binding FinExpense, Source={x:Static helpers:LanguageManager.Instance}}"/>
                </ComboBox>

                <!-- Period label + combo -->
                <fa:ImageAwesome Icon="Calendar" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding FinPeriod, Source={x:Static helpers:LanguageManager.Instance}}"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="200" SelectedIndex="{Binding SelectedPeriodIndex}"
                          Style="{StaticResource DarkComboBox}" Margin="0,0,10,0">
                    <ComboBoxItem Content="{Binding FinAll, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Show all records without date filter"/>
                    <ComboBoxItem Content="{Binding FinToday, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from today only"/>
                    <ComboBoxItem Content="{Binding FinYesterday, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from yesterday only"/>
                    <ComboBoxItem Content="{Binding FinThisWeek, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from this week"/>
                    <ComboBoxItem Content="{Binding FinLastWeek, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from last week"/>
                    <ComboBoxItem Content="{Binding FinThisMonth, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from the 1st of this month to today"/>
                    <ComboBoxItem Content="{Binding FinLastMonth, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from last month only"/>
                    <ComboBoxItem Content="{Binding FinLast3Months, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from the last 3 months"/>
                    <ComboBoxItem Content="{Binding FinLast6Months, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from the last 6 months"/>
                    <ComboBoxItem Content="{Binding FinThisYear, Source={x:Static helpers:LanguageManager.Instance}}" ToolTip="Records from January 1st to today"/>
                </ComboBox>

                <Button Style="{StaticResource SecondaryButton}" Padding="14,8"
                        Command="{Binding FilterChangedCommand}">
                    <fa:ImageAwesome Icon="Filter" Width="14" Height="14"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Transaction Table -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}">
            <DockPanel>
                <!-- Table Header -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgInputBrush}" CornerRadius="10"
                        Padding="16,10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Lang.Time}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Lang.FinType}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Lang.FinCategory}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Lang.FinAmount}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Lang.FinPayment}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="5" Text="{Binding Lang.FinDescription}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Transactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EventRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="{Binding FinIncome, Source={x:Static helpers:LanguageManager.Instance}}"/>
                                                    <Setter Property="Foreground" Value="#2ED47A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TypeLabel}" Value="Expense">
                                                            <Setter Property="Text" Value="{Binding FinExpense, Source={x:Static helpers:LanguageManager.Instance}}"/>
                                                            <Setter Property="Foreground" Value="#F7685B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Category}"
                                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='{}{0:N0}'}"
                                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PaymentLabel}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Description}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Padding="14,6"
                        Command="{Binding PreviousPageCommand}" Margin="0,0,10,0">
                    <fa:ImageAwesome Icon="ChevronLeft" Width="10" Height="10"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding PaginationText}"/>
                <Button Style="{StaticResource SecondaryButton}" Padding="14,6"
                        Command="{Binding NextPageCommand}" Margin="10,0,0,0">
                    <fa:ImageAwesome Icon="ChevronRight" Width="10" Height="10"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
