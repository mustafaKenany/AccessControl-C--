<Window x:Class="AccessControlPro.WPF.Views.PlayerProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers"
        Title="{Binding PrfPlayerProfile, Source={x:Static helpers:LanguageManager.Instance}}"
        Width="800" Height="660" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}" FontWeight="Bold"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#0D2527" CornerRadius="16" Padding="0"
            BorderBrush="{StaticResource PrimaryLightBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="#44A1A0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,20,24,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="32" Height="32" Cursor="Hand"
                            Click="CloseClick" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                        Width="32" Height="32">
                                    <fa:ImageAwesome Icon="Times" Width="12" Height="12"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#40F7685B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- Photo -->
                            <Border x:Name="PlayerPhotoContainer" Width="44" Height="44" CornerRadius="22"
                                    Background="#1A44A1A0" Margin="0,0,14,0" VerticalAlignment="Center"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="PlayerPhoto" Stretch="UniformToFill"
                                           Source="{Binding PhotoImageSource}" Visibility="Collapsed"/>
                                    <fa:ImageAwesome Icon="UserCircle" Width="22" Height="22" x:Name="DefaultIcon"
                                                     Foreground="{StaticResource PrimaryLightBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PlayerNameText" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CardNoText" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="SubTypeText" FontSize="12"
                                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                        Margin="24,0,24,20">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="tab" Background="Transparent" Padding="{TemplateBinding Padding}"
                                            BorderThickness="0,0,0,2" BorderBrush="Transparent" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tab" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tab" Property="Background" Value="#10FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Overview Tab -->
                <TabItem Header="{Binding PrfOverview, Source={x:Static helpers:LanguageManager.Instance}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock x:Name="PhoneLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PhoneValue" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="StartLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="StartValue" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="EndLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="EndValue" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="HeightLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="HeightValue" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock x:Name="FeeLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="FeeValue" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="PaidLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PaidValue" FontSize="14" Foreground="#2ED47A" Margin="0,0,0,12"/>
                                <TextBlock x:Name="RemLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="RemValue" FontSize="14" Foreground="#F7685B" Margin="0,0,0,12"/>
                                <TextBlock x:Name="WeightLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="WeightValue" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            </StackPanel>
                            <!-- Photo Display -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Border Width="160" Height="180" CornerRadius="8" Background="{StaticResource BgInputBrush}"
                                        Margin="5,0,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="OverviewPhoto" Stretch="UniformToFill"
                                               Source="{Binding PhotoImageSource}" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    x:Name="NoPhotoContainer">
                                            <fa:ImageAwesome Icon="UserCircle" Width="40" Height="40"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center"/>
                                            <TextBlock Text="No Photo" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Freeze History Tab -->
                <TabItem Header="{Binding PrfFreezeHistory, Source={x:Static helpers:LanguageManager.Instance}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                                    Padding="14,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PrfFreezeStart, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PrfFreezeEnd, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RcpDays, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding EnterFreezeReason, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="FreezeList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="14,8"
                                                BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FreezeStart, StringFormat='yyyy-MM-dd'}"
                                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FreezeEnd, StringFormat='yyyy-MM-dd', TargetNullValue='—'}"
                                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FreezeDays}"
                                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Reason}"
                                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoFreezeText" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Transactions Tab -->
                <TabItem Header="{Binding PrfTransactions, Source={x:Static helpers:LanguageManager.Instance}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                                    Padding="14,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FinType, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FinCategory, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FinAmount, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding FinDescription, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="TransactionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="14,8"
                                                BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeLabel}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding TypeColor}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Category}"
                                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='{}{0:N0}'}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Description}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoTransText" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Activity Log Tab -->
                <TabItem Header="{Binding PrfActivityLog, Source={x:Static helpers:LanguageManager.Instance}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                                    Padding="14,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PrfAction, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PrfPerformedBy, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PrfDetails, Source={x:Static helpers:LanguageManager.Instance}}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="AuditList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="14,8"
                                                BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Action}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryLightBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PerformedBy}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DisplayDetails}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoLogsText" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Close Button -->
            <Border Grid.Row="2" Padding="24,8,24,18">
                <Button Click="CloseClick" Cursor="Hand" HorizontalAlignment="Center"
                        Width="160" Height="40">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="10" Padding="20,8">
                                <TextBlock Text="{Binding BtnClose, Source={x:Static helpers:LanguageManager.Instance}}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#5AB5B4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Loading overlay -->
            <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3"
                    Background="#EE0D2527" CornerRadius="16"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Spinner" Width="30" Height="30" Spin="True"
                                     Foreground="{StaticResource PrimaryLightBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
