<Window x:Class="AccessControlPro.WPF.Views.AssignCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Lang.AuthorizeCard}" Width="540" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1A1A2E"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <!-- Dark theme overrides for ComboBox -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#44A1A0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#44A1A0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3A3A50"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#44A1A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Read-only TextBox (auto-filled) -->
        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#1A2A2E"/>
            <Setter Property="Foreground" Value="#78CDD7"/>
        </Style>

        <!-- Dark ComboBox with full ControlTemplate -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="#2A2A3E"
                                                BorderBrush="#3A3A50" BorderThickness="1.5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="#222238" BorderThickness="1.5,0,0,0" BorderBrush="#3A3A50">
                                                    <Path Fill="#78CDD7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#44A1A0"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#44A1A0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="12,8,32,8"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2A2A3E" BorderBrush="#44A1A0"
                                            BorderThickness="1.5" Padding="0,4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled CheckBox for dark theme -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="border" Width="20" Height="20"
                                    Background="#2A2A3E" BorderBrush="#44A1A0"
                                    BorderThickness="2" CornerRadius="4"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="checkMark" Text="&#x2713;"
                                           Foreground="White" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44A1A0"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#78CDD7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title -->
                <RowDefinition Height="Auto"/>  <!-- Card Number (auto-filled) -->
                <RowDefinition Height="Auto"/>  <!-- Door Access -->
                <RowDefinition Height="Auto"/>  <!-- Effective Times -->
                <RowDefinition Height="Auto"/>  <!-- Schedule (Time Group) -->
                <RowDefinition Height="Auto"/>  <!-- Valid Period (auto-filled) -->
                <RowDefinition Height="Auto"/>  <!-- Devices -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="{Binding Lang.AuthorizeCard}"
                       FontSize="20" FontWeight="Bold" Foreground="#FFFFFA"
                       Margin="0,0,0,18"/>

            <!-- Card Number (auto-filled from player, read-only) -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Lang.CardNumber}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <TextBox x:Name="CardNumberTextBox" Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource ReadOnlyTextBox}" Margin="0,0,0,10"
                     Focusable="False" IsTabStop="False"/>

            <!-- Door Access -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Lang.DoorAccess}"
                       Foreground="#9EC5C8" VerticalAlignment="Top" Margin="0,6,0,10" FontSize="13"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                <WrapPanel>
                    <CheckBox x:Name="Door1Check" Content="Door 1" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,20,2"/>
                    <CheckBox x:Name="Door2Check" Content="Door 2"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,20,2"/>
                    <CheckBox x:Name="Door3Check" Content="Door 3"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,20,2"/>
                    <CheckBox x:Name="Door4Check" Content="Door 4"
                              Style="{StaticResource DarkCheckBox}" Margin="0,2,0,2"/>
                </WrapPanel>
            </StackPanel>

            <!-- Effective Times — hidden in Multi Device mode -->
            <TextBlock x:Name="EffectiveTimesLabel" Grid.Row="3" Grid.Column="0" Text="{Binding Lang.EffectiveTimes}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <ComboBox x:Name="EffectiveTimesCombo" Grid.Row="3" Grid.Column="1"
                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"/>

            <!-- Schedule (Time Group) -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Lang.TgScheduleLabel}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <ComboBox x:Name="TimeGroupCombo" Grid.Row="4" Grid.Column="1"
                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,10"/>

            <!-- Valid Period (auto-filled from player subscription, read-only display) -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Lang.ValidUntil}"
                       Foreground="#9EC5C8" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="ValidFromText" Width="150"
                         Style="{StaticResource ReadOnlyTextBox}"
                         Focusable="False" IsTabStop="False"/>
                <TextBlock Text="&#x2192;" Foreground="#78CDD7" VerticalAlignment="Center"
                           Margin="10,0,10,0" FontSize="14"/>
                <TextBox x:Name="ValidToText" Width="150"
                         Style="{StaticResource ReadOnlyTextBox}"
                         Focusable="False" IsTabStop="False"/>
            </StackPanel>

            <!-- Devices to upload to -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Lang.SelectDevices}"
                       Foreground="#9EC5C8" VerticalAlignment="Top" Margin="0,6,0,10" FontSize="13"/>
            <Border Grid.Row="6" Grid.Column="1" Background="#0E2A2D"
                    BorderBrush="#3A3A50" BorderThickness="1.5" CornerRadius="8"
                    Margin="0,0,0,10" Padding="12,8" MinHeight="40">
                <StackPanel x:Name="DevicesPanel">
                    <TextBlock x:Name="NoDevicesText" Text="{Binding Lang.NoDevicesAvailable}"
                               Foreground="#5A8A8D" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <!-- Cancel -->
                <Button Width="150" Height="44" Margin="0,0,14,0"
                        Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#2A2A3E" CornerRadius="10"
                                    BorderBrush="#444" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333350"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding Lang.Cancel}" Foreground="#B0B0CC"
                               FontSize="15" FontWeight="Bold"/>
                </Button>

                <!-- Submit -->
                <Button Width="150" Height="44"
                        Click="OkButton_Click" IsDefault="True" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#44A1A0" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#247B7B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding Lang.Submit}" Foreground="White"
                               FontSize="15" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
