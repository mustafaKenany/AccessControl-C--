<Window x:Class="AccessControlPro.WPF.Views.SendDiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#1A1A2E" CornerRadius="14" BorderBrush="#2A2A3E" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top accent bar -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="#44A1A0"/>

            <!-- Header -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,22,28,0">
                <fa:ImageAwesome Icon="CloudUpload" Width="26" Height="26" Foreground="#78CDD7"
                                 VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Send Diagnostics to Support"
                           FontSize="17" FontWeight="Bold" Foreground="#FFFFFA"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- Body + Note -->
            <StackPanel Grid.Row="2" Margin="28,18,28,0">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap"
                           Foreground="#B0CFD0" FontSize="12.5" LineHeight="20"
                           Margin="0,0,0,14"
                           Text="This will upload your recent log files and a small system snapshot to support so we can investigate any issues. No passwords are included."/>

                <TextBlock x:Name="NoteLabel" Text="What happened? (optional)"
                           FontSize="12" Foreground="#9EC5C8" Margin="0,0,0,6"/>

                <Border Background="#143436" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                    <TextBox x:Name="NoteBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E0E0E0" FontSize="13"
                             FontFamily="{StaticResource CairoFont}" FontWeight="Normal"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="90"
                             CaretBrush="#E0E0E0"/>
                </Border>

                <TextBlock x:Name="HintText" TextWrapping="Wrap"
                           Foreground="#7080A0" FontSize="11"
                           Margin="2,0,0,0"
                           Text="Examples: 'card 0366549 not registering', 'app freezes when opening Events', 'sync stopped working yesterday'"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,22,0,24">
                <Button Width="140" Height="40" Margin="0,0,14,0"
                        Click="CancelButton_Click" Cursor="Hand" IsCancel="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#2A2A3E" CornerRadius="10"
                                    BorderBrush="#444" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333350"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="CancelButtonText" Text="Cancel" FontSize="14"
                               FontWeight="Bold" Foreground="#B0B0CC"/>
                </Button>

                <Button Width="160" Height="40"
                        Click="SendButton_Click" IsDefault="True" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#44A1A0" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#247B7B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="SendButtonText" Text="Send Now" FontSize="14"
                               FontWeight="Bold" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
