<Window x:Class="AccessControlPro.WPF.Views.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Real-Time Monitor"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E14"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#247B7B" Offset="0"/>
                            <GradientStop Color="#44A1A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <fa:ImageAwesome Icon="Eye" Width="20" Height="20" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Lang.MonitorTitle}" FontSize="24" FontWeight="Bold"
                           Foreground="#E0E6ED" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Margin="0,0,8,0" Command="{Binding StartMonitoringCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Play" Width="12" Height="12" Foreground="White"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.StartMonitor}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding StopMonitoringCommand}"
                        IsEnabled="{Binding IsMonitoring}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Stop" Width="12" Height="12"
                                         Foreground="#F7685B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.StopMonitor}" VerticalAlignment="Center"
                                   Foreground="#F7685B"/>
                    </StackPanel>
                </Button>

                <!-- Projector Display Toggle -->
                <Button Command="{Binding ToggleDisplayCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background" Value="#1A4FC3F7"/>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Television" Width="12" Height="12"
                                         Foreground="#4FC3F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#4FC3F7">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Lang.DispOpenDisplay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisplayOpen}" Value="True">
                                            <Setter Property="Text" Value="{Binding Lang.DispCloseDisplay}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Exit Button -->
                <Button Margin="8,0,0,0" Click="ExitClick" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background" Value="#1AF7685B"/>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="SignOut" Width="12" Height="12"
                                         Foreground="#F7685B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.BtnClose}" VerticalAlignment="Center"
                                   Foreground="#F7685B"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Stats Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <!-- Status -->
            <Border CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A1E28"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                <Setter Property="Background" Value="#1A2ED47A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="#2ED47A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#8899A6" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Connected Devices -->
            <Border Background="#1A1E28" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Server" Width="12" Height="12"
                                     Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="13" Foreground="#8899A6" VerticalAlignment="Center">
                        <Run Text="{Binding ConnectedDevices, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.NavDevices, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Today Events -->
            <Border Background="#1A1E28" CornerRadius="10" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Bolt" Width="12" Height="12"
                                     Foreground="#FFB946" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="13" Foreground="#8899A6" VerticalAlignment="Center">
                        <Run Text="{Binding TodayEventCount, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Lang.TodayEvents, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Table Header -->
        <Border Grid.Row="2" Background="#141820" CornerRadius="12,12,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Lang.LogTimestamp}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding Lang.Device}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="{Binding Lang.Door}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="{Binding Lang.Card}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="{Binding Lang.Player}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="{Binding Lang.EventType}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
                <TextBlock Grid.Column="6" Text="{Binding Lang.LogDetails}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
                <TextBlock Grid.Column="7" Text="{Binding Lang.Direction}" FontSize="13" Foreground="#556677" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Live Events List -->
        <Border Grid.Row="3" Background="#10131A" CornerRadius="0,0,12,12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LiveEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="Transparent" Padding="20,12"
                                        BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                   FontSize="15" Foreground="#8899A6" VerticalAlignment="Center" FontWeight="Bold"/>

                                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="14"
                                                   Foreground="#667788" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2" Text="{Binding DoorName}" FontSize="14"
                                                   Foreground="#78CDD7" VerticalAlignment="Center" FontWeight="Bold"/>

                                        <TextBlock Grid.Column="3" Text="{Binding CardNumber}" FontSize="14"
                                                   Foreground="#E0E6ED" VerticalAlignment="Center" FontWeight="Bold"/>

                                        <TextBlock Grid.Column="4" Text="{Binding PlayerName}" FontSize="14"
                                                   Foreground="#AABBCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Event Type Badge -->
                                        <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="6" Padding="10,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#20247B7B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Card">
                                                            <Setter Property="Background" Value="#202ED47A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Button">
                                                            <Setter Property="Background" Value="#204FC3F7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Alarm">
                                                            <Setter Property="Background" Value="#20F7685B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="System">
                                                            <Setter Property="Background" Value="#20FFB946"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EventType}" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#44A1A0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EventType}" Value="Card">
                                                                <Setter Property="Foreground" Value="#2ED47A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="Button">
                                                                <Setter Property="Foreground" Value="#4FC3F7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="Alarm">
                                                                <Setter Property="Foreground" Value="#F7685B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="System">
                                                                <Setter Property="Foreground" Value="#FFB946"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="6" Text="{Binding EventDescription}" FontSize="14"
                                                   Foreground="#8899A6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Direction Badge -->
                                        <Border Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="6" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Entry">
                                                            <Setter Property="Background" Value="#152ED47A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Exit">
                                                            <Setter Property="Background" Value="#15F7685B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Direction}" FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#556677"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Direction}" Value="Entry">
                                                                <Setter Property="Foreground" Value="#2ED47A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Direction}" Value="Exit">
                                                                <Setter Property="Foreground" Value="#F7685B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsMonitoring, Converter={StaticResource InverseBoolToVisibility}}">
                    <fa:ImageAwesome Icon="Eye" Width="48" Height="48" Foreground="#1A2030" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding Lang.MonitorReady}" FontSize="16"
                               Foreground="#334455" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
