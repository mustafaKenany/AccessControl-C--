<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Version is read at runtime by UpdateCheckService and compared against
         the VPS manifest. Bump this with EVERY release before running
         publish-release.ps1 — otherwise the update prompt loops forever. -->
    <Version>4.6.5</Version>
    <AssemblyVersion>4.6.5.0</AssemblyVersion>
    <FileVersion>4.6.5.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Exclude legacy/native DLLs from R2R (crossgen2 can't process them) -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRunExclude Include="FontAwesome.WPF.dll" />
    <PublishReadyToRunExclude Include="FCardCDrive.dll" />
    <PublishReadyToRunExclude Include="CareaIfc.dll" />
    <PublishReadyToRunExclude Include="CtrlEx.dll" />
    <PublishReadyToRunExclude Include="DataTool.dll" />
    <PublishReadyToRunExclude Include="DoorCtrller.dll" />
    <PublishReadyToRunExclude Include="MyCPlusPlus.dll" />
    <PublishReadyToRunExclude Include="cmproxy.dll" />
    <PublishReadyToRunExclude Include="dbproxy.dll" />
    <PublishReadyToRunExclude Include="egcproxy.dll" />
    <PublishReadyToRunExclude Include="netproxy.dll" />
    <PublishReadyToRunExclude Include="regex2.dll" />
    <PublishReadyToRunExclude Include="util.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessControlPro.Application\AccessControlPro.Application.csproj" />
    <ProjectReference Include="..\AccessControlPro.Infrastructure\AccessControlPro.Infrastructure.csproj" />
    <ProjectReference Include="..\AccessControlPro.Domain\AccessControlPro.Domain.csproj" />
    <ProjectReference Include="..\AccessControlPro.SDK\AccessControlPro.SDK.csproj" />
    <!-- Updater.exe ships next to AccessControlPro.WPF.exe so the auto-update flow
         can hand off the file-swap to a separate process. We build it but don't
         link its assembly (it's launched via Process.Start, not loaded). -->
    <ProjectReference Include="..\..\tools\Updater\Updater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- For Debug builds: copy framework-dependent Updater.exe + sidecars next to the
       WPF binary so the auto-update flow can be tested in dev (with .NET 8 installed
       on the dev machine). -->
  <Target Name="CopyUpdaterToDebugOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <UpdaterFiles Include="..\..\tools\Updater\bin\Debug\net8.0-windows\Updater.exe" />
      <UpdaterFiles Include="..\..\tools\Updater\bin\Debug\net8.0-windows\Updater.dll" />
      <UpdaterFiles Include="..\..\tools\Updater\bin\Debug\net8.0-windows\Updater.deps.json" />
      <UpdaterFiles Include="..\..\tools\Updater\bin\Debug\net8.0-windows\Updater.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!-- For Release publish: explicitly publish the Updater as self-contained single-file
       so it runs on customer PCs without .NET 8 installed system-wide, then copy the
       resulting Updater.exe (single ~15 MB file) into the WPF publish folder. -->
  <Target Name="PublishUpdaterForRelease" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\..\tools\Updater\Updater.csproj&quot; -c Release -o &quot;$(MSBuildProjectDirectory)\..\..\tools\Updater\bin\publish&quot;" />
    <ItemGroup>
      <UpdaterPublished Include="..\..\tools\Updater\bin\publish\Updater.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterPublished)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FontAwesome.WPF" Version="4.7.0.9" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.ar.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\Cairo-Regular.ttf" />
    <Resource Include="Resources\Fonts\Cairo-Bold.ttf" />
    <Resource Include="Resources\Fonts\Cairo-SemiBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SubscriptionPlans.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
