<UserControl x:Class="AccessControlPro.WPF.Controls.CoachMarkOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Visibility="Collapsed" Panel.ZIndex="999">
    <Grid>
        <!-- Dimmed backdrop with a spotlight hole around the current target -->
        <Path x:Name="MaskPath" Fill="#C0000000"/>

        <Canvas x:Name="Layer">
            <!-- Highlight ring around the target -->
            <Border x:Name="Ring" CornerRadius="14" BorderBrush="#FFD24A" BorderThickness="3"
                    Background="Transparent" IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#FFD24A" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
            </Border>

            <!-- Instruction card -->
            <Border x:Name="Card" Width="320" CornerRadius="16" Background="#12312F" BorderBrush="#44A1A0"
                    BorderThickness="1.5" Padding="20,18">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#3344A1A0" Margin="0,0,12,0">
                            <fa:ImageAwesome x:Name="StepIcon" Icon="HandPointerOutline" Width="20" Height="20"
                                             Foreground="#FFD24A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="StepTitle" Text="" FontSize="17" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Width="230"/>
                    </StackPanel>
                    <TextBlock x:Name="StepBody" Text="" FontSize="14" Foreground="#D0FFFFFF" TextWrapping="Wrap"
                               Margin="0,0,0,16"/>
                    <Grid>
                        <TextBlock x:Name="StepCounter" Text="" FontSize="12" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SkipButton" Click="Skip_Click" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="8" Padding="12,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="SkipText" Text="تخطّي" FontSize="13" FontWeight="Bold" Foreground="#A0FFFFFF"/>
                            </Button>
                            <Button x:Name="NextButton" Click="Next_Click" Cursor="Hand" Background="#44A1A0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="nb" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="nb" Property="Background" Value="#56B3B2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NextText" Text="التالي" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
