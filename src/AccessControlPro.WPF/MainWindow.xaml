<Window x:Class="AccessControlPro.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:views="clr-namespace:AccessControlPro.WPF.Views"
        xmlns:vm="clr-namespace:AccessControlPro.WPF.ViewModels"
        Title="{Binding Lang.AppTitle}"
        Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}"
        MouseLeftButtonDown="MainWindow_OnMouseLeftButtonDown">

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ Sidebar ═══════════ -->
            <Border Grid.Column="0" CornerRadius="12,0,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0A2124" Offset="0"/>
                        <GradientStop Color="#081B1D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <DockPanel>
                    <!-- ── Logo Area ── -->
                    <Border DockPanel.Dock="Top" Padding="24,28,24,20">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#247B7B" Offset="0"/>
                                        <GradientStop Color="#44A1A0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <fa:ImageAwesome Icon="Shield" Width="26" Height="26" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Lang.AppTitle}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"
                                       TextAlignment="Center"/>
                            <!-- Clicking the version opens SuperAdmin settings (password-gated) — a
                                 discreet entry for the provider to enable POS / online on an offline machine. -->
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryLightBrush}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"
                                       TextAlignment="Center" Opacity="0.85"
                                       Cursor="Hand" MouseLeftButtonUp="VersionClick"
                                       ToolTip="SuperAdmin"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <fa:ImageAwesome Icon="UserCircle" Width="12" Height="12"
                                                 Foreground="{StaticResource PrimaryLightBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CurrentUserDisplayName}"
                                           FontSize="12" Foreground="{StaticResource PrimaryLightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Background="#15FFFFFF" Margin="20,0"/>

                    <!-- ── Bottom Section: Language + Window Controls ── -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,16">
                        <Border Height="1" Background="#15FFFFFF" Margin="8,0,8,12"/>

                        <!-- Data Migration -->
                        <Button Style="{StaticResource SidebarButton}"
                                Click="MigrationClick">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Database" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Lang.MigDataMigration}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Change Password -->
                        <Button Style="{StaticResource SidebarButton}"
                                Click="ChangePasswordClick">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Key" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Lang.CpwChangePassword}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Send Diagnostics to Support -->
                        <Button Style="{StaticResource SidebarButton}"
                                Click="SendDiagnosticsClick"
                                Visibility="{Binding CanSendDiagnostics, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="CloudUpload" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Lang.DiagSendDiagnostics}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Language Toggle -->
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding ToggleLanguageCommand}"
                                Visibility="{Binding CanChangeLanguage, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Globe" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Lang.LanguageButtonText}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Width="36" Height="36" Cursor="Hand" Click="MinimizeClick"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                                Width="36" Height="36">
                                            <fa:ImageAwesome Icon="WindowMinimize" Width="12" Height="12"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="36" Height="36" Cursor="Hand" Click="MaximizeClick"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                                Width="36" Height="36">
                                            <fa:ImageAwesome Icon="WindowMaximize" Width="12" Height="12"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="36" Height="36" Cursor="Hand" Click="CloseClick"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                                Width="36" Height="36">
                                            <fa:ImageAwesome Icon="Times" Width="12" Height="12"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#40F7685B"/>
                                                <Setter TargetName="bg" Property="Tag" Value="danger"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Pinned quick-access: the two most-used screens (Monitor + Players), always
                         visible + prominent ABOVE the scroll so a gym owner never has to hunt/scroll
                         for them. Monitor used to sit at the very bottom of the scroll where owners
                         (especially new ones) kept losing it. ── -->
                    <StackPanel Margin="8,14,8,0">
                        <!-- المراقبة المباشرة -->
                        <Button Command="{Binding OpenMonitorCommand}" Cursor="Hand" Margin="0,0,0,8"
                                Visibility="{Binding CanViewMonitor, Converter={StaticResource BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="mb" CornerRadius="12" Padding="16,13" Background="#3344A1A0"
                                            BorderBrush="#7044A1A0" BorderThickness="1.5">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="Eye" Width="18" Height="18" Foreground="White"
                                                             VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Text="{Binding Lang.NavMonitor}" FontSize="15" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="mb" Property="Background" Value="#5544A1A0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- اللاعبين -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="Employees" Cursor="Hand"
                                Visibility="{Binding CanViewPlayers, Converter={StaticResource BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="pb" CornerRadius="12" Padding="16,13" Background="#3344A1A0"
                                            BorderBrush="#7044A1A0" BorderThickness="1.5">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="Users" Width="18" Height="18" Foreground="White"
                                                             VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Text="{Binding Lang.NavPlayers}" FontSize="15" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="pb" Property="Background" Value="#5544A1A0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Height="1" Background="#18FFFFFF" Margin="4,14,4,2"/>
                    </StackPanel>

                    <!-- ── Navigation Menu ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Visible" Margin="8,4,8,0">
                        <StackPanel>
                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Tachometer" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavDashboard}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Devices"
                                    Visibility="{Binding CanViewDevices, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Server" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavDevices}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Doors"
                                    Visibility="{Binding CanViewDoors, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Lock" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavDoors}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Events"
                                    Visibility="{Binding CanViewEvents, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="ClockOutline" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavEvents}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="#10FFFFFF" Margin="12,8"/>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Finance"
                                    Visibility="{Binding CanViewFinance, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Money" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavFinance}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="CashFlow"
                                    Visibility="{Binding CanViewCashFlow, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Exchange" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavCashFlow}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="#10FFFFFF" Margin="12,8"/>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Logs"
                                    Visibility="{Binding CanViewLogs, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="FileTextOutline" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavLogs}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="DeletedRecords"
                                    Visibility="{Binding CanViewDeletedRecords, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="TrashOutline" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavDeletedRecords}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Visitor passes are now CLOUD-ONLY (issued from the owner portal),
                                 so the local QR/visitor screen is hidden. Daily Pass (paid, same-day)
                                 stays available from the Dashboard / Players screens. -->
                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="QrPass"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Qrcode" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.QrNavTitle}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Reminders"
                                    Visibility="{Binding CanViewReminders, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Whatsapp" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavReminders}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══════════ Main Content Area ═══════════ -->
            <DockPanel Grid.Column="1">

                <!-- Device Notification Bar -->
                <Border DockPanel.Dock="Top"
                        Visibility="{Binding ShowDeviceNotification, Converter={StaticResource BoolToVisibility}}"
                        Margin="12,10,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1AFFB946"/>
                            <Setter Property="BorderBrush" Value="#FFB946"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Message -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceNotificationMessage}"
                                       Foreground="#FFB946" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding DeviceNotificationDetail}"
                                       Foreground="#8899A6" FontSize="11"/>
                        </StackPanel>

                        <!-- Sync Button -->
                        <Button Grid.Column="1" Command="{Binding SyncDeviceCommand}"
                                Cursor="Hand" Margin="10,0,0,0"
                                Background="#FFB946" Padding="15,6" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="#FFB946" CornerRadius="6"
                                                        Padding="15,6" Cursor="Hand">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#FFCB5C"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Refresh" Width="12" Height="12" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Lang.BtnSync, FallbackValue='Sync Now'}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Operation Progress Bar (shown during sync) -->
                <Border DockPanel.Dock="Top"
                        Visibility="{Binding IsDeviceOperationRunning, Converter={StaticResource BoolToVisibility}}"
                        Background="#0E2E30" CornerRadius="8" Padding="12,8" Margin="12,8,12,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Spinner" Width="14" Height="14" Foreground="#44A1A0"
                                         Margin="0,0,10,0" Spin="True"/>
                        <TextBlock Text="{Binding DeviceOperationProgress}" Foreground="#E0E6ED" FontSize="13"/>
                    </StackPanel>
                </Border>

            <ContentControl Content="{Binding CurrentView}" Margin="0">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
                        <views:DevicesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DoorsViewModel}">
                        <views:DoorsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
                        <views:EmployeesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                        <views:LogsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DeletedRecordsViewModel}">
                        <views:DeletedRecordsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:EventsViewModel}">
                        <views:EventsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
                        <views:FinanceView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CashFlowViewModel}">
                        <views:CashFlowView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:QrPassViewModel}">
                        <views:QrPassView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:RemindersViewModel}">
                        <views:RemindersView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>
