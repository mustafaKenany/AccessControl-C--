<Window x:Class="AccessControlPro.POS.PosMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:wpfViews="clr-namespace:AccessControlPro.WPF.Views;assembly=AccessControlPro.WPF"
        xmlns:wpfVm="clr-namespace:AccessControlPro.WPF.ViewModels;assembly=AccessControlPro.WPF"
        Title="Access Control Pro - POS Terminal"
        Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}"
        MouseLeftButtonDown="MainWindow_OnMouseLeftButtonDown">

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Padding="20,12" Background="#0A2124" CornerRadius="12,12,0,0">
                <DockPanel>
                    <!-- Left: Logo + Title -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2E7D32" Offset="0"/>
                                    <GradientStop Color="#4CAF50" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <fa:ImageAwesome Icon="ShoppingCart" Width="18" Height="18" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POS Terminal" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Lang.AppTitle}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,-2,0,0"/>
                        </StackPanel>
                        <Border Width="1" Height="28" Background="#20FFFFFF" Margin="16,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:ImageAwesome Icon="UserCircle" Width="14" Height="14"
                                             Foreground="{StaticResource PrimaryLightBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="13" Foreground="{StaticResource PrimaryLightBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Language + Window Controls -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Change Password -->
                        <Button Style="{StaticResource SidebarButton}" Padding="12,6"
                                Click="ChangePasswordClick" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Key" Width="14" Height="14"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Lang.CpwChangePassword}"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" Padding="12,6"
                                Command="{Binding ToggleLanguageCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Globe" Width="14" Height="14"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Lang.LanguageButtonText}"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Width="36" Height="36" Cursor="Hand" Click="MinimizeClick"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                            Width="36" Height="36">
                                        <fa:ImageAwesome Icon="WindowMinimize" Width="12" Height="12"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="36" Cursor="Hand" Click="MaximizeClick"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                            Width="36" Height="36">
                                        <fa:ImageAwesome Icon="WindowMaximize" Width="12" Height="12"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="36" Cursor="Hand" Click="CloseClick"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                            Width="36" Height="36">
                                        <fa:ImageAwesome Icon="Times" Width="12" Height="12"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#40F7685B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- POS Content - Reuse PosView from WPF project -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type wpfVm:PosViewModel}">
                        <wpfViews:PosView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Border>
</Window>
