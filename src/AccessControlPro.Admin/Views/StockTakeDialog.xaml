<Window x:Class="AccessControlPro.Admin.Views.StockTakeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
        Title="Stock Take"
        Width="760" Height="600" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LanguageManager.Instance}}"
        FontFamily="{StaticResource CairoFont}" FontWeight="Bold">
    <Border Background="#0B1F22" CornerRadius="16" Padding="24" BorderBrush="#2A3441" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0"
                       FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="HintText" Grid.Row="1" FontSize="13"
                       Foreground="#9BB0B3" Margin="2,0,0,10"/>

            <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                      RowBackground="#0E2A2D" AlternatingRowBackground="#112F32" Foreground="#FFFFFF"
                      BorderBrush="#2A3441" BorderThickness="1" CanUserAddRows="False"
                      FontWeight="Normal" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn x:Name="ColCategory" Binding="{Binding Category}" IsReadOnly="True" Width="140"/>
                    <DataGridTextColumn x:Name="ColSystem" Binding="{Binding SystemStock}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn x:Name="ColCounted" Binding="{Binding CountedStock, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn x:Name="ColVariance" Binding="{Binding Variance}" IsReadOnly="True" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="OkBtn" Padding="28,10" Click="OkClick" Margin="0,0,12,0" Cursor="Hand"
                        Background="#2A9D8F" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                <Button x:Name="CancelBtn" Padding="28,10" Click="CancelClick" Cursor="Hand"
                        Background="#223038" Foreground="#CFE0E2" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
