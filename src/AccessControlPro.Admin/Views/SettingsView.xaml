<UserControl x:Class="AccessControlPro.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="{StaticResource BgDarkBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Lang.NavSettings}" FontSize="24"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="System configuration and preferences" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                <!-- Company Info -->
                <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <fa:ImageAwesome Icon="Building" Width="18" Height="18"
                                             Foreground="{StaticResource PrimaryLightBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Company Information" FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Logo -->
                        <TextBlock Text="{Binding Lang.SetBrowseLogo}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="60" Height="60" CornerRadius="10" Background="#15FFFFFF"
                                    Margin="0,0,12,0">
                                <Image Source="{Binding LogoPath}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="{Binding Lang.SetBrowseLogo}"
                                        Command="{Binding BrowseLogoCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="16,6"
                                        FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LogoPath}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding Lang.SetCompanyName}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding Lang.SetGymName}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding GymName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding Lang.SetOwner}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding Lang.Phone}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Address" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                        <!-- Save Button -->
                        <Button Content="{Binding Lang.UsrSave}"
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="28,10"
                                HorizontalAlignment="Left" FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
