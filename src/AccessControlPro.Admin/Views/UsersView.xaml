<UserControl x:Class="AccessControlPro.Admin.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>

        <!-- Row hover style -->
        <Style x:Key="HoverDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A44A1A0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2244A1A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon Action Button -->
        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Lang.NavUsers}" FontSize="24"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Lang.UsrSubtitle}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding StartAddUserCommand}">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="UserPlus" Width="14" Height="14"
                                     Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.UsrAddUser}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Stats Bar -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <!-- Total Users -->
            <Border Background="#0E2A2D" CornerRadius="10" Padding="16,12" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="#1544A1A0" CornerRadius="8"
                            Width="40" Height="40" Margin="0,0,12,0">
                        <fa:ImageAwesome Icon="Users" Width="18" Height="18"
                                         Foreground="{StaticResource PrimaryLightBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalUsers}" FontSize="22"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Lang.UsrTotalUsers}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active Users -->
            <Border Background="#0E2A2D" CornerRadius="10" Padding="16,12" Margin="6,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="#152ED47A" CornerRadius="8"
                            Width="40" Height="40" Margin="0,0,12,0">
                        <fa:ImageAwesome Icon="CheckCircle" Width="18" Height="18"
                                         Foreground="{StaticResource SuccessBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveUsers}" FontSize="22"
                                   Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Lang.UsrActiveUsers}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Inactive Users -->
            <Border Background="#0E2A2D" CornerRadius="10" Padding="16,12" Margin="6,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="#15F7685B" CornerRadius="8"
                            Width="40" Height="40" Margin="0,0,12,0">
                        <fa:ImageAwesome Icon="Ban" Width="18" Height="18"
                                         Foreground="{StaticResource DangerBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding InactiveUsers}" FontSize="22"
                                   Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Lang.UsrInactiveUsers}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- Search Box -->
        <Border Grid.Row="2" Background="#0E2A2D" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
            <DockPanel>
                <fa:ImageAwesome DockPanel.Dock="Left" Icon="Search" Width="14" Height="14"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}"
                         FontSize="13"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Content: Users Table + Edit Panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Users Table -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,8,0">
                <Grid>
                    <!-- Loading -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <fa:ImageAwesome Icon="Spinner" Width="24" Height="24"
                                         Foreground="{StaticResource PrimaryLightBrush}"
                                         SpinDuration="1" Spin="True" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang.UsrLoading}" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding UsersView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="#0E2A2D"
                              AlternatingRowBackground="#112F32"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#0AFFFFFF"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              FontFamily="{StaticResource CairoFont}"
                              FontSize="13"
                              FontWeight="Bold"
                              RowStyle="{StaticResource HoverDataGridRow}"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#143436"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Lang.UsrID, Source={StaticResource Proxy}}" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.UsrUsername, Source={StaticResource Proxy}}" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.UsrDisplayName, Source={StaticResource Proxy}}" Binding="{Binding DisplayName}" Width="*"/>

                            <!-- Role Badge Column -->
                            <DataGridTemplateColumn Header="{Binding Data.Lang.UsrRole, Source={StaticResource Proxy}}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#25808080"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Background" Value="#2544A1A0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#999"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge Column -->
                            <DataGridTemplateColumn Header="{Binding Data.Lang.UsrStatus, Source={StaticResource Proxy}}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,5" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#302ED47A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#30F7685B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding DataContext.Lang.UsrActive, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="{Binding DataContext.Lang.UsrDisabled, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column: Edit, Toggle Active, Delete -->
                            <DataGridTemplateColumn Header="{Binding Data.Lang.UsrActions, Source={StaticResource Proxy}}" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- Edit Button -->
                                            <Button Style="{StaticResource IconActionButton}"
                                                    ToolTip="{Binding Data.Lang.UsrEditUser, Source={StaticResource Proxy}}"
                                                    Command="{Binding Data.StartEditUserCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,4,0">
                                                <fa:ImageAwesome Icon="Pencil" Width="13" Height="13"
                                                                 Foreground="{StaticResource AccentBrush}"/>
                                            </Button>

                                            <!-- Toggle Active/Deactivate Button -->
                                            <Button Style="{StaticResource IconActionButton}"
                                                    Command="{Binding Data.ToggleUserActiveCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,4,0">
                                                <Button.ToolTip>
                                                    <MultiBinding StringFormat="{}{0}">
                                                        <Binding Path="IsActive"/>
                                                    </MultiBinding>
                                                </Button.ToolTip>
                                                <fa:ImageAwesome Width="13" Height="13">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Icon" Value="Ban"/>
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Icon" Value="CheckCircle"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Style="{StaticResource IconActionButton}"
                                                    Command="{Binding Data.DeleteUserCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}">
                                                <fa:ImageAwesome Icon="Trash" Width="13" Height="13"
                                                                 Foreground="{StaticResource DangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Edit Panel (slides in when editing) -->
            <Border Grid.Column="1" Width="420" Style="{StaticResource DashboardCard}" Margin="8,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Panel Title -->
                        <DockPanel Margin="0,0,0,20">
                            <TextBlock DockPanel.Dock="Left" FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Lang.UsrEditUser}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAddingNew}" Value="True">
                                                <Setter Property="Text" Value="{Binding Lang.UsrAddNewUser}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Command="{Binding CancelEditCommand}"
                                    HorizontalAlignment="Right">
                                <fa:ImageAwesome Icon="Times" Width="14" Height="14"
                                                 Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                        </DockPanel>

                        <!-- Username -->
                        <TextBlock Text="{Binding Lang.UsrUsername}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                                 IsEnabled="{Binding IsAddingNew}"/>

                        <!-- Display Name -->
                        <TextBlock Text="{Binding Lang.UsrDisplayName}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                        <!-- Role -->
                        <TextBlock Text="{Binding Lang.UsrRole}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableRoles}"
                                  SelectedItem="{Binding EditRole}"
                                  Style="{StaticResource DarkComboBox}" Margin="0,0,0,14"/>

                        <!-- Password -->
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Lang.UsrNewPassword}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddingNew}" Value="True">
                                            <Setter Property="Text" Value="{Binding Lang.UsrPassword}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                        <!-- Active Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                    Visibility="{Binding IsAddingNew, Converter={StaticResource InverseBoolToVisibility}}">
                            <CheckBox IsChecked="{Binding EditIsActive}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Lang.UsrAccountActive}" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Permissions Section -->
                        <Border Height="1" Background="#15FFFFFF" Margin="0,4,0,14"/>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Lang.PermPermissions}" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                        Command="{Binding SelectAllPermissionsCommand}" Cursor="Hand">
                                    <TextBlock Text="{Binding Lang.PermSelectAll}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Padding="8,4"
                                        Command="{Binding ClearAllPermissionsCommand}" Cursor="Hand">
                                    <TextBlock Text="{Binding Lang.PermClearAll}" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{Binding Lang.PermAdminNote}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- Permissions Grouped List -->
                        <ItemsControl ItemsSource="{Binding EditPermissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,2,0,2">
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#15FFFFFF" Margin="0,14,0,14"/>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Save / Cancel Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Padding="20,10"
                                    Command="{Binding SaveUserCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Check" Width="12" Height="12"
                                                     Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Lang.UsrSave}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Padding="20,10"
                                    Command="{Binding CancelEditCommand}">
                                <TextBlock Text="{Binding Lang.UsrCancel}" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
