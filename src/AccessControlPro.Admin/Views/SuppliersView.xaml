<UserControl x:Class="AccessControlPro.Admin.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Lang.SupTitle}" FontSize="24"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Lang.SupSubtitle}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Suppliers DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="#0E2A2D"
                          AlternatingRowBackground="#112F32"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#15FFFFFF"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          CanUserResizeRows="False"
                          FontFamily="{StaticResource CairoFont}"
                          FontSize="13"
                          FontWeight="Bold">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#143436"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Lang.SupName, Source={StaticResource Proxy}}"
                                            Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.SupPhone, Source={StaticResource Proxy}}"
                                            Binding="{Binding Phone}" Width="140"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.SupContact, Source={StaticResource Proxy}}"
                                            Binding="{Binding ContactPerson}" Width="*"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.SupAddress, Source={StaticResource Proxy}}"
                                            Binding="{Binding Address}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right: Add/Edit Panel -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="8,0,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <fa:ImageAwesome Icon="PlusCircle" Width="16" Height="16"
                                             Foreground="{StaticResource PrimaryLightBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Lang.SupAddNew}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="{Binding Lang.SupEdit}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Command="{Binding CancelEditCommand}"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <fa:ImageAwesome Icon="Times" Width="14" Height="14"
                                             Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </DockPanel>

                    <!-- Name -->
                    <TextBlock Text="{Binding Lang.SupName}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                    <!-- Phone -->
                    <TextBlock Text="{Binding Lang.SupPhone}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                    <!-- Contact Person -->
                    <TextBlock Text="{Binding Lang.SupContact}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditContactPerson, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                    <!-- Address -->
                    <TextBlock Text="{Binding Lang.SupAddress}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                    <Border Height="1" Background="#15FFFFFF" Margin="0,4,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Padding="20,10"
                                Command="{Binding SaveCommand}" Margin="0,0,10,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Check" Width="12" Height="12"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Lang.UsrSave}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="20,10"
                                Command="{Binding DeleteCommand}" Cursor="Hand"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Trash" Width="12" Height="12"
                                                 Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Lang.CatDelete}" FontSize="13"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
