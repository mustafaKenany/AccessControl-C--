<UserControl x:Class="AccessControlPro.Admin.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="{StaticResource BgDarkBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Lang.BkpTitle}" FontSize="24"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Lang.BkpSubtitle}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" MaxWidth="600" HorizontalAlignment="Left">
            <!-- Backup Section -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="10" Background="#202ED47A" DockPanel.Dock="Left" Margin="0,0,14,0">
                            <fa:ImageAwesome Icon="Download" Width="20" Height="20" Foreground="#2ED47A"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Lang.BkpBackup}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Lang.BkpBackupDesc}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Button Style="{StaticResource PrimaryButton}" Padding="20,12"
                            Command="{Binding BackupCommand}" Cursor="Hand"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Database" Width="14" Height="14"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Lang.BkpCreateBackup}" FontSize="13" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Last Backup Info -->
                    <TextBlock Text="{Binding LastBackupInfo}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding LastBackupInfo, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Restore Section -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="10" Background="#20F7685B" DockPanel.Dock="Left" Margin="0,0,14,0">
                            <fa:ImageAwesome Icon="Upload" Width="20" Height="20" Foreground="#F7685B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Lang.BkpRestore}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Lang.BkpRestoreDesc}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Button Style="{StaticResource SecondaryButton}" Padding="20,12"
                            Command="{Binding RestoreCommand}" Cursor="Hand"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Upload" Width="14" Height="14"
                                             Foreground="#F7685B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Lang.BkpRestoreBackup}" FontSize="13" Foreground="#F7685B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Style="{StaticResource DashboardCard}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Spinner" Width="18" Height="18"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     SpinDuration="1" Spin="True" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
