<UserControl x:Class="AccessControlPro.Admin.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Lang.AuditTitle}" FontSize="24"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Lang.AuditSubtitle}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,12" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,8"
                        Command="{Binding ClearSearchCommand}" Margin="8,0,0,0" Cursor="Hand">
                    <fa:ImageAwesome Icon="Times" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,8"
                        Command="{Binding SearchCommand}" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Search" Width="12" Height="12" Foreground="White"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Lang.SearchPlaceholder}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>

        <!-- Audit Log Table -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}">
            <Grid>
                <!-- Loading -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <fa:ImageAwesome Icon="Spinner" Width="24" Height="24"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     SpinDuration="1" Spin="True" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Logs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="#0E2A2D"
                          AlternatingRowBackground="#112F32"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#15FFFFFF"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          CanUserResizeRows="False"
                          FontFamily="{StaticResource CairoFont}"
                          FontSize="13"
                          FontWeight="Bold"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#143436"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.AuditAction, Source={StaticResource Proxy}}"
                                            Binding="{Binding Action}" Width="140"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.AuditEntity, Source={StaticResource Proxy}}"
                                            Binding="{Binding EntityType}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.AuditDetails, Source={StaticResource Proxy}}"
                                            Binding="{Binding Details}" Width="*"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.AuditUser, Source={StaticResource Proxy}}"
                                            Binding="{Binding PerformedBy}" Width="140"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.AuditTime, Source={StaticResource Proxy}}"
                                            Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="3" Style="{StaticResource DashboardCard}" Margin="0,8,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding Lang.Total, Mode=OneWay}"/>
                    <Run Text=": "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Padding="10,6"
                            Command="{Binding PrevPageCommand}" Cursor="Hand" Margin="0,0,8,0">
                        <fa:ImageAwesome Icon="ChevronLeft" Width="10" Height="10"
                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Style="{StaticResource SecondaryButton}" Padding="10,6"
                            Command="{Binding NextPageCommand}" Cursor="Hand" Margin="8,0,0,0">
                        <fa:ImageAwesome Icon="ChevronRight" Width="10" Height="10"
                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
