<UserControl x:Class="AccessControlPro.Admin.Views.TimeGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
             xmlns:local="clr-namespace:AccessControlPro.Admin.ViewModels"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Lang.TgTitle}" FontSize="24"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Lang.TgSubtitle}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Padding="16,8" HorizontalAlignment="Right" Cursor="Hand"
                    Command="{Binding AddNewTimeGroupCommand}">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="PlusCircle" Width="14" Height="14"
                                     Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.TgAddNew}" FontSize="13"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Content: Grid + Edit Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left: DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,8,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding TimeGroups}"
                              SelectedItem="{Binding SelectedTimeGroup}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="#0E2A2D"
                              AlternatingRowBackground="#112F32"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#15FFFFFF"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              FontFamily="{StaticResource CairoFont}"
                              FontSize="13"
                              FontWeight="Bold">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#143436"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Lang.TgHwIndex, Source={StaticResource Proxy}}"
                                                Binding="{Binding HardwareIndex}" Width="70"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.TgNameEn, Source={StaticResource Proxy}}"
                                                Binding="{Binding NameEn}" Width="*"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.TgNameAr, Source={StaticResource Proxy}}"
                                                Binding="{Binding NameAr}" Width="*"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.TgSchedule, Source={StaticResource Proxy}}"
                                                Binding="{Binding ScheduleSummary}" Width="160"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Data.Lang.TgDefault, Source={StaticResource Proxy}}"
                                                   Foreground="#44A1A0" FontSize="11"
                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <fa:ImageAwesome Icon="Spinner" Width="24" Height="24"
                                         Foreground="{StaticResource PrimaryLightBrush}"
                                         SpinDuration="1" Spin="True" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Edit Panel -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Panel Title -->
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <fa:ImageAwesome Icon="ClockOutline" Width="16" Height="16"
                                                 Foreground="{StaticResource PrimaryLightBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Lang.TgAddNew}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Lang.TgEdit}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Command="{Binding CancelEditCommand}"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <fa:ImageAwesome Icon="Times" Width="14" Height="14"
                                                 Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                        </DockPanel>

                        <!-- Name (EN) -->
                        <TextBlock Text="{Binding Lang.TgNameEn}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditNameEn, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                        <!-- Name (AR) -->
                        <TextBlock Text="{Binding Lang.TgNameAr}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditNameAr, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"
                                 FlowDirection="RightToLeft"/>

                        <!-- Schedule Editor -->
                        <TextBlock Text="{Binding Lang.TgScheduleLabel}" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,10"/>

                        <ItemsControl ItemsSource="{Binding DaySchedules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A1E20" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <!-- Day header: name + toggle -->
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding DayName}" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" DockPanel.Dock="Left"
                                                           Width="80"/>
                                                <CheckBox IsChecked="{Binding IsEnabled}"
                                                          DockPanel.Dock="Left" VerticalAlignment="Center"
                                                          Margin="0,0,8,0">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="CheckBox">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border x:Name="box" Width="16" Height="16"
                                                                                    Background="#2A2A3E" BorderBrush="#44A1A0"
                                                                                    BorderThickness="1.5" CornerRadius="3"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock x:Name="tick" Text="&#x2713;"
                                                                                           Foreground="White" FontSize="10"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           Visibility="Collapsed"/>
                                                                            </Border>
                                                                            <ContentPresenter Margin="6,0,0,0"
                                                                                              VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="box" Property="Background" Value="#44A1A0"/>
                                                                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <TextBlock VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Source={StaticResource Proxy}, Path=Data.Lang.TgActive}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Text" Value="{Binding Source={StaticResource Proxy}, Path=Data.Lang.TgClosed}"/>
                                                                    <Setter Property="Foreground" Value="#F7685B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Add segment button -->
                                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Command="{Binding AddSegmentCommand}"
                                                        Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="+" Foreground="#44A1A0" FontSize="16" FontWeight="Bold"/>
                                                </Button>
                                            </DockPanel>

                                            <!-- Time segments -->
                                            <ItemsControl ItemsSource="{Binding Segments}"
                                                          Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                            <ComboBox ItemsSource="{x:Static local:TimeSegmentItem.Hours}"
                                                                      SelectedItem="{Binding StartHour}"
                                                                      Width="52" FontSize="12"
                                                                      Style="{StaticResource DarkComboBox}"/>
                                                            <TextBlock Text=":" Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="2,0"/>
                                                            <ComboBox ItemsSource="{x:Static local:TimeSegmentItem.Minutes}"
                                                                      SelectedItem="{Binding StartMinute}"
                                                                      Width="52" FontSize="12"
                                                                      Style="{StaticResource DarkComboBox}"/>
                                                            <TextBlock Text=" - " Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="4,0"/>
                                                            <ComboBox ItemsSource="{x:Static local:TimeSegmentItem.Hours}"
                                                                      SelectedItem="{Binding EndHour}"
                                                                      Width="52" FontSize="12"
                                                                      Style="{StaticResource DarkComboBox}"/>
                                                            <TextBlock Text=":" Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="2,0"/>
                                                            <ComboBox ItemsSource="{x:Static local:TimeSegmentItem.Minutes}"
                                                                      SelectedItem="{Binding EndMinute}"
                                                                      Width="52" FontSize="12"
                                                                      Style="{StaticResource DarkComboBox}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#15FFFFFF" Margin="0,10,0,14"/>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Padding="20,10"
                                    Command="{Binding SaveCommand}" Margin="0,0,10,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Check" Width="12" Height="12"
                                                     Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Lang.UsrSave}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Padding="20,10"
                                    Command="{Binding DeleteCommand}" Cursor="Hand"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Trash" Width="12" Height="12"
                                                     Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Lang.CatDelete}" FontSize="13"
                                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Padding="20,10"
                                    Command="{Binding SyncToDeviceCommand}" Cursor="Hand"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Refresh" Width="12" Height="12"
                                                     Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Lang.TgSyncToDevice}" FontSize="13"
                                               Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
