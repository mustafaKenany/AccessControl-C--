<UserControl x:Class="AccessControlPro.Admin.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
             xmlns:h="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>

        <!-- Shared styling for the newer report grids (Sales/Purchases/Movements) -->
        <Style x:Key="RptColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#143436"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RptCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RptGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#0E2A2D"/>
            <Setter Property="AlternatingRowBackground" Value="#112F32"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#15FFFFFF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource RptColHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource RptCell}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Dark date field, matching the rest of the app -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}" Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3A3A50"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Lang.RptTitle}" FontSize="24"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Lang.RptSubtitle}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Padding="16,10"
                        Command="{Binding PrintReportCommand}" Cursor="Hand" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Print" Width="14" Height="14"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Lang.RptPrint}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="16,10"
                        Command="{Binding ExportCsvCommand}" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="FileTextOutline" Width="14" Height="14"
                                         Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Lang.RptExport}" FontSize="13"
                                   Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Report Type Tabs -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Margin="0,0,4,0" CornerRadius="10" Padding="14,10" Cursor="Hand"
                    MouseLeftButtonUp="PlayersTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="0">
                                <Setter Property="Background" Value="#1A44A1A0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Users" Width="14" Height="14" Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptPlayers}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Margin="4,0" CornerRadius="10" Padding="14,10" Cursor="Hand"
                    MouseLeftButtonUp="FinanceTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="1">
                                <Setter Property="Background" Value="#1A2ED47A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="LineChart" Width="14" Height="14" Foreground="#2ED47A"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptFinance}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Margin="4,0,0,0" CornerRadius="10" Padding="14,10" Cursor="Hand"
                    MouseLeftButtonUp="InventoryTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="2">
                                <Setter Property="Background" Value="#1AFFB946"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Archive" Width="14" Height="14" Foreground="#FFB946"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptInventory}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Sales by product -->
            <Border Margin="0,8,4,0" CornerRadius="10" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="SalesTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="3">
                                <Setter Property="Background" Value="#1A2ED47A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="ShoppingCart" Width="14" Height="14" Foreground="#2ED47A"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptSales}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Purchases -->
            <Border Margin="4,8" CornerRadius="10" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="PurchasesTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="4">
                                <Setter Property="Background" Value="#1AF7685B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="ShoppingBasket" Width="14" Height="14" Foreground="#F7685B"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptPurchases}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Stock movements -->
            <Border Margin="4,8,0,0" CornerRadius="10" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="MovementsTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="5">
                                <Setter Property="Background" Value="#1A7E8CE0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Exchange" Width="14" Height="14" Foreground="#7E8CE0"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptMovements}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Supplier report -->
            <Border Margin="0,8,4,0" CornerRadius="10" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="SupplierTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="6">
                                <Setter Property="Background" Value="#1A44A1A0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Truck" Width="14" Height="14" Foreground="{StaticResource PrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptSupplier}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Daily entries -->
            <Border Margin="4,8" CornerRadius="10" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="DailyTab_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#112F32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportType}" Value="7">
                                <Setter Property="Background" Value="#1A2ED47A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Calendar" Width="14" Height="14" Foreground="#2ED47A"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Lang.RptDaily}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Date Filter + Run -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <!-- Supplier picker (only for the Supplier report) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsSupplierReport, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Lang.RptSupplier}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="200" Margin="0,0,16,0"
                              ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplierFilter}"
                              Style="{StaticResource SearchableComboBox}"
                              h:ComboBoxSearch.SearchPath="Name,Phone">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#E0E0E0"
                                           FontFamily="{StaticResource CairoFont}" FontWeight="Bold"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{Binding Lang.RptStartDate}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding DateFrom}" Width="140" Margin="0,0,16,0"
                            Style="{StaticResource DarkDatePicker}"/>
                <TextBlock Text="{Binding Lang.RptEndDate}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding DateTo}" Width="140" Margin="0,0,16,0"
                            Style="{StaticResource DarkDatePicker}"/>
                <Button Style="{StaticResource PrimaryButton}" Padding="16,8"
                        Command="{Binding LoadCommand}" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Play" Width="12" Height="12" Foreground="White"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Lang.RptRun}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="{Binding Lang.RptResults, Mode=OneWay}"/>
                    <Run Text=": "/>
                    <Run Text="{Binding ResultCount, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="3" Style="{StaticResource DashboardCard}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <fa:ImageAwesome Icon="Spinner" Width="24" Height="24"
                                     Foreground="{StaticResource PrimaryLightBrush}"
                                     SpinDuration="1" Spin="True" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Players Results (Tab 0) -->
                <DataGrid ItemsSource="{Binding PlayerResults}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#0E2A2D" AlternatingRowBackground="#112F32"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#15FFFFFF"
                          HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False"
                          FontFamily="{StaticResource CairoFont}" FontSize="13" FontWeight="Bold">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedReportType}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#143436"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Lang.PlayerName, Source={StaticResource Proxy}}"
                                            Binding="{Binding FullNameEn}" Width="*"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.Phone, Source={StaticResource Proxy}}"
                                            Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.Subscription, Source={StaticResource Proxy}}"
                                            Binding="{Binding SubscriptionType}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.RptEndDate, Source={StaticResource Proxy}}"
                                            Binding="{Binding EndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="110"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.Fee, Source={StaticResource Proxy}}"
                                            Binding="{Binding SubscriptionFee, StringFormat='{}{0:N0}'}" Width="90"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.Paid, Source={StaticResource Proxy}}"
                                            Binding="{Binding AmountPaid, StringFormat='{}{0:N0}'}" Width="90"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.Remaining, Source={StaticResource Proxy}}"
                                            Binding="{Binding RemainingBalance, StringFormat='{}{0:N0}'}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Finance Results (Tab 1) -->
                <DataGrid ItemsSource="{Binding FinanceResults}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#0E2A2D" AlternatingRowBackground="#112F32"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#15FFFFFF"
                          HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False"
                          FontFamily="{StaticResource CairoFont}" FontSize="13" FontWeight="Bold">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedReportType}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#143436"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Lang.SmDate, Source={StaticResource Proxy}}"
                                            Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Width="110"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.SmType, Source={StaticResource Proxy}}"
                                            Binding="{Binding TypeLabel}" Width="100"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdCategory, Source={StaticResource Proxy}}"
                                            Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdPrice, Source={StaticResource Proxy}}"
                                            Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="100"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.AuditDetails, Source={StaticResource Proxy}}"
                                            Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Inventory Results (Tab 2) -->
                <DataGrid ItemsSource="{Binding InventoryResults}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#0E2A2D" AlternatingRowBackground="#112F32"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#15FFFFFF"
                          HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False"
                          FontFamily="{StaticResource CairoFont}" FontSize="13" FontWeight="Bold">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedReportType}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#143436"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdName, Source={StaticResource Proxy}}"
                                            Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdNameAr, Source={StaticResource Proxy}}"
                                            Binding="{Binding NameAr}" Width="*"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdBarcode, Source={StaticResource Proxy}}"
                                            Binding="{Binding Barcode}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdPrice, Source={StaticResource Proxy}}"
                                            Binding="{Binding Price, StringFormat='{}{0:N0}'}" Width="100"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdCategory, Source={StaticResource Proxy}}"
                                            Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdStock, Source={StaticResource Proxy}}"
                                            Binding="{Binding Stock}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Sales by product (Tab 3) -->
                <DataGrid ItemsSource="{Binding SalesResults}">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource RptGrid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedReportType}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdName, Source={StaticResource Proxy}}" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='{}{0:N0}'}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdProfit, Source={StaticResource Proxy}}" Binding="{Binding Profit, StringFormat='{}{0:N0}'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Purchases (Tab 4) -->
                <DataGrid ItemsSource="{Binding PurchaseResults}">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource RptGrid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedReportType}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Lang.RptEndDate, Source={StaticResource Proxy}}" Binding="{Binding OrderDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="110"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.NavSuppliers, Source={StaticResource Proxy}}" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}" Width="100"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.Paid, Source={StaticResource Proxy}}" Binding="{Binding AmountPaid, StringFormat='{}{0:N0}'}" Width="100"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.Remaining, Source={StaticResource Proxy}}" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0}'}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Stock movements (Tab 5) -->
                <DataGrid ItemsSource="{Binding MovementResults}">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource RptGrid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedReportType}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Lang.RptEndDate, Source={StaticResource Proxy}}" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdName, Source={StaticResource Proxy}}" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="In/Out" Binding="{Binding Type}" Width="70"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="{Binding Data.Lang.PrdPrice, Source={StaticResource Proxy}}" Binding="{Binding UnitPrice, StringFormat='{}{0:N0}'}" Width="90"/>
                        <DataGridTextColumn Header="Ref" Binding="{Binding Reference}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Supplier report (Tab 6): itemized purchases + balance summary -->
                <Grid Visibility="{Binding IsSupplierReport, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary: purchased-in-range + outstanding balance -->
                    <Border Grid.Row="0" Background="{StaticResource BgInputBrush}" CornerRadius="10"
                            Padding="16,12" Margin="0,0,0,12">
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang.RptPurchasedInRange}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ReportTotal, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryLightBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang.RptOutstanding}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SupplierBalance, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold"
                                           Foreground="#F7685B"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SupplierResults}"
                              Style="{StaticResource RptGrid}" Visibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Lang.PrdName, Source={StaticResource Proxy}}" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="120"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N0}'}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Daily entries (Tab 7): per-entry list + count/revenue summary -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedReportType}" Value="7">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgInputBrush}" CornerRadius="10"
                            Padding="16,12" Margin="0,0,0,12">
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang.RptResults}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ResultCount}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryLightBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang.RptDailyRevenue}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ReportTotal, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold"
                                           Foreground="#2ED47A"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DailyResults}"
                              Style="{StaticResource RptGrid}" Visibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Lang.SmDate, Source={StaticResource Proxy}}" Binding="{Binding When, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.PrdCategory, Source={StaticResource Proxy}}" Binding="{Binding Tier}" Width="160"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.PrdPrice, Source={StaticResource Proxy}}" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="110"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.AuditDetails, Source={StaticResource Proxy}}" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
