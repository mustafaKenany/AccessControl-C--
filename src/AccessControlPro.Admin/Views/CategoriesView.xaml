<UserControl x:Class="AccessControlPro.Admin.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:AccessControlPro.WPF.Helpers;assembly=AccessControlPro.WPF"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Lang.CatTitle}" FontSize="24"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Lang.CatSubtitle}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Category Type Selector + Items List -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Type Selector -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Lang.CatType}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding CategoryTypes}"
                                  SelectedItem="{Binding SelectedCategoryType}"
                                  DisplayMemberPath="Display"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="250" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <!-- Items DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="#0E2A2D"
                              AlternatingRowBackground="#112F32"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#15FFFFFF"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              FontFamily="{StaticResource CairoFont}"
                              FontSize="13"
                              FontWeight="Bold">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#143436"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" Width="50"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.CatNameEn, Source={StaticResource Proxy}}"
                                                Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.CatNameAr, Source={StaticResource Proxy}}"
                                                Binding="{Binding NameAr}" Width="*"/>
                            <DataGridTextColumn Header="{Binding Data.Lang.CatRate, Source={StaticResource Proxy}}"
                                                Binding="{Binding NumericValue, StringFormat={}{0:N0}}" Width="120"
                                                Visibility="{Binding Data.ShowRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <fa:ImageAwesome Icon="Spinner" Width="24" Height="24"
                                         Foreground="{StaticResource PrimaryLightBrush}"
                                         SpinDuration="1" Spin="True" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Add/Edit Panel -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="8,0,0,0">
                <StackPanel>
                    <!-- Panel Title -->
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <fa:ImageAwesome Icon="PlusCircle" Width="16" Height="16"
                                             Foreground="{StaticResource PrimaryLightBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Lang.CatAddNew}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="{Binding Lang.CatEdit}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Command="{Binding CancelEditCommand}"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <fa:ImageAwesome Icon="Times" Width="14" Height="14"
                                             Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </DockPanel>

                    <!-- Name (EN) -->
                    <TextBlock Text="{Binding Lang.CatNameEn}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                    <!-- Name (AR) -->
                    <TextBlock Text="{Binding Lang.CatNameAr}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditNameAr, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                             FlowDirection="RightToLeft"/>

                    <!-- Rate (only for Subscription Plans) -->
                    <StackPanel Visibility="{Binding ShowRate, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,14">
                        <TextBlock Text="{Binding Lang.CatRate}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditRate, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>

                    <Border Height="1" Background="#15FFFFFF" Margin="0,4,0,14"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Padding="20,10"
                                Command="{Binding SaveCommand}" Margin="0,0,10,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Check" Width="12" Height="12"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Lang.UsrSave}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="20,10"
                                Command="{Binding DeleteCommand}" Cursor="Hand"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Trash" Width="12" Height="12"
                                                 Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Lang.CatDelete}" FontSize="13"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
