<Window x:Class="AccessControlPro.Admin.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:views="clr-namespace:AccessControlPro.Admin.Views"
        xmlns:vm="clr-namespace:AccessControlPro.Admin.ViewModels"
        Title="Access Control Pro - Admin Panel"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource CairoFont}"
        FontWeight="Bold"
        FlowDirection="{Binding Lang.FlowDirection}"
        MouseLeftButtonDown="MainWindow_OnMouseLeftButtonDown">

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" CornerRadius="12,0,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0A2124" Offset="0"/>
                        <GradientStop Color="#081B1D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <DockPanel>
                    <!-- Logo -->
                    <Border DockPanel.Dock="Top" Padding="24,24,24,16">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B4513" Offset="0"/>
                                        <GradientStop Color="#D2691E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <fa:ImageAwesome Icon="Cogs" Width="24" Height="24" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Admin Panel" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding Lang.AppTitle}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <fa:ImageAwesome Icon="UserCircle" Width="12" Height="12"
                                                 Foreground="{StaticResource PrimaryLightBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CurrentUserDisplayName}"
                                           FontSize="12" Foreground="{StaticResource PrimaryLightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Background="#15FFFFFF" Margin="20,0"/>

                    <!-- Bottom: Language + Window Controls -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,16">
                        <Border Height="1" Background="#15FFFFFF" Margin="8,0,8,12"/>

                        <!-- Change Password -->
                        <Button Style="{StaticResource SidebarButton}"
                                Click="ChangePasswordClick">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Key" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Lang.CpwChangePassword}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding ToggleLanguageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Globe" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Lang.LanguageButtonText}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Width="36" Height="36" Cursor="Hand" Click="MinimizeClick"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                                Width="36" Height="36">
                                            <fa:ImageAwesome Icon="WindowMinimize" Width="12" Height="12"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="36" Height="36" Cursor="Hand" Click="MaximizeClick"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                                Width="36" Height="36">
                                            <fa:ImageAwesome Icon="WindowMaximize" Width="12" Height="12"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="36" Height="36" Cursor="Hand" Click="CloseClick"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                                Width="36" Height="36">
                                            <fa:ImageAwesome Icon="Times" Width="12" Height="12"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#40F7685B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,16,8,0">
                        <StackPanel>
                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Tachometer" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavDash}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Users">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="UserSecret" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavUsers}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Categories">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="ListAlt" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavCategories}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Products">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Cubes" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavProducts}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Suppliers">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Truck" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavSuppliers}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="PurchaseOrders">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="ShoppingBasket" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavPurchaseOrders}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="TimeGroups">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="ClockOutline" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavTimeGroups}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="QrPool">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Qrcode" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="QR Pool" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="SubscriptionPlans">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="IdCard" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="Subscription Plans" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="#15FFFFFF" Margin="8,8"/>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Alerts">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="ExclamationTriangle" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavAlerts}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Reports">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="FileTextOutline" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavReports}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="AuditLog">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="History" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavAuditLog}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Backup">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Database" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavBackup}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Cog" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Lang.NavSettings}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Main Content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                        <views:UsersView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
                        <views:CategoriesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                        <views:ProductsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
                        <views:SuppliersView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PurchaseOrdersViewModel}">
                        <views:PurchaseOrdersView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
                        <views:AdminDashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
                        <views:AuditLogView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
                        <views:AlertsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                        <views:BackupView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <views:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TimeGroupViewModel}">
                        <views:TimeGroupView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:QrPoolViewModel}">
                        <views:QrPoolView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SubscriptionPlansViewModel}">
                        <views:SubscriptionPlansView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Border>
</Window>
