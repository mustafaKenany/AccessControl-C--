<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Version stays in sync with the WPF main app — they ship in the same ZIP -->
    <Version>4.6.8</Version>
    <AssemblyVersion>4.6.8.0</AssemblyVersion>
    <FileVersion>4.6.8.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRunExclude Include="FontAwesome.WPF.dll" />
    <PublishReadyToRunExclude Include="FCardCDrive.dll" />
    <PublishReadyToRunExclude Include="CareaIfc.dll" />
    <PublishReadyToRunExclude Include="CtrlEx.dll" />
    <PublishReadyToRunExclude Include="DataTool.dll" />
    <PublishReadyToRunExclude Include="DoorCtrller.dll" />
    <PublishReadyToRunExclude Include="MyCPlusPlus.dll" />
    <PublishReadyToRunExclude Include="cmproxy.dll" />
    <PublishReadyToRunExclude Include="dbproxy.dll" />
    <PublishReadyToRunExclude Include="egcproxy.dll" />
    <PublishReadyToRunExclude Include="netproxy.dll" />
    <PublishReadyToRunExclude Include="regex2.dll" />
    <PublishReadyToRunExclude Include="util.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessControlPro.WPF\AccessControlPro.WPF.csproj" />
    <ProjectReference Include="..\AccessControlPro.Application\AccessControlPro.Application.csproj" />
    <ProjectReference Include="..\AccessControlPro.Infrastructure\AccessControlPro.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FontAwesome.WPF" Version="4.7.0.9" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
  </ItemGroup>

  <!-- Link font files so pack URIs in shared styles resolve correctly -->
  <ItemGroup>
    <Resource Include="..\AccessControlPro.WPF\Resources\Fonts\Cairo-Regular.ttf" Link="Resources\Fonts\Cairo-Regular.ttf" />
    <Resource Include="..\AccessControlPro.WPF\Resources\Fonts\Cairo-Bold.ttf" Link="Resources\Fonts\Cairo-Bold.ttf" />
    <Resource Include="..\AccessControlPro.WPF\Resources\Fonts\Cairo-SemiBold.ttf" Link="Resources\Fonts\Cairo-SemiBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Allow duplicate content files during publish (Admin has its own appsettings.json, WPF also has one) -->
  <PropertyGroup>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

</Project>
