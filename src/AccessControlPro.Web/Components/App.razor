<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#44A1A0" />
    <meta name="description" content="HM-GymManagement Cloud Portal" />
    <base href="/" />
    <link rel="manifest" href="manifest.json" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="app.css?v=@(DateTime.UtcNow.Ticks)" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js');
        }

        // Auth helpers — call server endpoints that manage the HttpOnly session cookie.
        // Body is passed through as-is; the endpoint validates credentials server-side.
        window.authPost = async function (url, bodyJson) {
            try {
                const resp = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: bodyJson,
                    credentials: 'same-origin'
                });
                if (!resp.ok) return { success: false, error: 'Network error' };
                return await resp.json();
            } catch (e) {
                return { success: false, error: 'Network error' };
            }
        };
    </script>
</body>

</html>
