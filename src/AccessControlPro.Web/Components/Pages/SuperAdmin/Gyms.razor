@page "/superadmin/gyms"
@layout AccessControlPro.Web.Components.Layout.SuperAdminLayout
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="page-header">
    <h1 style="color: #7E57C2;">Gym Management</h1>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button class="btn-accent btn-sm" style="background: #25D366;" @onclick="ShowRenewalReminders">
            <i class="fab fa-whatsapp"></i> Renewal Reminders
        </button>
        <button class="btn-accent" style="background: #7E57C2;" @onclick="() => _showAddForm = !_showAddForm">
            <i class="fas fa-plus"></i> Add Gym
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="@(_isError ? "error-msg" : "success-msg")">@_message</div>
}

@* Renewal Reminders Panel *@
@if (_showReminders)
{
    <div class="content-card" style="border-color: #25D366; margin-bottom: 1.5rem;">
        <h3 style="color: #25D366; border-bottom-color: rgba(37, 211, 102, 0.3);">
            <i class="fab fa-whatsapp"></i> Renewal Reminders (Expiring within 30 days)
        </h3>
        @if (_expiringGyms.Count == 0)
        {
            <p class="no-data">No gyms expiring in the next 30 days.</p>
        }
        else
        {
            <p style="color: var(--text-secondary); margin-bottom: 1rem;">
                <strong>@_expiringGyms.Count</strong> gym(s) expiring soon.
                <button class="btn-accent btn-sm" style="background: #25D366; margin-left: 0.5rem;" @onclick="RemindAll">
                    <i class="fab fa-whatsapp"></i> Remind All
                </button>
            </p>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Gym</th>
                            <th>Owner</th>
                            <th>Phone</th>
                            <th>Expires</th>
                            <th>Days Left</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gym in _expiringGyms)
                        {
                            var daysLeft = (int)(gym.ExpiresAt - DateTime.UtcNow).TotalDays;
                            <tr>
                                <td><strong>@gym.Name</strong></td>
                                <td>@gym.OwnerName</td>
                                <td>@gym.OwnerPhone</td>
                                <td>@gym.ExpiresAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge @(daysLeft <= 7 ? "badge-expired" : "badge-expiring")">
                                        @daysLeft days
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(gym.OwnerPhone))
                                    {
                                        <a href="@GetReminderWhatsAppUrl(gym)" target="_blank"
                                           class="btn-accent btn-sm" style="background: #25D366; text-decoration: none; color: white;">
                                            <i class="fab fa-whatsapp"></i> Send
                                        </a>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-secondary);">No phone</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Copy-all messages section *@
            @if (_showAllMessages)
            {
                <div style="margin-top: 1rem; padding: 1rem; background: rgba(37, 211, 102, 0.1); border-radius: 8px;">
                    <h4 style="color: #25D366; margin-bottom: 0.5rem;">All Reminder Messages</h4>
                    @foreach (var gym in _expiringGyms.Where(g => !string.IsNullOrEmpty(g.OwnerPhone)))
                    {
                        var daysLeft = (int)(gym.ExpiresAt - DateTime.UtcNow).TotalDays;
                        <div style="margin-bottom: 0.75rem; padding: 0.5rem; background: var(--card-bg); border-radius: 4px;">
                            <div style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">
                                @gym.OwnerPhone
                            </div>
                            <div style="white-space: pre-line;">Hi @gym.OwnerName,
Your gym cloud subscription expires on @gym.ExpiresAt.ToString("yyyy-MM-dd") (@daysLeft days left).
Please contact us to renew.
HMTech Solutions</div>
                            <a href="@GetReminderWhatsAppUrl(gym)" target="_blank"
                               class="btn-accent btn-sm" style="background: #25D366; text-decoration: none; color: white; margin-top: 0.25rem; display: inline-block;">
                                <i class="fab fa-whatsapp"></i> Open WhatsApp
                            </a>
                        </div>
                    }
                </div>
            }
        }
        <div style="margin-top: 1rem;">
            <button class="btn-outline" @onclick="() => { _showReminders = false; _showAllMessages = false; }">Close</button>
        </div>
    </div>
}

@* Delete Confirmation *@
@if (_deleteConfirmGymId > 0)
{
    <div class="content-card" style="border-color: var(--danger); margin-bottom: 1.5rem;">
        <h3 style="color: var(--danger); border-bottom-color: rgba(231, 76, 60, 0.3);">
            <i class="fas fa-exclamation-triangle"></i> Confirm Delete
        </h3>
        <p>Are you sure you want to permanently delete <strong>@_deleteConfirmName</strong>?</p>
        <p style="color: var(--danger);">This will delete ALL data (players, events, finance, everything)!</p>
        <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
            <button class="btn-accent" style="background: var(--danger);" @onclick="DeleteGymAsync" disabled="@_deleting">
                <i class="fas fa-trash"></i> @(_deleting ? "Deleting..." : "Yes, Delete Permanently")
            </button>
            <button class="btn-outline" @onclick="() => _deleteConfirmGymId = 0">Cancel</button>
        </div>
    </div>
}

@* Add / Edit Gym Form *@
@if (_showAddForm || _editGym != null)
{
    <div class="content-card" style="border-color: #7E57C2; margin-bottom: 1.5rem;">
        <h3 style="color: #7E57C2; border-bottom-color: rgba(126, 87, 194, 0.3);">
            @(_editGym != null ? "Edit Gym" : "Add New Gym")
        </h3>
        <div class="form-row">
            <div class="form-group">
                <label>Gym Name</label>
                <input type="text" @bind="_formName" class="form-input" placeholder="Gym Name" />
            </div>
            <div class="form-group">
                <label>Subdomain</label>
                <input type="text" @bind="_formSubdomain" class="form-input" placeholder="e.g. mygym" />
            </div>
            <div class="form-group">
                <label>Owner Name</label>
                <input type="text" @bind="_formOwnerName" class="form-input" placeholder="Owner Name" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Owner Phone</label>
                <input type="tel" @bind="_formOwnerPhone" class="form-input" placeholder="+964..." />
            </div>
            <div class="form-group">
                <label>Owner Email</label>
                <input type="email" @bind="_formOwnerEmail" class="form-input" placeholder="email@example.com" />
            </div>
            <div class="form-group">
                <label>Subscription Price (Monthly)</label>
                <input type="number" @bind="_formPrice" class="form-input" placeholder="0" step="0.01" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Expiry Date</label>
                <input type="date" @bind="_formExpiry" class="form-input" />
            </div>
            <div class="form-group">
                <label>Notes</label>
                <input type="text" @bind="_formNotes" class="form-input" placeholder="Optional notes" />
            </div>
        </div>

        @* QR Pool Settings (Extra Paid Feature) *@
        <div style="margin-top: 0.75rem; padding: 0.75rem; border: 1px solid rgba(126, 87, 194, 0.3); border-radius: 8px; background: rgba(126, 87, 194, 0.05);">
            <h4 style="color: #7E57C2; margin: 0 0 0.75rem 0; font-size: 0.95rem;">
                <i class="fas fa-qrcode"></i> QR Pool (Extra Paid Feature)
            </h4>
            <div class="form-row">
                <div class="form-group">
                    <label>QR Pool</label>
                    <select @bind="_formQrEnabled" class="form-input">
                        <option value="false">Disabled (no extra fee)</option>
                        <option value="true">Enabled (extra fee)</option>
                    </select>
                </div>
                @if (_formQrEnabled == "true")
                {
                    <div class="form-group">
                        <label>QR Pool Size</label>
                        <select @bind="_formQrPoolSize" class="form-input">
                            <option value="3000">3,000 codes</option>
                            <option value="5000">5,000 codes</option>
                            <option value="10000">10,000 codes</option>
                            <option value="15000">15,000 codes</option>
                            <option value="20000">20,000 codes</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>QR Monthly Fee ($)</label>
                        <input type="number" @bind="_formQrMonthlyFee" class="form-input" placeholder="5.00" step="0.01" />
                    </div>
                }
            </div>
            @if (_formQrEnabled == "true")
            {
                <p style="color: var(--text-secondary); font-size: 0.8rem; margin: 0.5rem 0 0 0;">
                    <i class="fas fa-info-circle"></i>
                    QR range will be auto-calculated. Each gym gets a unique non-overlapping range of up to 20,000 codes.
                    Split: 60% local + 40% cloud.
                </p>
            }
        </div>

        <div class="form-actions">
            <button class="btn-accent" style="background: #7E57C2;" @onclick="SaveGym" disabled="@_saving">
                <i class="fas fa-save"></i> @(_saving ? "Saving..." : "Save")
            </button>
            <button class="btn-outline" style="color: #7E57C2; border-color: #7E57C2;" @onclick="CancelForm">Cancel</button>
        </div>
    </div>
}

@* Extend Subscription Modal *@
@if (_extendGymId > 0)
{
    <div class="content-card" style="border-color: #7E57C2; margin-bottom: 1.5rem;">
        <h3 style="color: #7E57C2; border-bottom-color: rgba(126, 87, 194, 0.3);">
            Extend Subscription - @_extendGymName
        </h3>
        <p style="color: var(--text-secondary); margin-bottom: 1rem;">
            Current Expiry: <strong>@_extendCurrentExpiry.ToString("yyyy-MM-dd")</strong>
        </p>
        <div class="filter-buttons" style="margin-bottom: 1rem;">
            <button class="filter-btn" @onclick="() => ExtendBy(1)">+1 Month</button>
            <button class="filter-btn" @onclick="() => ExtendBy(3)">+3 Months</button>
            <button class="filter-btn" @onclick="() => ExtendBy(6)">+6 Months</button>
            <button class="filter-btn" @onclick="() => ExtendBy(12)">+1 Year</button>
        </div>
        <button class="btn-outline" @onclick="() => _extendGymId = 0">Close</button>
    </div>
}

@if (_loading)
{
    <p class="no-data">Loading gyms...</p>
}
else if (_gyms.Count == 0)
{
    <p class="no-data">No gyms registered yet.</p>
}
else
{
    @* Desktop Table *@
    <div class="desktop-only">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Subdomain</th>
                        <th>Owner</th>
                        <th>Phone</th>
                        <th>Expiry</th>
                        <th>Status</th>
                        <th>QR Pool</th>
                        <th>Players</th>
                        <th>Last Sync</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var gym in _gyms)
                    {
                        <tr>
                            <td><strong><a href="/superadmin/gym/@gym.Id" style="color: #7E57C2; text-decoration: none;">@gym.Name</a></strong></td>
                            <td>@gym.Subdomain</td>
                            <td>@gym.OwnerName</td>
                            <td>@gym.OwnerPhone</td>
                            <td>@gym.ExpiresAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @GetStatusBadge(gym.ExpiresAt, gym.IsActive)">
                                    @GetStatusText(gym.ExpiresAt, gym.IsActive)
                                </span>
                            </td>
                            <td>
                                @if (gym.QrPoolEnabled)
                                {
                                    <span style="color: var(--success); font-weight: 600;">
                                        <i class="fas fa-qrcode"></i> @gym.QrPoolSize.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">--</span>
                                }
                            </td>
                            <td>@gym.PlayerCount</td>
                            <td>@(gym.LastSyncAt.HasValue ? gym.LastSyncAt.Value.ToString("MM/dd HH:mm") : "Never")</td>
                            <td>
                                <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                                    <a href="/superadmin/gym/@gym.Id" class="btn-accent btn-sm" style="background: #5C6BC0; text-decoration: none; color: white;">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button class="btn-accent btn-sm" style="background: #7E57C2;" @onclick="() => StartEdit(gym)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-accent btn-sm" style="background: var(--success);" @onclick="() => StartExtend(gym)">
                                        <i class="fas fa-calendar-plus"></i>
                                    </button>
                                    <button class="btn-accent btn-sm" style="background: var(--danger);" @onclick="() => ToggleActive(gym)">
                                        <i class="fas @(gym.IsActive ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                    <button class="btn-accent btn-sm" style="background: #c0392b;" @onclick="() => ConfirmDelete(gym.Id, gym.Name)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    @if (!string.IsNullOrEmpty(gym.OwnerPhone))
                                    {
                                        <a href="@GetWhatsAppUrl(gym)" target="_blank" class="btn-whatsapp btn-sm" style="text-decoration: none;">
                                            <i class="fab fa-whatsapp"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Mobile Cards *@
    <div class="mobile-only">
        <div class="mobile-cards">
            @foreach (var gym in _gyms)
            {
                <div class="mobile-card">
                    <div class="mobile-card-header">
                        <a href="/superadmin/gym/@gym.Id" style="color: #7E57C2; text-decoration: none;">
                            <span class="mobile-card-name">@gym.Name</span>
                        </a>
                        <span class="badge @GetStatusBadge(gym.ExpiresAt, gym.IsActive)">
                            @GetStatusText(gym.ExpiresAt, gym.IsActive)
                        </span>
                    </div>
                    <div class="mobile-card-row">
                        <span class="mobile-card-label">Owner</span>
                        <span class="mobile-card-value">@gym.OwnerName</span>
                    </div>
                    <div class="mobile-card-row">
                        <span class="mobile-card-label">Expires</span>
                        <span class="mobile-card-value">@gym.ExpiresAt.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="mobile-card-row">
                        <span class="mobile-card-label">QR Pool</span>
                        <span class="mobile-card-value">
                            @if (gym.QrPoolEnabled)
                            {
                                <span style="color: var(--success);"><i class="fas fa-qrcode"></i> @gym.QrPoolSize.ToString("N0")</span>
                            }
                            else
                            {
                                <span>--</span>
                            }
                        </span>
                    </div>
                    <div class="mobile-card-row">
                        <span class="mobile-card-label">Players</span>
                        <span class="mobile-card-value">@gym.PlayerCount</span>
                    </div>
                    <div class="mobile-card-row">
                        <span class="mobile-card-label">Last Sync</span>
                        <span class="mobile-card-value">@(gym.LastSyncAt.HasValue ? gym.LastSyncAt.Value.ToString("MM/dd HH:mm") : "Never")</span>
                    </div>
                    <div class="mobile-card-divider"></div>
                    <div class="mobile-card-actions">
                        <a href="/superadmin/gym/@gym.Id" class="btn-accent btn-sm" style="background: #5C6BC0; text-decoration: none; color: white;">
                            <i class="fas fa-eye"></i> View
                        </a>
                        <button class="btn-accent btn-sm" style="background: #7E57C2;" @onclick="() => StartEdit(gym)">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button class="btn-accent btn-sm" style="background: var(--success);" @onclick="() => StartExtend(gym)">
                            <i class="fas fa-calendar-plus"></i> Extend
                        </button>
                        <button class="btn-accent btn-sm" style="background: var(--danger);" @onclick="() => ToggleActive(gym)">
                            <i class="fas @(gym.IsActive ? "fa-ban" : "fa-check")"></i> @(gym.IsActive ? "Deactivate" : "Activate")
                        </button>
                        <button class="btn-accent btn-sm" style="background: #c0392b;" @onclick="() => ConfirmDelete(gym.Id, gym.Name)">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _deleting;
    private bool _showAddForm;
    private string _message = "";
    private bool _isError;
    private List<GymRecord> _gyms = new();

    // Form fields
    private string _formName = "";
    private string _formSubdomain = "";
    private string _formOwnerName = "";
    private string _formOwnerPhone = "";
    private string _formOwnerEmail = "";
    private decimal _formPrice;
    private DateTime _formExpiry = DateTime.UtcNow.AddYears(1);
    private string _formNotes = "";
    private string _formQrEnabled = "false";
    private string _formQrPoolSize = "3000";
    private decimal _formQrMonthlyFee;
    private GymRecord? _editGym;

    // Extend fields
    private int _extendGymId;
    private string _extendGymName = "";
    private DateTime _extendCurrentExpiry;

    // Delete fields
    private int _deleteConfirmGymId;
    private string _deleteConfirmName = "";

    // Reminder fields
    private bool _showReminders;
    private bool _showAllMessages;
    private List<GymRecord> _expiringGyms = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSuperAdmin) { Nav.NavigateTo("/superadmin/login", forceLoad: true); return; }
        await LoadGymsAsync();
    }

    private async Task LoadGymsAsync()
    {
        _loading = true;
        _gyms.Clear();
        try
        {
            using var conn = await GymDb.GetMasterConnectionAsync();
            using var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""Id"", ""Name"", ""Subdomain"", ""ApiKey"", ""IsActive"", ""ExpiresAt"", ""CreatedAt"",
                         ""OwnerName"", ""OwnerPhone"", ""OwnerEmail"", ""SubscriptionPrice"", ""Notes"",
                         ""LastSyncAt"", ""PlayerCount"",
                         ""QrPoolEnabled"", ""QrPoolSize"", ""QrRangeStart"", ""QrMonthlyFee""
                  FROM ""Gyms"" ORDER BY ""CreatedAt"" DESC", conn);
            using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                _gyms.Add(new GymRecord
                {
                    Id = reader.GetInt32(0),
                    Name = reader.IsDBNull(1) ? "" : reader.GetString(1),
                    Subdomain = reader.IsDBNull(2) ? "" : reader.GetString(2),
                    ApiKey = reader.IsDBNull(3) ? "" : reader.GetString(3),
                    IsActive = reader.IsDBNull(4) ? false : reader.GetBoolean(4),
                    ExpiresAt = reader.IsDBNull(5) ? DateTime.MinValue : reader.GetDateTime(5),
                    CreatedAt = reader.IsDBNull(6) ? DateTime.MinValue : reader.GetDateTime(6),
                    OwnerName = reader.IsDBNull(7) ? "" : reader.GetString(7),
                    OwnerPhone = reader.IsDBNull(8) ? "" : reader.GetString(8),
                    OwnerEmail = reader.IsDBNull(9) ? "" : reader.GetString(9),
                    SubscriptionPrice = reader.IsDBNull(10) ? 0 : reader.GetDecimal(10),
                    Notes = reader.IsDBNull(11) ? "" : reader.GetString(11),
                    LastSyncAt = reader.IsDBNull(12) ? null : reader.GetDateTime(12),
                    PlayerCount = reader.IsDBNull(13) ? 0 : reader.GetInt32(13),
                    QrPoolEnabled = reader.IsDBNull(14) ? false : reader.GetBoolean(14),
                    QrPoolSize = reader.IsDBNull(15) ? 0 : reader.GetInt32(15),
                    QrRangeStart = reader.IsDBNull(16) ? 0 : reader.GetInt32(16),
                    QrMonthlyFee = reader.IsDBNull(17) ? 0 : reader.GetDecimal(17)
                });
            }
        }
        catch (Exception ex)
        {
            _message = $"Error loading gyms: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartEdit(GymRecord gym)
    {
        _editGym = gym;
        _formName = gym.Name;
        _formSubdomain = gym.Subdomain;
        _formOwnerName = gym.OwnerName;
        _formOwnerPhone = gym.OwnerPhone;
        _formOwnerEmail = gym.OwnerEmail;
        _formPrice = gym.SubscriptionPrice;
        _formExpiry = gym.ExpiresAt;
        _formNotes = gym.Notes;
        _formQrEnabled = gym.QrPoolEnabled ? "true" : "false";
        _formQrPoolSize = gym.QrPoolSize > 0 ? gym.QrPoolSize.ToString() : "3000";
        _formQrMonthlyFee = gym.QrMonthlyFee;
        _showAddForm = false;
    }

    private void CancelForm()
    {
        _showAddForm = false;
        _editGym = null;
        ResetForm();
    }

    private void ResetForm()
    {
        _formName = "";
        _formSubdomain = "";
        _formOwnerName = "";
        _formOwnerPhone = "";
        _formOwnerEmail = "";
        _formPrice = 0;
        _formExpiry = DateTime.UtcNow.AddYears(1);
        _formNotes = "";
        _formQrEnabled = "false";
        _formQrPoolSize = "3000";
        _formQrMonthlyFee = 0;
    }

    private async Task SaveGym()
    {
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _message = "Gym name is required.";
            _isError = true;
            return;
        }

        _saving = true;
        _message = "";
        try
        {
            using var conn = await GymDb.GetMasterConnectionAsync();

            if (_editGym != null)
            {
                // Update
                var qrEnabled = _formQrEnabled == "true";
                var qrPoolSize = qrEnabled ? int.Parse(_formQrPoolSize) : 0;
                var qrRangeStart = qrEnabled ? 50000001 + (_editGym.Id * 20000) : 0;
                var qrMonthlyFee = qrEnabled ? _formQrMonthlyFee : 0;

                using var cmd = new Npgsql.NpgsqlCommand(
                    @"UPDATE ""Gyms"" SET ""Name"" = @name, ""Subdomain"" = @sub, ""OwnerName"" = @on,
                      ""OwnerPhone"" = @op, ""OwnerEmail"" = @oe, ""SubscriptionPrice"" = @price,
                      ""ExpiresAt"" = @exp, ""Notes"" = @notes,
                      ""QrPoolEnabled"" = @qr, ""QrPoolSize"" = @qrsize, ""QrRangeStart"" = @qrstart, ""QrMonthlyFee"" = @qrfee
                      WHERE ""Id"" = @id", conn);
                cmd.Parameters.AddWithValue("name", _formName);
                cmd.Parameters.AddWithValue("sub", _formSubdomain);
                cmd.Parameters.AddWithValue("on", _formOwnerName);
                cmd.Parameters.AddWithValue("op", _formOwnerPhone);
                cmd.Parameters.AddWithValue("oe", _formOwnerEmail);
                cmd.Parameters.AddWithValue("price", _formPrice);
                cmd.Parameters.AddWithValue("exp", _formExpiry);
                cmd.Parameters.AddWithValue("notes", _formNotes);
                cmd.Parameters.AddWithValue("qr", qrEnabled);
                cmd.Parameters.AddWithValue("qrsize", qrPoolSize);
                cmd.Parameters.AddWithValue("qrstart", qrRangeStart);
                cmd.Parameters.AddWithValue("qrfee", qrMonthlyFee);
                cmd.Parameters.AddWithValue("id", _editGym.Id);
                await cmd.ExecuteNonQueryAsync();
                _message = "Gym updated successfully.";
            }
            else
            {
                // Insert — auto-generate API key and database name
                var apiKey = $"HMT-{_formSubdomain}-{Guid.NewGuid().ToString("N")[..8]}".ToUpper();
                var sanitizedSubdomain = System.Text.RegularExpressions.Regex.Replace(
                    _formSubdomain.Trim().ToLower(), "[^a-z0-9_]", "_");
                var dbName = $"gymcloud_{sanitizedSubdomain}";

                // Create the gym's own database
                try
                {
                    await GymDb.CreateGymDatabaseAsync(dbName);
                }
                catch (Npgsql.PostgresException pgEx) when (pgEx.SqlState == "42P04")
                {
                    // Database already exists — that's fine, continue
                }

                var qrEnabled = _formQrEnabled == "true";
                var qrPoolSize = qrEnabled ? int.Parse(_formQrPoolSize) : 0;
                var qrMonthlyFee = qrEnabled ? _formQrMonthlyFee : 0;

                using var cmd = new Npgsql.NpgsqlCommand(
                    @"INSERT INTO ""Gyms"" (""Name"", ""Subdomain"", ""ApiKey"", ""DatabaseName"", ""OwnerName"", ""OwnerPhone"",
                      ""OwnerEmail"", ""SubscriptionPrice"", ""ExpiresAt"", ""Notes"", ""IsActive"",
                      ""QrPoolEnabled"", ""QrPoolSize"", ""QrRangeStart"", ""QrMonthlyFee"")
                      VALUES (@name, @sub, @key, @dbname, @on, @op, @oe, @price, @exp, @notes, TRUE,
                      @qr, @qrsize, 0, @qrfee)
                      RETURNING ""Id""", conn);
                cmd.Parameters.AddWithValue("name", _formName);
                cmd.Parameters.AddWithValue("sub", _formSubdomain);
                cmd.Parameters.AddWithValue("key", apiKey);
                cmd.Parameters.AddWithValue("dbname", dbName);
                cmd.Parameters.AddWithValue("on", _formOwnerName);
                cmd.Parameters.AddWithValue("op", _formOwnerPhone);
                cmd.Parameters.AddWithValue("oe", _formOwnerEmail);
                cmd.Parameters.AddWithValue("price", _formPrice);
                cmd.Parameters.AddWithValue("exp", _formExpiry);
                cmd.Parameters.AddWithValue("notes", _formNotes);
                cmd.Parameters.AddWithValue("qr", qrEnabled);
                cmd.Parameters.AddWithValue("qrsize", qrPoolSize);
                cmd.Parameters.AddWithValue("qrfee", qrMonthlyFee);
                var newGymId = Convert.ToInt32(await cmd.ExecuteScalarAsync());

                // Set QR range start based on gym ID
                if (qrEnabled)
                {
                    var qrRangeStart = 50000001 + (newGymId * 20000);
                    using var updateQrCmd = new Npgsql.NpgsqlCommand(
                        @"UPDATE ""Gyms"" SET ""QrRangeStart"" = @start WHERE ""Id"" = @id", conn);
                    updateQrCmd.Parameters.AddWithValue("start", qrRangeStart);
                    updateQrCmd.Parameters.AddWithValue("id", newGymId);
                    await updateQrCmd.ExecuteNonQueryAsync();

                    // Generate cloud QR pool in the gym's database
                    await GenerateCloudQrPoolAsync(dbName, qrRangeStart, qrPoolSize);
                }

                _message = $"Gym added. API Key: {apiKey} | Database: {dbName}";
                if (qrEnabled)
                    _message += $" | QR Pool: {qrPoolSize} codes";
            }

            _isError = false;
            _editGym = null;
            _showAddForm = false;
            ResetForm();
            await LoadGymsAsync();
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartExtend(GymRecord gym)
    {
        _extendGymId = gym.Id;
        _extendGymName = gym.Name;
        _extendCurrentExpiry = gym.ExpiresAt;
    }

    private async Task ExtendBy(int months)
    {
        try
        {
            var baseDate = _extendCurrentExpiry > DateTime.UtcNow ? _extendCurrentExpiry : DateTime.UtcNow;
            var newExpiry = baseDate.AddMonths(months);

            using var conn = await GymDb.GetMasterConnectionAsync();
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Gyms"" SET ""ExpiresAt"" = @exp, ""IsActive"" = TRUE WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("exp", newExpiry);
            cmd.Parameters.AddWithValue("id", _extendGymId);
            await cmd.ExecuteNonQueryAsync();

            _message = $"Extended to {newExpiry:yyyy-MM-dd}.";
            _isError = false;
            _extendGymId = 0;
            await LoadGymsAsync();
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _isError = true;
        }
    }

    private async Task ToggleActive(GymRecord gym)
    {
        try
        {
            using var conn = await GymDb.GetMasterConnectionAsync();
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Gyms"" SET ""IsActive"" = @active WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("active", !gym.IsActive);
            cmd.Parameters.AddWithValue("id", gym.Id);
            await cmd.ExecuteNonQueryAsync();

            _message = gym.IsActive ? "Gym deactivated." : "Gym activated.";
            _isError = false;
            await LoadGymsAsync();
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _isError = true;
        }
    }

    // --- Delete Gym ---

    private void ConfirmDelete(int gymId, string name)
    {
        _deleteConfirmGymId = gymId;
        _deleteConfirmName = name;
    }

    private async Task DeleteGymAsync()
    {
        if (_deleteConfirmGymId == 0) return;
        _deleting = true;
        _message = "";
        try
        {
            using var masterConn = await GymDb.GetMasterConnectionAsync();

            // Get database name
            string? dbName = null;
            using (var getCmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""DatabaseName"" FROM ""Gyms"" WHERE ""Id"" = @id", masterConn))
            {
                getCmd.Parameters.AddWithValue("id", _deleteConfirmGymId);
                dbName = (await getCmd.ExecuteScalarAsync())?.ToString();
            }

            // Delete from Gyms table
            using (var delCmd = new Npgsql.NpgsqlCommand(
                @"DELETE FROM ""Gyms"" WHERE ""Id"" = @id", masterConn))
            {
                delCmd.Parameters.AddWithValue("id", _deleteConfirmGymId);
                await delCmd.ExecuteNonQueryAsync();
            }

            // Drop database if it exists and is not the master
            if (!string.IsNullOrEmpty(dbName) && dbName != "gymcloud")
            {
                try
                {
                    // Terminate all connections to the database first
                    using (var termCmd = new Npgsql.NpgsqlCommand(
                        $"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '{dbName}' AND pid <> pg_backend_pid()",
                        masterConn))
                    {
                        await termCmd.ExecuteNonQueryAsync();
                    }

                    using (var dropCmd = new Npgsql.NpgsqlCommand(
                        $@"DROP DATABASE IF EXISTS ""{dbName}""", masterConn))
                    {
                        await dropCmd.ExecuteNonQueryAsync();
                    }
                }
                catch { /* DB might not exist */ }
            }

            _message = $"Gym '{_deleteConfirmName}' deleted successfully.";
            _isError = false;
            _deleteConfirmGymId = 0;
            _deleteConfirmName = "";
            await LoadGymsAsync();
        }
        catch (Exception ex)
        {
            _message = $"Delete failed: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _deleting = false;
        }
    }

    // --- Renewal Reminders ---

    private void ShowRenewalReminders()
    {
        _expiringGyms = _gyms
            .Where(g => g.IsActive && g.ExpiresAt > DateTime.UtcNow && (g.ExpiresAt - DateTime.UtcNow).TotalDays <= 30)
            .OrderBy(g => g.ExpiresAt)
            .ToList();
        _showReminders = true;
        _showAllMessages = false;
    }

    private void RemindAll()
    {
        _showAllMessages = true;
    }

    private string GetReminderWhatsAppUrl(GymRecord gym)
    {
        var phone = gym.OwnerPhone.Replace("+", "").Replace(" ", "").Replace("-", "");
        var daysLeft = (int)(gym.ExpiresAt - DateTime.UtcNow).TotalDays;
        var msg = $"Hi {gym.OwnerName},\nYour gym cloud subscription expires on {gym.ExpiresAt:yyyy-MM-dd} ({daysLeft} days left).\nPlease contact us to renew.\nHMTech Solutions";
        return $"https://wa.me/{phone}?text={Uri.EscapeDataString(msg)}";
    }

    private string GetWhatsAppUrl(GymRecord gym)
    {
        var phone = gym.OwnerPhone.Replace("+", "").Replace(" ", "").Replace("-", "");
        var daysLeft = (gym.ExpiresAt - DateTime.UtcNow).TotalDays;
        var msg = daysLeft > 0
            ? $"Hello {gym.OwnerName}, your gym subscription ({gym.Name}) expires in {(int)daysLeft} days ({gym.ExpiresAt:yyyy-MM-dd}). Please renew to avoid interruption."
            : $"Hello {gym.OwnerName}, your gym subscription ({gym.Name}) has expired on {gym.ExpiresAt:yyyy-MM-dd}. Please renew to restore access.";
        return $"https://wa.me/{phone}?text={Uri.EscapeDataString(msg)}";
    }

    private string GetStatusText(DateTime expires, bool isActive)
    {
        if (!isActive) return "Inactive";
        if (expires <= DateTime.UtcNow) return "Expired";
        if ((expires - DateTime.UtcNow).TotalDays <= 30) return "Expiring";
        return "Active";
    }

    private string GetStatusBadge(DateTime expires, bool isActive)
    {
        if (!isActive) return "badge-expired";
        if (expires <= DateTime.UtcNow) return "badge-expired";
        if ((expires - DateTime.UtcNow).TotalDays <= 30) return "badge-expiring";
        return "badge-active";
    }

    private async Task GenerateCloudQrPoolAsync(string dbName, int qrRangeStart, int qrPoolSize)
    {
        try
        {
            var cloudStart = qrRangeStart + (int)(qrPoolSize * 0.6);
            var cloudCount = qrPoolSize - (int)(qrPoolSize * 0.6);

            using var gymConn = await GymDb.GetGymConnectionAsync(dbName);
            for (int i = 0; i < cloudCount; i++)
            {
                var code = (cloudStart + i).ToString();
                try
                {
                    using var insertCmd = new Npgsql.NpgsqlCommand(
                        @"INSERT INTO ""QrPool"" (""Code"", ""Status"", ""Source"", ""ValidFrom"", ""ValidTo"", ""CreatedAt"")
                          VALUES (@c, 0, 'Cloud', NOW(), NOW() + INTERVAL '1 year', NOW()) ON CONFLICT DO NOTHING", gymConn);
                    insertCmd.Parameters.AddWithValue("c", code);
                    await insertCmd.ExecuteNonQueryAsync();
                }
                catch { /* skip duplicates */ }
            }
        }
        catch { /* gym DB might not be ready */ }
    }

