@page "/superadmin/data-quality"
@layout AccessControlPro.Web.Components.Layout.SuperAdminLayout
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@inject AccessControlPro.Web.Services.SessionState Session
@rendermode InteractiveServer

<div class="page-header">
    <h1 style="color: #7E57C2;">Data Quality</h1>
    <button class="btn-accent btn-sm" style="background: #7E57C2;" @onclick="LoadAsync" disabled="@_loading">
        <i class="fas fa-sync @(_loading ? "fa-spin" : "")"></i> Refresh
    </button>
</div>

<p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1rem;">
    Per-gym data-integrity stats. Counts come from the synced cloud copy of each gym's local DB.
    Run <code>tools/data-integrity/cleanup.bat</code> on the customer's PC to fix dangling/duplicate rows.
    Migrated-player counts clean naturally as renewals happen — no action needed.
</p>

@if (_loading)
{
    <p class="no-data">Scanning gyms...</p>
}
else if (_rows.Count == 0)
{
    <div class="content-card" style="text-align: center; padding: 2.5rem;">
        <i class="fas fa-database" style="font-size: 2.5rem; color: var(--text-secondary); margin-bottom: 0.75rem;"></i>
        <p class="no-data" style="margin: 0;">No gyms with synced data yet.</p>
    </div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card purple">
            <div class="stat-icon" style="background: rgba(126, 87, 194, 0.15); color: #7E57C2;">
                <i class="fas fa-building"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number" style="color: #7E57C2;">@_rows.Count</div>
                <div class="stat-label">Gyms Scanned</div>
            </div>
        </div>
        <div class="stat-card red">
            <div class="stat-icon" style="background: rgba(239, 68, 68, 0.15); color: #DC2626;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number" style="color: #DC2626;">@_rows.Sum(r => r.DanglingCards + r.DuplicateCards + r.OrphanFreezes)</div>
                <div class="stat-label">Total Issues</div>
            </div>
        </div>
        <div class="stat-card orange">
            <div class="stat-icon" style="background: rgba(245, 158, 11, 0.15); color: #D97706;">
                <i class="fas fa-user-clock"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number" style="color: #D97706;">@_rows.Sum(r => r.MigratedPlayers)</div>
                <div class="stat-label">Migrated (Natural)</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon" style="background: rgba(34, 197, 94, 0.15); color: #16A34A;">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number" style="color: #16A34A;">@_rows.Count(r => r.DanglingCards == 0 && r.DuplicateCards == 0 && r.OrphanFreezes == 0)</div>
                <div class="stat-label">Clean Gyms</div>
            </div>
        </div>
    </div>

    <div class="content-card table-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Gym</th>
                        <th>Players</th>
                        <th>Cards</th>
                        <th title="Cards pointing to deleted players">Dangling</th>
                        <th title="Same CardNumber on multiple rows">Duplicate</th>
                        <th title="Freeze rows for deleted players">Orphan Freezes</th>
                        <th title="Players whose name contains 'Migrated' — clean naturally on renewal">Migrated</th>
                        <th title="Plans configured in admin (should be > 0)">Plans</th>
                        <th>Verdict</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td>
                                <strong>@r.GymName</strong>
                                <span style="color: var(--text-secondary); font-size: 0.78rem; display: block;">@r.Subdomain</span>
                            </td>
                            <td>@r.PlayersTotal</td>
                            <td>@r.CardsTotal</td>
                            <td>
                                @if (r.DanglingCards > 0)
                                {
                                    <span class="status-pill expired">@r.DanglingCards</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">0</span>
                                }
                            </td>
                            <td>
                                @if (r.DuplicateCards > 0)
                                {
                                    <span class="status-pill expired">@r.DuplicateCards</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">0</span>
                                }
                            </td>
                            <td>
                                @if (r.OrphanFreezes > 0)
                                {
                                    <span class="status-pill expiring">@r.OrphanFreezes</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">0</span>
                                }
                            </td>
                            <td>
                                @if (r.MigratedPlayers > 0)
                                {
                                    <span style="color: #D97706;">@r.MigratedPlayers</span>
                                    <span style="color: var(--text-secondary); font-size: 0.78rem;"> (@((r.MigratedPlayers * 100 / Math.Max(1, r.PlayersTotal)))%)</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">0</span>
                                }
                            </td>
                            <td>
                                @if (r.PlansConfigured == 0)
                                {
                                    <span class="status-pill expired">0</span>
                                }
                                else
                                {
                                    <span class="status-pill active">@r.PlansConfigured</span>
                                }
                            </td>
                            <td>
                                @{
                                    var issues = r.DanglingCards + r.DuplicateCards + r.OrphanFreezes;
                                }
                                @if (issues == 0 && r.PlansConfigured > 0)
                                {
                                    <span class="status-pill active"><i class="fas fa-check"></i> Clean</span>
                                }
                                else if (issues == 0 && r.PlansConfigured == 0)
                                {
                                    <span class="status-pill expiring">Plans missing</span>
                                }
                                else
                                {
                                    <span class="status-pill expired">@issues issue(s)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="content-card" style="margin-top: 1.5rem;">
        <h3 style="color: var(--text-primary);">Action guide</h3>
        <ul style="line-height: 1.8; color: var(--text-secondary); font-size: 0.9rem;">
            <li><strong>Dangling / Duplicate / Orphan Freezes &gt; 0:</strong> run <code>tools/data-integrity/cleanup.bat</code> on the customer's PC (takes ~1 minute, takes a safety backup first).</li>
            <li><strong>Plans = 0:</strong> the customer never configured subscription plans — renewals default to the literal string "Fitness". Open admin panel → Subscription Plans → add their actual plans with prices.</li>
            <li><strong>Migrated &gt; 0:</strong> no action. Each migrated player gets cleaned the next time the receptionist renews them (renewal forces re-entry of phone/DOB).</li>
        </ul>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="content-card" style="margin-top: 1rem; border-color: var(--danger);">
        <strong style="color: var(--danger);">Error:</strong> @_error
    </div>
}

@code {
    private List<GymQualityRow> _rows = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // Get the list of active gyms from the master DB
            using var master = await GymDb.GetMasterConnectionAsync();
            var gyms = new List<(int id, string name, string subdomain, string dbName)>();
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""Id"", ""Name"", ""Subdomain"", ""DatabaseName""
                  FROM ""Gyms"" WHERE ""IsActive"" = TRUE ORDER BY ""Name""", master))
            using (var r = await cmd.ExecuteReaderAsync())
            {
                while (await r.ReadAsync())
                    gyms.Add((r.GetInt32(0), r.GetString(1), r.GetString(2), r.GetString(3)));
            }
            await master.CloseAsync();

            // Per-gym: open its DB and run the quality counts
            var rows = new List<GymQualityRow>();
            foreach (var g in gyms)
            {
                try
                {
                    using var conn = await GymDb.GetGymConnectionAsync(g.dbName);
                    var row = new GymQualityRow
                    {
                        GymId = g.id, GymName = g.name, Subdomain = g.subdomain
                    };

                    // One round-trip with multiple CTEs / scalar queries
                    using var cmd = new Npgsql.NpgsqlCommand(@"
                        SELECT
                          (SELECT COUNT(*) FROM ""Players"")                                                                        AS players_total,
                          (SELECT COUNT(*) FROM ""Players"" WHERE ""FullNameEn"" LIKE '%Migrated%' OR ""FullNameAr"" LIKE '%مهاجر%') AS players_migrated,
                          (SELECT COUNT(*) FROM ""AccessCards"")                                                                    AS cards_total,
                          (SELECT COUNT(*) FROM ""AccessCards"" c LEFT JOIN ""Players"" p ON c.""EmployeeId"" = p.""Id""
                                                                  WHERE c.""EmployeeId"" <> 0 AND p.""Id"" IS NULL)                  AS cards_dangling,
                          (SELECT COUNT(*) - COUNT(DISTINCT ""CardNumber"") FROM ""AccessCards"" WHERE ""CardNumber"" <> '')          AS cards_duplicate,
                          (SELECT COUNT(*) FROM ""FreezeHistories"" f LEFT JOIN ""Players"" p ON f.""EmployeeId"" = p.""Id""
                                                                       WHERE p.""Id"" IS NULL)                                       AS freezes_orphan,
                          (SELECT COUNT(*) FROM ""SubscriptionPlans"" WHERE ""IsActive"" = TRUE)                                     AS plans_active,
                          (SELECT COUNT(*) FROM ""QrPool"" WHERE ""Status"" = 0 AND ""Source"" = 'Cloud')                            AS qr_cloud_available
                        ", conn);
                    using var r = await cmd.ExecuteReaderAsync();
                    if (await r.ReadAsync())
                    {
                        row.PlayersTotal      = r.GetInt32(0);
                        row.MigratedPlayers   = r.GetInt32(1);
                        row.CardsTotal        = r.GetInt32(2);
                        row.DanglingCards     = r.GetInt32(3);
                        row.DuplicateCards    = r.GetInt32(4);
                        row.OrphanFreezes     = r.GetInt32(5);
                        row.PlansConfigured   = r.GetInt32(6);
                        row.QrCloudAvailable  = r.GetInt32(7);
                    }
                    rows.Add(row);
                }
                catch (Exception ex)
                {
                    rows.Add(new GymQualityRow
                    {
                        GymId = g.id, GymName = g.name, Subdomain = g.subdomain,
                        ErrorMsg = ex.Message
                    });
                }
            }

            _rows = rows;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private class GymQualityRow
    {
        public int GymId { get; set; }
        public string GymName { get; set; } = "";
        public string Subdomain { get; set; } = "";
        public int PlayersTotal { get; set; }
        public int MigratedPlayers { get; set; }
        public int CardsTotal { get; set; }
        public int DanglingCards { get; set; }
        public int DuplicateCards { get; set; }
        public int OrphanFreezes { get; set; }
        public int PlansConfigured { get; set; }
        public int QrCloudAvailable { get; set; }
        public string? ErrorMsg { get; set; }
    }
}
