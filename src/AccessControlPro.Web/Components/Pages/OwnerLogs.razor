@page "/logs"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@rendermode InteractiveServer

@* TODO: Currently checks Session.IsOwner only. When granular cloud permissions are added,
   enforce AppPermission checks per page (e.g., LogsView for this page). *@
@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-list"></i> @L("Audit Logs", "سجلات التدقيق")</h1>
        <span class="last-sync">@L("Total", "الإجمالي"): @_totalCount</span>
    </div>

    <div class="filter-group">
        <button class="filter-btn @(_period == "all" ? "active" : "")" @onclick='() => SetPeriod("all")'
                title="@GetFilterTooltip("all")">
            @L("All", "الكل")
        </button>
        <button class="filter-btn @(_period == "today" ? "active" : "")" @onclick='() => SetPeriod("today")'
                title="@GetFilterTooltip("today")">
            @L("Today", "اليوم")
        </button>
        <button class="filter-btn @(_period == "yesterday" ? "active" : "")" @onclick='() => SetPeriod("yesterday")'
                title="@GetFilterTooltip("yesterday")">
            @L("Yesterday", "أمس")
        </button>
        <button class="filter-btn @(_period == "thisweek" ? "active" : "")" @onclick='() => SetPeriod("thisweek")'
                title="@GetFilterTooltip("thisweek")">
            @L("This Week", "هذا الأسبوع")
        </button>
        <button class="filter-btn @(_period == "lastweek" ? "active" : "")" @onclick='() => SetPeriod("lastweek")'
                title="@GetFilterTooltip("lastweek")">
            @L("Last Week", "الأسبوع الماضي")
        </button>
        <button class="filter-btn @(_period == "thismonth" ? "active" : "")" @onclick='() => SetPeriod("thismonth")'
                title="@GetFilterTooltip("thismonth")">
            @L("This Month", "هذا الشهر")
        </button>
        <button class="filter-btn @(_period == "lastmonth" ? "active" : "")" @onclick='() => SetPeriod("lastmonth")'
                title="@GetFilterTooltip("lastmonth")">
            @L("Last Month", "الشهر الماضي")
        </button>
        <button class="filter-btn @(_period == "last3months" ? "active" : "")" @onclick='() => SetPeriod("last3months")'
                title="@GetFilterTooltip("last3months")">
            @L("Last 3 Months", "آخر 3 أشهر")
        </button>
        <button class="filter-btn @(_period == "last6months" ? "active" : "")" @onclick='() => SetPeriod("last6months")'
                title="@GetFilterTooltip("last6months")">
            @L("Last 6 Months", "آخر 6 أشهر")
        </button>
    </div>

    <div class="filter-bar">
        <input type="text" @bind="_search" @bind:event="oninput" @onkeyup="OnSearch"
               class="form-input" style="max-width: 300px;"
               placeholder="@L("Search...", "بحث...")" />
    </div>

    <div class="content-card">
        @* Desktop table *@
        <div class="desktop-only">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Date/Time", "التاريخ/الوقت")</th>
                            <th>@L("Action", "الإجراء")</th>
                            <th>@L("Entity Type", "نوع الكيان")</th>
                            <th>@L("Entity ID", "معرف الكيان")</th>
                            <th>@L("Details", "التفاصيل")</th>
                            <th>@L("Performed By", "بواسطة")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _logs)
                        {
                            <tr>
                                <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><span class="badge @GetActionBadge(log.Action)">@log.Action</span></td>
                                <td>@log.EntityType</td>
                                <td>@log.EntityId</td>
                                <td>@OneLang(log.Details, log.DetailsAr)</td>
                                <td>@log.PerformedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Mobile cards *@
        <div class="mobile-only">
            <div class="mobile-cards">
                @foreach (var log in _logs)
                {
                    <div class="mobile-card">
                        <div class="mobile-card-header">
                            <span class="mobile-card-name">@log.Timestamp.ToLocalTime().ToString("MM/dd HH:mm")</span>
                            <span class="badge @GetActionBadge(log.Action)">@log.Action</span>
                        </div>
                        <div class="mobile-card-divider"></div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Entity", "الكيان")</span>
                            <span class="mobile-card-value">@log.EntityType #@log.EntityId</span>
                        </div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Details", "التفاصيل")</span>
                            <span class="mobile-card-value" style="max-width: 60%; text-align: right;">@OneLang(log.Details, log.DetailsAr)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(log.PerformedBy))
                        {
                            <div class="mobile-card-row">
                                <span class="mobile-card-label">@L("By", "بواسطة")</span>
                                <span class="mobile-card-value">@log.PerformedBy</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!_logs.Any())
        {
            <p class="no-data">@L("No audit logs found", "لم يتم العثور على سجلات تدقيق")</p>
        }

        @if (_totalCount > 0)
        {
            <div class="pagination">
                <button class="btn-outline btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">
                    <i class="fas fa-chevron-left"></i> @L("Previous", "السابق")
                </button>
                <span class="page-info">
                    @L("Page", "صفحة") @_page / @TotalPages (@_totalCount @L("records", "سجل"))
                </span>
                <button class="btn-outline btn-sm" disabled="@(!_hasMore)" @onclick="NextPage">
                    @L("Next", "التالي") <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    private string _period = "thismonth";
    private string _search = "";
    private List<AuditLogRow> _logs = new();

    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private bool _hasMore => _page * PageSize < _totalCount;
    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling((double)_totalCount / PageSize);

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    // Show details in ONE language. The field is already picked by language; this also strips
    // any legacy "English / Arabic" merged value down to the active-language half.
    private string OneLang(string en, string ar)
    {
        var text = Session.IsArabic && !string.IsNullOrEmpty(ar) ? ar : en;
        return AccessControlPro.Web.Services.DualLanguageText.Single(text, Session.IsArabic);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadLogsAsync();
    }

    private (DateTime start, DateTime end) GetDateRange()
    {
        var now = DateTime.UtcNow;
        var today = now.Date;
        return _period switch
        {
            "today" => (today, now),
            "yesterday" => (today.AddDays(-1), today),
            "thisweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7), now),
            "lastweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7 - 7), today.AddDays(-((int)today.DayOfWeek + 1) % 7)),
            "thismonth" => (new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc), now),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc).AddMonths(-1),
                            new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc)),
            "last3months" => (today.AddMonths(-3), now),
            "last6months" => (today.AddMonths(-6), now),
            "thisyear" => (new DateTime(now.Year, 1, 1, 0, 0, 0, DateTimeKind.Utc), now),
            "all" => (DateTime.MinValue, now),
            _ => (today, now)
        };
    }

    private (DateTime start, DateTime end) GetDateRangeFor(string p)
    {
        var now = DateTime.UtcNow;
        var today = now.Date;
        return p switch
        {
            "today" => (today, now),
            "yesterday" => (today.AddDays(-1), today),
            "thisweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7), now),
            "lastweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7 - 7), today.AddDays(-((int)today.DayOfWeek + 1) % 7)),
            "thismonth" => (new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc), now),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc).AddMonths(-1),
                            new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc)),
            "last3months" => (today.AddMonths(-3), now),
            "last6months" => (today.AddMonths(-6), now),
            "thisyear" => (new DateTime(now.Year, 1, 1, 0, 0, 0, DateTimeKind.Utc), now),
            "all" => (DateTime.MinValue, now),
            _ => (today, now)
        };
    }

    private string GetFilterTooltip(string period)
    {
        var (s, e) = GetDateRangeFor(period);
        var startStr = s == DateTime.MinValue ? "" : s.ToString("yyyy-MM-dd");
        var endStr = L("Now", "الآن");
        if (period == "yesterday" || period == "lastweek" || period == "lastmonth")
            endStr = e.ToString("yyyy-MM-dd");

        return period switch
        {
            "all" => L("Show all records without date filter", "عرض جميع السجلات بدون فلتر تاريخ"),
            "today" => L($"Records from today ({startStr} → {endStr})", $"سجلات اليوم ({startStr} → {endStr})"),
            "yesterday" => L($"Records from yesterday ({startStr} → {endStr})", $"سجلات الأمس ({startStr} → {endStr})"),
            "thisweek" => L($"This week ({startStr} → {endStr})", $"هذا الأسبوع ({startStr} → {endStr})"),
            "lastweek" => L($"Last week ({startStr} → {endStr})", $"الأسبوع الماضي ({startStr} → {endStr})"),
            "thismonth" => L($"This month ({startStr} → {endStr})", $"هذا الشهر ({startStr} → {endStr})"),
            "lastmonth" => L($"Last month ({startStr} → {endStr})", $"الشهر الماضي ({startStr} → {endStr})"),
            "last3months" => L($"Last 3 months ({startStr} → {endStr})", $"آخر 3 أشهر ({startStr} → {endStr})"),
            "last6months" => L($"Last 6 months ({startStr} → {endStr})", $"آخر 6 أشهر ({startStr} → {endStr})"),
            "thisyear" => L($"This year ({startStr} → {endStr})", $"هذا العام ({startStr} → {endStr})"),
            _ => ""
        };
    }

    private async Task SetPeriod(string period)
    {
        _period = period;
        _page = 1;
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        try
        {
            var (from, to) = GetDateRange();
            var isAll = _period == "all";
            var dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            var hasSearch = !string.IsNullOrWhiteSpace(_search);
            var q = hasSearch ? $"%{_search.Trim().ToLower()}%" : "";

            // Date + search are BOTH applied in SQL now, so search spans the whole table
            // (the old client-side filter only searched the current 20-row page) and the
            // count + page come back in one round-trip via COUNT(*) OVER().
            var conds = new List<string>();
            if (!isAll) conds.Add(@"""Timestamp"" >= @from AND ""Timestamp"" < @to");
            if (hasSearch) conds.Add(@"(LOWER(""Action"") LIKE @q OR LOWER(""EntityType"") LIKE @q OR LOWER(COALESCE(""Details"",'')) LIKE @q OR COALESCE(""DetailsAr"",'') LIKE @q OR LOWER(COALESCE(""PerformedBy"",'')) LIKE @q)");
            var where = conds.Count > 0 ? " WHERE " + string.Join(" AND ", conds) : "";

            var sql = $@"SELECT ""Id"", COALESCE(""Action"",''), COALESCE(""EntityType"",''), COALESCE(""EntityId"",0),
                                COALESCE(""Details"",''), COALESCE(""DetailsAr"",''), COALESCE(""PerformedBy"",''), ""Timestamp"",
                                COUNT(*) OVER() AS total_count
                         FROM ""AuditLogs""{where}
                         ORDER BY ""Timestamp"" DESC";

            var (items, total) = await GymDb.PagedQueryAsync(dbName, sql, _page, PageSize,
                p =>
                {
                    if (!isAll) { p.AddWithValue("from", from); p.AddWithValue("to", to); }
                    if (hasSearch) p.AddWithValue("q", q);
                },
                r => new AuditLogRow(r.GetInt32(0), r.GetString(1), r.GetString(2), r.GetInt32(3),
                                     r.GetString(4), r.GetString(5), r.GetString(6), r.GetDateTime(7)));

            _logs = items;
            _totalCount = total;
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerLogs] LoadLogsAsync Error: {ex.Message}"); }
    }

    private async Task OnSearch()
    {
        // Limit search input length to prevent abuse
        if (_search.Length > 100) _search = _search[..100];
        _page = 1;
        await LoadLogsAsync();
    }

    private async Task NextPage()
    {
        if (_hasMore) { _page++; await LoadLogsAsync(); }
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadLogsAsync(); }
    }

    private string GetActionBadge(string action)
    {
        var a = action.ToUpper();
        if (a.Contains("DELETE") || a.Contains("REMOVE")) return "badge-expired";
        if (a.Contains("CREATE") || a.Contains("ADD")) return "badge-active";
        if (a.Contains("FREEZE")) return "badge-frozen";
        return "badge-expiring";
    }

    private record AuditLogRow(int Id, string Action, string EntityType, int EntityId,
        string Details, string DetailsAr, string PerformedBy, DateTime Timestamp);
}
