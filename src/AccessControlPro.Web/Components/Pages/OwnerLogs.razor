@page "/logs"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@rendermode InteractiveServer

@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-list"></i> @L("Audit Logs", "سجلات التدقيق")</h1>
        <span class="last-sync">@L("Total", "الإجمالي"): @_totalCount</span>
    </div>

    <div class="filter-group">
        <button class="filter-btn @(_period == "today" ? "active" : "")" @onclick='() => SetPeriod("today")'>
            @L("Today", "اليوم")
        </button>
        <button class="filter-btn @(_period == "yesterday" ? "active" : "")" @onclick='() => SetPeriod("yesterday")'>
            @L("Yesterday", "أمس")
        </button>
        <button class="filter-btn @(_period == "thisweek" ? "active" : "")" @onclick='() => SetPeriod("thisweek")'>
            @L("This Week", "هذا الأسبوع")
        </button>
        <button class="filter-btn @(_period == "thismonth" ? "active" : "")" @onclick='() => SetPeriod("thismonth")'>
            @L("This Month", "هذا الشهر")
        </button>
        <button class="filter-btn @(_period == "lastmonth" ? "active" : "")" @onclick='() => SetPeriod("lastmonth")'>
            @L("Last Month", "الشهر الماضي")
        </button>
        <button class="filter-btn @(_period == "last3months" ? "active" : "")" @onclick='() => SetPeriod("last3months")'>
            @L("Last 3 Months", "آخر 3 أشهر")
        </button>
        <button class="filter-btn @(_period == "lastyear" ? "active" : "")" @onclick='() => SetPeriod("lastyear")'>
            @L("Last Year", "العام الماضي")
        </button>
        <button class="filter-btn @(_period == "all" ? "active" : "")" @onclick='() => SetPeriod("all")'>
            @L("All", "الكل")
        </button>
    </div>

    <div class="filter-bar">
        <input type="text" @bind="_search" @bind:event="oninput" @onkeyup="OnSearch"
               class="form-input" style="max-width: 300px;"
               placeholder="@L("Search...", "بحث...")" />
    </div>

    <div class="content-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L("Date/Time", "التاريخ/الوقت")</th>
                        <th>@L("Action", "الإجراء")</th>
                        <th>@L("Entity Type", "نوع الكيان")</th>
                        <th>@L("Entity ID", "معرف الكيان")</th>
                        <th>@L("Details", "التفاصيل")</th>
                        <th>@L("Performed By", "بواسطة")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr>
                            <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge @GetActionBadge(log.Action)">@log.Action</span></td>
                            <td>@log.EntityType</td>
                            <td>@log.EntityId</td>
                            <td>@(SessionState.IsArabic && !string.IsNullOrEmpty(log.DetailsAr) ? log.DetailsAr : log.Details)</td>
                            <td>@log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!_logs.Any())
        {
            <p class="no-data">@L("No audit logs found", "لم يتم العثور على سجلات تدقيق")</p>
        }

        @if (_totalCount > 0)
        {
            <div class="pagination">
                <button class="btn-outline btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">
                    <i class="fas fa-chevron-left"></i> @L("Previous", "السابق")
                </button>
                <span class="page-info">
                    @L("Page", "صفحة") @_page / @TotalPages (@_totalCount @L("records", "سجل"))
                </span>
                <button class="btn-outline btn-sm" disabled="@(!_hasMore)" @onclick="NextPage">
                    @L("Next", "التالي") <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    private string _period = "thismonth";
    private string _search = "";
    private List<AuditLogRow> _logs = new();

    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private bool _hasMore => _page * PageSize < _totalCount;
    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling((double)_totalCount / PageSize);

    private string L(string en, string ar) => SessionState.IsArabic ? ar : en;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadLogsAsync();
    }

    private (DateTime start, DateTime end) GetDateRange()
    {
        var now = DateTime.UtcNow;
        var today = now.Date;
        return _period switch
        {
            "today" => (today, now),
            "yesterday" => (today.AddDays(-1), today),
            "thisweek" => (today.AddDays(-(int)today.DayOfWeek), now),
            "thismonth" => (new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc), now),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc).AddMonths(-1),
                            new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc)),
            "last3months" => (today.AddMonths(-3), now),
            "lastyear" => (today.AddYears(-1), now),
            "all" => (DateTime.MinValue, now),
            _ => (today, now)
        };
    }

    private async Task SetPeriod(string period)
    {
        _period = period;
        _page = 1;
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        try
        {
            var (from, to) = GetDateRange();
            var isAll = _period == "all";

            using var conn = await Db.GetConnectionAsync();

            var dateWhere = isAll ? "" : @" WHERE ""Timestamp"" >= @from AND ""Timestamp"" < @to";

            // Count
            using (var countCmd = new Npgsql.NpgsqlCommand(
                $@"SELECT COUNT(*) FROM ""AuditLogs""{dateWhere}", conn))
            {
                if (!isAll)
                {
                    countCmd.Parameters.AddWithValue("from", from);
                    countCmd.Parameters.AddWithValue("to", to);
                }
                _totalCount = Convert.ToInt32(await countCmd.ExecuteScalarAsync());
            }

            // Data
            using (var cmd = new Npgsql.NpgsqlCommand(
                $@"SELECT ""Id"", COALESCE(""Action"",''), COALESCE(""EntityType"",''), COALESCE(""EntityId"",0),
                         COALESCE(""Details"",''), COALESCE(""DetailsAr"",''), COALESCE(""PerformedBy"",''), ""Timestamp""
                  FROM ""AuditLogs""{dateWhere}
                  ORDER BY ""Timestamp"" DESC LIMIT @limit OFFSET @offset", conn))
            {
                if (!isAll)
                {
                    cmd.Parameters.AddWithValue("from", from);
                    cmd.Parameters.AddWithValue("to", to);
                }
                cmd.Parameters.AddWithValue("limit", PageSize);
                cmd.Parameters.AddWithValue("offset", (_page - 1) * PageSize);

                using var r = await cmd.ExecuteReaderAsync();
                _logs = new List<AuditLogRow>();
                while (await r.ReadAsync())
                {
                    _logs.Add(new AuditLogRow(
                        r.GetInt32(0), r.GetString(1), r.GetString(2), r.GetInt32(3),
                        r.GetString(4), r.GetString(5), r.GetString(6), r.GetDateTime(7)));
                }
            }

            // Apply client-side search
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var q = _search.Trim().ToLower();
                _logs = _logs.Where(l =>
                    l.Action.ToLower().Contains(q) ||
                    l.EntityType.ToLower().Contains(q) ||
                    l.Details.ToLower().Contains(q) ||
                    l.DetailsAr.Contains(q) ||
                    l.PerformedBy.ToLower().Contains(q)
                ).ToList();
            }
        }
        catch { }
    }

    private async Task OnSearch()
    {
        _page = 1;
        await LoadLogsAsync();
    }

    private async Task NextPage()
    {
        if (_hasMore) { _page++; await LoadLogsAsync(); }
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadLogsAsync(); }
    }

    private string GetActionBadge(string action)
    {
        var a = action.ToUpper();
        if (a.Contains("DELETE") || a.Contains("REMOVE")) return "badge-expired";
        if (a.Contains("CREATE") || a.Contains("ADD")) return "badge-active";
        if (a.Contains("FREEZE")) return "badge-frozen";
        return "badge-expiring";
    }

    private record AuditLogRow(int Id, string Action, string EntityType, int EntityId,
        string Details, string DetailsAr, string PerformedBy, DateTime Timestamp);
}
