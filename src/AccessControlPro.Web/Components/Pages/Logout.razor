@page "/logout"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card" style="text-align: center;">
        <i class="fas fa-sign-out-alt" style="font-size: 2rem; color: var(--accent); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-secondary);">Logging out...</p>
    </div>
</div>

@code {
    private bool _wasSuperAdmin;

    protected override void OnInitialized()
    {
        _wasSuperAdmin = Session.IsSuperAdmin;
        // Clear session + delete session file
        Session.Logout();
        var sessionFile = System.IO.Path.Combine(AppContext.BaseDirectory, ".active_session");
        try { if (System.IO.File.Exists(sessionFile)) System.IO.File.Delete(sessionFile); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", "document.cookie = 'session=; path=/; max-age=0'");
            await Task.Delay(300);
            var url = _wasSuperAdmin ? "/superadmin/login" : "/login";
            await JS.InvokeVoidAsync("eval", $"window.location.href = '{url}'");
        }
    }
}
