@page "/logout"
@inject AccessControlPro.Web.Services.SessionState Session
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card" style="text-align: center;">
        <i class="fas fa-sign-out-alt" style="font-size: 2rem; color: var(--accent); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-secondary);">Logging out...</p>
    </div>
</div>

@code {
    private bool _wasSuperAdmin;

    protected override void OnInitialized()
    {
        _wasSuperAdmin = Session.IsSuperAdmin;
        // Clear per-circuit session state. The HttpOnly cookie is revoked
        // server-side by the /api/auth/logout call below, so the current
        // session token can't be replayed even if someone copied the cookie.
        Session.Logout();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Call the server to revoke the session row and delete the HttpOnly cookie.
            // We don't need a body; the server reads the cookie off the request.
            try
            {
                await JS.InvokeAsync<object>("authPost", "/api/auth/logout", "{}");
            }
            catch { /* best-effort; nav happens anyway */ }

            var url = _wasSuperAdmin ? "/superadmin/login" : "/login";
            await JS.InvokeVoidAsync("eval", $"window.location.href = '{url}'");
        }
    }
}
