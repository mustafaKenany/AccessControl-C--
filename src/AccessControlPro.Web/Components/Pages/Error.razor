@page "/Error"
@using System.Diagnostics

<PageTitle>Error - HM GymManagement</PageTitle>

<div style="display: flex; justify-content: center; align-items: center; min-height: 60vh; padding: 2rem;">
    <div style="text-align: center; max-width: 500px;">
        <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--accent, #44A1A0);">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h1 style="color: var(--text-primary, #fff); font-size: 1.5rem; margin-bottom: 0.5rem;">Something went wrong</h1>
        <p style="color: var(--text-secondary, #999); margin-bottom: 1.5rem;">
            An unexpected error occurred. Please try again or contact support if the problem persists.
        </p>
        @if (ShowRequestId)
        {
            <p style="color: var(--text-secondary, #999); font-size: 0.8rem; margin-bottom: 1rem;">
                Request ID: <code>@RequestId</code>
            </p>
        }
        <a href="/" style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--accent, #44A1A0); color: #fff; border-radius: 8px; text-decoration: none; font-weight: 600;">
            <i class="fas fa-home"></i> Go Home
        </a>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
