    private async Task ConfirmDeactivateAsync()
    {
        if (string.IsNullOrWhiteSpace(_actionReason) || _actionUser == null) return;

        _errorMsg = "";
        _successMsg = "";

        try
        {
            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Users"" SET ""IsActive"" = FALSE WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("id", _deactivateUserId);
            await cmd.ExecuteNonQueryAsync();

            await LogAuditAsync("DEACTIVATE_USER", _deactivateUserId,
                $"Deactivated user '{_actionUser.Username}'. Reason: {_actionReason}",
                $"تم تعطيل المستخدم '{_actionUser.Username}'. السبب: {_actionReason}");

            _successMsg = L("User deactivated successfully.", "تم تعطيل المستخدم بنجاح.");
            CancelAllActions();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = $"{L("Error deactivating user", "خطأ في تعطيل المستخدم")}: {ex.Message}";
        }
    }

    private async Task ActivateUserAsync(UserRow user)
    {
        _errorMsg = "";
        _successMsg = "";
        CancelAllActions();

        try
        {
            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Users"" SET ""IsActive"" = TRUE WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("id", user.Id);
            await cmd.ExecuteNonQueryAsync();

            await LogAuditAsync("ACTIVATE_USER", user.Id,
                $"Activated user '{user.Username}'",
                $"تم تفعيل المستخدم '{user.Username}'");

            _successMsg = L("User activated successfully.", "تم تفعيل المستخدم بنجاح.");
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = $"{L("Error activating user", "خطأ في تفعيل المستخدم")}: {ex.Message}";
        }
    }

    private void StartDelete(UserRow user)
    {
        CancelAllActions();
        _deleteUserId = user.Id;
        _actionUser = user;
        _actionReason = "";
        _editingUserId = 0;
        _errorMsg = "";
        _successMsg = "";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (string.IsNullOrWhiteSpace(_actionReason) || _actionUser == null) return;

        _errorMsg = "";
        _successMsg = "";

        try
        {
            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());
            using var cmd = new Npgsql.NpgsqlCommand(
                @"DELETE FROM ""Users"" WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("id", _deleteUserId);
            await cmd.ExecuteNonQueryAsync();

            await LogAuditAsync("DELETE_USER", _deleteUserId,
                $"Deleted user '{_actionUser.Username}'. Reason: {_actionReason}",
                $"تم حذف المستخدم '{_actionUser.Username}'. السبب: {_actionReason}");

            _successMsg = L("User deleted successfully.", "تم حذف المستخدم بنجاح.");
            CancelAllActions();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = $"{L("Error deleting user", "خطأ في حذف المستخدم")}: {ex.Message}";
        }
    }

    private void CancelAllActions()
    {
        _resetPasswordUserId = 0;
        _resetPassword = "";
        _deactivateUserId = 0;
        _deleteUserId = 0;
        _actionReason = "";
        _actionUser = null;
    }

    private void ToggleNewPermission(string perm, bool isChecked)
    {
        if (isChecked) _newPermissions.Add(perm);
        else _newPermissions.Remove(perm);
    }

    private void ToggleEditPermission(string perm, bool isChecked)
    {
        if (isChecked) _editPermissions.Add(perm);
        else _editPermissions.Remove(perm);
    }

    private void SelectAllNew(bool select)
    {
        _newPermissions.Clear();
        if (select)
            foreach (var g in _permissionGroups)
                foreach (var p in g.perms)
                    _newPermissions.Add(p.key);
    }

    private void SelectAllEdit(bool select)
    {
        _editPermissions.Clear();
        if (select)
            foreach (var g in _permissionGroups)
                foreach (var p in g.perms)
                    _editPermissions.Add(p.key);
    }

    private string FormatPermissions(string permissions)
    {
        if (string.IsNullOrEmpty(permissions)) return "-";
        var perms = permissions.Split(',', StringSplitOptions.RemoveEmptyEntries);
        var labels = perms.Select(p =>
            _allPermissions.TryGetValue(p, out var val) ? L(val.en, val.ar) : p
        );
        return string.Join(", ", labels);
    }

    private record UserRow(int Id, string Username, string DisplayName, string Role, bool IsActive, string Permissions);
}
