@page "/users"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@rendermode InteractiveServer

@* TODO: Currently checks Session.IsOwner only. When granular cloud permissions are added,
   enforce AppPermission checks per page (e.g., AdminManageUsers for this page). *@
@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-user-shield"></i> @L("User Management", "إدارة المستخدمين")</h1>
    </div>

    <!-- Stats Bar -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
        <div style="background: var(--card-bg, #0d2628); border: 1px solid var(--border, #1a3a3c); border-radius: 10px; padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(68,161,160,0.15); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-users" style="color: var(--accent, #44A1A0); font-size: 1.1rem;"></i>
            </div>
            <div>
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary, #e0e0e0);">@_users.Count</div>
                <div style="font-size: 0.8rem; color: var(--text-secondary, #8a9a9c);">@L("Total Users", "إجمالي المستخدمين")</div>
            </div>
        </div>
        <div style="background: var(--card-bg, #0d2628); border: 1px solid var(--border, #1a3a3c); border-radius: 10px; padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(76,175,80,0.15); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-user-check" style="color: #4CAF50; font-size: 1.1rem;"></i>
            </div>
            <div>
                <div style="font-size: 1.5rem; font-weight: 700; color: #4CAF50;">@_users.Count(u => u.IsActive)</div>
                <div style="font-size: 0.8rem; color: var(--text-secondary, #8a9a9c);">@L("Active", "نشط")</div>
            </div>
        </div>
        <div style="background: var(--card-bg, #0d2628); border: 1px solid var(--border, #1a3a3c); border-radius: 10px; padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(244,67,54,0.15); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-user-slash" style="color: #F44336; font-size: 1.1rem;"></i>
            </div>
            <div>
                <div style="font-size: 1.5rem; font-weight: 700; color: #F44336;">@_users.Count(u => !u.IsActive)</div>
                <div style="font-size: 0.8rem; color: var(--text-secondary, #8a9a9c);">@L("Inactive", "غير نشط")</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_successMsg))
    {
        <div class="success-msg" style="display: flex; align-items: center; gap: 0.5rem; animation: fadeIn 0.3s ease;">
            <i class="fas fa-check-circle"></i> @_successMsg
        </div>
    }
    @if (!string.IsNullOrEmpty(_errorMsg))
    {
        <div class="error-msg" style="display: flex; align-items: center; gap: 0.5rem; animation: fadeIn 0.3s ease;">
            <i class="fas fa-exclamation-circle"></i> @_errorMsg
        </div>
    }

    <!-- Create New User (Collapsible) -->
    <div class="content-card" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; cursor: pointer;" @onclick="() => _showCreateForm = !_showCreateForm">
            <h3 style="margin: 0;"><i class="fas fa-user-plus"></i> @L("Create New User", "إنشاء مستخدم جديد")</h3>
            <button class="btn-outline btn-sm" style="min-width: auto; padding: 0.3rem 0.6rem;">
                <i class="fas @(_showCreateForm ? "fa-chevron-up" : "fa-chevron-down")"></i>
            </button>
        </div>

        @if (_showCreateForm)
        {
            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border, #1a3a3c);">
                <div class="form-row" style="gap: 1rem;">
                    <div class="form-group">
                        <label>@L("Username", "اسم المستخدم")</label>
                        <input type="text" @bind="_newUsername" class="form-input"
                               placeholder="@L("Enter username", "أدخل اسم المستخدم")" />
                    </div>
                    <div class="form-group">
                        <label>@L("Display Name", "الاسم المعروض")</label>
                        <input type="text" @bind="_newDisplayName" class="form-input"
                               placeholder="@L("Enter display name", "أدخل الاسم المعروض")" />
                    </div>
                    <div class="form-group">
                        <label>@L("Password", "كلمة المرور")</label>
                        <input type="password" @bind="_newPassword" class="form-input"
                               placeholder="@L("Enter password (min 6 chars)", "أدخل كلمة المرور (6 أحرف على الأقل)")" />
                    </div>
                    <div class="form-group">
                        <label>@L("Role", "الدور")</label>
                        <select @bind="_newRole" class="form-select">
                            <option value="Admin">@L("Admin", "مدير")</option>
                            <option value="User">@L("User", "مستخدم")</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin-top: 0.75rem;">
                    <label>@L("Permissions", "الصلاحيات")</label>
                    <div style="margin-bottom: 0.5rem;">
                        <button class="filter-btn" style="font-size: 0.75rem;" @onclick="() => SelectAllNew(true)">
                            @L("Select All", "تحديد الكل")
                        </button>
                        <button class="filter-btn" style="font-size: 0.75rem;" @onclick="() => SelectAllNew(false)">
                            @L("Clear All", "مسح الكل")
                        </button>
                    </div>
                    @foreach (var group in _permissionGroups)
                    {
                        <div style="margin-bottom: 0.75rem;">
                            <div style="color: var(--accent); font-weight: 600; font-size: 0.85rem; margin-bottom: 0.3rem; border-bottom: 1px solid var(--border); padding-bottom: 0.2rem;">
                                @L(group.groupEn, group.groupAr)
                            </div>
                            <div class="permissions-grid">
                                @foreach (var perm in group.perms)
                                {
                                    var key = perm.key;
                                    var isChecked = _newPermissions.Contains(key);
                                    <div class="permission-item">
                                        <input type="checkbox" id="new_@key" checked="@isChecked"
                                               @onchange="(e) => ToggleNewPermission(key, (bool)(e.Value ?? false))" />
                                        <label for="new_@key">@L(perm.en, perm.ar)</label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="form-actions" style="margin-top: 1rem;">
                    <button class="btn-accent" @onclick="CreateUserAsync" disabled="@_loading">
                        <i class="fas fa-plus"></i> @L("Create User", "إنشاء مستخدم")
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Search -->
    <div style="margin-bottom: 1rem;">
        <div style="position: relative; max-width: 400px;">
            <i class="fas fa-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-secondary, #8a9a9c); font-size: 0.85rem;"></i>
            <input type="text" @bind="_searchQuery" @bind:event="oninput" class="form-input"
                   style="padding-left: 36px; width: 100%;"
                   placeholder="@L("Search by username or display name...", "البحث بالاسم أو اسم المستخدم...")" />
        </div>
    </div>

    <!-- Existing Users -->
    <div class="content-card">
        <h3 style="margin-bottom: 1rem;"><i class="fas fa-users"></i> @L("Existing Users", "المستخدمون الحاليون") <span style="font-size: 0.85rem; color: var(--text-secondary); font-weight: 400;">(@FilteredUsers.Count())</span></h3>

        @* Desktop table *@
        <div class="desktop-only">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Username", "اسم المستخدم")</th>
                            <th>@L("Display Name", "الاسم المعروض")</th>
                            <th>@L("Role", "الدور")</th>
                            <th>@L("Status", "الحالة")</th>
                            <th>@L("Permissions", "الصلاحيات")</th>
                            <th style="min-width: 280px;">@L("Actions", "الإجراءات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            var isEditing = _editingUserId == user.Id;
                            <tr style="transition: background 0.2s ease;" class="@(user.IsActive ? "" : "inactive-row")">
                                <td>
                                    <span style="font-weight: 500;">@user.Username</span>
                                </td>
                                <td>
                                    @if (isEditing)
                                    {
                                        <input type="text" @bind="_editDisplayName" class="form-input" style="max-width: 200px;" />
                                    }
                                    else
                                    {
                                        @user.DisplayName
                                    }
                                </td>
                                <td>
                                    @if (isEditing)
                                    {
                                        <select @bind="_editRole" class="form-select" style="max-width: 120px;">
                                            <option value="Admin">@L("Admin", "مدير")</option>
                                            <option value="User">@L("User", "مستخدم")</option>
                                            <option value="Owner">@L("Owner", "مالك")</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge" style="@GetRoleBadgeStyle(user.Role)">
                                            @L(user.Role, GetRoleArabic(user.Role))
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (isEditing)
                                    {
                                        <select @bind="_editIsActive" class="form-select" style="max-width: 120px;">
                                            <option value="true">@L("Active", "نشط")</option>
                                            <option value="false">@L("Inactive", "غير نشط")</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge" style="@(user.IsActive ? "background: rgba(76,175,80,0.15); color: #4CAF50; border: 1px solid rgba(76,175,80,0.3);" : "background: rgba(244,67,54,0.15); color: #F44336; border: 1px solid rgba(244,67,54,0.3);")">
                                            @(user.IsActive ? L("Active", "نشط") : L("Inactive", "غير نشط"))
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (isEditing)
                                    {
                                        <div style="margin-bottom: 0.3rem;">
                                            <button class="filter-btn" style="font-size: 0.7rem; padding: 0.15rem 0.4rem;" @onclick="() => SelectAllEdit(true)">
                                                @L("All", "الكل")
                                            </button>
                                            <button class="filter-btn" style="font-size: 0.7rem; padding: 0.15rem 0.4rem;" @onclick="() => SelectAllEdit(false)">
                                                @L("None", "لا شيء")
                                            </button>
                                        </div>
                                        @foreach (var group in _permissionGroups)
                                        {
                                            <div style="margin-bottom: 0.5rem;">
                                                <div style="color: var(--accent); font-weight: 600; font-size: 0.75rem; margin-bottom: 0.15rem;">
                                                    @L(group.groupEn, group.groupAr)
                                                </div>
                                                <div class="permissions-grid" style="font-size: 0.78rem;">
                                                    @foreach (var perm in group.perms)
                                                    {
                                                        var key = perm.key;
                                                        var isChecked = _editPermissions.Contains(key);
                                                        <div class="permission-item">
                                                            <input type="checkbox" id="edit_@key" checked="@isChecked"
                                                                   @onchange="(e) => ToggleEditPermission(key, (bool)(e.Value ?? false))" />
                                                            <label for="edit_@key">@L(perm.en, perm.ar)</label>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(user.Permissions))
                                        {
                                            var permCount = user.Permissions.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
                                            <span style="font-size: 0.8rem; color: var(--text-secondary);" title="@FormatPermissions(user.Permissions)">
                                                @permCount @L("permissions", "صلاحية")
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-secondary); font-size: 0.8rem;">-</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (isEditing)
                                    {
                                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                            <button class="btn-accent btn-sm" @onclick="SaveEditAsync">
                                                <i class="fas fa-check"></i> @L("Save", "حفظ")
                                            </button>
                                            <button class="btn-outline btn-sm" @onclick="CancelEdit">
                                                <i class="fas fa-times"></i> @L("Cancel", "إلغاء")
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                                            <button class="btn-outline btn-sm" @onclick="() => StartEdit(user)" title="@L("Edit", "تعديل")">
                                                <i class="fas fa-edit"></i> @L("Edit", "تعديل")
                                            </button>
                                            <button class="btn-outline btn-sm" @onclick="() => StartResetPassword(user.Id)" title="@L("Reset Password", "إعادة تعيين كلمة المرور")">
                                                <i class="fas fa-key"></i>
                                            </button>
                                            @if (user.Role != "Owner")
                                            {
                                                @if (user.IsActive)
                                                {
                                                    <button class="btn-sm" style="background: rgba(255,152,0,0.15); color: #FF9800; border: 1px solid rgba(255,152,0,0.3); border-radius: 6px; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.8rem; transition: all 0.2s ease;"
                                                            @onclick="() => StartDeactivate(user)" title="@L("Deactivate", "تعطيل")">
                                                        <i class="fas fa-ban"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn-sm" style="background: rgba(76,175,80,0.15); color: #4CAF50; border: 1px solid rgba(76,175,80,0.3); border-radius: 6px; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.8rem; transition: all 0.2s ease;"
                                                            @onclick="() => ActivateUserAsync(user)" title="@L("Activate", "تفعيل")">
                                                        <i class="fas fa-check-circle"></i>
                                                    </button>
                                                }
                                                <button class="btn-sm" style="background: rgba(244,67,54,0.15); color: #F44336; border: 1px solid rgba(244,67,54,0.3); border-radius: 6px; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.8rem; transition: all 0.2s ease;"
                                                        @onclick="() => StartDelete(user)" title="@L("Delete", "حذف")">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>

                            @* Reset password inline row *@
                            @if (_resetPasswordUserId == user.Id)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div style="display: flex; gap: 0.75rem; align-items: flex-end; padding: 0.5rem; background: rgba(68,161,160,0.05); border-radius: 8px;">
                                            <div class="form-group" style="margin-bottom: 0; flex: 1; max-width: 300px;">
                                                <label>@L("New Password", "كلمة المرور الجديدة")</label>
                                                <input type="password" @bind="_resetPassword" class="form-input"
                                                       placeholder="@L("Enter new password", "أدخل كلمة المرور الجديدة")" />
                                            </div>
                                            <button class="btn-accent btn-sm" @onclick="ResetPasswordAsync">
                                                <i class="fas fa-save"></i> @L("Reset", "إعادة تعيين")
                                            </button>
                                            <button class="btn-outline btn-sm" @onclick="CancelAllActions">
                                                <i class="fas fa-times"></i> @L("Cancel", "إلغاء")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @* Deactivate reason inline row *@
                            @if (_deactivateUserId == user.Id)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div style="padding: 0.75rem; background: rgba(255,152,0,0.08); border: 1px solid rgba(255,152,0,0.2); border-radius: 8px;">
                                            <div style="color: #FF9800; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.5rem;">
                                                <i class="fas fa-exclamation-triangle"></i> @L("Deactivate User", "تعطيل المستخدم"): @user.Username
                                            </div>
                                            <div class="form-group" style="margin-bottom: 0.5rem;">
                                                <label>@L("Reason (required)", "السبب (مطلوب)")</label>
                                                <input type="text" @bind="_actionReason" class="form-input"
                                                       placeholder="@L("Enter reason for deactivation...", "أدخل سبب التعطيل...")" />
                                            </div>
                                            <div style="display: flex; gap: 0.5rem;">
                                                <button class="btn-sm" style="background: #FF9800; color: white; border: none; border-radius: 6px; padding: 0.35rem 0.75rem; cursor: pointer; font-size: 0.8rem;"
                                                        @onclick="ConfirmDeactivateAsync" disabled="@(string.IsNullOrWhiteSpace(_actionReason))">
                                                    <i class="fas fa-ban"></i> @L("Confirm Deactivate", "تأكيد التعطيل")
                                                </button>
                                                <button class="btn-outline btn-sm" @onclick="CancelAllActions">
                                                    <i class="fas fa-times"></i> @L("Cancel", "إلغاء")
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @* Delete confirmation inline row *@
                            @if (_deleteUserId == user.Id)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div style="padding: 0.75rem; background: rgba(244,67,54,0.08); border: 1px solid rgba(244,67,54,0.2); border-radius: 8px;">
                                            <div style="color: #F44336; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.5rem;">
                                                <i class="fas fa-exclamation-triangle"></i> @L("Delete User Permanently", "حذف المستخدم نهائيا"): @user.Username
                                            </div>
                                            <div style="color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 0.5rem;">
                                                @L("This action cannot be undone. All user data will be permanently removed.", "لا يمكن التراجع عن هذا الإجراء. سيتم حذف جميع بيانات المستخدم نهائيا.")
                                            </div>
                                            <div class="form-group" style="margin-bottom: 0.5rem;">
                                                <label>@L("Reason (required)", "السبب (مطلوب)")</label>
                                                <input type="text" @bind="_actionReason" class="form-input"
                                                       placeholder="@L("Enter reason for deletion...", "أدخل سبب الحذف...")" />
                                            </div>
                                            <div style="display: flex; gap: 0.5rem;">
                                                <button class="btn-sm" style="background: #F44336; color: white; border: none; border-radius: 6px; padding: 0.35rem 0.75rem; cursor: pointer; font-size: 0.8rem;"
                                                        @onclick="ConfirmDeleteAsync" disabled="@(string.IsNullOrWhiteSpace(_actionReason))">
                                                    <i class="fas fa-trash"></i> @L("Confirm Delete", "تأكيد الحذف")
                                                </button>
                                                <button class="btn-outline btn-sm" @onclick="CancelAllActions">
                                                    <i class="fas fa-times"></i> @L("Cancel", "إلغاء")
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Mobile cards *@
        <div class="mobile-only">
            <div class="mobile-cards">
                @foreach (var user in FilteredUsers)
                {
                    var permCount = string.IsNullOrEmpty(user.Permissions) ? 0 : user.Permissions.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
                    <div class="mobile-card" style="@(user.IsActive ? "" : "opacity: 0.7; border-left: 3px solid #F44336;")">
                        <div class="mobile-card-header">
                            <div>
                                <span class="mobile-card-name">@user.DisplayName</span>
                                <div class="mobile-card-sub">@user.Username</div>
                            </div>
                            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem;">
                                <span class="badge" style="@(user.IsActive ? "background: rgba(76,175,80,0.15); color: #4CAF50; border: 1px solid rgba(76,175,80,0.3);" : "background: rgba(244,67,54,0.15); color: #F44336; border: 1px solid rgba(244,67,54,0.3);")">
                                    @(user.IsActive ? L("Active", "نشط") : L("Inactive", "غير نشط"))
                                </span>
                                <span class="badge" style="@GetRoleBadgeStyle(user.Role); font-size: 0.7rem;">
                                    @L(user.Role, GetRoleArabic(user.Role))
                                </span>
                            </div>
                        </div>
                        <div class="mobile-card-divider"></div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Permissions", "الصلاحيات")</span>
                            <span class="mobile-card-value">@permCount</span>
                        </div>
                        <div class="mobile-card-actions" style="flex-wrap: wrap;">
                            <button class="btn-outline btn-sm" @onclick="() => StartEdit(user)">
                                <i class="fas fa-edit"></i> @L("Edit", "تعديل")
                            </button>
                            <button class="btn-outline btn-sm" @onclick="() => StartResetPassword(user.Id)">
                                <i class="fas fa-key"></i> @L("Reset", "إعادة تعيين")
                            </button>
                            @if (user.Role != "Owner")
                            {
                                @if (user.IsActive)
                                {
                                    <button class="btn-sm" style="background: rgba(255,152,0,0.15); color: #FF9800; border: 1px solid rgba(255,152,0,0.3); border-radius: 6px; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.78rem;"
                                            @onclick="() => StartDeactivate(user)">
                                        <i class="fas fa-ban"></i> @L("Deactivate", "تعطيل")
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-sm" style="background: rgba(76,175,80,0.15); color: #4CAF50; border: 1px solid rgba(76,175,80,0.3); border-radius: 6px; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.78rem;"
                                            @onclick="() => ActivateUserAsync(user)">
                                        <i class="fas fa-check-circle"></i> @L("Activate", "تفعيل")
                                    </button>
                                }
                                <button class="btn-sm" style="background: rgba(244,67,54,0.15); color: #F44336; border: 1px solid rgba(244,67,54,0.3); border-radius: 6px; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.78rem;"
                                        @onclick="() => StartDelete(user)">
                                    <i class="fas fa-trash"></i> @L("Delete", "حذف")
                                </button>
                            }
                        </div>
                    </div>

                    @* Mobile: Reset password *@
                    @if (_resetPasswordUserId == user.Id)
                    {
                        <div class="mobile-card" style="border-color: var(--accent);">
                            <div class="form-group" style="margin-bottom: 0.5rem;">
                                <label>@L("New Password", "كلمة المرور الجديدة")</label>
                                <input type="password" @bind="_resetPassword" class="form-input"
                                       placeholder="@L("Enter new password", "أدخل كلمة المرور الجديدة")" />
                            </div>
                            <div class="mobile-card-actions">
                                <button class="btn-accent btn-sm" @onclick="ResetPasswordAsync">
                                    <i class="fas fa-save"></i> @L("Reset", "إعادة تعيين")
                                </button>
                                <button class="btn-outline btn-sm" @onclick="CancelAllActions">
                                    <i class="fas fa-times"></i> @L("Cancel", "إلغاء")
                                </button>
                            </div>
                        </div>
                    }

                    @* Mobile: Deactivate reason *@
                    @if (_deactivateUserId == user.Id)
                    {
                        <div class="mobile-card" style="border-color: #FF9800; background: rgba(255,152,0,0.05);">
                            <div style="color: #FF9800; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.5rem;">
                                <i class="fas fa-exclamation-triangle"></i> @L("Deactivate", "تعطيل"): @user.Username
                            </div>
                            <div class="form-group" style="margin-bottom: 0.5rem;">
                                <label>@L("Reason (required)", "السبب (مطلوب)")</label>
                                <input type="text" @bind="_actionReason" class="form-input"
                                       placeholder="@L("Enter reason...", "أدخل السبب...")" />
                            </div>
                            <div class="mobile-card-actions">
                                <button class="btn-sm" style="background: #FF9800; color: white; border: none; border-radius: 6px; padding: 0.35rem 0.75rem; cursor: pointer; font-size: 0.8rem;"
                                        @onclick="ConfirmDeactivateAsync" disabled="@(string.IsNullOrWhiteSpace(_actionReason))">
                                    <i class="fas fa-ban"></i> @L("Confirm", "تأكيد")
                                </button>
                                <button class="btn-outline btn-sm" @onclick="CancelAllActions">
                                    <i class="fas fa-times"></i> @L("Cancel", "إلغاء")
                                </button>
                            </div>
                        </div>
                    }

                    @* Mobile: Delete confirmation *@
                    @if (_deleteUserId == user.Id)
                    {
                        <div class="mobile-card" style="border-color: #F44336; background: rgba(244,67,54,0.05);">
                            <div style="color: #F44336; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.3rem;">
                                <i class="fas fa-exclamation-triangle"></i> @L("Delete Permanently", "حذف نهائي"): @user.Username
                            </div>
                            <div style="color: var(--text-secondary); font-size: 0.78rem; margin-bottom: 0.5rem;">
                                @L("This action cannot be undone.", "لا يمكن التراجع عن هذا الإجراء.")
                            </div>
                            <div class="form-group" style="margin-bottom: 0.5rem;">
                                <label>@L("Reason (required)", "السبب (مطلوب)")</label>
                                <input type="text" @bind="_actionReason" class="form-input"
                                       placeholder="@L("Enter reason...", "أدخل السبب...")" />
                            </div>
                            <div class="mobile-card-actions">
                                <button class="btn-sm" style="background: #F44336; color: white; border: none; border-radius: 6px; padding: 0.35rem 0.75rem; cursor: pointer; font-size: 0.8rem;"
                                        @onclick="ConfirmDeleteAsync" disabled="@(string.IsNullOrWhiteSpace(_actionReason))">
                                    <i class="fas fa-trash"></i> @L("Confirm", "تأكيد")
                                </button>
                                <button class="btn-outline btn-sm" @onclick="CancelAllActions">
                                    <i class="fas fa-times"></i> @L("Cancel", "إلغاء")
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @if (!FilteredUsers.Any())
        {
            <p class="no-data">
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    @L("No users match your search", "لا يوجد مستخدمون يطابقون بحثك")
                }
                else
                {
                    @L("No users found", "لم يتم العثور على مستخدمين")
                }
            </p>
        }
    </div>
}

