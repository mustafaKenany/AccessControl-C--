    private async Task ResetPasswordAsync()
    {
        _errorMsg = "";
        _successMsg = "";

        if (string.IsNullOrWhiteSpace(_resetPassword) || _resetPassword.Length < 6)
        {
            _errorMsg = L("Password must be at least 6 characters.", "كلمة المرور يجب أن تكون 6 أحرف على الأقل.");
            return;
        }

        try
        {
            var hash = BCrypt.Net.BCrypt.HashPassword(_resetPassword);
            var user = _users.FirstOrDefault(u => u.Id == _resetPasswordUserId);

            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Users"" SET ""PasswordHash"" = @h WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("h", hash);
            cmd.Parameters.AddWithValue("id", _resetPasswordUserId);
            await cmd.ExecuteNonQueryAsync();

            await LogAuditAsync("RESET_PASSWORD", _resetPasswordUserId,
                $"Reset password for user '{user?.Username}'",
                $"تم إعادة تعيين كلمة مرور المستخدم '{user?.Username}'");

            _successMsg = L("Password reset successfully.", "تم إعادة تعيين كلمة المرور بنجاح.");
            _resetPasswordUserId = 0;
            _resetPassword = "";
        }
        catch (Exception ex)
        {
            _errorMsg = $"{L("Error resetting password", "خطأ في إعادة تعيين كلمة المرور")}: {ex.Message}";
        }
    }

    private void StartDeactivate(UserRow user)
    {
        CancelAllActions();
        _deactivateUserId = user.Id;
