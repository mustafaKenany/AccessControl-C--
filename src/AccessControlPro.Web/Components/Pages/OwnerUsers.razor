    // Flat dictionary for display
    private Dictionary<string, (string en, string ar)> _allPermissions = new();

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    private string GetDbName() => !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";

    private string GetRoleBadgeStyle(string role) => role switch
    {
        "Owner" => "background: rgba(156,39,176,0.15); color: #CE93D8; border: 1px solid rgba(156,39,176,0.3);",
        "Admin" => "background: rgba(33,150,243,0.15); color: #64B5F6; border: 1px solid rgba(33,150,243,0.3);",
        _ => "background: rgba(158,158,158,0.15); color: #BDBDBD; border: 1px solid rgba(158,158,158,0.3);"
    };

    private string GetRoleArabic(string role) => role switch
