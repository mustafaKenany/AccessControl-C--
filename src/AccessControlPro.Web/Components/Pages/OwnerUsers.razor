    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        // Build flat permissions from groups
        foreach (var group in _permissionGroups)
            foreach (var perm in group.perms)
                _allPermissions[perm.key] = (perm.en, perm.ar);

        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());
            using var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""Id"", ""Username"", COALESCE(""DisplayName"",''), COALESCE(""Role"",'User'),
                         ""IsActive"", COALESCE(""Permissions"",'')
                  FROM ""Users"" ORDER BY ""Id""", conn);
            using var r = await cmd.ExecuteReaderAsync();
            _users = new List<UserRow>();
            while (await r.ReadAsync())
            {
                _users.Add(new UserRow(
                    r.GetInt32(0), r.GetString(1), r.GetString(2),
                    r.GetString(3), r.GetBoolean(4), r.GetString(5)));
            }
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerUsers] LoadUsersAsync Error: {ex.Message}"); }
    }

    private async Task LogAuditAsync(string action, int entityId, string details, string detailsAr)
    {
        try
        {
            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());
            using var cmd = new Npgsql.NpgsqlCommand(
                @"INSERT INTO ""AuditLogs"" (""Action"", ""EntityType"", ""EntityId"", ""Details"", ""DetailsAr"", ""PerformedBy"", ""Timestamp"")
                  VALUES (@action, 'User', @entityId, @details, @detailsAr, @performedBy, @ts)", conn);
            cmd.Parameters.AddWithValue("action", action);
            cmd.Parameters.AddWithValue("entityId", entityId);
            cmd.Parameters.AddWithValue("details", details);
            cmd.Parameters.AddWithValue("detailsAr", detailsAr);
            cmd.Parameters.AddWithValue("performedBy", Session.DisplayName ?? "System");
            cmd.Parameters.AddWithValue("ts", DateTime.UtcNow);
            await cmd.ExecuteNonQueryAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OwnerUsers] Audit log error: {ex.Message}");
        }
    }

    private async Task CreateUserAsync()
    {
        _errorMsg = "";
        _successMsg = "";

        if (string.IsNullOrWhiteSpace(_newUsername) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _errorMsg = L("Username and password are required.", "اسم المستخدم وكلمة المرور مطلوبان.");
            return;
        }

        if (_newPassword.Length < 6)
        {
            _errorMsg = L("Password must be at least 6 characters.", "كلمة المرور يجب أن تكون 6 أحرف على الأقل.");
            return;
        }

        _loading = true;
        try
        {
            var hash = BCrypt.Net.BCrypt.HashPassword(_newPassword);
            var permissions = string.Join(",", _newPermissions);

            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());

            // Check if username exists
            using (var checkCmd = new Npgsql.NpgsqlCommand(
                @"SELECT COUNT(*) FROM ""Users"" WHERE ""Username"" = @u", conn))
            {
                checkCmd.Parameters.AddWithValue("u", _newUsername.Trim());
                var exists = Convert.ToInt32(await checkCmd.ExecuteScalarAsync()) > 0;
                if (exists)
                {
                    _errorMsg = L("Username already exists.", "اسم المستخدم موجود بالفعل.");
                    return;
                }
            }

            using var cmd = new Npgsql.NpgsqlCommand(
                @"INSERT INTO ""Users"" (""Username"", ""PasswordHash"", ""DisplayName"", ""Role"", ""IsActive"", ""Permissions"")
                  VALUES (@u, @h, @d, @r, TRUE, @p) RETURNING ""Id""", conn);
            cmd.Parameters.AddWithValue("u", _newUsername.Trim());
            cmd.Parameters.AddWithValue("h", hash);
            cmd.Parameters.AddWithValue("d", _newDisplayName.Trim());
            cmd.Parameters.AddWithValue("r", _newRole);
            cmd.Parameters.AddWithValue("p", permissions);
            var newId = Convert.ToInt32(await cmd.ExecuteScalarAsync());

            await LogAuditAsync("CREATE_USER", newId,
                $"Created user '{_newUsername.Trim()}' with role {_newRole}",
                $"تم إنشاء المستخدم '{_newUsername.Trim()}' بدور {_newRole}");

            _successMsg = L("User created successfully.", "تم إنشاء المستخدم بنجاح.");
            _newUsername = "";
            _newPassword = "";
            _newDisplayName = "";
            _newRole = "User";
            _newPermissions.Clear();
            _showCreateForm = false;
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = $"{L("Error creating user", "خطأ في إنشاء المستخدم")}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartEdit(UserRow user)
    {
        _editingUserId = user.Id;
        _editDisplayName = user.DisplayName;
        _editRole = user.Role;
        _editIsActive = user.IsActive.ToString().ToLower();
        _editPermissions = string.IsNullOrEmpty(user.Permissions)
            ? new HashSet<string>()
            : user.Permissions.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
        CancelAllActions();
        _errorMsg = "";
        _successMsg = "";
    }

    private void CancelEdit()
    {
        _editingUserId = 0;
    }

    private async Task SaveEditAsync()
    {
        _errorMsg = "";
        _successMsg = "";

        try
        {
            var permissions = string.Join(",", _editPermissions);
            var isActive = _editIsActive == "true";
            var user = _users.FirstOrDefault(u => u.Id == _editingUserId);

            using var conn = await GymDb.GetGymConnectionAsync(GetDbName());
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Users"" SET ""DisplayName"" = @d, ""Role"" = @r, ""IsActive"" = @a, ""Permissions"" = @p
                  WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("d", _editDisplayName.Trim());
            cmd.Parameters.AddWithValue("r", _editRole);
            cmd.Parameters.AddWithValue("a", isActive);
            cmd.Parameters.AddWithValue("p", permissions);
            cmd.Parameters.AddWithValue("id", _editingUserId);
            await cmd.ExecuteNonQueryAsync();

            // Build change description
            var changes = new List<string>();
            if (user != null)
            {
                if (user.DisplayName != _editDisplayName.Trim()) changes.Add($"DisplayName: '{user.DisplayName}' -> '{_editDisplayName.Trim()}'");
                if (user.Role != _editRole) changes.Add($"Role: {user.Role} -> {_editRole}");
                if (user.IsActive != isActive) changes.Add($"IsActive: {user.IsActive} -> {isActive}");
            }
            var changeStr = changes.Any() ? string.Join(", ", changes) : "permissions updated";

            await LogAuditAsync("UPDATE_USER", _editingUserId,
                $"Updated user '{user?.Username}': {changeStr}",
                $"تم تحديث المستخدم '{user?.Username}': {changeStr}");

            _successMsg = L("User updated successfully.", "تم تحديث المستخدم بنجاح.");
            _editingUserId = 0;
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = $"{L("Error updating user", "خطأ في تحديث المستخدم")}: {ex.Message}";
        }
    }

    private void StartResetPassword(int userId)
