@page "/players"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@inject IConfiguration Config
@rendermode InteractiveServer
@attribute [StreamRendering]

@* TODO: Currently checks Session.IsOwner only. When granular cloud permissions are added,
   enforce AppPermission checks per page (e.g., PlayersView for this page). *@
@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-users"></i> @L("Players", "اللاعبون")</h1>
        <div style="display: flex; align-items: center; gap: 1rem;">
            <button class="btn-outline btn-sm" @onclick="RefreshData" disabled="@_refreshing" style="display: inline-flex; align-items: center; gap: 0.4rem;">
                <i class="fas fa-sync-alt @(_refreshing ? "fa-spin" : "")"></i> @L("Refresh", "تحديث")
            </button>
            <span class="last-sync">@L("Total", "الإجمالي"): @_totalCount</span>
        </div>
    </div>

    <div class="search-bar" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <input type="text" @bind="_search" @bind:event="oninput" @onkeyup="OnSearch"
               class="form-input" placeholder="@L("Search by name, phone, or card...", "ابحث بالاسم أو الهاتف أو البطاقة...")" />
        <div class="filter-buttons">
            <button class="filter-btn @(_filter == "All" ? "active" : "")" @onclick='() => SetFilter("All")'>@L("All", "الكل")</button>
            <button class="filter-btn @(_filter == "Active" ? "active" : "")" @onclick='() => SetFilter("Active")'>@L("Active", "نشط")</button>
            <button class="filter-btn @(_filter == "Expiring" ? "active" : "")" @onclick='() => SetFilter("Expiring")'>@L("Expiring", "ينتهي قريباً")</button>
            <button class="filter-btn @(_filter == "Expired" ? "active" : "")" @onclick='() => SetFilter("Expired")'>@L("Expired", "منتهي")</button>
            <button class="filter-btn @(_filter == "Frozen" ? "active" : "")" @onclick='() => SetFilter("Frozen")'>@L("Frozen", "مجمد")</button>
        </div>
    </div>

    <div class="filter-group" style="margin-top: 0.5rem;">
        <span style="color: var(--text-secondary); font-size: 0.85rem; margin-right: 0.5rem;">
            <i class="fas fa-calendar-alt"></i> @L("Expires In", "ينتهي في"):
        </span>
        <button class="filter-btn @(_period == "all" ? "active" : "")" @onclick='() => SetPeriod("all")'
                title="@GetFilterTooltip("all")">
            @L("All", "الكل")
        </button>
        <button class="filter-btn @(_period == "today" ? "active" : "")" @onclick='() => SetPeriod("today")'
                title="@GetFilterTooltip("today")">
            @L("Today", "اليوم")
        </button>
        <button class="filter-btn @(_period == "yesterday" ? "active" : "")" @onclick='() => SetPeriod("yesterday")'
                title="@GetFilterTooltip("yesterday")">
            @L("Yesterday", "أمس")
        </button>
        <button class="filter-btn @(_period == "thisweek" ? "active" : "")" @onclick='() => SetPeriod("thisweek")'
                title="@GetFilterTooltip("thisweek")">
            @L("This Week", "هذا الأسبوع")
        </button>
        <button class="filter-btn @(_period == "lastweek" ? "active" : "")" @onclick='() => SetPeriod("lastweek")'
                title="@GetFilterTooltip("lastweek")">
            @L("Last Week", "الأسبوع الماضي")
        </button>
        <button class="filter-btn @(_period == "thismonth" ? "active" : "")" @onclick='() => SetPeriod("thismonth")'
                title="@GetFilterTooltip("thismonth")">
            @L("This Month", "هذا الشهر")
        </button>
        <button class="filter-btn @(_period == "lastmonth" ? "active" : "")" @onclick='() => SetPeriod("lastmonth")'
                title="@GetFilterTooltip("lastmonth")">
            @L("Last Month", "الشهر الماضي")
        </button>
        <button class="filter-btn @(_period == "last3months" ? "active" : "")" @onclick='() => SetPeriod("last3months")'
                title="@GetFilterTooltip("last3months")">
            @L("Last 3 Months", "آخر 3 أشهر")
        </button>
        <button class="filter-btn @(_period == "last6months" ? "active" : "")" @onclick='() => SetPeriod("last6months")'
                title="@GetFilterTooltip("last6months")">
            @L("Last 6 Months", "آخر 6 أشهر")
        </button>
    </div>

    <div class="content-card">
        @* Player tiles — Arabic name only; tap a player to open the full profile page. *@
        <div class="players-grid">
            @foreach (var p in _players)
            {
                var now = DateTime.UtcNow;
                var status = p.IsFrozen ? "Frozen" :
                             p.EndDate <= now ? "Expired" :
                             (p.EndDate - now).Days <= 7 ? "Expiring" : "Active";
                var ring = status == "Active" ? "#2ED47A" :
                           status == "Frozen" ? "#4CA1A3" :
                           status == "Expiring" ? "#FFB946" : "#F7685B";
                var name = !string.IsNullOrEmpty(p.FullNameAr) ? p.FullNameAr : p.FullNameEn;
                var initial = string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1];

                <a href="/player/@p.Id" class="player-tile" title="@name">
                    <div class="player-tile-avatar" style="border-color:@ring;">@initial</div>
                    <div class="player-tile-name" dir="rtl">@name</div>
                </a>
            }
        </div>

        @if (!_players.Any())
        {
            <p class="no-data">@L("No players found", "لم يتم العثور على لاعبين")</p>
        }

        @if (_totalCount > 0)
        {
            <div class="pagination">
                <button class="btn-outline btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">
                    <i class="fas fa-chevron-left"></i> @L("Previous", "السابق")
                </button>
                <span class="page-info">
                    @L("Page", "صفحة") @_page / @TotalPages (@_totalCount @L("records", "سجل"))
                </span>
                <button class="btn-outline btn-sm" disabled="@(!_hasMore)" @onclick="NextPage">
                    @L("Next", "التالي") <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    private string _search = "";
    private string _filter = "All";
    private string _period = "all";
    private List<PlayerRow> _players = new();
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private bool _hasMore => _page * PageSize < _totalCount;
    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling((double)_totalCount / PageSize);

    private string _gymName = "";
    private bool _refreshing;

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadGymNameAsync();
        await LoadPlayersAsync();
    }

    private async Task LoadGymNameAsync()
    {
        _gymName = Config["GymName"] ?? "HM Gym";
        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);
            using var cmd = new Npgsql.NpgsqlCommand(@"SELECT ""GymName"" FROM ""AppSettings"" LIMIT 1", conn);
            var result = await cmd.ExecuteScalarAsync();
            if (result != null && result != DBNull.Value && !string.IsNullOrWhiteSpace(result.ToString()))
                _gymName = result.ToString()!;
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerPlayers] LoadGymNameAsync Error: {ex.Message}"); }
    }

    private async Task LoadPlayersAsync()
    {
        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            // Build WHERE clause based on filter
            var now = DateTime.UtcNow;
            var weekFromNow = now.AddDays(7);
            var whereBase = @"""IsDeleted"" = FALSE";
            var extraWhere = _filter switch
            {
                "Active" => @" AND ""IsFrozen"" = FALSE AND ""EndDate"" > @now",
                "Expiring" => @" AND ""IsFrozen"" = FALSE AND ""EndDate"" > @now AND ""EndDate"" <= @week",
                "Expired" => @" AND ""IsFrozen"" = FALSE AND ""EndDate"" <= @now",
                "Frozen" => @" AND ""IsFrozen"" = TRUE",
                _ => ""
            };

            // Date period filter on EndDate
            var isAllPeriod = _period == "all";
            var dateWhere = "";
            DateTime periodFrom = DateTime.MinValue, periodTo = DateTime.MaxValue;
            if (!isAllPeriod)
            {
                (periodFrom, periodTo) = GetDateRange();
                dateWhere = @" AND ""EndDate"" >= @periodFrom AND ""EndDate"" < @periodTo";
            }

            var searchWhere = "";
            if (!string.IsNullOrWhiteSpace(_search))
            {
                searchWhere = @" AND (LOWER(""FullNameEn"") LIKE @q OR ""FullNameAr"" LIKE @q OR ""Phone"" LIKE @q OR ""CardNo"" LIKE @q)";
            }

            var fullWhere = $"WHERE {whereBase}{extraWhere}{dateWhere}{searchWhere}";

            // Count
            using (var countCmd = new Npgsql.NpgsqlCommand(
                $@"SELECT COUNT(*) FROM ""Players"" {fullWhere}", conn))
            {
                if (_filter is "Active" or "Expiring" or "Expired")
                    countCmd.Parameters.AddWithValue("now", now);
                if (_filter == "Expiring")
                    countCmd.Parameters.AddWithValue("week", weekFromNow);
                if (!isAllPeriod)
                {
                    countCmd.Parameters.AddWithValue("periodFrom", periodFrom);
                    countCmd.Parameters.AddWithValue("periodTo", periodTo);
                }
                if (!string.IsNullOrWhiteSpace(_search))
                    countCmd.Parameters.AddWithValue("q", $"%{_search.Trim().ToLower()}%");

                _totalCount = Convert.ToInt32(await countCmd.ExecuteScalarAsync());
            }

            // Data
            using (var cmd = new Npgsql.NpgsqlCommand(
                $@"SELECT ""Id"", ""FullNameEn"", ""FullNameAr"", COALESCE(""CardNo"",''), COALESCE(""Phone"",''),
                         COALESCE(""SubscriptionType"",''), ""StartDate"", ""EndDate"",
                         COALESCE(""SubscriptionFee"",0), COALESCE(""AmountPaid"",0),
                         COALESCE(""MaxVisits"",0), COALESCE(""UsedVisits"",0), ""IsFrozen"", ""FreezeStartDate""
                  FROM ""Players"" {fullWhere}
                  ORDER BY ""Id"" DESC LIMIT @limit OFFSET @offset", conn))
            {
                if (_filter is "Active" or "Expiring" or "Expired")
                    cmd.Parameters.AddWithValue("now", now);
                if (_filter == "Expiring")
                    cmd.Parameters.AddWithValue("week", weekFromNow);
                if (!isAllPeriod)
                {
                    cmd.Parameters.AddWithValue("periodFrom", periodFrom);
                    cmd.Parameters.AddWithValue("periodTo", periodTo);
                }
                if (!string.IsNullOrWhiteSpace(_search))
                    cmd.Parameters.AddWithValue("q", $"%{_search.Trim().ToLower()}%");
                cmd.Parameters.AddWithValue("limit", PageSize);
                cmd.Parameters.AddWithValue("offset", (_page - 1) * PageSize);

                using var r = await cmd.ExecuteReaderAsync();
                _players = new List<PlayerRow>();
                while (await r.ReadAsync())
                {
                    _players.Add(new PlayerRow(
                        r.GetInt32(0), r.GetString(1), r.GetString(2), r.GetString(3), r.GetString(4),
                        r.GetString(5), r.GetDateTime(6), r.GetDateTime(7),
                        r.GetDecimal(8), r.GetDecimal(9),
                        r.GetInt32(10), r.GetInt32(11), r.GetBoolean(12),
                        r.IsDBNull(13) ? null : r.GetDateTime(13)));
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerPlayers] LoadPlayersAsync Error: {ex.Message}"); }
    }

    private async Task RefreshData()
    {
        _refreshing = true;
        StateHasChanged();
        try
        {
            _page = 1;
            await LoadPlayersAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task SetFilter(string filter)
    {
        _filter = filter;
        _page = 1;
        await LoadPlayersAsync();
    }

    private async Task SetPeriod(string period)
    {
        _period = period;
        _page = 1;
        await LoadPlayersAsync();
    }

    private (DateTime start, DateTime end) GetDateRange()
    {
        var now = DateTime.UtcNow;
        var future = now.AddHours(12);
        var today = now.Date;
        return _period switch
        {
            "today" => (today.AddHours(-6), future),
            "yesterday" => (today.AddDays(-1).AddHours(-6), today.AddHours(-6)),
            "thisweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6), future),
            "lastweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7 - 7).AddHours(-6), today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6)),
            "thismonth" => (new DateTime(now.Year, now.Month, 1).AddHours(-6), future),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1).AddMonths(-1).AddHours(-6),
                            new DateTime(now.Year, now.Month, 1).AddHours(-6)),
            "last3months" => (today.AddMonths(-3).AddHours(-6), future),
            "last6months" => (today.AddMonths(-6).AddHours(-6), future),
            "all" => (DateTime.MinValue, future),
            _ => (today.AddHours(-6), future)
        };
    }

    private (DateTime start, DateTime end) GetDateRangeFor(string p)
    {
        var now = DateTime.UtcNow;
        var future = now.AddHours(12);
        var today = now.Date;
        return p switch
        {
            "today" => (today.AddHours(-6), future),
            "yesterday" => (today.AddDays(-1).AddHours(-6), today.AddHours(-6)),
            "thisweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6), future),
            "lastweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7 - 7).AddHours(-6), today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6)),
            "thismonth" => (new DateTime(now.Year, now.Month, 1).AddHours(-6), future),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1).AddMonths(-1).AddHours(-6),
                            new DateTime(now.Year, now.Month, 1).AddHours(-6)),
            "last3months" => (today.AddMonths(-3).AddHours(-6), future),
            "last6months" => (today.AddMonths(-6).AddHours(-6), future),
            "all" => (DateTime.MinValue, future),
            _ => (today.AddHours(-6), future)
        };
    }

    private string GetFilterTooltip(string period)
    {
        var (s, e) = GetDateRangeFor(period);
        var startStr = s == DateTime.MinValue ? "" : s.ToString("yyyy-MM-dd");
        var endStr = e > DateTime.UtcNow.AddHours(10) ? L("Now", "الآن") : e.ToString("yyyy-MM-dd");

        return period switch
        {
            "all" => L("Show all players without date filter", "عرض جميع اللاعبين بدون فلتر تاريخ"),
            "today" => L($"Expires today ({startStr} → {endStr})", $"ينتهي اليوم ({startStr} → {endStr})"),
            "yesterday" => L($"Expired yesterday ({startStr} → {endStr})", $"انتهى بالأمس ({startStr} → {endStr})"),
            "thisweek" => L($"Expires this week ({startStr} → {endStr})", $"ينتهي هذا الأسبوع ({startStr} → {endStr})"),
            "lastweek" => L($"Expired last week ({startStr} → {endStr})", $"انتهى الأسبوع الماضي ({startStr} → {endStr})"),
            "thismonth" => L($"Expires this month ({startStr} → {endStr})", $"ينتهي هذا الشهر ({startStr} → {endStr})"),
            "lastmonth" => L($"Expired last month ({startStr} → {endStr})", $"انتهى الشهر الماضي ({startStr} → {endStr})"),
            "last3months" => L($"Expired last 3 months ({startStr} → {endStr})", $"انتهى آخر 3 أشهر ({startStr} → {endStr})"),
            "last6months" => L($"Expired last 6 months ({startStr} → {endStr})", $"انتهى آخر 6 أشهر ({startStr} → {endStr})"),
            _ => ""
        };
    }

    private async Task OnSearch()
    {
        // Limit search input length to prevent abuse
        if (_search.Length > 100) _search = _search[..100];
        _page = 1;
        await LoadPlayersAsync();
    }

    private async Task NextPage()
    {
        if (_hasMore) { _page++; await LoadPlayersAsync(); }
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadPlayersAsync(); }
    }
}
