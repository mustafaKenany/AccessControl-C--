    private async Task LoadVisitsAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(_player?.CardNo))
                return;

            using var conn = await Db.GetConnectionAsync();
            using var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT e.""EventDate"", e.""EventCode"",
                         COALESCE(d.""Name"", 'Door ' || e.""DoorId"") as ""DoorName""
                  FROM ""AccessEvents"" e
                  LEFT JOIN ""Doors"" d ON e.""DoorId"" = d.""Id""
                  WHERE e.""Details"" LIKE '%' || @cardNo || '%'
                  ORDER BY e.""EventDate"" DESC
                  LIMIT 100", conn);
            cmd.Parameters.AddWithValue("cardNo", _player.CardNo);

            using var r = await cmd.ExecuteReaderAsync();
            _visits = new List<VisitRow>();
            while (await r.ReadAsync())
            {
                _visits.Add(new VisitRow(
                    r.GetDateTime(0), r.GetString(2), r.GetInt32(1)));
            }
        }
        catch { }
    }
