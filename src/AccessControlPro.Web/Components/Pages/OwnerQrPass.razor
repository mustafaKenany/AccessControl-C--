@page "/qr-pass"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@rendermode InteractiveServer

@* TODO: Currently checks Session.IsOwner only. When granular cloud permissions are added,
   enforce AppPermission checks per page (e.g., QrPassManage for this page). *@
@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-qrcode"></i> @L("QR Guest Pass", "تصريح ضيف QR")</h1>
    </div>

    <div class="content-card">
        <h3>@L("Create New Pass", "إنشاء تصريح جديد")</h3>
        <div class="qr-form">
            <div class="form-group">
                <label>@L("Guest Name", "اسم الضيف")</label>
                <input class="form-input" @bind="_guestName" placeholder="@L("Enter guest name", "أدخل اسم الضيف")" />
            </div>
            <div class="form-group">
                <label>@L("Max Uses", "الحد الأقصى للاستخدام")</label>
                <select class="form-select" @bind="_maxUses">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="10">10</option>
                </select>
            </div>
            <div class="form-group">
                <label>@L("Valid Until", "صالح حتى")</label>
                <input type="date" class="form-input" @bind="_validTo" />
            </div>
            <div class="form-group" style="display:flex;align-items:flex-end;">
                <button class="btn-accent" @onclick="CreatePassAsync" disabled="@_isCreating">
                    <i class="fas fa-plus"></i> @L("Create Pass", "إنشاء تصريح")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div class="error-msg">@_errorMsg</div>
        }
    </div>

    @if (_showQrResult)
    {
        <div class="content-card">
            <h3>@L("Pass Created", "تم إنشاء التصريح")</h3>
            <div class="qr-result">
                <img src="https://api.qrserver.com/v1/create-qr-code/?data=@Uri.EscapeDataString(_qrContent)&size=300x300" alt="QR Code" width="300" height="300" />
                <div class="qr-code-text">@_createdCode</div>
                <p style="color:var(--text-secondary);margin-bottom:0.75rem;">
                    @L("Guest", "الضيف"): @_guestName |
                    @L("Uses", "الاستخدامات"): @_maxUses |
                    @L("Valid until", "صالح حتى"): @_validTo.ToString("yyyy-MM-dd")
                </p>
                <div class="qr-actions">
                    <button class="btn-whatsapp" @onclick="ShareQrViaWhatsApp">
                        <i class="fab fa-whatsapp"></i> @L("Share via WhatsApp", "مشاركة عبر واتساب")
                    </button>
                    <a class="btn-accent" href="https://api.qrserver.com/v1/create-qr-code/?data=@Uri.EscapeDataString(_qrContent)&size=600x600&format=png" target="_blank" download="@($"pass-{_createdCode}.png")">
                        <i class="fas fa-download"></i> @L("Download QR", "تحميل QR")
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="content-card">
        <h3>@L("Active Passes", "التصاريح النشطة")</h3>
        @if (_passes.Any())
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Guest Name", "اسم الضيف")</th>
                            <th>@L("Code", "الرمز")</th>
                            <th>@L("Uses", "الاستخدامات")</th>
                            <th>@L("Valid Until", "صالح حتى")</th>
                            <th>@L("Status", "الحالة")</th>
                            <th>@L("Actions", "الإجراءات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _passes)
                        {
                            var isExpired = p.ValidTo < DateTime.UtcNow;
                            var isUsedUp = p.UsedCount >= p.MaxUses;
                            <tr>
                                <td>@p.PlayerName</td>
                                <td style="font-family:monospace;">@p.Code</td>
                                <td>@p.UsedCount / @p.MaxUses</td>
                                <td>@p.ValidTo.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (!p.IsActive)
                                    {
                                        <span class="badge badge-expired">@L("Deactivated", "معطل")</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge badge-expired">@L("Expired", "منتهي")</span>
                                    }
                                    else if (isUsedUp)
                                    {
                                        <span class="badge badge-expiring">@L("Used Up", "مستنفد")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-active">@L("Active", "نشط")</span>
                                    }
                                </td>
                                <td>
                                    @if (p.IsActive && !isExpired && !isUsedUp)
                                    {
                                        <button class="btn-danger btn-sm" @onclick="() => DeactivateAsync(p.Id)">
                                            <i class="fas fa-ban"></i> @L("Deactivate", "تعطيل")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="no-data">@L("No passes created yet", "لم يتم إنشاء تصاريح بعد")</p>
        }
    </div>
}

@code {
    private string _guestName = "";
    private int _maxUses = 1;
    private DateTime _validTo = DateTime.Today;
    private bool _isCreating;
    private string? _errorMsg;

    // QR result
    private bool _showQrResult;
    private string _createdCode = "";
    private string _qrContent = "";
    private string _whatsAppUrl = "";
    private string _gymName = "MyGym";

    // Passes list
    private List<QrPass> _passes = new();

    private string L(string en, string ar) => SessionState.IsArabic ? ar : en;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        await LoadPassesAsync();
    }

    private async Task CreatePassAsync()
    {
        _errorMsg = null;
        _showQrResult = false;

        if (string.IsNullOrWhiteSpace(_guestName))
        {
            _errorMsg = L("Please enter guest name", "الرجاء إدخال اسم الضيف");
            return;
        }

        _isCreating = true;
        StateHasChanged();

        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            // Pick available code from cloud pool (50003501-50006000)
            string? code;
            using (var pickCmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""Code"" FROM ""QrPool"" WHERE ""Status"" = 0 AND ""Source"" = 'Cloud' ORDER BY RANDOM() LIMIT 1", conn))
            {
                code = (await pickCmd.ExecuteScalarAsync())?.ToString();
            }

            if (string.IsNullOrEmpty(code))
            {
                _errorMsg = L("No QR codes available. Pool needs regeneration.", "لا توجد رموز QR متاحة. يجب إعادة إنشاء المجموعة.");
                return;
            }

            var validTo = new DateTime(_validTo.Year, _validTo.Month, _validTo.Day, 23, 59, 59, DateTimeKind.Utc);

            // Assign the code from pool
            using (var updateCmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""QrPool"" SET ""Status"" = 1, ""GuestName"" = @name, ""GuestPhone"" = '',
                  ""Reason"" = 'Guest Pass', ""MaxUses"" = @max, ""AssignedAt"" = NOW(),
                  ""ValidTo"" = @to WHERE ""Code"" = @code", conn))
            {
                updateCmd.Parameters.AddWithValue("name", _guestName.Trim());
                updateCmd.Parameters.AddWithValue("max", _maxUses);
                updateCmd.Parameters.AddWithValue("to", validTo);
                updateCmd.Parameters.AddWithValue("code", code);
                await updateCmd.ExecuteNonQueryAsync();
            }

            // Also insert into QrPasses for backward compatibility
            using (var legacyCmd = new Npgsql.NpgsqlCommand(
                @"INSERT INTO ""QrPasses"" (""Code"", ""PlayerName"", ""MaxUses"", ""UsedCount"", ""ValidFrom"", ""ValidTo"", ""IsActive"", ""CreatedBy"", ""CreatedAt"")
                  VALUES (@code, @name, @max, 0, NOW(), @to, TRUE, @by, NOW())", conn))
            {
                legacyCmd.Parameters.AddWithValue("code", code);
                legacyCmd.Parameters.AddWithValue("name", _guestName.Trim());
                legacyCmd.Parameters.AddWithValue("max", _maxUses);
                legacyCmd.Parameters.AddWithValue("to", validTo);
                legacyCmd.Parameters.AddWithValue("by", Session.DisplayName);
                await legacyCmd.ExecuteNonQueryAsync();
            }

            // Build QR content - just the numeric code
            _createdCode = code;
            _qrContent = code;

            // Build WhatsApp share URL
            _gymName = "MyGym";
            try
            {
                using var gymCmd = new Npgsql.NpgsqlCommand(@"SELECT ""GymName"" FROM ""AppSettings"" LIMIT 1", conn);
                var result = await gymCmd.ExecuteScalarAsync();
                if (result != null && result != DBNull.Value)
                {
                    var name = result.ToString();
                    if (!string.IsNullOrEmpty(name)) _gymName = name;
                }
            }
            catch { }

            ShareQrViaWhatsAppBuild();

            _showQrResult = true;
            await LoadPassesAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = L("Error creating pass: ", "خطأ في إنشاء التصريح: ") + ex.Message;
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task DeactivateAsync(int id)
    {
        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            // Deactivate in QrPool
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""QrPool"" SET ""Status"" = 3, ""ExpiredAt"" = NOW() WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("id", id);
            await cmd.ExecuteNonQueryAsync();

            // Also deactivate in QrPasses if exists
            try
            {
                // Get code by pool ID
                using var getCmd = new Npgsql.NpgsqlCommand(
                    @"SELECT ""Code"" FROM ""QrPool"" WHERE ""Id"" = @id", conn);
                getCmd.Parameters.AddWithValue("id", id);
                var code = (await getCmd.ExecuteScalarAsync())?.ToString();
                if (!string.IsNullOrEmpty(code))
                {
                    using var legacyCmd = new Npgsql.NpgsqlCommand(
                        @"UPDATE ""QrPasses"" SET ""IsActive"" = FALSE WHERE ""Code"" = @code", conn);
                    legacyCmd.Parameters.AddWithValue("code", code);
                    await legacyCmd.ExecuteNonQueryAsync();
                }
            }
            catch { }

            await LoadPassesAsync();
        }
        catch { }
    }

    private async Task LoadPassesAsync()
    {
        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            // Load from QrPool (primary source for pool-based passes)
            using var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""Id"", ""Code"", ""GuestName"", ""MaxUses"", ""UsedCount"", ""ValidTo"",
                         CASE WHEN ""Status"" IN (0,1) THEN TRUE ELSE FALSE END AS ""IsActive"",
                         COALESCE(""AssignedAt"", ""CreatedAt"") AS ""CreatedAt""
                  FROM ""QrPool"" WHERE ""Status"" IN (1, 2, 3) AND ""Source"" = 'Cloud'
                  ORDER BY ""AssignedAt"" DESC NULLS LAST LIMIT 50", conn);
            using var r = await cmd.ExecuteReaderAsync();
            _passes = new List<QrPass>();
            while (await r.ReadAsync())
            {
                _passes.Add(new QrPass(
                    r.GetInt32(0), r.GetString(1),
                    r.IsDBNull(2) ? "" : r.GetString(2),
                    r.GetInt32(3), r.GetInt32(4), r.GetDateTime(5),
                    r.GetBoolean(6), r.GetDateTime(7)));
            }
        }
        catch { }
    }

    private string GenerateSecureCode()
    {
        // Combine timestamp + random for uniqueness
        var timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var random = Random.Shared.Next(100000, 999999);
        var raw = $"{timestamp}{random}";

        // Hash with HMAC-SHA256 using a secret key
        using var hmac = new System.Security.Cryptography.HMACSHA256(
            System.Text.Encoding.UTF8.GetBytes("HMTech-QR-Secret-2026"));
        var hash = hmac.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw));

        // Convert hash to numeric string (take first 14 digits)
        var numeric = string.Join("", hash.Take(7).Select(b => (b % 100).ToString("D2")));
        return numeric; // 14-digit number like "84729163502847"
    }

    private void ShareQrViaWhatsApp()
    {
        var qrImageUrl = $"https://api.qrserver.com/v1/create-qr-code/?data={_createdCode}&size=300x300";

        var msg = SessionState.IsArabic
            ? $"\U0001F3CB\uFE0F \u062A\u0635\u0631\u064A\u062D \u062F\u062E\u0648\u0644 - {_gymName}\n\n\U0001F464 \u0627\u0644\u0627\u0633\u0645: {_guestName}\n\U0001F522 \u0627\u0644\u0631\u0645\u0632: {_createdCode}\n\U0001F4C5 \u0635\u0627\u0644\u062D \u062D\u062A\u0649: {_validTo:yyyy-MM-dd}\n\U0001F504 \u0639\u062F\u062F \u0627\u0644\u0645\u0631\u0627\u062A: {_maxUses}\n\n\U0001F4F1 \u0635\u0648\u0631\u0629 QR:\n{qrImageUrl}\n\n\u0623\u0638\u0647\u0631 \u0647\u0630\u0627 \u0627\u0644\u0631\u0645\u0632 \u0639\u0646\u062F \u0627\u0644\u0627\u0633\u062A\u0642\u0628\u0627\u0644"
            : $"\U0001F3CB\uFE0F Guest Pass - {_gymName}\n\n\U0001F464 Name: {_guestName}\n\U0001F522 Code: {_createdCode}\n\U0001F4C5 Valid until: {_validTo:yyyy-MM-dd}\n\U0001F504 Uses: {_maxUses}\n\n\U0001F4F1 QR Image:\n{qrImageUrl}\n\nShow this code at reception";

        var url = $"https://wa.me/?text={Uri.EscapeDataString(msg)}";
        Nav.NavigateTo(url, forceLoad: true);
    }

    private void ShareQrViaWhatsAppBuild()
    {
        var qrImageUrl = $"https://api.qrserver.com/v1/create-qr-code/?data={_createdCode}&size=300x300";

        var msg = SessionState.IsArabic
            ? $"\U0001F3CB\uFE0F \u062A\u0635\u0631\u064A\u062D \u062F\u062E\u0648\u0644 - {_gymName}\n\n\U0001F464 \u0627\u0644\u0627\u0633\u0645: {_guestName}\n\U0001F522 \u0627\u0644\u0631\u0645\u0632: {_createdCode}\n\U0001F4C5 \u0635\u0627\u0644\u062D \u062D\u062A\u0649: {_validTo:yyyy-MM-dd}\n\U0001F504 \u0639\u062F\u062F \u0627\u0644\u0645\u0631\u0627\u062A: {_maxUses}\n\n\U0001F4F1 \u0635\u0648\u0631\u0629 QR:\n{qrImageUrl}\n\n\u0623\u0638\u0647\u0631 \u0647\u0630\u0627 \u0627\u0644\u0631\u0645\u0632 \u0639\u0646\u062F \u0627\u0644\u0627\u0633\u062A\u0642\u0628\u0627\u0644"
            : $"\U0001F3CB\uFE0F Guest Pass - {_gymName}\n\n\U0001F464 Name: {_guestName}\n\U0001F522 Code: {_createdCode}\n\U0001F4C5 Valid until: {_validTo:yyyy-MM-dd}\n\U0001F504 Uses: {_maxUses}\n\n\U0001F4F1 QR Image:\n{qrImageUrl}\n\nShow this code at reception";

        _whatsAppUrl = $"https://wa.me/?text={Uri.EscapeDataString(msg)}";
    }

    private record QrPass(int Id, string Code, string PlayerName, int MaxUses, int UsedCount, DateTime ValidTo, bool IsActive, DateTime CreatedAt);
}
