@page "/finance"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@rendermode InteractiveServer

@* TODO: Currently checks Session.IsOwner only. When granular cloud permissions are added,
   enforce AppPermission checks per page (e.g., FinanceView for this page). *@
@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-wallet"></i> @L("Finance", "المالية")</h1>
    </div>

    <div class="stats-grid">
        <div class="stat-card green">
            <div class="stat-icon"><i class="fas fa-arrow-up"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_periodIncome.ToString("N2")</div>
                <div class="stat-label">@L("Total Revenue", "إجمالي الإيرادات")</div>
            </div>
        </div>
        <div class="stat-card red">
            <div class="stat-icon"><i class="fas fa-arrow-down"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_periodExpense.ToString("N2")</div>
                <div class="stat-label">@L("Total Expenses", "إجمالي المصروفات")</div>
            </div>
        </div>
        <div class="stat-card @(_periodProfit >= 0 ? "teal" : "red")">
            <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_periodProfit.ToString("N2")</div>
                <div class="stat-label">@L("Net Profit", "صافي الربح")</div>
            </div>
        </div>
        <div class="stat-card orange">
            <div class="stat-icon"><i class="fas fa-exclamation-circle"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_outstanding.ToString("N2")</div>
                <div class="stat-label">@L("Outstanding", "المتبقي")</div>
            </div>
        </div>
    </div>

    <div class="filter-group">
        <button class="filter-btn @(_period == "all" ? "active" : "")" @onclick='() => SetPeriod("all")'
                title="@GetFilterTooltip("all")">
            @L("All", "الكل")
        </button>
        <button class="filter-btn @(_period == "today" ? "active" : "")" @onclick='() => SetPeriod("today")'
                title="@GetFilterTooltip("today")">
            @L("Today", "اليوم")
        </button>
        <button class="filter-btn @(_period == "yesterday" ? "active" : "")" @onclick='() => SetPeriod("yesterday")'
                title="@GetFilterTooltip("yesterday")">
            @L("Yesterday", "أمس")
        </button>
        <button class="filter-btn @(_period == "thisweek" ? "active" : "")" @onclick='() => SetPeriod("thisweek")'
                title="@GetFilterTooltip("thisweek")">
            @L("This Week", "هذا الأسبوع")
        </button>
        <button class="filter-btn @(_period == "lastweek" ? "active" : "")" @onclick='() => SetPeriod("lastweek")'
                title="@GetFilterTooltip("lastweek")">
            @L("Last Week", "الأسبوع الماضي")
        </button>
        <button class="filter-btn @(_period == "thismonth" ? "active" : "")" @onclick='() => SetPeriod("thismonth")'
                title="@GetFilterTooltip("thismonth")">
            @L("This Month", "هذا الشهر")
        </button>
        <button class="filter-btn @(_period == "lastmonth" ? "active" : "")" @onclick='() => SetPeriod("lastmonth")'
                title="@GetFilterTooltip("lastmonth")">
            @L("Last Month", "الشهر الماضي")
        </button>
        <button class="filter-btn @(_period == "last3months" ? "active" : "")" @onclick='() => SetPeriod("last3months")'
                title="@GetFilterTooltip("last3months")">
            @L("Last 3 Months", "آخر 3 أشهر")
        </button>
        <button class="filter-btn @(_period == "last6months" ? "active" : "")" @onclick='() => SetPeriod("last6months")'
                title="@GetFilterTooltip("last6months")">
            @L("Last 6 Months", "آخر 6 أشهر")
        </button>
    </div>

    <div class="filter-bar" style="margin-top: 0.5rem;">
        <input type="text" @bind="_search" @bind:event="oninput" @onkeyup="OnSearch"
               class="form-input" style="max-width: 320px;"
               placeholder="@L("Search by player name or card...", "بحث باسم اللاعب أو البطاقة...")" />
        @if (!string.IsNullOrWhiteSpace(_search))
        {
            <span style="color: var(--text-secondary); font-size: 0.8rem; margin-inline-start: 0.5rem;">
                <i class="fas fa-search"></i> @L("Searching all dates", "بحث في كل التواريخ")
            </span>
        }
    </div>

    <div class="content-card">
        <h3>@L("Transactions", "المعاملات") (@_totalCount)</h3>

        @* Desktop table *@
        <div class="desktop-only">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Date", "التاريخ")</th>
                            <th>@L("Type", "النوع")</th>
                            <th>@L("Category", "الفئة")</th>
                            <th>@L("Amount", "المبلغ")</th>
                            <th>@L("Description", "الوصف")</th>
                            <th>@L("Recorded By", "بواسطة")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _transactions)
                        {
                            var typeLabel = t.Type == 0 ? L("Income", "إيراد") : L("Expense", "مصروف");
                            var typeClass = t.Type == 0 ? "badge-active" : "badge-expired";
                            var amountClass = t.Type == 0 ? "text-success" : "text-danger";
                            <tr>
                                <td>@t.TransactionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge @typeClass">@typeLabel</span></td>
                                <td>@t.Category</td>
                                <td class="@amountClass">@t.Amount.ToString("N2")</td>
                                <td>@DescLabel(t.Description)</td>
                                <td>@t.RecordedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Mobile cards *@
        <div class="mobile-only">
            <div class="mobile-cards">
                @foreach (var t in _transactions)
                {
                    var typeLabel = t.Type == 0 ? L("Income", "إيراد") : L("Expense", "مصروف");
                    var typeClass = t.Type == 0 ? "badge-active" : "badge-expired";
                    var amountClass = t.Type == 0 ? "text-success" : "text-danger";
                    <div class="mobile-card">
                        <div class="mobile-card-header">
                            <span class="mobile-card-name @amountClass">@t.Amount.ToString("N2")</span>
                            <span class="badge @typeClass">@typeLabel</span>
                        </div>
                        <div class="mobile-card-divider"></div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Date", "التاريخ")</span>
                            <span class="mobile-card-value">@t.TransactionDate.ToLocalTime().ToString("MM/dd HH:mm")</span>
                        </div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Category", "الفئة")</span>
                            <span class="mobile-card-value">@t.Category</span>
                        </div>
                        @if (!string.IsNullOrEmpty(t.Description))
                        {
                            <div class="mobile-card-row">
                                <span class="mobile-card-label">@L("Description", "الوصف")</span>
                                <span class="mobile-card-value">@DescLabel(t.Description)</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(t.RecordedBy))
                        {
                            <div class="mobile-card-row">
                                <span class="mobile-card-label">@L("By", "بواسطة")</span>
                                <span class="mobile-card-value">@t.RecordedBy</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!_transactions.Any())
        {
            <p class="no-data">@L("No transactions found", "لم يتم العثور على معاملات")</p>
        }

        @if (_totalCount > 0)
        {
            <div class="pagination">
                <button class="btn-outline btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">
                    <i class="fas fa-chevron-left"></i> @L("Previous", "السابق")
                </button>
                <span class="page-info">
                    @L("Page", "صفحة") @_page / @TotalPages (@_totalCount @L("records", "سجل"))
                </span>
                <button class="btn-outline btn-sm" disabled="@(!_hasMore)" @onclick="NextPage">
                    @L("Next", "التالي") <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    private string _period = "thismonth";
    private string _search = "";
    private decimal _periodIncome, _periodExpense, _periodProfit, _outstanding;
    private List<TransactionRow> _transactions = new();

    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private bool _hasMore => _page * PageSize < _totalCount;
    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling((double)_totalCount / PageSize);

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadDataAsync();
    }

    private (DateTime start, DateTime end) GetDateRange()
    {
        var now = DateTime.UtcNow;
        var future = now.AddHours(12);
        var today = now.Date;
        return _period switch
        {
            "today" => (today.AddHours(-6), future),
            "yesterday" => (today.AddDays(-1).AddHours(-6), today.AddHours(-6)),
            "thisweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6), future),
            "lastweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7 - 7).AddHours(-6), today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6)),
            "thismonth" => (new DateTime(now.Year, now.Month, 1).AddHours(-6), future),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1).AddMonths(-1).AddHours(-6),
                            new DateTime(now.Year, now.Month, 1).AddHours(-6)),
            "last3months" => (today.AddMonths(-3).AddHours(-6), future),
            "last6months" => (today.AddMonths(-6).AddHours(-6), future),
            "thisyear" => (new DateTime(now.Year, 1, 1).AddHours(-6), future),
            "all" => (DateTime.MinValue, future),
            _ => (today.AddHours(-6), future)
        };
    }

    private (DateTime start, DateTime end) GetDateRangeFor(string p)
    {
        var now = DateTime.UtcNow;
        var future = now.AddHours(12);
        var today = now.Date;
        return p switch
        {
            "today" => (today.AddHours(-6), future),
            "yesterday" => (today.AddDays(-1).AddHours(-6), today.AddHours(-6)),
            "thisweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6), future),
            "lastweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7 - 7).AddHours(-6), today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6)),
            "thismonth" => (new DateTime(now.Year, now.Month, 1).AddHours(-6), future),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1).AddMonths(-1).AddHours(-6),
                            new DateTime(now.Year, now.Month, 1).AddHours(-6)),
            "last3months" => (today.AddMonths(-3).AddHours(-6), future),
            "last6months" => (today.AddMonths(-6).AddHours(-6), future),
            "thisyear" => (new DateTime(now.Year, 1, 1).AddHours(-6), future),
            "all" => (DateTime.MinValue, future),
            _ => (today.AddHours(-6), future)
        };
    }

    private string GetFilterTooltip(string period)
    {
        var (s, e) = GetDateRangeFor(period);
        var startStr = s == DateTime.MinValue ? "" : s.ToString("yyyy-MM-dd");
        var endStr = e > DateTime.UtcNow.AddHours(10) ? L("Now", "الآن") : e.ToString("yyyy-MM-dd");

        return period switch
        {
            "all" => L("Show all records without date filter", "عرض جميع السجلات بدون فلتر تاريخ"),
            "today" => L($"Records from today ({startStr} → {endStr})", $"سجلات اليوم ({startStr} → {endStr})"),
            "yesterday" => L($"Records from yesterday ({startStr} → {endStr})", $"سجلات الأمس ({startStr} → {endStr})"),
            "thisweek" => L($"This week ({startStr} → {endStr})", $"هذا الأسبوع ({startStr} → {endStr})"),
            "lastweek" => L($"Last week ({startStr} → {endStr})", $"الأسبوع الماضي ({startStr} → {endStr})"),
            "thismonth" => L($"This month ({startStr} → {endStr})", $"هذا الشهر ({startStr} → {endStr})"),
            "lastmonth" => L($"Last month ({startStr} → {endStr})", $"الشهر الماضي ({startStr} → {endStr})"),
            "last3months" => L($"Last 3 months ({startStr} → {endStr})", $"آخر 3 أشهر ({startStr} → {endStr})"),
            "last6months" => L($"Last 6 months ({startStr} → {endStr})", $"آخر 6 أشهر ({startStr} → {endStr})"),
            "thisyear" => L($"This year ({startStr} → {endStr})", $"هذا العام ({startStr} → {endStr})"),
            _ => ""
        };
    }

    private async Task SetPeriod(string period)
    {
        _period = period;
        _page = 1;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var (from, to) = GetDateRange();
            var isAll = _period == "all";

            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            // Outstanding balance (always all-time)
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT COALESCE(SUM(""SubscriptionFee"" - ""AmountPaid""), 0)
                  FROM ""Players"" WHERE ""IsDeleted"" = FALSE AND ""SubscriptionFee"" > ""AmountPaid""", conn))
            {
                _outstanding = Convert.ToDecimal(await cmd.ExecuteScalarAsync());
            }

            // Period totals
            var whereClause = isAll ? "" : @" WHERE ""TransactionDate"" >= @from AND ""TransactionDate"" < @to";
            using (var cmd = new Npgsql.NpgsqlCommand(
                $@"SELECT
                    COALESCE(SUM(CASE WHEN ""Type"" = 0 THEN ""Amount"" ELSE 0 END), 0),
                    COALESCE(SUM(CASE WHEN ""Type"" = 1 THEN ""Amount"" ELSE 0 END), 0)
                  FROM ""Transactions""{whereClause}", conn))
            {
                if (!isAll)
                {
                    cmd.Parameters.AddWithValue("from", from);
                    cmd.Parameters.AddWithValue("to", to);
                }
                using var r = await cmd.ExecuteReaderAsync();
                if (await r.ReadAsync())
                {
                    _periodIncome = r.GetDecimal(0);
                    _periodExpense = r.GetDecimal(1);
                }
            }
            _periodProfit = _periodIncome - _periodExpense;

            // List + count. Join Players so we can search by player name or card number.
            // While searching we ignore the date filter so a person's FULL history shows
            // (no more paging through to find one member).
            var searching = !string.IsNullOrWhiteSpace(_search);
            var applyDate = !searching && !isAll;
            var conds = new List<string>();
            if (applyDate) conds.Add(@"t.""TransactionDate"" >= @from AND t.""TransactionDate"" < @to");
            if (searching) conds.Add(@"(t.""Description"" LIKE @q OR t.""Category"" ILIKE @q
                                       OR p.""FullNameEn"" ILIKE @q OR p.""FullNameAr"" LIKE @q OR p.""CardNo"" LIKE @q)");
            var where = conds.Count > 0 ? "WHERE " + string.Join(" AND ", conds) : "";
            const string fromJoin = @"FROM ""Transactions"" t LEFT JOIN ""Players"" p ON t.""RelatedEmployeeId"" = p.""Id""";

            // Count
            using (var countCmd = new Npgsql.NpgsqlCommand($"SELECT COUNT(*) {fromJoin} {where}", conn))
            {
                if (applyDate) { countCmd.Parameters.AddWithValue("from", from); countCmd.Parameters.AddWithValue("to", to); }
                if (searching) countCmd.Parameters.AddWithValue("q", $"%{_search.Trim()}%");
                _totalCount = Convert.ToInt32(await countCmd.ExecuteScalarAsync());
            }

            // Transactions (paginated)
            using (var cmd = new Npgsql.NpgsqlCommand(
                $@"SELECT t.""Id"", t.""Type"", COALESCE(t.""Category"",''), t.""Amount"", COALESCE(t.""Description"",''),
                         t.""TransactionDate"", COALESCE(t.""RecordedBy"",'')
                  {fromJoin} {where}
                  ORDER BY t.""TransactionDate"" DESC LIMIT @limit OFFSET @offset", conn))
            {
                if (applyDate) { cmd.Parameters.AddWithValue("from", from); cmd.Parameters.AddWithValue("to", to); }
                if (searching) cmd.Parameters.AddWithValue("q", $"%{_search.Trim()}%");
                cmd.Parameters.AddWithValue("limit", PageSize);
                cmd.Parameters.AddWithValue("offset", (_page - 1) * PageSize);

                using var r = await cmd.ExecuteReaderAsync();
                _transactions = new List<TransactionRow>();
                while (await r.ReadAsync())
                {
                    _transactions.Add(new TransactionRow(
                        r.GetInt32(0), r.GetInt32(1), r.GetString(2), r.GetDecimal(3),
                        r.GetString(4), r.GetDateTime(5), r.GetString(6)));
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerFinance] LoadDataAsync Error: {ex.Message}"); }
    }

    private async Task OnSearch()
    {
        if (_search.Length > 100) _search = _search[..100];
        _page = 1;
        await LoadDataAsync();
    }

    // Collapse the stored description to what the gym owner wants to read:
    //   subscription payments -> "اشتراك جديد" / "تجديد اشتراك"
    //   everything else (manual income/expense) -> the Arabic text only (strip English).
    private string DescLabel(string desc)
    {
        var d = desc ?? "";
        var low = d.ToLowerInvariant();
        if (low.Contains("renew") || d.Contains("تجديد")) return "تجديد اشتراك";
        if ((low.Contains("new") && low.Contains("subsc")) || d.Contains("اشتراك جديد")) return "اشتراك جديد";

        // Non-subscription: keep only the Arabic portion (drop Latin words like the EN label).
        var arabic = System.Text.RegularExpressions.Regex.Replace(d, "[A-Za-z]+", " ");
        arabic = System.Text.RegularExpressions.Regex.Replace(arabic, @"\s{2,}", " ").Trim();
        arabic = arabic.Trim(' ', ':', '-', '(', ')', '|');
        return string.IsNullOrWhiteSpace(arabic) ? d : arabic;
    }

    private async Task NextPage()
    {
        if (_hasMore) { _page++; await LoadDataAsync(); }
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadDataAsync(); }
    }
}
