@page "/"
@layout AccessControlPro.Web.Components.Layout.LandingLayout
@inject AccessControlPro.Web.Services.SessionState Session

<!-- Hero Section -->
<section class="landing-hero" dir="@Session.Dir">
    <div class="hero-bg-effects">
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
        <div class="hero-grid-overlay"></div>
    </div>
    <div class="hero-content">
        <div class="hero-badge">
            <i class="fas fa-bolt"></i> @L("Next-Generation Gym Management", "الجيل الجديد من إدارة النوادي")
        </div>
        <h1 class="hero-title">
            <span class="gradient-text">HM-GymManagement</span>
        </h1>
        <p class="hero-subtitle">
            @L("Complete Gym & Access Control Management System", "نظام إدارة النوادي الرياضية والتحكم بالوصول")
        </p>
        <div class="hero-buttons">
            <a href="https://wa.me/9647812573845?text=Hi%2C%20I%27m%20interested%20in%20HM-GymManagement%20software.%20I%27d%20like%20to%20request%20a%20demo."
               target="_blank" class="btn-whatsapp">
                <i class="fab fa-whatsapp"></i> @L("Request Free Demo", "طلب عرض مجاني")
            </a>
            <a href="/login" class="btn-outline">
                <i class="fas fa-sign-in-alt"></i> @L("Login", "تسجيل الدخول")
            </a>
        </div>
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="hero-stat-number">500+</span>
                <span class="hero-stat-label">@L("Active Gyms", "نادي نشط")</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">50K+</span>
                <span class="hero-stat-label">@L("Members Managed", "عضو مُدار")</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">99.9%</span>
                <span class="hero-stat-label">@L("Uptime", "وقت التشغيل")</span>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="landing-section" dir="@Session.Dir">
    <div class="section-header">
        <span class="section-tag"><i class="fas fa-star"></i> @L("Features", "المميزات")</span>
        <h2>@L("Everything You Need to", "كل ما تحتاجه") <span class="gradient-text">@L("Run Your Gym", "لإدارة ناديك")</span></h2>
        <p class="section-desc">@L("Powerful tools designed for modern fitness businesses", "أدوات قوية مصممة لأعمال اللياقة البدنية الحديثة")</p>
    </div>
    <div class="features-grid">
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #4FC3F7;">
                <i class="fas fa-dumbbell"></i>
            </div>
            <h3>@L("Player Management", "إدارة اللاعبين")</h3>
            <p>@L("Register, renew, freeze, and track subscriptions. Full player profiles with photos, cards, and history.", "تسجيل، تجديد، تجميد، ومتابعة الاشتراكات. ملفات لاعبين كاملة مع الصور والبطاقات والسجل.")</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #2ED47A;">
                <i class="fas fa-fingerprint"></i>
            </div>
            <h3>@L("Access Control", "التحكم بالوصول")</h3>
            <p>@L("RFID card management, door control, real-time entry/exit monitoring with hardware integration.", "إدارة بطاقات RFID، التحكم بالأبواب، مراقبة الدخول/الخروج مع تكامل الأجهزة.")</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #FFB74D;">
                <i class="fas fa-wallet"></i>
            </div>
            <h3>@L("Finance", "المالية")</h3>
            <p>@L("Track income, expenses, cash flow, and payments. Complete financial reports and analytics.", "تتبع الدخل والمصروفات والتدفق النقدي والمدفوعات. تقارير مالية وتحليلات شاملة.")</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #E57373;">
                <i class="fas fa-chart-pie"></i>
            </div>
            <h3>@L("Cloud Portal", "البوابة السحابية")</h3>
            <p>@L("Monitor your gym from anywhere, any device. Real-time dashboard accessible via web browser.", "راقب ناديك من أي مكان وأي جهاز. لوحة تحكم فورية عبر المتصفح.")</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #CE93D8;">
                <i class="fas fa-users-cog"></i>
            </div>
            <h3>@L("Multi-User", "تعدد المستخدمين")</h3>
            <p>@L("Role-based permissions with admin panel. Receptionist, manager, and owner access levels.", "صلاحيات حسب الأدوار مع لوحة إدارة. مستويات وصول للموظف والمدير والمالك.")</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #44A1A0;">
                <i class="fas fa-mobile-alt"></i>
            </div>
            <h3>@L("Mobile App", "تطبيق الجوال")</h3>
            <p>@L("Players check their subscription status, visit history, and remaining days on their phone.", "يتحقق اللاعبون من حالة اشتراكهم وسجل الزيارات والأيام المتبقية من هواتفهم.")</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #F06292;">
                <i class="fas fa-bell"></i>
            </div>
            <h3>@L("Smart Alerts", "تنبيهات ذكية")</h3>
            <p>@L("Expiry reminders via WhatsApp, automated backup, and intelligent notifications.", "تذكيرات انتهاء عبر واتساب، نسخ احتياطي تلقائي، وإشعارات ذكية.")</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #81C784;">
                <i class="fas fa-language"></i>
            </div>
            <h3>@L("Bilingual", "ثنائي اللغة")</h3>
            <p>@L("Full Arabic and English support. Switch languages instantly throughout the entire system.", "دعم كامل للعربية والإنجليزية. تبديل اللغات فوراً في جميع أنحاء النظام.")</p>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section id="how-it-works" class="landing-section landing-section-alt" dir="@Session.Dir">
    <div class="section-header">
        <span class="section-tag"><i class="fas fa-cogs"></i> @L("How It Works", "كيف يعمل")</span>
        <h2>@L("Get Started in", "ابدأ في") <span class="gradient-text">@L("3 Simple Steps", "3 خطوات بسيطة")</span></h2>
        <p class="section-desc">@L("Up and running in under 30 minutes", "جاهز للعمل في أقل من 30 دقيقة")</p>
    </div>
    <div class="steps-container">
        <div class="steps-line"></div>
        <div class="step-card fade-in">
            <div class="step-number">1</div>
            <div class="step-icon"><i class="fas fa-download"></i></div>
            <h3>@L("Install Software", "تثبيت البرنامج")</h3>
            <p>@L("Install HM-GymManagement software at your gym. Quick setup in under 30 minutes.", "ثبّت برنامج HM-GymManagement في ناديك. إعداد سريع في أقل من 30 دقيقة.")</p>
        </div>
        <div class="step-card fade-in">
            <div class="step-number">2</div>
            <div class="step-icon"><i class="fas fa-plug"></i></div>
            <h3>@L("Connect Devices", "ربط الأجهزة")</h3>
            <p>@L("Connect your access control devices — RFID readers, turnstiles, and door controllers.", "اربط أجهزة التحكم بالوصول — قارئات RFID، البوابات الدوارة، ووحدات التحكم بالأبواب.")</p>
        </div>
        <div class="step-card fade-in">
            <div class="step-number">3</div>
            <div class="step-icon"><i class="fas fa-rocket"></i></div>
            <h3>@L("Manage Everything", "أدِر كل شيء")</h3>
            <p>@L("Manage players, finances, and access control from one unified platform.", "أدِر اللاعبين والمالية والتحكم بالوصول من منصة واحدة موحدة.")</p>
        </div>
    </div>
</section>

<!-- Pricing Section -->
