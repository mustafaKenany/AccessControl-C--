@page "/"
@layout AccessControlPro.Web.Components.Layout.LandingLayout

<!-- Hero Section -->
<section class="landing-hero">
    <div class="hero-bg-effects">
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
        <div class="hero-grid-overlay"></div>
    </div>
    <div class="hero-content">
        <div class="hero-badge">
            <i class="fas fa-bolt"></i> Next-Generation Gym Management
        </div>
        <h1 class="hero-title">
            <span class="gradient-text">HM-GymManagement</span>
        </h1>
        <p class="hero-subtitle">
            Complete Gym & Access Control Management System
        </p>
        <p class="hero-subtitle-ar">
            نظام إدارة النوادي الرياضية والتحكم بالوصول
        </p>
        <div class="hero-buttons">
            <a href="https://wa.me/9647812573845?text=Hi%2C%20I%27m%20interested%20in%20HM-GymManagement%20software.%20I%27d%20like%20to%20request%20a%20demo."
               target="_blank" class="btn-whatsapp">
                <i class="fab fa-whatsapp"></i> Request Free Demo
            </a>
            <a href="/login" class="btn-outline">
                <i class="fas fa-sign-in-alt"></i> Login / تسجيل الدخول
            </a>
        </div>
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="hero-stat-number">500+</span>
                <span class="hero-stat-label">Active Gyms</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">50K+</span>
                <span class="hero-stat-label">Members Managed</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">99.9%</span>
                <span class="hero-stat-label">Uptime</span>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="landing-section">
    <div class="section-header">
        <span class="section-tag"><i class="fas fa-star"></i> Features</span>
        <h2>Everything You Need to <span class="gradient-text">Run Your Gym</span></h2>
        <p class="section-desc">Powerful tools designed for modern fitness businesses</p>
    </div>
    <div class="features-grid">
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #4FC3F7;">
                <i class="fas fa-dumbbell"></i>
            </div>
            <h3>Player Management</h3>
            <p>Register, renew, freeze, and track subscriptions. Full player profiles with photos, cards, and history.</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #2ED47A;">
                <i class="fas fa-fingerprint"></i>
            </div>
            <h3>Access Control</h3>
            <p>RFID card management, door control, real-time entry/exit monitoring with hardware integration.</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #FFB74D;">
                <i class="fas fa-wallet"></i>
            </div>
            <h3>Finance</h3>
            <p>Track income, expenses, cash flow, and payments. Complete financial reports and analytics.</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #E57373;">
                <i class="fas fa-chart-pie"></i>
            </div>
            <h3>Cloud Portal</h3>
            <p>Monitor your gym from anywhere, any device. Real-time dashboard accessible via web browser.</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #CE93D8;">
                <i class="fas fa-users-cog"></i>
            </div>
            <h3>Multi-User</h3>
            <p>Role-based permissions with admin panel. Receptionist, manager, and owner access levels.</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #44A1A0;">
                <i class="fas fa-mobile-alt"></i>
            </div>
            <h3>Mobile App</h3>
            <p>Players check their subscription status, visit history, and remaining days on their phone.</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #F06292;">
                <i class="fas fa-bell"></i>
            </div>
            <h3>Smart Alerts</h3>
            <p>Expiry reminders via WhatsApp, automated backup, and intelligent notifications.</p>
        </div>
        <div class="feature-card fade-in">
            <div class="feature-icon-wrap" style="--icon-color: #81C784;">
                <i class="fas fa-language"></i>
            </div>
            <h3>Bilingual</h3>
            <p>Full Arabic and English support. Switch languages instantly throughout the entire system.</p>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section id="how-it-works" class="landing-section landing-section-alt">
    <div class="section-header">
        <span class="section-tag"><i class="fas fa-cogs"></i> How It Works</span>
        <h2>Get Started in <span class="gradient-text">3 Simple Steps</span></h2>
        <p class="section-desc">Up and running in under 30 minutes</p>
    </div>
    <div class="steps-container">
        <div class="steps-line"></div>
        <div class="step-card fade-in">
            <div class="step-number">1</div>
            <div class="step-icon"><i class="fas fa-download"></i></div>
            <h3>Install Software</h3>
            <p>Install HM-GymManagement software at your gym. Quick setup in under 30 minutes.</p>
        </div>
        <div class="step-card fade-in">
            <div class="step-number">2</div>
            <div class="step-icon"><i class="fas fa-plug"></i></div>
            <h3>Connect Devices</h3>
            <p>Connect your access control devices — RFID readers, turnstiles, and door controllers.</p>
        </div>
        <div class="step-card fade-in">
            <div class="step-number">3</div>
            <div class="step-icon"><i class="fas fa-rocket"></i></div>
            <h3>Manage Everything</h3>
            <p>Manage players, finances, and access control from one unified platform.</p>
        </div>
    </div>
</section>

