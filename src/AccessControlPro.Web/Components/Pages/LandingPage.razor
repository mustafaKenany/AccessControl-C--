<!-- Contact/Demo Section -->
<section id="contact" class="landing-section" dir="@Session.Dir">
    <div class="section-header">
        <span class="section-tag"><i class="fas fa-headset"></i> @L("Get In Touch", "تواصل معنا")</span>
        <h2>@L("Ready to", "مستعد لـ") <span class="gradient-text">@L("Get Started?", "البدء؟")</span></h2>
        <p class="section-desc">@L("Request a free demo and see HM-GymManagement in action", "اطلب عرضاً مجانياً وشاهد HM-GymManagement أثناء العمل")</p>
    </div>
    <div class="contact-container">
        <div class="contact-form-card">
            <h3><i class="fas fa-paper-plane"></i> @L("Request Free Demo", "طلب عرض مجاني")</h3>
            <p>@L("Fill in your details and we'll get back to you via WhatsApp", "أدخل بياناتك وسنتواصل معك عبر واتساب")</p>
            <div class="demo-form">
                <div class="form-group">
                    <div class="form-icon"><i class="fas fa-user"></i></div>
                    <input type="text" class="form-input" placeholder="@L("Your Name", "الاسم")" @bind="demoName" />
                </div>
                <div class="form-group">
                    <div class="form-icon"><i class="fas fa-phone"></i></div>
                    <input type="tel" class="form-input" placeholder="@L("Phone Number", "رقم الهاتف")" @bind="demoPhone" />
                </div>
                <div class="form-group">
                    <div class="form-icon"><i class="fas fa-building"></i></div>
                    <input type="text" class="form-input" placeholder="@L("Gym Name", "اسم النادي")" @bind="demoGymName" />
                </div>
                <a href="@GetWhatsAppDemoUrl()" target="_blank" class="btn-whatsapp btn-full">
                    <i class="fab fa-whatsapp"></i> @L("Send via WhatsApp", "إرسال عبر واتساب")
                </a>
            </div>
        </div>
        <div class="contact-info-card">
            <h3><i class="fas fa-map-marker-alt"></i> @L("Contact Info", "معلومات التواصل")</h3>
            <div class="contact-info-items">
                <a href="https://wa.me/9647812573845" target="_blank" class="contact-info-item">
                    <div class="contact-info-icon whatsapp"><i class="fab fa-whatsapp"></i></div>
                    <div>
                        <strong>@L("WhatsApp", "واتساب")</strong>
                        <span>+964 781 257 3845</span>
                    </div>
                </a>
                <a href="tel:+9647812573845" class="contact-info-item">
                    <div class="contact-info-icon phone"><i class="fas fa-phone"></i></div>
                    <div>
                        <strong>@L("Phone", "الهاتف")</strong>
                        <span>+964 781 257 3845</span>
                    </div>
                </a>
                <a href="mailto:mustafa.kenany2022@gmail.com" class="contact-info-item">
                    <div class="contact-info-icon email"><i class="fas fa-envelope"></i></div>
                    <div>
                        <strong>@L("Email", "البريد الإلكتروني")</strong>
                        <span>mustafa.kenany2022@gmail.com</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private string demoName = "";
    private string demoPhone = "";
    private string demoGymName = "";

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    private string GetWhatsAppDemoUrl()
    {
        var message = $"Hi, I'm interested in HM-GymManagement software.\nName: {demoName}\nGym: {demoGymName}\nPhone: {demoPhone}";
        return $"https://wa.me/9647812573845?text={Uri.EscapeDataString(message)}";
    }
}
