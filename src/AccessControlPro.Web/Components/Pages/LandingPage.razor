@page "/"
@layout AccessControlPro.Web.Components.Layout.LandingLayout

<!-- Hero Section -->
<section class="landing-hero">
    <h1>HM-GymManagement</h1>
    <p class="subtitle">Complete Gym & Access Control Management System</p>
    <p class="subtitle-ar">نظام إدارة النوادي الرياضية والتحكم بالوصول</p>
    <div class="landing-hero-buttons">
        <a href="https://wa.me/+9647700000000?text=Hi%20HMTech%2C%20I%27d%20like%20to%20request%20a%20demo%20of%20HM-GymManagement"
           target="_blank" class="btn-demo">
            <i class="fab fa-whatsapp"></i> Request Demo
        </a>
        <a href="/login" class="btn-login-hero">
            Login / تسجيل الدخول
        </a>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="landing-section">
    <h2>Features</h2>
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">🏋️</div>
            <h3>Player Management</h3>
            <p>Register, renew, freeze, and track subscriptions. Full player profiles with photos, cards, and history.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🔐</div>
            <h3>Access Control</h3>
            <p>RFID card management, door control, real-time entry/exit monitoring with hardware integration.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">💰</div>
            <h3>Finance</h3>
            <p>Track income, expenses, cash flow, and payments. Complete financial reports and analytics.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>Cloud Portal</h3>
            <p>Monitor your gym from anywhere, any device. Real-time dashboard accessible via web browser.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">👥</div>
            <h3>Multi-User</h3>
            <p>Role-based permissions with admin panel. Receptionist, manager, and owner access levels.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>Mobile App</h3>
            <p>Players check their subscription status, visit history, and remaining days on their phone.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🔔</div>
            <h3>Smart Alerts</h3>
            <p>Expiry reminders via WhatsApp, automated backup, and intelligent notifications.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🌐</div>
            <h3>Bilingual</h3>
            <p>Full Arabic and English support. Switch languages instantly throughout the entire system.</p>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="landing-section">
    <h2>How It Works</h2>
    <div class="steps-grid">
        <div class="step-item">
            <div class="step-number">1</div>
            <h3>Install Software</h3>
            <p>Install HM-GymManagement software at your gym. Quick setup in under 30 minutes.</p>
        </div>
        <div class="step-item">
            <div class="step-number">2</div>
            <h3>Connect Devices</h3>
            <p>Connect your access control devices — RFID readers, turnstiles, and door controllers.</p>
        </div>
        <div class="step-item">
            <div class="step-number">3</div>
            <h3>Manage Everything</h3>
            <p>Manage players, finances, and access control from one unified platform.</p>
        </div>
    </div>
</section>

<!-- Pricing Section -->
<section id="pricing" class="landing-section">
    <h2>Pricing</h2>
    <div class="pricing-grid">
        <div class="pricing-card">
            <h3>Basic</h3>
            <div class="pricing-price">$200</div>
            <div class="pricing-period">One-time payment</div>
            <ul class="pricing-features">
                <li>Local desktop software</li>
                <li>Player management</li>
                <li>Access control integration</li>
                <li>Finance tracking</li>
                <li>Multi-user support</li>
                <li>Bilingual (AR/EN)</li>
            </ul>
            <a href="https://wa.me/+9647700000000?text=Hi%20HMTech%2C%20I%27m%20interested%20in%20the%20Basic%20plan"
               target="_blank" class="btn-demo" style="display:block; text-align:center;">Get Started</a>
        </div>
        <div class="pricing-card featured">
            <h3>Pro</h3>
            <div class="pricing-price">$200 <span style="font-size:1rem; color:#A0B4B5;">+ $10/mo</span></div>
            <div class="pricing-period">Setup + monthly subscription</div>
            <ul class="pricing-features">
                <li>Everything in Basic</li>
                <li>Cloud portal access</li>
                <li>Mobile app for players</li>
                <li>Real-time cloud sync</li>
                <li>WhatsApp notifications</li>
                <li>Automated backups</li>
                <li>Priority email support</li>
            </ul>
            <a href="https://wa.me/+9647700000000?text=Hi%20HMTech%2C%20I%27m%20interested%20in%20the%20Pro%20plan"
               target="_blank" class="btn-demo" style="display:block; text-align:center;">Get Started</a>
        </div>
        <div class="pricing-card">
            <h3>Enterprise</h3>
            <div class="pricing-price">$500 <span style="font-size:1rem; color:#A0B4B5;">+ $20/mo</span></div>
            <div class="pricing-period">Setup + monthly subscription</div>
            <ul class="pricing-features">
                <li>Everything in Pro</li>
                <li>Multi-branch support</li>
                <li>Advanced analytics</li>
                <li>Custom reports</li>
                <li>Priority phone support</li>
                <li>On-site installation</li>
                <li>Staff training included</li>
            </ul>
            <a href="https://wa.me/+9647700000000?text=Hi%20HMTech%2C%20I%27m%20interested%20in%20the%20Enterprise%20plan"
               target="_blank" class="btn-demo" style="display:block; text-align:center;">Get Started</a>
        </div>
    </div>
</section>

<!-- Screenshots Section -->
<section class="landing-section">
    <h2>Screenshots</h2>
    <div class="screenshots-grid">
        <div class="screenshot-placeholder">
            <div class="screenshot-box" style="background: linear-gradient(135deg, #1A4A4D, #0E2E30);">
                <i class="fas fa-chart-line" style="font-size:2rem;"></i>
                <span>Dashboard Overview</span>
            </div>
        </div>
        <div class="screenshot-placeholder">
            <div class="screenshot-box" style="background: linear-gradient(135deg, #2d7a79, #1A4A4D);">
                <i class="fas fa-users" style="font-size:2rem;"></i>
                <span>Players Management</span>
            </div>
        </div>
        <div class="screenshot-placeholder">
            <div class="screenshot-box" style="background: linear-gradient(135deg, #1A4A4D, #123A3D);">
                <i class="fas fa-desktop" style="font-size:2rem;"></i>
                <span>Real-time Monitor</span>
            </div>
        </div>
        <div class="screenshot-placeholder">
            <div class="screenshot-box" style="background: linear-gradient(135deg, #0E2E30, #1A4A4D);">
                <i class="fas fa-mobile-alt" style="font-size:2rem;"></i>
                <span>Cloud Portal on Mobile</span>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="landing-section">
    <div class="contact-section">
        <h2 style="color: #44A1A0; margin-bottom: 1rem;">Request Free Demo</h2>
        <p style="color: #A0B4B5; margin-bottom: 2rem;">Fill in your details and we'll get back to you via WhatsApp</p>

        <div class="demo-form">
            <div class="form-group">
                <input type="text" class="form-input" placeholder="Your Name / الاسم" @bind="demoName" />
            </div>
            <div class="form-group">
                <input type="tel" class="form-input" placeholder="Phone Number / رقم الهاتف" @bind="demoPhone" />
            </div>
            <div class="form-group">
                <input type="text" class="form-input" placeholder="Gym Name / اسم النادي" @bind="demoGymName" />
            </div>
            <a href="@GetWhatsAppDemoUrl()" target="_blank" class="btn-demo" style="display:block; text-align:center; margin-top:1rem;">
                <i class="fab fa-whatsapp"></i> Send via WhatsApp
            </a>
        </div>

        <div style="margin-top: 2rem; display: flex; flex-direction: column; gap: 0.75rem; align-items: center;">
            <a href="https://wa.me/+9647700000000" target="_blank" class="btn-demo" style="width:280px; text-align:center;">
                <i class="fab fa-whatsapp"></i> Chat on WhatsApp
            </a>
            <p style="color: #A0B4B5; font-size: 0.9rem;"><i class="fas fa-phone"></i> +964 770 000 0000</p>
            <p style="color: #A0B4B5; font-size: 0.9rem;"><i class="fas fa-envelope"></i> info@hmtech.solutions</p>
        </div>
    </div>
</section>

@code {
    private string demoName = "";
    private string demoPhone = "";
    private string demoGymName = "";

    private string GetWhatsAppDemoUrl()
    {
        var message = $"Hi HMTech, I'd like to request a demo.\nName: {demoName}\nPhone: {demoPhone}\nGym: {demoGymName}";
        return $"https://wa.me/+9647700000000?text={Uri.EscapeDataString(message)}";
    }
}
