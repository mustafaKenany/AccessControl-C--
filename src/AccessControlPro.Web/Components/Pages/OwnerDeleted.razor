@page "/deleted"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@rendermode InteractiveServer

@* TODO: Currently checks Session.IsOwner only. When granular cloud permissions are added,
   enforce AppPermission checks per page (e.g., DeletedRecordsView for this page). *@
@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-trash"></i> @L("Deleted Records", "المحذوفات")</h1>
        <span class="last-sync">@L("Total", "الإجمالي"): @_totalCount</span>
    </div>

    <div class="search-bar">
        <input type="text" @bind="_search" @bind:event="oninput" @onkeyup="OnSearch"
               class="form-input" placeholder="@L("Search by name, phone, or card...", "ابحث بالاسم أو الهاتف أو البطاقة...")" />
    </div>

    <div class="content-card">
        @* Desktop table *@
        <div class="desktop-only">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Original ID", "المعرف الأصلي")</th>
                            <th>@L("Name (EN)", "الاسم (إنجليزي)")</th>
                            <th>@L("Name (AR)", "الاسم (عربي)")</th>
                            <th>@L("Card No", "رقم البطاقة")</th>
                            <th>@L("Phone", "الهاتف")</th>
                            <th>@L("Delete Reason", "سبب الحذف")</th>
                            <th>@L("Deleted By", "حُذف بواسطة")</th>
                            <th>@L("Deleted At", "تاريخ الحذف")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _deleted)
                        {
                            <tr>
                                <td>@d.OriginalId</td>
                                <td>@d.FullNameEn</td>
                                <td dir="rtl">@d.FullNameAr</td>
                                <td>@d.CardNo</td>
                                <td>@d.Phone</td>
                                <td>@AccessControlPro.Web.Services.DualLanguageText.Single(d.DeleteReason, Session.IsArabic)</td>
                                <td>@d.DeletedBy</td>
                                <td>@d.DeletedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Mobile cards *@
        <div class="mobile-only">
            <div class="mobile-cards">
                @foreach (var d in _deleted)
                {
                    var name = Session.IsArabic && !string.IsNullOrEmpty(d.FullNameAr) ? d.FullNameAr : d.FullNameEn;
                    var nameSecondary = Session.IsArabic ? d.FullNameEn : d.FullNameAr;
                    <div class="mobile-card">
                        <div class="mobile-card-header">
                            <div>
                                <span class="mobile-card-name">@name</span>
                                @if (!string.IsNullOrEmpty(nameSecondary))
                                {
                                    <div class="mobile-card-sub">@nameSecondary</div>
                                }
                            </div>
                            <span class="badge badge-expired">@L("Deleted", "محذوف")</span>
                        </div>
                        <div class="mobile-card-divider"></div>
                        @if (!string.IsNullOrEmpty(d.CardNo))
                        {
                            <div class="mobile-card-row">
                                <span class="mobile-card-label">@L("Card", "البطاقة")</span>
                                <span class="mobile-card-value">@d.CardNo</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(d.Phone))
                        {
                            <div class="mobile-card-row">
                                <span class="mobile-card-label">@L("Phone", "الهاتف")</span>
                                <span class="mobile-card-value">@d.Phone</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(d.DeleteReason))
                        {
                            <div class="mobile-card-row">
                                <span class="mobile-card-label">@L("Reason", "السبب")</span>
                                <span class="mobile-card-value" style="max-width: 60%; text-align: right;">@AccessControlPro.Web.Services.DualLanguageText.Single(d.DeleteReason, Session.IsArabic)</span>
                            </div>
                        }
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Deleted By", "حُذف بواسطة")</span>
                            <span class="mobile-card-value">@d.DeletedBy</span>
                        </div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Date", "التاريخ")</span>
                            <span class="mobile-card-value">@d.DeletedAt.ToLocalTime().ToString("MM/dd HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!_deleted.Any())
        {
            <p class="no-data">@L("No deleted records found", "لم يتم العثور على سجلات محذوفة")</p>
        }

        @if (_totalCount > 0)
        {
            <div class="pagination">
                <button class="btn-outline btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">
                    <i class="fas fa-chevron-left"></i> @L("Previous", "السابق")
                </button>
                <span class="page-info">
                    @L("Page", "صفحة") @_page / @TotalPages (@_totalCount @L("records", "سجل"))
                </span>
                <button class="btn-outline btn-sm" disabled="@(!_hasMore)" @onclick="NextPage">
                    @L("Next", "التالي") <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    private string _search = "";
    private List<DeletedRow> _deleted = new();

    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private bool _hasMore => _page * PageSize < _totalCount;
    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling((double)_totalCount / PageSize);

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadDeletedAsync();
    }

    private async Task LoadDeletedAsync()
    {
        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            var searchWhere = "";
            if (!string.IsNullOrWhiteSpace(_search))
            {
                searchWhere = @" WHERE (LOWER(""FullNameEn"") LIKE @q OR ""FullNameAr"" LIKE @q OR ""Phone"" LIKE @q OR ""CardNo"" LIKE @q)";
            }

            // Count
            using (var countCmd = new Npgsql.NpgsqlCommand(
                $@"SELECT COUNT(*) FROM ""DeletedEmployees""{searchWhere}", conn))
            {
                if (!string.IsNullOrWhiteSpace(_search))
                    countCmd.Parameters.AddWithValue("q", $"%{_search.Trim().ToLower()}%");
                _totalCount = Convert.ToInt32(await countCmd.ExecuteScalarAsync());
            }

            // Data
            using (var cmd = new Npgsql.NpgsqlCommand(
                $@"SELECT ""Id"", COALESCE(""OriginalId"",0), COALESCE(""FullNameEn"",''), COALESCE(""FullNameAr"",''),
                         COALESCE(""CardNo"",''), COALESCE(""Phone"",''), COALESCE(""DeleteReason"",''),
                         COALESCE(""DeletedBy"",''), ""DeletedAt""
                  FROM ""DeletedEmployees""{searchWhere}
                  ORDER BY ""DeletedAt"" DESC LIMIT @limit OFFSET @offset", conn))
            {
                if (!string.IsNullOrWhiteSpace(_search))
                    cmd.Parameters.AddWithValue("q", $"%{_search.Trim().ToLower()}%");
                cmd.Parameters.AddWithValue("limit", PageSize);
                cmd.Parameters.AddWithValue("offset", (_page - 1) * PageSize);

                using var r = await cmd.ExecuteReaderAsync();
                _deleted = new List<DeletedRow>();
                while (await r.ReadAsync())
                {
                    _deleted.Add(new DeletedRow(
                        r.GetInt32(0), r.GetInt32(1), r.GetString(2), r.GetString(3),
                        r.GetString(4), r.GetString(5), r.GetString(6), r.GetString(7), r.GetDateTime(8)));
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerDeleted] LoadDeletedAsync Error: {ex.Message}"); }
    }

    private async Task OnSearch()
    {
        // Limit search input length to prevent abuse
        if (_search.Length > 100) _search = _search[..100];
        _page = 1;
        await LoadDeletedAsync();
    }

    private async Task NextPage()
    {
        if (_hasMore) { _page++; await LoadDeletedAsync(); }
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadDeletedAsync(); }
    }

    private record DeletedRow(int Id, int OriginalId, string FullNameEn, string FullNameAr,
        string CardNo, string Phone, string DeleteReason, string DeletedBy, DateTime DeletedAt);
}
