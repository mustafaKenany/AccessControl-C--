@page "/dashboard"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpCtx
@rendermode InteractiveServer

@if (_pageLoading)
{
    <div style="display:flex; justify-content:center; align-items:center; min-height:50vh; color:var(--accent);">
        <i class="fas fa-spinner fa-spin" style="font-size:2rem;"></i>
    </div>
}
else if (Session.IsAuthenticated && Session.IsOwner)
{
    <div class="sync-info-bar">
        <div class="sync-info-left">
            <i class="fas fa-sync"></i>
            <span>@L("Last sync from gym PC", "آخر مزامنة من جهاز النادي"): @(_lastSync?.ToString("yyyy-MM-dd HH:mm") ?? L("Never", "لم تتم"))</span>
            @if (_lastSyncStatus != null)
            {
                <span class="badge @(_lastSyncStatus == "Success" ? "badge-active" : _lastSyncStatus == "Failed" ? "badge-expired" : "badge-expiring")">
                    @_lastSyncStatus
                </span>
            }
        </div>
        <div style="display:flex; gap:8px;">
            <button class="filter-btn" @onclick="ForceFullSync" disabled="@(_forcingFullSync || _forceFullSyncQueued)" title="@L("Resets the client's delta state — the next sync from the gym PC will resend everything.", "يعيد ضبط حالة المزامنة — ستعيد المزامنة التالية من جهاز النادي إرسال كل البيانات.")">
                <i class="fas fa-sync-alt @(_forcingFullSync ? "fa-spin" : "")"></i>
                @(_forceFullSyncQueued
                    ? L("Queued — waits for gym PC", "في الانتظار — ينتظر جهاز النادي")
                    : L("Force full sync", "مزامنة كاملة"))
            </button>
            <button class="filter-btn" @onclick="RefreshData" disabled="@_isRefreshing">
                <i class="fas fa-refresh @(_isRefreshing ? "fa-spin" : "")"></i> @L("Refresh", "تحديث")
            </button>
        </div>
    </div>

    <div class="page-header">
        <h1><i class="fas fa-chart-line"></i> @L("Dashboard", "لوحة التحكم")</h1>
        <span class="last-sync">@L("Last refresh", "آخر تحديث"): @DateTime.Now.ToString("HH:mm")</span>
    </div>

    @if (_syncErrorCount > 0)
    {
        <div class="sync-error-alert" style="background:#3a1e1e; border:1px solid #a03a3a; border-radius:6px; padding:12px 14px; margin-bottom:16px; color:#ffd6d6;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <i class="fas fa-exclamation-triangle" style="color:#ff8c8c; margin-inline-end:8px;"></i>
                    <strong>@string.Format(L("{0} sync attempt(s) had errors in the last 24 hours.", "{0} محاولة مزامنة بها أخطاء خلال 24 ساعة الماضية."), _syncErrorCount)</strong>
                </div>
                <button class="filter-btn" @onclick="() => _syncErrorsExpanded = !_syncErrorsExpanded" style="background:transparent; border:1px solid #a03a3a; color:#ffd6d6;">
                    @(_syncErrorsExpanded ? L("Hide", "إخفاء") : L("Details", "التفاصيل"))
                </button>
            </div>
            @if (_syncErrorsExpanded && !string.IsNullOrEmpty(_latestSyncErrorDetails))
            {
                <div style="margin-top:10px; padding:10px; background:#2a1414; border-radius:4px; font-family:monospace; font-size:12px; white-space:pre-wrap; max-height:200px; overflow:auto;">@_latestSyncErrorDetails</div>
            }
        </div>
    }

    <div class="stats-grid">
        <div class="stat-card teal">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_totalPlayers</div>
                <div class="stat-label">@L("Total Players", "إجمالي اللاعبين")</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon"><i class="fas fa-user-check"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_activePlayers</div>
                <div class="stat-label">@L("Active Players", "اللاعبون النشطون")</div>
            </div>
        </div>
        <div class="stat-card orange">
            <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_expiringPlayers</div>
                <div class="stat-label">@L("Expiring Soon (7 days)", "ينتهي قريباً (7 أيام)")</div>
            </div>
        </div>
        <div class="stat-card red">
            <div class="stat-icon"><i class="fas fa-user-slash"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_expiredPlayers</div>
                <div class="stat-label">@L("Expired", "منتهي")</div>
            </div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card blue">
            <div class="stat-icon"><i class="fas fa-snowflake"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_frozenPlayers</div>
                <div class="stat-label">@L("Frozen", "مجمد")</div>
            </div>
        </div>
        <div class="stat-card purple">
            <div class="stat-icon"><i class="fas fa-door-open"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_todayEntries</div>
                <div class="stat-label">@L("Today's Entries", "دخول اليوم")</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon"><i class="fas fa-arrow-up"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_monthRevenue.ToString("N0")</div>
                <div class="stat-label">@L("Monthly Revenue", "إيرادات الشهر")</div>
            </div>
        </div>
        <div class="stat-card orange">
            <div class="stat-icon"><i class="fas fa-exclamation-circle"></i></div>
            <div class="stat-content">
                <div class="stat-number">@_outstanding.ToString("N0")</div>
                <div class="stat-label">@L("Outstanding Balance", "المبالغ المتبقية")</div>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <div class="content-card">
            <h3>@L("Recent Events", "الأحداث الأخيرة")</h3>
            @if (_recentEvents.Any())
            {
                @* Desktop table *@
                <div class="desktop-only">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@L("Time", "الوقت")</th>
                                <th>@L("Player", "اللاعب")</th>
                                <th>@L("Door", "الباب")</th>
                                <th>@L("Event", "الحدث")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in _recentEvents)
                            {
                                <tr>
                                    <td>@ev.EventDate.ToIraqTime().ToString("MM/dd HH:mm")</td>
                                    <td>@GetPlayerDisplay(ev)</td>
                                    <td>@(string.IsNullOrEmpty(ev.DoorName) ? GetDoorName(ev.DoorId) : ev.DoorName)</td>
                                    <td>@GetEventName(ev.EventCode)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Mobile cards *@
                <div class="mobile-only">
                    <div class="mobile-cards">
                        @foreach (var ev in _recentEvents)
                        {
                            <div class="mobile-card">
                                <div class="mobile-card-header">
                                    <span class="mobile-card-name">@ev.EventDate.ToIraqTime().ToString("MM/dd HH:mm")</span>
                                    <span class="mobile-card-sub">@GetEventName(ev.EventCode)</span>
                                </div>
                                <div class="mobile-card-row">
                                    <span class="mobile-card-label">@L("Player", "اللاعب")</span>
                                    <span class="mobile-card-value">@GetPlayerDisplay(ev)</span>
                                </div>
                                <div class="mobile-card-row">
                                    <span class="mobile-card-label">@L("Door", "الباب")</span>
                                    <span class="mobile-card-value">@(string.IsNullOrEmpty(ev.DoorName) ? GetDoorName(ev.DoorId) : ev.DoorName)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="no-data">@L("No recent events", "لا توجد أحداث حديثة")</p>
            }
        </div>

        <div class="content-card">
            <h3>@L("Expiring Soon", "ينتهي قريباً")</h3>
            @if (_expiringList.Any())
            {
                @* Desktop table *@
                <div class="desktop-only">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@L("Player", "اللاعب")</th>
                                <th>@L("Expires", "ينتهي")</th>
                                <th>@L("Days Left", "الأيام المتبقية")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _expiringList)
                            {
                                var days = (p.EndDate - DateTime.UtcNow).Days;
                                <tr>
                                    <td>@(Session.IsArabic && !string.IsNullOrEmpty(p.FullNameAr) ? p.FullNameAr : p.FullNameEn)</td>
                                    <td>@p.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td class="@(days <= 3 ? "text-danger" : "text-warning")">@days</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Mobile cards *@
                <div class="mobile-only">
                    <div class="mobile-cards">
                        @foreach (var p in _expiringList)
                        {
                            var days = (p.EndDate - DateTime.UtcNow).Days;
                            <div class="mobile-card">
                                <div class="mobile-card-header">
                                    <span class="mobile-card-name">@(Session.IsArabic && !string.IsNullOrEmpty(p.FullNameAr) ? p.FullNameAr : p.FullNameEn)</span>
                                    <span class="badge @(days <= 3 ? "badge-expired" : "badge-expiring")">@days @L("days", "يوم")</span>
                                </div>
                                <div class="mobile-card-row">
                                    <span class="mobile-card-label">@L("Expires", "ينتهي")</span>
                                    <span class="mobile-card-value">@p.EndDate.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="no-data">@L("No expiring subscriptions", "لا توجد اشتراكات تنتهي قريباً")</p>
            }
        </div>
    </div>
}

@code {
    private int _totalPlayers, _activePlayers, _expiringPlayers, _expiredPlayers, _frozenPlayers, _todayEntries;
    private decimal _monthRevenue, _outstanding;
    private List<EventRow> _recentEvents = new();
    private List<PlayerRow> _expiringList = new();
    private Dictionary<int, string> _doorNames = new();
    private Dictionary<int, string> _playerByCard = new();
    private DateTime? _lastSync;
    private string? _lastSyncStatus;
    private bool _isRefreshing;
    private bool _forcingFullSync;
    private bool _forceFullSyncQueued;
    private int _syncErrorCount;
    private string? _latestSyncErrorDetails;
    private bool _syncErrorsExpanded;

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    private bool _dataLoaded;
    private bool _pageLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Hydrate from HttpContext.Items (populated by the session-read middleware)
        if (!Session.IsAuthenticated)
        {
            var info = HttpCtx.HttpContext?.Items["SessionInfo"] as AccessControlPro.Web.Services.SessionInfo;
            if (info != null)
            {
                var result = new AuthResult
                {
                    IsAuthenticated = true,
                    Role = info.Role,
                    DisplayName = info.DisplayName,
                    UserId = info.UserId,
                    GymDatabase = info.GymDatabase,
                    GymId = info.GymId
                };
                Session.Login(result, info.GymDatabase, info.GymId);
            }
        }

        if (Session.IsAuthenticated && Session.IsOwner)
        {
            await LoadDataAsync();
            _pageLoading = false;
            _dataLoaded = true;
        }
        else
        {
            _pageLoading = false;
        }
    }

    private async Task RefreshData()
    {
        _isRefreshing = true;
        StateHasChanged();
        await LoadDataAsync();
        _isRefreshing = false;
        StateHasChanged();
    }

    private async Task ForceFullSync()
    {
        if (_forcingFullSync || Session.GymId <= 0) return;

        // Confirm first — the next sync re-uploads every row, which can be several MB.
        var prompt = L(
            "Queue a full re-sync? The next sync from the gym PC will resend all rows.",
            "هل تريد طلب مزامنة كاملة؟ ستعيد المزامنة التالية من جهاز النادي إرسال كل الصفوف.");
        var confirmed = await JS.InvokeAsync<bool>("confirm", prompt);
        if (!confirmed) return;

        _forcingFullSync = true;
        StateHasChanged();
        try
        {
            using var conn = await Db.GetConnectionAsync();
            using var cmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Gyms"" SET ""ForceFullSync"" = TRUE WHERE ""Id"" = @id", conn);
            cmd.Parameters.AddWithValue("id", Session.GymId);
            await cmd.ExecuteNonQueryAsync();
            _forceFullSyncQueued = true;
        }
        catch { /* swallow — button just won't flip to queued state */ }
        finally
        {
            _forcingFullSync = false;
            StateHasChanged();
        }
    }

    private string GetDoorName(int doorId)
        => _doorNames.TryGetValue(doorId, out var name) ? name : $"Door {doorId}";

    private string GetPlayerName(int? cardId)
    {
        if (cardId == null) return "-";
        return _playerByCard.TryGetValue(cardId.Value, out var name) ? name : cardId.Value.ToString();
    }

    private string GetPlayerDisplay(EventRow ev)
    {
        // Prefer JOIN-based player name from query
        if (!string.IsNullOrEmpty(ev.PlayerNameAr) && Session.IsArabic)
            return ev.PlayerNameAr;
        if (!string.IsNullOrEmpty(ev.PlayerNameEn))
            return ev.PlayerNameEn;
        // Fallback to lookup dictionary
        return GetPlayerName(ev.CardId);
    }

    private string GetEventName(int code) => code switch
    {
        1 => L("Card Open", "فتح بالبطاقة"),
        2 => L("Button Open", "فتح بالزر"),
        3 => L("Remote Open", "فتح عن بعد"),
        _ => code.ToString()
    };

    private async Task LoadDataAsync()
    {
        try
        {
            var now = DateTime.UtcNow;
            var todayStart = now.Date.AddHours(-6); // Cover timezone offset
            var weekFromNow = now.AddDays(7);
            var monthStart = new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc);

            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            // Recent sync errors — count partial/failed syncs in last 24h, capture latest error text
            try
            {
                using var errCmd = new Npgsql.NpgsqlCommand(
                    @"SELECT COUNT(*),
                             MAX(""SyncedAt""),
                             (SELECT ""Details"" FROM ""CloudSyncLogs""
                              WHERE ""Status"" <> 'Success' AND ""SyncedAt"" >= @since
                              ORDER BY ""SyncedAt"" DESC LIMIT 1)
                      FROM ""CloudSyncLogs""
                      WHERE ""Status"" <> 'Success' AND ""SyncedAt"" >= @since", conn);
                errCmd.Parameters.AddWithValue("since", now.AddHours(-24));
                using var er = await errCmd.ExecuteReaderAsync();
                if (await er.ReadAsync())
                {
                    _syncErrorCount = er.GetInt32(0);
                    _latestSyncErrorDetails = er.IsDBNull(2) ? null : er.GetString(2);
                }
            }
            catch { _syncErrorCount = 0; _latestSyncErrorDetails = null; }

            // Player stats including frozen
            using (var cmd = new Npgsql.NpgsqlCommand(@"
                SELECT
                    COUNT(*),
                    COUNT(*) FILTER (WHERE ""EndDate"" > @now AND ""IsFrozen"" = FALSE),
                    COUNT(*) FILTER (WHERE ""EndDate"" > @now AND ""EndDate"" <= @week AND ""IsFrozen"" = FALSE),
                    COUNT(*) FILTER (WHERE ""EndDate"" <= @now AND ""IsFrozen"" = FALSE),
                    COUNT(*) FILTER (WHERE ""IsFrozen"" = TRUE)
                FROM ""Players"" WHERE ""IsDeleted"" = FALSE", conn))
            {
                cmd.Parameters.AddWithValue("now", now);
                cmd.Parameters.AddWithValue("week", weekFromNow);
                using var r = await cmd.ExecuteReaderAsync();
                if (await r.ReadAsync())
                {
                    _totalPlayers = r.GetInt32(0);
                    _activePlayers = r.GetInt32(1);
                    _expiringPlayers = r.GetInt32(2);
                    _expiredPlayers = r.GetInt32(3);
                    _frozenPlayers = r.GetInt32(4);
                }
            }

            // Today entries
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT COUNT(*) FROM ""AccessEvents"" WHERE ""EventDate"" >= @today", conn))
            {
                cmd.Parameters.AddWithValue("today", todayStart);
                _todayEntries = Convert.ToInt32(await cmd.ExecuteScalarAsync());
            }

            // Month revenue
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT COALESCE(SUM(""Amount""), 0) FROM ""Transactions"" WHERE ""TransactionDate"" >= @ms AND ""Type"" = 0", conn))
            {
                cmd.Parameters.AddWithValue("ms", monthStart);
                _monthRevenue = Convert.ToDecimal(await cmd.ExecuteScalarAsync());
            }

            // Outstanding balance
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT COALESCE(SUM(""SubscriptionFee"" - ""AmountPaid""), 0)
                  FROM ""Players"" WHERE ""IsDeleted"" = FALSE AND ""SubscriptionFee"" > ""AmountPaid""", conn))
            {
                _outstanding = Convert.ToDecimal(await cmd.ExecuteScalarAsync());
            }

            // Door names
            using (var cmd = new Npgsql.NpgsqlCommand(@"SELECT ""Id"", COALESCE(""Name"",'') FROM ""Doors""", conn))
            {
                using var r = await cmd.ExecuteReaderAsync();
                while (await r.ReadAsync())
                    _doorNames[r.GetInt32(0)] = r.GetString(1);
            }

            // Player name by card
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""CardNo"", ""FullNameEn"", ""FullNameAr""
                  FROM ""Players"" WHERE ""IsDeleted"" = FALSE AND ""CardNo"" IS NOT NULL AND ""CardNo"" != ''", conn))
            {
                using var r = await cmd.ExecuteReaderAsync();
                while (await r.ReadAsync())
                {
                    var cardNo = r.GetString(0);
                    if (int.TryParse(cardNo, out var cid))
                    {
                        var nameEn = r.GetString(1);
                        var nameAr = r.GetString(2);
                        _playerByCard[cid] = Session.IsArabic && !string.IsNullOrEmpty(nameAr) ? nameAr : nameEn;
                    }
                }
            }

            // Recent events with JOINs for card number and player name
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT e.""Id"", e.""DoorId"", e.""CardId"", e.""EventCode"", e.""EventDate"", COALESCE(e.""Details"",''),
                         COALESCE(dr.""Name"", 'Door ' || e.""DoorId"") AS ""DoorName"",
                         COALESCE(c.""CardNumber"", '') AS ""CardNumber"",
                         COALESCE(p.""FullNameEn"", '') AS ""PlayerNameEn"",
                         COALESCE(p.""FullNameAr"", '') AS ""PlayerNameAr""
                  FROM ""AccessEvents"" e
                  LEFT JOIN ""Doors"" dr ON e.""DoorId"" = dr.""Id""
                  LEFT JOIN ""AccessCards"" c ON e.""CardId"" = c.""Id""
                  LEFT JOIN ""Players"" p ON c.""EmployeeId"" = p.""Id""
                  ORDER BY e.""EventDate"" DESC LIMIT 10", conn))
            {
                using var r = await cmd.ExecuteReaderAsync();
                _recentEvents = new List<EventRow>();
                while (await r.ReadAsync())
                {
                    _recentEvents.Add(new EventRow(
                        r.GetInt32(0), r.GetInt32(1),
                        r.IsDBNull(2) ? null : r.GetInt32(2),
                        r.GetInt32(3), r.GetDateTime(4), r.GetString(5),
                        r.GetString(6), r.GetString(7), r.GetString(8), r.GetString(9)));
                }
            }

            // Last sync info
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""SyncedAt"", ""Status"" FROM ""CloudSyncLogs"" ORDER BY ""SyncedAt"" DESC LIMIT 1", conn))
            {
                using var r = await cmd.ExecuteReaderAsync();
                if (await r.ReadAsync())
                {
                    _lastSync = r.GetDateTime(0);
                    _lastSyncStatus = r.GetString(1);
                }
            }

            // Expiring players
            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""Id"", ""FullNameEn"", ""FullNameAr"", COALESCE(""CardNo"",''), COALESCE(""Phone"",''),
                         COALESCE(""SubscriptionType"",''), ""StartDate"", ""EndDate"",
                         COALESCE(""SubscriptionFee"",0), COALESCE(""AmountPaid"",0),
                         COALESCE(""MaxVisits"",0), COALESCE(""UsedVisits"",0), ""IsFrozen"", ""FreezeStartDate""
                  FROM ""Players""
                  WHERE ""IsDeleted"" = FALSE AND ""IsFrozen"" = FALSE
                    AND ""EndDate"" > @now AND ""EndDate"" <= @week
                  ORDER BY ""EndDate"" LIMIT 10", conn))
            {
                cmd.Parameters.AddWithValue("now", now);
                cmd.Parameters.AddWithValue("week", weekFromNow);
                using var r = await cmd.ExecuteReaderAsync();
                _expiringList = new List<PlayerRow>();
                while (await r.ReadAsync())
                {
                    _expiringList.Add(ReadPlayerRow(r));
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerDashboard] LoadDataAsync Error: {ex.Message}"); }
    }

    private static PlayerRow ReadPlayerRow(Npgsql.NpgsqlDataReader r)
    {
        return new PlayerRow(
            r.GetInt32(0), r.GetString(1), r.GetString(2), r.GetString(3), r.GetString(4),
            r.GetString(5), r.GetDateTime(6), r.GetDateTime(7),
            r.GetDecimal(8), r.GetDecimal(9),
            r.GetInt32(10), r.GetInt32(11), r.GetBoolean(12),
            r.IsDBNull(13) ? null : r.GetDateTime(13));
    }
}
