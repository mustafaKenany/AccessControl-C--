@page "/change-password"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@rendermode InteractiveServer

@if (!Session.IsAuthenticated)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-key"></i> @L("Change Password", "\u062A\u063A\u064A\u064A\u0631 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631")</h1>
    </div>

    <div class="content-card" style="max-width: 500px;">
        @if (!string.IsNullOrEmpty(_successMsg))
        {
            <div class="success-msg" style="background: rgba(68,161,160,0.15); color: #44A1A0; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid rgba(68,161,160,0.3);">
                <i class="fas fa-check-circle"></i> @_successMsg
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div class="error-msg">@_errorMsg</div>
        }

        <div class="form-group">
            <label>@L("Current Password", "\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062D\u0627\u0644\u064A\u0629")</label>
            <input type="password" class="form-input" @bind="_currentPassword" @bind:event="oninput"
                   placeholder="@L("Enter current password", "\u0623\u062F\u062E\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062D\u0627\u0644\u064A\u0629")" />
        </div>

        <div class="form-group">
            <label>@L("New Password", "\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062C\u062F\u064A\u062F\u0629")</label>
            <input type="password" class="form-input" @bind="_newPassword" @bind:event="oninput"
                   placeholder="@L("Enter new password (min 6 chars)", "\u0623\u062F\u062E\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062C\u062F\u064A\u062F\u0629 (6 \u0623\u062D\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644)")" />
        </div>

        <div class="form-group">
            <label>@L("Confirm New Password", "\u062A\u0623\u0643\u064A\u062F \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062C\u062F\u064A\u062F\u0629")</label>
            <input type="password" class="form-input" @bind="_confirmPassword" @bind:event="oninput"
                   placeholder="@L("Re-enter new password", "\u0623\u0639\u062F \u0625\u062F\u062E\u0627\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062C\u062F\u064A\u062F\u0629")" />
        </div>

        <button class="btn-accent" @onclick="ChangePasswordAsync" disabled="@_isSaving" style="width: 100%; margin-top: 0.5rem;">
            @if (_isSaving)
            {
                <i class="fas fa-spinner fa-spin"></i> @L("Saving...", "\u062C\u0627\u0631\u064A \u0627\u0644\u062D\u0641\u0638...")
            }
            else
            {
                <i class="fas fa-save"></i> @L("Change Password", "\u062A\u063A\u064A\u064A\u0631 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631")
            }
        </button>
    </div>
}

@code {
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _errorMsg;
    private string? _successMsg;
    private bool _isSaving;

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _errorMsg = null;
        _successMsg = null;

        // Validation
        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _errorMsg = L("Please enter your current password", "\u0627\u0644\u0631\u062C\u0627\u0621 \u0625\u062F\u062E\u0627\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062D\u0627\u0644\u064A\u0629");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _errorMsg = L("Please enter a new password", "\u0627\u0644\u0631\u062C\u0627\u0621 \u0625\u062F\u062E\u0627\u0644 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u062C\u062F\u064A\u062F\u0629");
            return;
        }

        if (_newPassword.Length < 6)
        {
            _errorMsg = L("New password must be at least 6 characters", "\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062C\u062F\u064A\u062F\u0629 \u064A\u062C\u0628 \u0623\u0646 \u062A\u0643\u0648\u0646 6 \u0623\u062D\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644");
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMsg = L("Passwords do not match", "\u0643\u0644\u0645\u0627\u062A \u0627\u0644\u0645\u0631\u0648\u0631 \u063A\u064A\u0631 \u0645\u062A\u0637\u0627\u0628\u0642\u0629");
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            // Get current password hash
            using var getCmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""PasswordHash"" FROM ""Users"" WHERE ""Id"" = @id AND ""IsActive"" = TRUE", conn);
            getCmd.Parameters.AddWithValue("id", Session.UserId);
            var hashResult = await getCmd.ExecuteScalarAsync();

            if (hashResult == null || hashResult == DBNull.Value)
            {
                _errorMsg = L("User not found", "\u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u063A\u064A\u0631 \u0645\u0648\u062C\u0648\u062F");
                return;
            }

            var currentHash = hashResult.ToString()!;

            // Verify current password
            try
            {
                if (!BCrypt.Net.BCrypt.Verify(_currentPassword, currentHash))
                {
                    _errorMsg = L("Current password is incorrect", "\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062D\u0627\u0644\u064A\u0629 \u063A\u064A\u0631 \u0635\u062D\u064A\u062D\u0629");
                    return;
                }
            }
            catch
            {
                _errorMsg = L("Current password is incorrect", "\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062D\u0627\u0644\u064A\u0629 \u063A\u064A\u0631 \u0635\u062D\u064A\u062D\u0629");
                return;
            }

            // Hash new password and update
            var newHash = BCrypt.Net.BCrypt.HashPassword(_newPassword);

            using var updateCmd = new Npgsql.NpgsqlCommand(
                @"UPDATE ""Users"" SET ""PasswordHash"" = @hash WHERE ""Id"" = @id", conn);
            updateCmd.Parameters.AddWithValue("hash", newHash);
            updateCmd.Parameters.AddWithValue("id", Session.UserId);
            await updateCmd.ExecuteNonQueryAsync();

            _successMsg = L("Password changed successfully", "\u062A\u0645 \u062A\u063A\u064A\u064A\u0631 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0628\u0646\u062C\u0627\u062D");
            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
        }
        catch (Exception ex)
        {
            _errorMsg = L("Error changing password: ", "\u062E\u0637\u0623 \u0641\u064A \u062A\u063A\u064A\u064A\u0631 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631: ") + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
