@page "/events"
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.DbHelper Db
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@rendermode InteractiveServer

@* TODO: Currently checks Session.IsOwner only. When granular cloud permissions are added,
   enforce AppPermission checks per page (e.g., EventsView for this page). *@
@if (!Session.IsAuthenticated || !Session.IsOwner)
{
    <p>Redirecting...</p>
}
else
{
    <div class="page-header">
        <h1><i class="fas fa-clock"></i> @L("Access Events", "أحداث الوصول")</h1>
        <span class="last-sync">@L("Total", "الإجمالي"): @_totalCount</span>
    </div>

    <div class="filter-group">
        <button class="filter-btn @(_period == "all" ? "active" : "")" @onclick='() => SetPeriod("all")' title="@GetFilterTooltip("all")">@L("All", "الكل")</button>
        <button class="filter-btn @(_period == "today" ? "active" : "")" @onclick='() => SetPeriod("today")' title="@GetFilterTooltip("today")">@L("Today", "اليوم")</button>
        <button class="filter-btn @(_period == "yesterday" ? "active" : "")" @onclick='() => SetPeriod("yesterday")' title="@GetFilterTooltip("yesterday")">@L("Yesterday", "أمس")</button>
        <button class="filter-btn @(_period == "thisweek" ? "active" : "")" @onclick='() => SetPeriod("thisweek")' title="@GetFilterTooltip("thisweek")">@L("This Week", "هذا الأسبوع")</button>
        <button class="filter-btn @(_period == "lastweek" ? "active" : "")" @onclick='() => SetPeriod("lastweek")' title="@GetFilterTooltip("lastweek")">@L("Last Week", "الأسبوع الماضي")</button>
        <button class="filter-btn @(_period == "thismonth" ? "active" : "")" @onclick='() => SetPeriod("thismonth")' title="@GetFilterTooltip("thismonth")">@L("This Month", "هذا الشهر")</button>
        <button class="filter-btn @(_period == "lastmonth" ? "active" : "")" @onclick='() => SetPeriod("lastmonth")' title="@GetFilterTooltip("lastmonth")">@L("Last Month", "الشهر الماضي")</button>
        <button class="filter-btn @(_period == "last3months" ? "active" : "")" @onclick='() => SetPeriod("last3months")' title="@GetFilterTooltip("last3months")">@L("Last 3 Months", "آخر 3 أشهر")</button>
        <button class="filter-btn @(_period == "last6months" ? "active" : "")" @onclick='() => SetPeriod("last6months")' title="@GetFilterTooltip("last6months")">@L("Last 6 Months", "آخر 6 أشهر")</button>
    </div>

    <div class="filter-bar">
        <input type="text" @bind="_search" @bind:event="oninput" @onkeyup="OnSearch"
               class="form-input" style="max-width: 320px;"
               placeholder="@L("Search by player name or card...", "بحث باسم اللاعب أو البطاقة...")" />
        @if (!string.IsNullOrWhiteSpace(_search))
        {
            <span style="color: var(--text-secondary); font-size: 0.8rem; margin-inline-start: 0.5rem;">
                <i class="fas fa-search"></i> @L("Searching all dates", "بحث في كل التواريخ")
            </span>
        }
    </div>

    <div class="content-card">
        @* Desktop table *@
        <div class="desktop-only">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Date/Time", "التاريخ/الوقت")</th>
                            <th>@L("Device", "الجهاز")</th>
                            <th>@L("Door", "الباب")</th>
                            <th>@L("Card No", "رقم البطاقة")</th>
                            <th>@L("Player", "اللاعب")</th>
                            <th>@L("Event Type", "نوع الحدث")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in _events)
                        {
                            <tr>
                                <td>@ev.EventDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@GetDeviceName(ev.DoorId)</td>
                                <td>@(string.IsNullOrEmpty(ev.DoorName) ? GetDoorName(ev.DoorId) : ev.DoorName)</td>
                                @{ var deskCardNo = GetCardDisplay(ev); }
                                <td>
                                    @if (!string.IsNullOrEmpty(deskCardNo) && deskCardNo.StartsWith("5000"))
                                    {
                                        <span class="badge badge-active" style="font-size:0.7em;margin-right:4px;">QR</span>
                                    }
                                    @(string.IsNullOrEmpty(deskCardNo) ? "-" : deskCardNo)
                                </td>
                                <td>@GetPlayerDisplay(ev)</td>
                                <td>
                                    <span class="badge @GetEventBadgeClass(ev.EventCode)">
                                        @GetEventTypeName(ev.EventCode)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Mobile cards *@
        <div class="mobile-only">
            <div class="mobile-cards">
                @foreach (var ev in _events)
                {
                    var local = ev.EventDate.ToLocalTime();
                    <div class="mobile-card">
                        <div class="mobile-card-header">
                            <span class="mobile-card-name">@local.ToString("MM/dd HH:mm")</span>
                            <span class="badge @GetEventBadgeClass(ev.EventCode)">@GetEventTypeName(ev.EventCode)</span>
                        </div>
                        <div class="mobile-card-divider"></div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Player", "اللاعب")</span>
                            <span class="mobile-card-value">@GetPlayerDisplay(ev)</span>
                        </div>
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Door", "الباب")</span>
                            <span class="mobile-card-value">@(string.IsNullOrEmpty(ev.DoorName) ? GetDoorName(ev.DoorId) : ev.DoorName)</span>
                        </div>
                        @{ var mobCardNo = GetCardDisplay(ev); }
                        <div class="mobile-card-row">
                            <span class="mobile-card-label">@L("Card", "البطاقة")</span>
                            <span class="mobile-card-value">
                                @if (!string.IsNullOrEmpty(mobCardNo) && mobCardNo.StartsWith("5000"))
                                {
                                    <span class="badge badge-active" style="font-size:0.7em;margin-right:4px;">QR</span>
                                }
                                @(string.IsNullOrEmpty(mobCardNo) ? "-" : mobCardNo)
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!_events.Any())
        {
            <p class="no-data">
                @(string.IsNullOrWhiteSpace(_search)
                    ? L("No events found for the selected period", "لم يتم العثور على أحداث للفترة المحددة")
                    : L("No events found for this search", "لم يتم العثور على أحداث لهذا البحث"))
            </p>
        }

        @if (_events.Any())
        {
            <div style="text-align:center; margin-top:1rem;">
                @if (_hasMore)
                {
                    <button class="btn-outline" @onclick="LoadMore" disabled="@_loadingMore">
                        <i class="fas @(_loadingMore ? "fa-spinner fa-spin" : "fa-chevron-down")"></i>
                        @L("Load more", "تحميل المزيد")
                    </button>
                }
                <div style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 0.5rem;">
                    @L("Showing", "عرض") @_events.Count @L("of", "من") @_totalCount
                </div>
            </div>
        }
    </div>
}

@code {
    private string _period = "today";
    private string _search = "";
    private List<EventRow> _events = new();
    private Dictionary<int, string> _doorNames = new();
    private Dictionary<int, string> _deviceByDoor = new();
    private Dictionary<long, string> _playerByCardNum = new();

    private const int PageSize = 100;
    private int _loaded;          // how many rows we've fetched so far (the SQL OFFSET)
    private int _totalCount;      // total rows matching the current period/search
    private bool _hasMore;        // last batch was full -> more available
    private bool _loadingMore;

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsOwner)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadLookupsAsync();
        await LoadEventsAsync(reset: true);
    }

    private (DateTime start, DateTime end) GetDateRange() => GetDateRangeFor(_period);

    private (DateTime start, DateTime end) GetDateRangeFor(string p)
    {
        var now = DateTime.UtcNow;
        var future = now.AddHours(12);
        var today = now.Date;
        return p switch
        {
            "today" => (today.AddHours(-6), future),
            "yesterday" => (today.AddDays(-1).AddHours(-6), today.AddHours(-6)),
            "thisweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6), future),
            "lastweek" => (today.AddDays(-((int)today.DayOfWeek + 1) % 7 - 7).AddHours(-6), today.AddDays(-((int)today.DayOfWeek + 1) % 7).AddHours(-6)),
            "thismonth" => (new DateTime(now.Year, now.Month, 1).AddHours(-6), future),
            "lastmonth" => (new DateTime(now.Year, now.Month, 1).AddMonths(-1).AddHours(-6),
                            new DateTime(now.Year, now.Month, 1).AddHours(-6)),
            "last3months" => (today.AddMonths(-3).AddHours(-6), future),
            "last6months" => (today.AddMonths(-6).AddHours(-6), future),
            "all" => (DateTime.MinValue, future),
            _ => (today.AddHours(-6), future)
        };
    }

    private string GetFilterTooltip(string period)
    {
        var (s, e) = GetDateRangeFor(period);
        var startStr = s == DateTime.MinValue ? "" : s.ToString("yyyy-MM-dd");
        var endStr = e > DateTime.UtcNow.AddHours(10) ? L("Now", "الآن") : e.ToString("yyyy-MM-dd");

        return period switch
        {
            "all" => L("Show all records without date filter", "عرض جميع السجلات بدون فلتر تاريخ"),
            "today" => L($"Records from today ({startStr} → {endStr})", $"سجلات اليوم ({startStr} → {endStr})"),
            "yesterday" => L($"Records from yesterday ({startStr} → {endStr})", $"سجلات الأمس ({startStr} → {endStr})"),
            "thisweek" => L($"This week ({startStr} → {endStr})", $"هذا الأسبوع ({startStr} → {endStr})"),
            "lastweek" => L($"Last week ({startStr} → {endStr})", $"الأسبوع الماضي ({startStr} → {endStr})"),
            "thismonth" => L($"This month ({startStr} → {endStr})", $"هذا الشهر ({startStr} → {endStr})"),
            "lastmonth" => L($"Last month ({startStr} → {endStr})", $"الشهر الماضي ({startStr} → {endStr})"),
            "last3months" => L($"Last 3 months ({startStr} → {endStr})", $"آخر 3 أشهر ({startStr} → {endStr})"),
            "last6months" => L($"Last 6 months ({startStr} → {endStr})", $"آخر 6 أشهر ({startStr} → {endStr})"),
            _ => ""
        };
    }

    private async Task SetPeriod(string period)
    {
        _period = period;
        await LoadEventsAsync(reset: true);
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT d.""Id"", COALESCE(d.""Name"",''), COALESCE(dev.""Name"",'')
                  FROM ""Doors"" d LEFT JOIN ""Devices"" dev ON d.""DeviceId"" = dev.""Id""", conn))
            {
                using var r = await cmd.ExecuteReaderAsync();
                while (await r.ReadAsync())
                {
                    _doorNames[r.GetInt32(0)] = r.GetString(1);
                    _deviceByDoor[r.GetInt32(0)] = r.GetString(2);
                }
            }

            using (var cmd = new Npgsql.NpgsqlCommand(
                @"SELECT ""CardNo"", ""FullNameEn"", ""FullNameAr""
                  FROM ""Players"" WHERE ""IsDeleted"" = FALSE AND ""CardNo"" IS NOT NULL AND ""CardNo"" != ''", conn))
            {
                using var r = await cmd.ExecuteReaderAsync();
                while (await r.ReadAsync())
                {
                    var cardNo = r.GetString(0);
                    if (long.TryParse(cardNo, out var cnum))
                    {
                        var nameEn = r.GetString(1);
                        var nameAr = r.GetString(2);
                        _playerByCardNum[cnum] = Session.IsArabic && !string.IsNullOrEmpty(nameAr) ? nameAr : nameEn;
                    }
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerEvents] LoadLookupsAsync Error: {ex.Message}"); }
    }

    // Shared FROM + JOINs for both the count and data queries. The p2 join recovers players
    // for orphan AccessCards created from 8H10D Wiegand scans (card "3665490" vs registered
    // "0366549"), matching numerically with the /10 normalisation.
    private const string FromJoins = @"
          FROM ""AccessEvents"" e
          LEFT JOIN ""Doors"" d ON e.""DoorId"" = d.""Id""
          LEFT JOIN ""AccessCards"" c ON e.""CardId"" = c.""Id""
          LEFT JOIN ""Players"" p ON c.""EmployeeId"" = p.""Id""
          LEFT JOIN ""Players"" p2 ON p.""Id"" IS NULL
               AND c.""CardNumber"" ~ '^[0-9]+$'
               AND p2.""CardNo"" ~ '^[0-9]+$'
               AND p2.""CardNo""::bigint = c.""CardNumber""::bigint / 10";

    // While searching we ignore the date filter so the owner sees a person's FULL history
    // in one go (the old client-side search only looked at the current 20-row page).
    private bool Searching => !string.IsNullOrWhiteSpace(_search);

    private async Task LoadEventsAsync(bool reset)
    {
        try
        {
            if (reset) { _events = new List<EventRow>(); _loaded = 0; _hasMore = false; }

            var _dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
            using var conn = await GymDb.GetGymConnectionAsync(_dbName);

            var conds = new List<string>();
            var applyDate = !Searching && _period != "all";
            DateTime from = DateTime.MinValue, to = DateTime.MaxValue;
            if (applyDate)
            {
                (from, to) = GetDateRange();
                conds.Add(@"e.""EventDate"" >= @from AND e.""EventDate"" < @to");
            }
            if (Searching)
            {
                conds.Add(@"(c.""CardNumber"" LIKE @q
                          OR p.""FullNameEn"" ILIKE @q OR p.""FullNameAr"" LIKE @q
                          OR p2.""FullNameEn"" ILIKE @q OR p2.""FullNameAr"" LIKE @q
                          OR COALESCE(d.""Name"",'') ILIKE @q
                          OR e.""Details"" LIKE @q)");
            }
            var whereClause = conds.Count > 0 ? "WHERE " + string.Join(" AND ", conds) : "";

            // Count (only on reset — it doesn't change while paging the same query)
            if (reset)
            {
                using var countCmd = new Npgsql.NpgsqlCommand(
                    "SELECT COUNT(*) " + FromJoins + " " + whereClause, conn);
                if (applyDate) { countCmd.Parameters.AddWithValue("from", from); countCmd.Parameters.AddWithValue("to", to); }
                if (Searching) countCmd.Parameters.AddWithValue("q", $"%{_search.Trim()}%");
                _totalCount = Convert.ToInt32(await countCmd.ExecuteScalarAsync());
            }

            var dataSql = @"SELECT e.""Id"", e.""DoorId"", e.""CardId"", e.""EventCode"", e.""EventDate"", COALESCE(e.""Details"",''),
                          COALESCE(d.""Name"", ''), COALESCE(c.""CardNumber"", ''),
                          COALESCE(NULLIF(p.""FullNameEn"", ''), p2.""FullNameEn"", ''),
                          COALESCE(NULLIF(p.""FullNameAr"", ''), p2.""FullNameAr"", '')"
                  + FromJoins + " " + whereClause +
                  @" ORDER BY e.""EventDate"" DESC LIMIT @limit OFFSET @offset";
            using (var cmd = new Npgsql.NpgsqlCommand(dataSql, conn))
            {
                if (applyDate) { cmd.Parameters.AddWithValue("from", from); cmd.Parameters.AddWithValue("to", to); }
                if (Searching) cmd.Parameters.AddWithValue("q", $"%{_search.Trim()}%");
                cmd.Parameters.AddWithValue("limit", PageSize);
                cmd.Parameters.AddWithValue("offset", _loaded);

                using var r = await cmd.ExecuteReaderAsync();
                int batch = 0;
                while (await r.ReadAsync())
                {
                    _events.Add(new EventRow(
                        r.GetInt32(0), r.GetInt32(1),
                        r.IsDBNull(2) ? null : r.GetInt32(2),
                        r.GetInt32(3), r.GetDateTime(4), r.GetString(5),
                        r.GetString(6), r.GetString(7), r.GetString(8), r.GetString(9)));
                    batch++;
                }
                _loaded += batch;
                _hasMore = batch == PageSize;
            }
        }
        catch (Exception ex) { Console.WriteLine($"[OwnerEvents] LoadEventsAsync Error: {ex.Message}"); }
    }

    private async Task OnSearch()
    {
        if (_search.Length > 100) _search = _search[..100];
        await LoadEventsAsync(reset: true);
    }

    private async Task LoadMore()
    {
        if (!_hasMore || _loadingMore) return;
        _loadingMore = true;
        try { await LoadEventsAsync(reset: false); }
        finally { _loadingMore = false; }
    }

    private string GetDoorName(int doorId)
        => _doorNames.TryGetValue(doorId, out var name) && !string.IsNullOrEmpty(name) ? name : $"Door {doorId}";

    private string GetDeviceName(int doorId)
        => _deviceByDoor.TryGetValue(doorId, out var name) && !string.IsNullOrEmpty(name) ? name : "-";

    // Resolve a player by the card NUMBER (not the AccessCards row id). Used for events
    // whose CardId is null — e.g. "@NotRegistered" scans where the card wasn't synced to
    // the device yet: the player exists in our DB but the event isn't linked to a card.
    private string ResolvePlayerByCardNumber(string cardNo)
    {
        if (string.IsNullOrEmpty(cardNo) || !long.TryParse(cardNo, out var n)) return "";
        if (_playerByCardNum.TryGetValue(n, out var name)) return name;
        if (_playerByCardNum.TryGetValue(n / 10, out var name2)) return name2; // 8H10D Wiegand check digit
        return "";
    }

    private string GetPlayerDisplay(EventRow ev)
    {
        var cardNo = GetCardDisplay(ev);
        if (!string.IsNullOrEmpty(cardNo) && cardNo.StartsWith("5000"))
            return L("QR Guest", "ضيف QR");

        if (!string.IsNullOrEmpty(ev.PlayerNameAr) && Session.IsArabic)
            return ev.PlayerNameAr;
        if (!string.IsNullOrEmpty(ev.PlayerNameEn))
            return ev.PlayerNameEn;
        var fromLookup = ResolvePlayerByCardNumber(cardNo);
        if (!string.IsNullOrEmpty(fromLookup)) return fromLookup;
        return ExtractPlayerNameFromDetails(ev.Details);
    }

    private string GetCardDisplay(EventRow ev)
    {
        if (!string.IsNullOrEmpty(ev.CardNumber))
            return ev.CardNumber;
        return ExtractFieldFromDetails(ev.Details, "#");
    }

    private static string ExtractFieldFromDetails(string details, string prefix)
    {
        if (string.IsNullOrEmpty(details)) return "";
        var parts = details.Split('|');
        foreach (var part in parts)
        {
            var trimmed = part.Trim();
            if (trimmed.StartsWith(prefix))
                return trimmed.Substring(prefix.Length).Trim();
        }
        return "";
    }

    private static string ExtractPlayerNameFromDetails(string details)
    {
        if (string.IsNullOrEmpty(details)) return "-";
        var parts = details.Split('|');
        for (int i = 0; i < parts.Length; i++)
        {
            var trimmed = parts[i].Trim();
            if (trimmed.StartsWith("#") && i + 1 < parts.Length)
            {
                var next = parts[i + 1].Trim();
                if (!next.StartsWith("SN:") && !next.StartsWith("@"))
                    return next;
            }
        }
        return "-";
    }

    private string GetEventTypeName(int code) => code switch
    {
        1 => L("Card Open", "فتح بالبطاقة"),
        2 => L("Button Open", "فتح بالزر"),
        3 => L("Remote Open", "فتح عن بعد"),
        4 => L("Alarm", "إنذار"),
        5 => L("Door Open", "فتح الباب"),
        6 => L("Door Close", "إغلاق الباب"),
        _ => $"Code {code}"
    };

    private string GetEventBadgeClass(int code) => code switch
    {
        1 => "badge-active",
        4 => "badge-expired",
        _ => "badge-frozen"
    };
}
