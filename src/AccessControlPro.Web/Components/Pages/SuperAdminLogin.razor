@page "/superadmin"
@page "/superadmin/login"
@layout AccessControlPro.Web.Components.Layout.LandingLayout
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card" style="border-color: #7E57C2;">
        <h2 class="login-title" style="color: #7E57C2;">HM-GymManagement</h2>
        <p class="login-subtitle">Super Admin Panel</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }

        <div class="form-group">
            <label>Username</label>
            <input type="text" @bind="_username" @bind:event="oninput" class="form-input"
                   placeholder="Enter username" style="border-color: #7E57C2;" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" @bind="_password" @bind:event="oninput" class="form-input"
                   placeholder="Enter password" style="border-color: #7E57C2;"
                   @onkeydown="HandleKeyDown" />
        </div>

        <button class="login-btn" style="background: #7E57C2;" @onclick="DoLogin" disabled="@_loading">
            @if (_loading)
            {
                <span>Logging in...</span>
            }
            else
            {
                <span>Login</span>
            }
        </button>
    </div>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string _error = "";
    private bool _loading;
    private bool _loginSuccess;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.IsSuperAdmin)
        {
            await JS.InvokeVoidAsync("eval", "window.location.href = '/superadmin/dashboard'");
            return;
        }
        if (_loginSuccess && Session.IsSuperAdmin)
        {
            _loginSuccess = false;
            var cookieValue = $"SuperAdmin|Super Admin|0||0";
            // Save to server-side file
            var sessionFile = System.IO.Path.Combine(AppContext.BaseDirectory, ".active_session");
            try { System.IO.File.WriteAllText(sessionFile, cookieValue); } catch { }
            // Also cookie as backup
            var encoded = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(cookieValue));
            await JS.InvokeVoidAsync("eval", $"document.cookie = 'session={encoded}; path=/; max-age=86400; SameSite=Strict'");
            await JS.InvokeVoidAsync("eval", "window.location.href = '/superadmin/dashboard'");
        }
    }

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private Task DoLogin()
    {
        _error = "";
        _loading = true;

        try
        {
            var configUser = Config["SuperAdmin:Username"] ?? "";
            var configHash = Config["SuperAdmin:PasswordHash"] ?? "";

            if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
            {
                _error = "Username and password are required.";
                return Task.CompletedTask;
            }

            bool hashOk;
            if (configHash.StartsWith("$2"))
            {
                // BCrypt hash (prefix $2a/$2b/$2y) — slow, salted, preferred.
                try { hashOk = BCrypt.Net.BCrypt.Verify(_password, configHash); }
                catch { hashOk = false; }
            }
            else
            {
                // Legacy SHA256(base64) hash — fast and unsalted. Kept for backward
                // compatibility with existing deployments. Replace the appsettings.json
                // PasswordHash with a BCrypt hash when convenient:
                //   BCrypt.Net.BCrypt.HashPassword("your password", workFactor: 12)
                var inputHash = Convert.ToBase64String(
                    System.Security.Cryptography.SHA256.HashData(
                        System.Text.Encoding.UTF8.GetBytes(_password)));
                hashOk = inputHash == configHash;
                if (hashOk)
                    Console.WriteLine("[SuperAdminLogin] WARN: using legacy SHA256 hash. Migrate SuperAdmin:PasswordHash to BCrypt.");
            }

            if (_username.Trim() == configUser && hashOk)
            {
                var result = AuthResult.Success("Super Admin", "SuperAdmin", 0);
                Session.Login(result);
                _loginSuccess = true;
                StateHasChanged();
            }
            else
            {
                _error = "Invalid credentials.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        return Task.CompletedTask;
    }
}
