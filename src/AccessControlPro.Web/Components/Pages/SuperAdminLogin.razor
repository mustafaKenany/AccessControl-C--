@page "/superadmin"
@page "/superadmin/login"
@layout AccessControlPro.Web.Components.Layout.LandingLayout
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card" style="border-color: #7E57C2;">
        <h2 class="login-title" style="color: #7E57C2;">HM-GymManagement</h2>
        <p class="login-subtitle">Super Admin Panel</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }

        <div class="form-group">
            <label>Username</label>
            <input type="text" @bind="_username" @bind:event="oninput" class="form-input"
                   placeholder="Enter username" style="border-color: #7E57C2;" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" @bind="_password" @bind:event="oninput" class="form-input"
                   placeholder="Enter password" style="border-color: #7E57C2;"
                   @onkeydown="HandleKeyDown" />
        </div>

        <button class="login-btn" style="background: #7E57C2;" @onclick="DoLogin" disabled="@_loading">
            @if (_loading)
            {
                <span>Logging in...</span>
            }
            else
            {
                <span>Login</span>
            }
        </button>
    </div>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string _error = "";
    private bool _loading;

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        _error = "";
        _loading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
            {
                _error = "Username and password are required.";
                return;
            }

            var body = System.Text.Json.JsonSerializer.Serialize(new
            {
                username = _username.Trim(),
                password = _password
            });

            // Server endpoint does hash verification + creates session + sets HttpOnly
            // cookie. Credentials never touch .active_session or JS-readable cookies.
            var response = await JS.InvokeAsync<LoginResponse>("authPost", "/api/auth/superadmin-login", body);
            if (response?.Success == true && !string.IsNullOrEmpty(response.Redirect))
            {
                await JS.InvokeVoidAsync("eval", $"window.location.href = '{response.Redirect}'");
            }
            else
            {
                _error = response?.Error ?? "Invalid credentials.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginResponse
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public string? Redirect { get; set; }
    }
}
