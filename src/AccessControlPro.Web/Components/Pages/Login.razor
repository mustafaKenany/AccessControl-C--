@page "/login"
@layout AccessControlPro.Web.Components.Layout.LandingLayout
@inject AccessControlPro.Web.Services.WebAuthService AuthService
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card">
        <h2 class="login-title">HM-GymManagement</h2>
        <p class="login-subtitle">@L("Cloud Portal", "البوابة السحابية")</p>

        <div style="text-align: center; margin-bottom: 1rem;">
            <button class="filter-btn" style="font-size: 0.8rem;" @onclick="ToggleLang">
                @(SessionState.IsArabic ? "English" : "عربي")
            </button>
        </div>

        <div class="login-tabs">
            <button class="tab-btn @(_isOwnerMode ? "active" : "")" @onclick="() => _isOwnerMode = true">
                @L("Owner Login", "دخول المالك")
            </button>
            <button class="tab-btn @(!_isOwnerMode ? "active" : "")" @onclick="() => _isOwnerMode = false">
                @L("Player Login", "دخول اللاعب")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }

        @if (_isOwnerMode)
        {
            <div class="form-group">
                <label>@L("Username", "اسم المستخدم")</label>
                <input type="text" @bind="_username" @bind:event="oninput" class="form-input"
                       placeholder="@L("Enter username", "أدخل اسم المستخدم")" />
            </div>
            <div class="form-group">
                <label>@L("Password", "كلمة المرور")</label>
                <input type="password" @bind="_password" @bind:event="oninput" class="form-input"
                       placeholder="@L("Enter password", "أدخل كلمة المرور")"
                       @onkeydown="HandleKeyDown" />
            </div>
        }
        else
        {
            <div class="form-group">
                <label>@L("Phone Number", "رقم الهاتف")</label>
                <input type="tel" @bind="_phone" @bind:event="oninput" class="form-input"
                       placeholder="@L("Enter phone number", "أدخل رقم الهاتف")" />
            </div>
            <div class="form-group">
                <label>@L("Last 4 Digits of Card", "آخر 4 أرقام من البطاقة")</label>
                <input type="text" @bind="_cardLast4" @bind:event="oninput" class="form-input"
                       placeholder="@L("e.g. 1234", "مثال 1234")" maxlength="4"
                       @onkeydown="HandleKeyDown" />
            </div>
        }

        <button class="login-btn" @onclick="DoLogin" disabled="@_loading">
            @if (_loading)
            {
                <span>@L("Logging in...", "جاري تسجيل الدخول...")</span>
            }
            else
            {
                <span>@L("Login", "تسجيل الدخول")</span>
            }
        </button>
    </div>
</div>

@code {
    private bool _isOwnerMode = true;
    private string _username = "";
    private string _password = "";
    private string _phone = "";
    private string _cardLast4 = "";
    private string _error = "";
    private bool _loading;
    private bool _loginSuccess;

    private string L(string en, string ar) => SessionState.IsArabic ? ar : en;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Clear any existing session when login page loads
            // This prevents session leak from "Login as Owner" or other flows
            if (Session.IsAuthenticated)
            {
                Session.Logout();
                await JS.InvokeVoidAsync("eval", "document.cookie = 'session=; path=/; max-age=0'");
            }
        }

        if (_loginSuccess && Session.IsAuthenticated)
        {
            _loginSuccess = false;
            var cookieValue = $"{Session.Role}|{Session.DisplayName}|{Session.UserId}|{Session.GymDatabase}|{Session.GymId}";
            var encoded = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(cookieValue));
            await JS.InvokeVoidAsync("eval", $"document.cookie = 'session={encoded}; path=/; max-age=86400; SameSite=Strict'");

            var url = Session.IsOwner ? "/dashboard" : "/my";
            await JS.InvokeVoidAsync("eval", $"window.location.href = '{url}'");
        }
    }

    private void ToggleLang()
    {
        SessionState.ToggleLanguage();
        StateHasChanged();
    }

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        _error = "";
        _loading = true;

        try
        {
            AuthResult result;

            if (_isOwnerMode)
                result = await AuthService.OwnerLoginAsync(_username.Trim(), _password);
            else
                result = await AuthService.PlayerLoginAsync(_phone.Trim(), _cardLast4.Trim());

            if (result.IsAuthenticated)
            {
                // Check cloud expiry
                var expiresStr = Config["CloudExpiresAt"];
                if (!string.IsNullOrEmpty(expiresStr) && DateTime.TryParse(expiresStr, out var expires) && DateTime.UtcNow > expires)
                {
                    _error = L("Cloud access expired. Contact support to renew.", "\u0627\u0646\u062a\u0647\u062a \u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0633\u062d\u0627\u0628\u064a. \u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u062f\u0639\u0645 \u0644\u0644\u062a\u062c\u062f\u064a\u062f.");
                    return;
                }

                Session.Login(result, result.GymDatabase, result.GymId);
                _loginSuccess = true;
                StateHasChanged();
            }
            else
            {
                _error = result.Error;
            }
        }
        catch (Exception ex)
        {
            _error = $"{L("Connection error", "خطأ في الاتصال")}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
