@page "/login"
@layout AccessControlPro.Web.Components.Layout.LandingLayout
@inject AccessControlPro.Web.Services.WebAuthService AuthService
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card">
        <h2 class="login-title">HM-GymManagement</h2>
        <p class="login-subtitle">@L("Cloud Portal", "البوابة السحابية")</p>

        <div style="text-align: center; margin-bottom: 1rem;">
            <button class="filter-btn" style="font-size: 0.8rem;" @onclick="ToggleLang">
                @(Session.IsArabic ? "English" : "عربي")
            </button>
        </div>

        <div class="login-tabs">
            <button class="tab-btn @(_isOwnerMode ? "active" : "")" @onclick="() => _isOwnerMode = true">
                @L("Owner Login", "دخول المالك")
            </button>
            <button class="tab-btn @(!_isOwnerMode ? "active" : "")" @onclick="() => _isOwnerMode = false">
                @L("Player Login", "دخول اللاعب")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }

        @if (_isOwnerMode)
        {
            <div class="form-group">
                <label>@L("Username", "اسم المستخدم")</label>
                <input type="text" @bind="_username" @bind:event="oninput" class="form-input"
                       placeholder="@L("Enter username", "أدخل اسم المستخدم")" />
            </div>
            <div class="form-group">
                <label>@L("Password", "كلمة المرور")</label>
                <input type="password" @bind="_password" @bind:event="oninput" class="form-input"
                       placeholder="@L("Enter password", "أدخل كلمة المرور")"
                       @onkeydown="HandleKeyDown" />
            </div>
        }
        else
        {
            <div class="form-group">
                <label>@L("Phone Number", "رقم الهاتف")</label>
                <input type="tel" @bind="_phone" @bind:event="oninput" class="form-input"
                       placeholder="@L("Enter phone number", "أدخل رقم الهاتف")" />
            </div>
            <div class="form-group">
                <label>@L("Last 4 Digits of Card", "آخر 4 أرقام من البطاقة")</label>
                <input type="text" @bind="_cardLast4" @bind:event="oninput" class="form-input"
                       placeholder="@L("e.g. 1234", "مثال 1234")" maxlength="4"
                       @onkeydown="HandleKeyDown" />
            </div>
        }

        <button class="login-btn" @onclick="DoLogin" disabled="@_loading">
            @if (_loading)
            {
                <span>@L("Logging in...", "جاري تسجيل الدخول...")</span>
            }
            else
            {
                <span>@L("Login", "تسجيل الدخول")</span>
            }
        </button>
    </div>
</div>

@code {
    private bool _isOwnerMode = true;
    private string _username = "";
    private string _password = "";
    private string _phone = "";
    private string _cardLast4 = "";
    private string _error = "";
    private bool _loading;

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    protected override void OnInitialized()
    {
        // Clear any per-circuit auth state when the login page loads — the HttpOnly
        // cookie is authoritative; the server middleware revalidates on each request.
        // If the cookie is still valid, the user is auto-redirected by MainLayout.
        Session.Logout();
    }

    private void ToggleLang()
    {
        Session.ToggleLanguage();
        StateHasChanged();
    }

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        _error = "";
        _loading = true;
        try
        {
            // Display-only expiry check; the server enforces access too.
            var expiresStr = Config["CloudExpiresAt"];
            if (!string.IsNullOrEmpty(expiresStr) && DateTime.TryParse(expiresStr, out var expires) && DateTime.UtcNow > expires)
            {
                _error = L("Cloud access expired. Contact support to renew.",
                    "انتهت صلاحية الوصول السحابي. تواصل مع الدعم للتجديد.");
                return;
            }

            var body = _isOwnerMode
                ? System.Text.Json.JsonSerializer.Serialize(new
                {
                    mode = "owner",
                    username = _username.Trim(),
                    password = _password
                })
                : System.Text.Json.JsonSerializer.Serialize(new
                {
                    mode = "player",
                    phone = _phone.Trim(),
                    cardLast4 = _cardLast4.Trim()
                });

            // Browser POSTs credentials to the server endpoint. Server validates,
            // creates a row in Sessions, and attaches an HttpOnly session cookie.
            // JS never sees the session token — that's the point of this refactor.
            var response = await JS.InvokeAsync<LoginResponse>("authPost", "/api/auth/login", body);

            if (response?.Success == true && !string.IsNullOrEmpty(response.Redirect))
            {
                // Full-page nav so the session-read middleware hydrates SessionState
                // from the cookie on the next render.
                await JS.InvokeVoidAsync("eval", $"window.location.href = '{response.Redirect}'");
            }
            else
            {
                _error = response?.Error ?? L("Invalid credentials", "بيانات غير صحيحة");
            }
        }
        catch (Exception ex)
        {
            _error = $"{L("Connection error", "خطأ في الاتصال")}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginResponse
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public string? Redirect { get; set; }
    }
}
