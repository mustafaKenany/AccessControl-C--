@inherits LayoutComponentBase
@inject AccessControlPro.Web.Services.SessionState Session

<div class="landing-page" dir="@Session.Dir">
    <nav class="landing-nav">
        <div class="landing-nav-inner">
            <a href="/" class="landing-nav-brand">
                <i class="fas fa-shield-alt"></i>
                <span>HM-GymManagement</span>
            </a>
            <div class="landing-nav-links">
                <a href="#features">@L("Features", "المميزات")</a>
                <a href="#how-it-works">@L("How It Works", "كيف يعمل")</a>
                <a href="#pricing">@L("Pricing", "الأسعار")</a>
                <a href="#screenshots">@L("Screenshots", "لقطات")</a>
                <a href="#contact">@L("Contact", "تواصل")</a>
                <a href="/docs">@L("Docs", "التوثيق")</a>
                <button class="lang-btn" @onclick="ToggleLang">@(Session.IsArabic ? "EN" : "عربي")</button>
                <a href="/login" class="landing-nav-login">
                    <i class="fas fa-sign-in-alt"></i> @L("Login", "دخول")
                </a>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <button class="lang-btn lang-btn-mobile" @onclick="ToggleLang">@(Session.IsArabic ? "EN" : "عربي")</button>
                <a href="/login" class="landing-nav-login-mobile">
                    <i class="fas fa-sign-in-alt"></i> @L("Login", "دخول")
                </a>
            </div>
        </div>
    </nav>
    @Body
    <footer class="landing-footer">
        <div class="landing-footer-inner">
            <div class="footer-col">
                <h4>@L("About", "حول")</h4>
                <p>@L("HM-GymManagement by HM-Tech IT Solutions. A complete gym management and access control solution built for modern fitness businesses.", "HM-GymManagement من HM-Tech IT Solutions. حل متكامل لإدارة النوادي والتحكم بالوصول مصمم لأعمال اللياقة الحديثة.")</p>
                <div class="landing-footer-social">
                    <a href="#" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" title="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" title="YouTube"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>@L("Quick Links", "روابط سريعة")</h4>
                <ul>
                    <li><a href="#features"><i class="fas fa-chevron-right"></i> @L("Features", "المميزات")</a></li>
                    <li><a href="#pricing"><i class="fas fa-chevron-right"></i> @L("Pricing", "الأسعار")</a></li>
                    <li><a href="#contact"><i class="fas fa-chevron-right"></i> @L("Contact", "تواصل")</a></li>
                    <li><a href="/docs"><i class="fas fa-chevron-right"></i> @L("Documentation", "التوثيق")</a></li>
                    <li><a href="/login"><i class="fas fa-chevron-right"></i> @L("Login", "دخول")</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>@L("Contact", "تواصل")</h4>
                <ul>
                    <li><a href="tel:+9647812573845"><i class="fas fa-phone"></i> +964 781 257 3845</a></li>
                    <li><a href="mailto:mustafa.kenany2022@gmail.com"><i class="fas fa-envelope"></i> mustafa.kenany2022@gmail.com</a></li>
                    <li><a href="https://wa.me/9647812573845" target="_blank"><i class="fab fa-whatsapp"></i> @L("WhatsApp", "واتساب")</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 HM-Tech IT Solutions. @L("All rights reserved.", "جميع الحقوق محفوظة.")</p>
        </div>
    </footer>
</div>

@code {
    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    private void ToggleLang()
    {
        Session.ToggleLanguage();
        StateHasChanged();
    }
}
