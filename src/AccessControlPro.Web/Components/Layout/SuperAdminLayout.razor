@inherits LayoutComponentBase
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpCtx

<div class="app-container superadmin-container">
    @if (_wrongSubdomain)
    {
        <div style="display:flex; flex-direction:column; justify-content:center; align-items:center; min-height:100vh; padding:2rem; text-align:center;">
            <i class="fas fa-lock" style="font-size:3rem; color:#7E57C2; margin-bottom:1rem;"></i>
            <h2 style="color:#7E57C2; margin-bottom:0.5rem;">Super Admin is restricted</h2>
            <p style="color:var(--text-secondary); margin-bottom:1.5rem; max-width:480px;">
                The Super Admin panel is only reachable from <strong>admin.hmtech.solutions</strong>.<br/>
                You're currently on <code>@_currentHost</code>.
            </p>
            <a href="https://admin.hmtech.solutions/superadmin/dashboard" class="btn-accent" style="background:#7E57C2; text-decoration:none; padding:0.6rem 1.25rem; border-radius:10px; color:white;">
                Go to admin.hmtech.solutions
            </a>
        </div>
    }
    else if (_isLoading)
    {
        <div style="display:flex; justify-content:center; align-items:center; min-height:100vh; color:#7E57C2;">
            <i class="fas fa-spinner fa-spin" style="font-size:2rem;"></i>
        </div>
    }
    else if (Session.IsSuperAdmin)
    {
        <nav class="sidebar superadmin-sidebar">
            <div class="sidebar-brand" style="border-bottom-color: rgba(126, 87, 194, 0.3);">
                <h3 style="color: #7E57C2;">HM-Tech Admin</h3>
                <span class="user-role">Super Admin</span>
            </div>
            <div class="nav-links">
                <a href="/superadmin/dashboard" class="nav-link sa-nav @ActiveClass("superadmin/dashboard")">
                    <i class="fas fa-chart-line"></i> <span class="nav-text">Dashboard</span>
                </a>
                <a href="/superadmin/gyms" class="nav-link sa-nav @ActiveClass("superadmin/gyms")">
                    <i class="fas fa-dumbbell"></i> <span class="nav-text">Gyms</span>
                </a>
                <a href="/superadmin/revenue" class="nav-link sa-nav @ActiveClass("superadmin/revenue")">
                    <i class="fas fa-dollar-sign"></i> <span class="nav-text">Revenue</span>
                </a>
                <a href="/superadmin/health" class="nav-link sa-nav @ActiveClass("superadmin/health")">
                    <i class="fas fa-heartbeat"></i> <span class="nav-text">System Health</span>
                </a>
                <a href="/superadmin/diagnostics" class="nav-link sa-nav @ActiveClass("superadmin/diagnostics")">
                    <i class="fas fa-life-ring"></i> <span class="nav-text">Diagnostics</span>
                </a>
                <a href="/superadmin/data-quality" class="nav-link sa-nav @ActiveClass("superadmin/data-quality")">
                    <i class="fas fa-clipboard-check"></i> <span class="nav-text">Data Quality</span>
                </a>
                <a href="javascript:void(0)" class="nav-link sa-nav logout-link" @onclick="DoLogout"
                   style="color: #e74c3c; border-top: 1px solid rgba(126, 87, 194, 0.3); margin-top: auto;">
                    <i class="fas fa-sign-out-alt"></i> <span class="nav-text">Logout</span>
                </a>
            </div>
        </nav>
        <main class="main-content">
            @Body
        </main>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _wrongSubdomain;
    private string _currentHost = "";

    protected override void OnInitialized()
    {
        // SuperAdmin pages must only be reachable from the admin.* subdomain.
        // Without this check, basmia.hmtech.solutions/superadmin/dashboard would
        // expose the cross-gym admin panel to anyone who guesses the URL. The
        // GymSubdomainMiddleware treats 'admin' as a reserved subdomain (no gym
        // resolution) so the only way to legitimately reach /superadmin/* is via
        // exactly admin.hmtech.solutions OR root hmtech.solutions (for dev).
        var host = HttpCtx.HttpContext?.Request.Host.Host ?? "";
        _currentHost = host;
        var isAdminSubdomain = host.StartsWith("admin.", StringComparison.OrdinalIgnoreCase);
        var isRootDomain     = host.Equals("hmtech.solutions", StringComparison.OrdinalIgnoreCase)
                            || host.Equals("localhost", StringComparison.OrdinalIgnoreCase)
                            || host.StartsWith("localhost:", StringComparison.OrdinalIgnoreCase);
        if (!isAdminSubdomain && !isRootDomain && !string.IsNullOrEmpty(host))
        {
            _wrongSubdomain = true;
            _isLoading = false;
            return;
        }

        // Hydrate from the server-validated session that the request middleware stashed
        // in HttpContext.Items (no file reads, no cookie parsing in user-land code).
        if (!Session.IsSuperAdmin)
        {
            var info = HttpCtx.HttpContext?.Items["SessionInfo"] as AccessControlPro.Web.Services.SessionInfo;
            if (info?.Role == "SuperAdmin")
            {
                var result = new AuthResult
                {
                    IsAuthenticated = true,
                    Role = "SuperAdmin",
                    DisplayName = info.DisplayName
                };
                Session.Login(result);
            }
        }

        _isLoading = !Session.IsSuperAdmin;
    }

    private string ActiveClass(string href)
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var target = href.TrimStart('/').TrimEnd('/');
        return string.Equals(uri, target, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private async Task DoLogout()
    {
        Session.Logout();
        // Server revokes the session row and clears the HttpOnly cookie
        try { await JS.InvokeAsync<object>("authPost", "/api/auth/logout", "{}"); }
        catch { /* continue with redirect regardless */ }
        await JS.InvokeVoidAsync("eval", "window.location.href = '/superadmin/login'");
    }
}
