@inherits LayoutComponentBase
@implements IDisposable
@inject AccessControlPro.Web.Services.SessionState Session
@inject NavigationManager Nav
@inject AccessControlPro.Web.Data.GymDbHelper GymDb
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpCtx
@inject Microsoft.AspNetCore.Components.PersistentComponentState AppState

<div class="app-container" dir="@Session.Dir">
    @if (_isLoading)
    {
        <div style="position:fixed; inset:0; width:100vw; height:100vh; display:flex; justify-content:center; align-items:center; color:var(--accent);">
            <i class="fas fa-spinner fa-spin" style="font-size:2.5rem;"></i>
        </div>
    }
    else if (Session.IsAuthenticated)
    {
        <nav class="sidebar @(Session.IsPlayer ? "player-bar" : "")">
            <div class="sidebar-brand">
                <h3>@_gymName</h3>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
                    <span class="user-role">@Session.DisplayName</span>
                    <a href="/logout" style="color: var(--danger); font-size: 0.8rem; text-decoration: none;">
                        <i class="fas fa-sign-out-alt"></i> @L("Logout", "خروج")
                    </a>
                </div>
                @if (!string.IsNullOrEmpty(_expiryInfo))
                {
                    <div style="color: var(--warning); font-size: 0.7rem; margin-top: 0.3rem;">
                        @_expiryInfo
                    </div>
                }
            </div>
            <div class="nav-links">
                @if (Session.IsOwner)
                {
                    <a href="/dashboard" class="nav-link @ActiveClass("dashboard")">
                        <i class="fas fa-chart-line"></i> <span class="nav-text">@L("Dashboard", "لوحة التحكم")</span>
                    </a>
                    <a href="/players" class="nav-link @ActiveClass("players")">
                        <i class="fas fa-users"></i> <span class="nav-text">@L("Players", "اللاعبون")</span>
                    </a>
                    <a href="/events" class="nav-link @ActiveClass("events")">
                        <i class="fas fa-clock"></i> <span class="nav-text">@L("Events", "الأحداث")</span>
                    </a>
                    <a href="/finance" class="nav-link @ActiveClass("finance")">
                        <i class="fas fa-wallet"></i> <span class="nav-text">@L("Finance", "المالية")</span>
                    </a>
                    <a href="/devices" class="nav-link @ActiveClass("devices")">
                        <i class="fas fa-server"></i> <span class="nav-text">@L("Devices", "الأجهزة")</span>
                    </a>
                    <a href="/logs" class="nav-link @ActiveClass("logs")">
                        <i class="fas fa-list"></i> <span class="nav-text">@L("Logs", "السجلات")</span>
                    </a>
                    <a href="/deleted" class="nav-link @ActiveClass("deleted")">
                        <i class="fas fa-trash"></i> <span class="nav-text">@L("Deleted", "المحذوفات")</span>
                    </a>
                    <a href="/qr-pass" class="nav-link @ActiveClass("qr-pass")">
                        <i class="fas fa-qrcode"></i> <span class="nav-text">@L("QR", "QR")</span>
                    </a>
                    <a href="/backup" class="nav-link @ActiveClass("backup")">
                        <i class="fas fa-database"></i> <span class="nav-text">@L("Backup", "نسخ")</span>
                    </a>
                    <a href="/users" class="nav-link @ActiveClass("users")">
                        <i class="fas fa-user-shield"></i> <span class="nav-text">@L("Users", "مستخدمون")</span>
                    </a>
                    <a href="/admin/gyms" class="nav-link @ActiveClass("admin/gyms")">
                        <i class="fas fa-building"></i> <span class="nav-text">@L("Gym", "النادي")</span>
                    </a>
                }
                else
                {
                    <a href="/my" class="nav-link @ActiveClass("my")">
                        <i class="fas fa-id-card"></i> <span class="nav-text">@L("My Subscription", "اشتراكي")</span>
                    </a>
                    <a href="/my/visits" class="nav-link @ActiveClass("my/visits")">
                        <i class="fas fa-clock"></i> <span class="nav-text">@L("Visits", "الزيارات")</span>
                    </a>
                }
                <a href="/change-password" class="nav-link @ActiveClass("change-password")">
                    <i class="fas fa-key"></i> <span class="nav-text">@L("Password", "كلمة المرور")</span>
                </a>
                @* Language toggle hidden 2026-05-13 — site is Arabic-only. *@
                <a href="/logout" class="nav-link logout-link" style="color: #e74c3c; border-top: 1px solid rgba(255,255,255,0.1); margin-top: 0.5rem; padding-top: 0.75rem;">
                    <i class="fas fa-sign-out-alt"></i> <span class="nav-text">@L("Logout", "خروج")</span>
                </a>
            </div>
        </nav>
        <main class="main-content">
            @Body
        </main>
    }
    else
    {
        @Body
    }
</div>

@code {
    private string _gymName = "HM-GymManagement";
    private string _expiryInfo = "";
    private bool _isLoading = true;
    private PersistingComponentStateSubscription _persistSub;

    private string L(string en, string ar) => Session.IsArabic ? ar : en;

    protected override void OnInitialized()
    {
        // Carry the session across the prerender -> interactive-circuit boundary.
        // HttpContext.Items["SessionInfo"] (set by the request middleware from the
        // validated HttpOnly cookie) is ONLY available during server prerender; in the
        // live Blazor circuit HttpContext is null. Without persisting it, every
        // interactive page re-renders unauthenticated and bounces to /login — which
        // showed up as a stuck spinner / redirect loop. PersistentComponentState is the
        // supported way: stash during prerender, restore when the circuit starts.
        _persistSub = AppState.RegisterOnPersisting(PersistSession);

        if (!Session.IsAuthenticated)
        {
            var info = HttpCtx.HttpContext?.Items["SessionInfo"] as AccessControlPro.Web.Services.SessionInfo;

            // Circuit phase: no HttpContext, so restore from the prerender-persisted state.
            if (info == null &&
                AppState.TryTakeFromJson<PersistedSession>("acp.session", out var ps) && ps != null)
            {
                info = new AccessControlPro.Web.Services.SessionInfo
                {
                    Role = ps.Role,
                    DisplayName = ps.DisplayName,
                    UserId = ps.UserId,
                    GymDatabase = ps.GymDatabase,
                    GymId = ps.GymId
                };
            }

            if (info != null)
            {
                Session.Login(new AuthResult
                {
                    IsAuthenticated = true,
                    Role = info.Role,
                    DisplayName = info.DisplayName,
                    UserId = info.UserId,
                    GymDatabase = info.GymDatabase,
                    GymId = info.GymId
                }, info.GymDatabase, info.GymId);
            }
        }

        // Still unauthenticated during server render (e.g. an installed PWA cold-launched
        // to /my without a session cookie): issue a clean server-side redirect to /login
        // NOW, rather than rendering a spinner that waits on the interactive circuit —
        // which is slow/unreliable in standalone PWA mode and left the app stuck loading.
        // HttpContext is non-null only during prerender, where NavigateTo becomes a 302.
        if (!Session.IsAuthenticated && HttpCtx.HttpContext != null)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        _isLoading = !Session.IsAuthenticated;
    }

    private Task PersistSession()
    {
        if (Session.IsAuthenticated)
        {
            AppState.PersistAsJson("acp.session", new PersistedSession
            {
                Role = Session.Role,
                DisplayName = Session.DisplayName,
                UserId = Session.UserId,
                GymDatabase = Session.GymDatabase,
                GymId = Session.GymId
            });
        }
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    private class PersistedSession
    {
        public string Role { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public int UserId { get; set; }
        public string GymDatabase { get; set; } = "";
        public int GymId { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Session is already hydrated in OnInitialized() from HttpContext.Items.
                // No JS cookie parsing or file reads needed — the HttpOnly cookie never
                // reaches JavaScript.

                // Load gym name if authenticated
                if (Session.IsAuthenticated && Session.IsOwner)
                {
                    try { await LoadGymInfoAsync(); }
                    catch (Exception ex) { Console.WriteLine($"[MainLayout] LoadGymInfo error: {ex.Message}"); }
                }

                // Step 3: If still not authenticated, redirect to login
                if (!Session.IsAuthenticated)
                {
                    await JS.InvokeVoidAsync("eval", "window.location.href = '/login'");
                    return;
                }

                _isLoading = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadGymInfoAsync()
    {
        if (Session.IsAuthenticated && Session.IsOwner)
        {
            try
            {
                var dbName = !string.IsNullOrEmpty(Session.GymDatabase) ? Session.GymDatabase : "gymcloud";
                using var conn = await GymDb.GetGymConnectionAsync(dbName);

                // Get gym name from AppSettings
                using var cmd = new Npgsql.NpgsqlCommand(@"SELECT ""GymName"" FROM ""AppSettings"" LIMIT 1", conn);
                var result = await cmd.ExecuteScalarAsync();
                if (result != null && result != DBNull.Value)
                    _gymName = result.ToString() ?? "HM-GymManagement";
            }
            catch (Exception ex) { Console.WriteLine($"[MainLayout] LoadGymName Error: {ex.Message}"); }

            // Get cloud expiry from master
            try
            {
                using var masterConn = await GymDb.GetMasterConnectionAsync();
                using var expiryCmd = new Npgsql.NpgsqlCommand(
                    @"SELECT ""ExpiresAt"" FROM ""Gyms"" WHERE ""Id"" = @id", masterConn);
                expiryCmd.Parameters.AddWithValue("id", Session.GymId > 0 ? Session.GymId : 1);
                var expiryResult = await expiryCmd.ExecuteScalarAsync();
                if (expiryResult != null && expiryResult is DateTime expiry)
                {
                    var daysLeft = (expiry - DateTime.UtcNow).Days;
                    _expiryInfo = daysLeft > 30
                        ? "" // Don't show if more than 30 days
                        : daysLeft > 0
                            ? L($"Expires in {daysLeft} days", $"\u064a\u0646\u062a\u0647\u064a \u062e\u0644\u0627\u0644 {daysLeft} \u064a\u0648\u0645")
                            : L("Expired!", "\u0645\u0646\u062a\u0647\u064a!");
                }
            }
            catch (Exception ex) { Console.WriteLine($"[MainLayout] LoadExpiryInfo Error: {ex.Message}"); }
        }
    }

    private string ActiveClass(string href)
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var target = href.TrimStart('/').TrimEnd('/');
        return string.Equals(uri, target, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private void ToggleLang()
    {
        Session.ToggleLanguage();
        StateHasChanged();
    }
}
